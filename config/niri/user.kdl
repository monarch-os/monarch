// User overrides for the Monarch Niri configuration.
//
// ~/.config/niri/config.kdl is installed and maintained by Monarch — do not
// edit it. This file is included LAST from there, so anything you set here
// wins over Monarch defaults via Niri's include-merging rules:
//
//   - For singleton sections (layout, input, environment, cursor, ...) only
//     the keys you redefine are overridden; the rest stays untouched.
//   - For binds, redefining a single shortcut replaces just that one.
//   - For window-rule / layer-rule / spawn-at-startup blocks, entries are
//     appended (not merged), so feel free to add new ones here.
//
// See: https://niri-wm.github.io/niri/Configuration%3A-Include.html

// ============================================================================
// MONITORS  —  per-output mode / scale / position, or disable an output
// ============================================================================
// Example: pin a per-monitor configuration
// output "DP-1" {
//     mode "3840x2160@60.000"
//     scale 1.5
//     position x=0 y=0
// }

// ============================================================================
// INPUT  —  keyboard layout, touchpad, mouse
// ============================================================================
// Example: change the keyboard layout
// input {
//     keyboard {
//         xkb { layout "fr"; }
//     }
// }

// ============================================================================
// KEYBINDINGS  —  redefining a shortcut replaces just that one bind
// ============================================================================
// Example: override a single binding
// binds {
//     Mod+Return { spawn "kitty"; }
// }

// ============================================================================
// WORKSPACES & WINDOW RULES  —  route apps to workspaces / outputs
// ============================================================================
// Example: route an app to its own workspace
// workspace "chat" {
//     open-on-output "DP-1"
// }
// window-rule {
//     match at-startup=true app-id=r#"^org\.telegram\.desktop$"#
//     open-on-workspace "chat"
// }

// ============================================================================
// AUTOSTART  —  extra programs to launch on login
// ============================================================================
// Example: extra autostart
// spawn-at-startup "uwsm-app" "--" "my-service"
