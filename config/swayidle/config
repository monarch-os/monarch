# Monarch swayidle configuration (replaces hypridle).
# Reference: man 5 swayidle

# Lock the session when systemd asks for sleep, then turn the display on resume.
before-sleep 'MONARCH_LOCK_ONLY=true monarch-system-lock'
after-resume 'sleep 1 && monarch-system-wake'

# Start the screensaver after 2.5 minutes of inactivity. Noctalia's lock
# screen lives inside the noctalia-shell process and naturally renders on top
# of the screensaver overlay, so no separate guard is needed.
timeout 150 'monarch-launch-screensaver'

# Lock the system after 5 minutes (the screensaver resets the idle timer, so
# we double up with a small margin).
timeout 152 'monarch-system-lock' resume 'monarch-system-wake'

# Turn the displays off 30s after the lock.
timeout 182 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors'
