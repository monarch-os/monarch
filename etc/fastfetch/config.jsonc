{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/monarch/branding/about.txt",
    "color": { "1": "green" },
    "padding": {
      "top": 2,
      "right": 0,
      "left": 8,
    },
  },
  "display": {
    "separator": " ",
    "disableLinewrap": true,
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m╭───────────────────── \u001b[92mHardware\u001b[90m ─────────────────────╮\u001b[0m",
    },
    {
      "type": "host",
      "key": "\u001b[90m│  \u001b[92m  ::\u001b[0m",
      "format": "{family:-44}{/family}{name:-44}{/}",
    },
    {
      "type": "cpu",
      "key": "\u001b[90m│  \u001b[92m  ::\u001b[0m",
      "format": "{name:-44}",
      "showPeCoreCount": true,
    },
    {
      "type": "gpu",
      "key": "\u001b[90m│  \u001b[92m  ::\u001b[0m",
      "format": "{name:-44}",
      "detectionMethod": "pci",
    },
    {
      "type": "display",
      "key": "\u001b[90m│  \u001b[92m󱄄  ::\u001b[0m",
      "format": "{width}x{height} @ {refresh-rate} Hz",
    },
    {
      "type": "disk",
      "key": "\u001b[90m│  \u001b[92m󰋊  ::\u001b[0m",
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "memory",
      "key": "\u001b[90m│  \u001b[92m  ::\u001b[0m",
      "format": "{used} / {total} ({percentage})",
    },
    {
      "type": "swap",
      "key": "\u001b[90m│  \u001b[92m󰓡  ::\u001b[0m",
      "format": "{used} / {total} ({percentage})",
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰────────────────────────────────────────────────────╯\u001b[0m",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m╭───────────────────── \u001b[94mSoftware\u001b[90m ─────────────────────╮\u001b[0m",
    },
    {
      "type": "command",
      "key": "\u001b[90m│  \u001b[94m\ue900  ::\u001b[0m",
      "text": "version=$(monarch-version); echo \"Monarch $version\"",
    },
    {
      "type": "command",
      "key": "\u001b[90m│  \u001b[94m󰘬  ::\u001b[0m",
      "text": "branch=$(monarch-version-branch); echo \"$branch\"",
    },
    {
      "type": "command",
      "key": "\u001b[90m│  \u001b[94m󰔫  ::\u001b[0m",
      "text": "channel=$(monarch-version-channel); echo \"$channel\"",
    },
    {
      "type": "kernel",
      "key": "\u001b[90m│  \u001b[94m  ::\u001b[0m",
    },
    {
      "type": "wm",
      "key": "\u001b[90m│  \u001b[94m  ::\u001b[0m",
    },
    {
      "type": "de",
      "key": "\u001b[90m│  \u001b[94m󰟀  ::\u001b[0m",
    },
    {
      "type": "terminal",
      "key": "\u001b[90m│  \u001b[94m  ::\u001b[0m",
    },
    {
      "type": "packages",
      "key": "\u001b[90m│  \u001b[94m󰏖  ::\u001b[0m",
    },
    {
      "type": "wmtheme",
      "key": "\u001b[90m│  \u001b[94m󰉼  ::\u001b[0m",
    },
    {
      "type": "command",
      "key": "\u001b[90m│  \u001b[94m󰸌  ::\u001b[0m",
      "text": "theme=$(noctalia msg color-scheme-get 2>/dev/null | cut -d' ' -f2-); echo -e \"${theme:-Monarch} \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\"",
    },
    {
      "type": "terminalfont",
      "key": "\u001b[90m│  \u001b[94m  ::\u001b[0m",
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰────────────────────────────────────────────────────╯\u001b[0m",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m╭────────────────────── \u001b[95mSystem\u001b[90m ──────────────────────╮\u001b[0m",
    },
    {
      "type": "command",
      "key": "\u001b[90m│  \u001b[95m󱦟  ::\u001b[0m",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days",
    },
    {
      "type": "uptime",
      "key": "\u001b[90m│  \u001b[95m󱫐  ::\u001b[0m",
    },
    {
      "type": "command",
      "key": "\u001b[90m│  \u001b[95m  ::\u001b[0m",
      "text": "updated=$(monarch-version-pkgs); echo \"$updated\"",
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰────────────────────────────────────────────────────╯\u001b[0m",
    },
    "break",
  ],
}
