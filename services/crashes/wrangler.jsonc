{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monarch-crashes",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "INGEST_ENABLED": "false",
    "DAILY_LIMIT": "1000",
    "RETENTION_DAYS": "30",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "triggers": { "crons": ["17 * * * *"] },
  "ratelimits": [{
    "name": "INGEST_LIMITER",
    "namespace_id": "10001",
    "simple": { "limit": 10, "period": 60 }
  }],
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "monarch-crashes" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "monarch-crashes",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "env": {
    "local": {
      "vars": {
        "LOCAL_DEV": "true",
        "INGEST_ENABLED": "true",
        "DAILY_LIMIT": "1000",
        "RETENTION_DAYS": "30",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      },
      "ratelimits": [{
        "name": "INGEST_LIMITER",
        "namespace_id": "10002",
        "simple": { "limit": 10, "period": 60 }
      }],
      "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "monarch-crashes-local" }],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "crashes",
        "database_id": "00000000-0000-0000-0000-000000000000",
        "migrations_dir": "migrations"
      }]
    }
  }
}
