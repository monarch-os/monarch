{
  "name": "monarch-crash-collection",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev --env local --ip 127.0.0.1",
    "test": "node test/worker.test.js",
    "test:integration": "node test/integration.js",
    "db:local": "wrangler d1 migrations apply crashes --local --env local",
    "check:deploy": "wrangler deploy --dry-run --outdir .wrangler/build"
  },
  "dependencies": { "jose": "^6.1.3" },
  "devDependencies": { "wrangler": "^4.0.0" }
}
