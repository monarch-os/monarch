#!/bin/bash

# monarch:summary=Set and launch the default coding agent
# monarch:args=[pi|omp|opencode|ori|claude|codex|grok|agy|copilot|crush]
# monarch:examples=monarch default agent | monarch default agent claude | monarch default agent codex

agent_file="$HOME/.config/monarch/defaults/agent"

if (($# == 0)); then
  if [[ -f $agent_file ]]; then
    read -r agent <"$agent_file"
  fi

  # Silent when unset rather than defaulting: Monarch picks no agent for you, so
  # the menu leaves every entry unchecked until one is chosen.
  [[ -n ${agent:-} ]] && echo "$agent"
  exit 0
fi

installing=false
if [[ $1 == "--install" ]]; then
  installing=true
  shift
fi

case "$1" in
pi) agent="pi"; name="Pi" ;;
omp | oh-my-pi) agent="omp"; name="Oh My Pi"; agent_package="github:can1357/oh-my-pi" ;;
opencode | open-code) agent="opencode"; name="OpenCode" ;;
ori | openrouter) agent="ori"; name="Ori"; agent_package="github:OpenRouterLabs/ori-releases" ;;
claude | claude-code) agent="claude"; name="Claude Code" ;;
codex) agent="codex"; name="Codex" ;;
grok) agent="grok"; name="Grok"; agent_package="npm:@xai-official/grok" ;;
agy | antigravity | antigravity-cli | gemini | gemini-cli) agent="agy"; name="Antigravity"; agent_package="antigravity-cli" ;;
copilot | github-copilot) agent="copilot"; name="GitHub Copilot" ;;
crush) agent="crush"; name="Crush" ;;
*)
  echo "Usage: monarch-default-agent <pi|omp|opencode|ori|claude|codex|grok|agy|copilot|crush>" >&2
  exit 1
  ;;
esac

agent_package=${agent_package:-$agent}

if [[ $installing == "false" ]] && ! mise where "$agent_package" &>/dev/null; then
  exec monarch-launch-floating-terminal-with-presentation monarch-default-agent --install "$agent"
fi

if ! mise use -g "$agent_package"; then
  if [[ $installing == "true" ]]; then
    echo "Could not install $name with mise" >&2
  else
    echo "Could not set $name as the default coding agent" >&2
  fi
  exit 1
fi

mkdir -p "$(dirname "$agent_file")"
printf '%s\n' "$agent" >"$agent_file"

# Collect usage now rather than leaving the bar empty until the shell's own
# refresh comes round. Detached and quiet: the collectors reach the network and
# walk the transcripts, and neither the agent launch below nor the terminal it
# runs in should wait on that.
if monarch-cmd-present monarch-agent-usage-update; then
  setsid --fork monarch-agent-usage-update --force >/dev/null 2>&1 &
fi

if [[ $installing == "true" ]]; then
  printf '\033[2J\033[3J\033[H'
  exec monarch-agent --inline
else
  notify-send -u low "󰚩    $name is now the default coding agent"
  exec monarch-agent
fi
