#!/bin/bash

# monarch:summary=Install and configure the NVIDIA driver for this GPU
# monarch:requires-sudo=true

set -euo pipefail

if ! monarch-hw-nvidia; then
  echo "No NVIDIA GPU found." >&2
  exit 1
fi

if monarch-hw-nvidia-gsp; then
  PACKAGES=(nvidia-open-dkms nvidia-utils libva-nvidia-driver)
  GPU_ARCH="turing_plus"
elif monarch-hw-nvidia-without-gsp; then
  PACKAGES=(nvidia-580xx-dkms nvidia-580xx-utils)
  GPU_ARCH="maxwell_pascal_volta"
else
  echo "No compatible driver for your NVIDIA GPU. See: https://wiki.archlinux.org/title/NVIDIA"
  exit 0
fi

monarch-pkg-add $(monarch-hw-kernel-headers) "${PACKAGES[@]}"

sudo tee /etc/modprobe.d/nvidia.conf <<EOF >/dev/null
options nvidia_drm modeset=1
EOF

sudo tee /etc/mkinitcpio.conf.d/nvidia.conf <<EOF >/dev/null
MODULES+=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)
EOF

source "${MONARCH_PATH:-/usr/share/monarch}/install/reconcile/nvidia-env.sh"
monarch_reconcile_nvidia_environment "$GPU_ARCH"

rm -f ~/.local/state/monarch/nvidia-driver-pending

# The installer keeps the mkinitcpio hooks disabled and rebuilds every UKI later,
# in install/login/limine-snapper.sh. Run outside it, nothing else will.
if [[ -z ${MONARCH_INSTALL:-} ]]; then
  sudo mkinitcpio -P
  echo "Reboot to load the driver."
fi
