#!/bin/bash

# monarch:summary=Launch the Monarch Menu or jump straight to a submenu.
# monarch:args=[route]
# monarch:examples=monarch menu | monarch menu style | monarch menu trigger.capture

# The menu's content is data: default/monarch/monarch-menu.jsonc, overlaid by
# ~/.config/monarch/extensions/monarch-menu.jsonc — see that file for the entry
# schema. The menu is drawn by the monarch/menu Noctalia panel; this command
# loads the data for it, evaluates the guards, and routes the keybinds to it.

MONARCH_ROOT="${MONARCH_PATH:-/usr/share/monarch}"

# Guard expressions call monarch-* commands, and this runs from a keybind, from
# the Noctalia panel and from a plain shell — none of which can be relied on to
# have Monarch's bin on PATH. Without this every guard fails and rows silently
# vanish, differently depending on the caller.
PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd):$PATH"

# Fall back to the checkout this script lives in when the installed tree has no
# menu data. That is the case in CI and whenever a developer runs bin/monarch-menu
# straight out of a clone, where relying on MONARCH_PATH being exported is a trap:
# the test suite sets it, a bare invocation does not, and the two disagree.
if [[ ! -f "$MONARCH_ROOT/default/monarch/monarch-menu.jsonc" ]]; then
  MONARCH_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
fi

DEFAULT_MENU="$MONARCH_ROOT/default/monarch/monarch-menu.jsonc"
USER_MENU="$HOME/.config/monarch/extensions/monarch-menu.jsonc"

# Row sources the data cannot express: `list` enumerates values, `current` names
# the selected one, `action` receives it. Declared here rather than in the panel
# so the CLI and the panel cannot drift; an extension may point a submenu at one
# of these but cannot declare a new one.
declare -A PROVIDER_LIST=(
  [fonts]="monarch-font-list"
  [power-profiles]="monarch-powerprofiles-list"
  [text-size]="monarch-display-text-size --list"
)
declare -A PROVIDER_CURRENT=(
  [fonts]="monarch-font-current"
  [power-profiles]="powerprofilesctl get"
  [text-size]="monarch-display-text-size --current"
)
declare -A PROVIDER_ACTION=(
  [fonts]="monarch-font-set"
  # Not `powerprofilesctl set`: that applies without recording, so the next
  # time the cable moves the choice made here is silently undone.
  [power-profiles]="monarch-powerprofiles-set autodetect"
  [text-size]="monarch-display-text-size"
)
# ── Data ─────────────────────────────────────────────────────────────────────

# JSONC is JSON plus whole-line // comments and trailing commas, both stripped
# textually — an inline trailing comment breaks the parse, same limitation
# Monarch documents. The user file is overlaid per key and per field, so reusing
# a shipped id replaces only the fields it declares and keeps its position,
# while new ids append. A user file that does not parse contributes nothing
# rather than taking the whole menu down with it.
load_menu() {
  MENU_JSON=$(
    python - "$DEFAULT_MENU" "$USER_MENU" <<'PY'
import json, re, sys

def load(path):
    try:
        raw = open(path, encoding="utf-8").read()
    except OSError:
        return None
    raw = "\n".join("" if l.lstrip().startswith("//") else l for l in raw.splitlines())
    raw = re.sub(r",(\s*[}\]])", r"\1", raw)
    try:
        data = json.loads(raw)
    except ValueError as exc:
        print(f"{path}: {exc}", file=sys.stderr)
        return None
    return data if isinstance(data, dict) else None

defaults = load(sys.argv[1])
if defaults is None:
    sys.exit(1)

for key, entry in (load(sys.argv[2]) or {}).items():
    if key in defaults and isinstance(entry, dict) and isinstance(defaults[key], dict):
        defaults[key].update(entry)
    else:
        defaults[key] = entry

json.dump(defaults, sys.stdout)
PY
  ) || {
    echo "monarch-menu: cannot read $DEFAULT_MENU" >&2
    exit 1
  }
}

ids() { jq -r 'keys_unsorted[]' <<<"$MENU_JSON"; }

# One jq call per level: id and every field the renderer needs, unit-separated —
# not tab, because bash `read` folds runs of whitespace delimiters together and
# an empty field would shift every field after it.
level_rows() {
  local parent="$1"
  jq -r --arg parent "$parent" '
    to_entries
    | map(select(
        if $parent == "root"
        then ((.key | contains(".") | not) and ((.value.hiddenAtRoot // false) | not))
        else (.key | startswith($parent + ".")) and
             ((.key | ltrimstr($parent + ".") | contains(".")) | not)
        end))
    | .[]
    | [ .key,
        (.value.icon // ""),
        (.value.label // (.key | split(".") | last)),
        (.value.when // ""),
        (.value.checked // ""),
        (.value.disabled // "") ]
    | join("\u001f")' <<<"$MENU_JSON"
}

field() {
  jq -r --arg id "$1" --arg key "$2" '.[$id][$key] // empty' <<<"$MENU_JSON"
}

tree_payload() {
  jq -c '
    . as $menu
    | (keys_unsorted | map(select(test("\\.")) | sub("\\.[^.]+$"; "")) | unique) as $parents
    | to_entries
    | map(.key as $id | {
        id: $id,
        searchText: ([
          (.value.label // ($id | split(".") | last)),
          ($id | split(".") | last),
          (.value.description // "")
        ] + (.value.aliases // []) + (.value.keywords // []) | join(" "))
        } + .value + {hasChildren: (($parents | index($id)) != null)})' <<<"$MENU_JSON"
}

initial_payload() {
  local route=$1
  tree_payload | jq -c --arg route "$route" '
    map(.id as $id | select((.when == null) and (
      if $route == "root" then
        (($id | contains(".") | not) and (.hiddenAtRoot != true))
      else
        ($id == $route)
        or ($route | startswith($id + "."))
        or (($id | startswith($route + ".")) and (($id | ltrimstr($route + ".") | contains(".")) | not))
      end
    )))'
}

menu_title() {
  [[ $1 == root ]] && {
    echo Go
    return
  }
  local title
  title=$(jq -r --arg id "$1" '.[$id].title // .[$id].label // ($id | split(".") | last)' <<<"$MENU_JSON")
  echo "$title"
}

# ── Routes ───────────────────────────────────────────────────────────────────

# Exact id first, then a declared alias, then the last segment of an id — which
# is why `monarch menu style` and `monarch menu trigger.capture` both work and
# almost nothing needs an alias. An unknown route is passed through unchanged so
# a typo fails visibly instead of silently opening the root menu.
resolve_route() {
  local route="${1,,}"
  route="${route//_/-}"

  if [[ -z $route || $route == go || $route == menu || $route == root ]]; then
    echo root
    return
  fi

  jq -r --arg r "$route" '
    (keys_unsorted[] | select(ascii_downcase == $r)),
    (to_entries[] | select(.value.aliases // [] | map(ascii_downcase) | index($r)) | .key),
    (keys_unsorted[] | select((split(".") | last | ascii_downcase) == $r)),
    $r' <<<"$MENU_JSON" | head -1
}

guard_passes() { (eval "$1") >/dev/null 2>&1; }

# Evaluating the guards is the whole cost of opening the menu: 137 of them on
# the shipped tree, ~1s of the ~1s `--state` takes. Almost all of them call one
# of four Monarch helpers, and each helper is a script, so a guard costs a fork
# *and* an exec of bash — for work that is either a shell builtin or a lookup in
# state that can be read once for the whole tree.
#
# Defining those four as functions collapses that: a function is found before
# PATH, so the guards get them in-process, while the scripts stay exactly where
# they are for every other caller (and for a guard in a user's extension that
# calls something else entirely). Measured on the shipped tree: 990ms → 190ms,
# with all 137 verdicts unchanged.
#
# Parallelising instead was tried and is slower — one bash per guard costs more
# than the execs it removes. Keep these in step with the scripts they shadow:
# bin/monarch-{cmd,pkg,desktop}-present and bin/monarch-default-{browser,agent}.
prime_guard_helpers() {
  monarch-cmd-present() {
    local cmd
    for cmd in "$@"; do
      command -v "$cmd" >/dev/null 2>&1 || return 1
    done
    return 0
  }

  monarch-desktop-present() {
    local entry="${1:-}" dir
    [[ -z $entry ]] && return 1
    for dir in "$HOME/.local/share/applications" "$HOME/.nix-profile/share/applications" /usr/share/applications; do
      [[ -f "$dir/$entry" ]] && return 0
    done
    return 1
  }

  # One snapshot of the local database instead of a `pacman -Q` per row. Only
  # taken when something asks, so a tree with no package rows pays nothing.
  if [[ $MENU_JSON == *monarch-pkg-present* ]]; then
    declare -gA PKG_PRESENT=()
    local pkg
    while read -r pkg; do
      PKG_PRESENT[$pkg]=1
    done < <(pacman -Qq 2>/dev/null)
    monarch-pkg-present() {
      local pkg
      for pkg in "$@"; do
        [[ -n ${PKG_PRESENT[$pkg]:-} ]] || return 1
      done
      return 0
    }
  fi

  # xdg-settings shells out to gio, so the browser rows were each paying for a
  # full lookup — seven of them, ~35ms apiece. Resolve it once. Only the
  # no-argument form is a query; with arguments this is a setter, which has side
  # effects and must reach the real script.
  if [[ $MENU_JSON == *monarch-default-browser* ]]; then
    DEFAULT_BROWSER=$(command monarch-default-browser 2>/dev/null)
    monarch-default-browser() {
      if (($# == 0)); then
        printf '%s\n' "$DEFAULT_BROWSER"
        return 0
      fi
      command monarch-default-browser "$@"
    }
  fi

  # One agent row per agent, all asking the same question. Cheaper than the
  # browser lookup but eight times over, so resolve it once as well.
  if [[ $MENU_JSON == *monarch-default-agent* ]]; then
    DEFAULT_AGENT=$(command monarch-default-agent 2>/dev/null)
    monarch-default-agent() {
      if (($# == 0)); then
        printf '%s\n' "$DEFAULT_AGENT"
        return 0
      fi
      command monarch-default-agent "$@"
    }
  fi

  if [[ $MENU_JSON == *monarch-default-terminal* ]]; then
    DEFAULT_TERMINAL=$(command monarch-default-terminal 2>/dev/null)
    monarch-default-terminal() {
      if (($# == 0)); then
        printf '%s\n' "$DEFAULT_TERMINAL"
      else
        command monarch-default-terminal "$@"
      fi
    }
  fi

  if [[ $MENU_JSON == *monarch-default-editor* ]]; then
    DEFAULT_EDITOR=$(command monarch-default-editor 2>/dev/null)
    monarch-default-editor() {
      if (($# == 0)); then
        printf '%s\n' "$DEFAULT_EDITOR"
      else
        command monarch-default-editor "$@"
      fi
    }
  fi

  if [[ $MENU_JSON == *monarch-bar-position* ]]; then
    BAR_POSITION=$(command monarch-bar-position 2>/dev/null)
    monarch-bar-position() {
      if (($# == 0)); then
        printf '%s\n' "$BAR_POSITION"
      else
        command monarch-bar-position "$@"
      fi
    }
  fi

  if [[ $MENU_JSON == *monarch-version-channel* ]]; then
    VERSION_CHANNEL=$(command monarch-version-channel 2>/dev/null)
    monarch-version-channel() {
      printf '%s\n' "$VERSION_CHANNEL"
    }
  fi

  if [[ $MENU_JSON == *monarch-hibernation-available* ]]; then
    HIBERNATION_AVAILABLE=false
    command monarch-hibernation-available && HIBERNATION_AVAILABLE=true
    monarch-hibernation-available() {
      [[ $HIBERNATION_AVAILABLE == true ]]
    }
  fi

  monarch-toggle-enabled() {
    [[ -f "$HOME/.local/state/monarch/toggles/${1:-}" ]]
  }
}

# ── Inspection ───────────────────────────────────────────────────────────────

# Everything above renders; nothing below it opens a window. These modes are
# what the test suite drives, and they are equally useful for debugging a route
# or a guard by hand.

# Reports what the data says that the renderer cannot discover at runtime:
# a target or provider that does not exist, an entry whose parent is missing,
# and a submenu with no children.
# One jq pass over the whole tree. The obvious shape — a loop calling `field`
# and `level_rows` per entry — spawns roughly four jq processes per entry and
# took 55 seconds on the shipped menu, which the test suite calls four times.
check_menu() {
  local providers findings
  providers=$(printf '%s\n' "${!PROVIDER_LIST[@]}" | jq -R . | jq -sc .)

  findings=$(jq -r --argjson providers "$providers" '
    . as $menu
    | (keys_unsorted) as $ids
    | ($ids | map({key: ., value: true}) | from_entries) as $exists
    | ($ids | map(select(test("\\.")) | sub("\\.[^.]+$"; "")) | unique) as $parents
    | [ to_entries[]
        | .key as $id
        | .value as $entry
        | (if ($entry.target != null) and (($exists[$entry.target] // false) | not)
           then "\($id): target \u0027\($entry.target)\u0027 does not exist" else empty end),
          (if ($entry.provider != null) and (($providers | index($entry.provider)) == null)
           then "\($id): unknown provider \u0027\($entry.provider)\u0027" else empty end),
          ((($id | sub("\\.[^.]+$"; "")) as $parent
            | if ($id | test("\\.")) and (($exists[$parent] // false) | not)
              then "\($id): parent \u0027\($parent)\u0027 does not exist" else empty end)),
          (if ($entry.action == null)
              and ($entry.target == null)
              and ($entry.provider == null)
              and (($parents | index($id)) == null)
           then "\($id): submenu with no children" else empty end)
      ]
    | .[]' <<<"$MENU_JSON")

  if [[ -n $findings ]]; then
    printf '%s\n' "$findings" >&2
    return 1
  fi

  echo "Menu data check passed ($(jq -r 'length' <<<"$MENU_JSON") entries)"
}

case "${1:-}" in
--initial)
  load_menu
  route=$(resolve_route "${2:-}")
  initial_payload "$route"
  exit 0
  ;;
--tree)
  load_menu
  tree_payload
  exit 0
  ;;
--state)
  # Tree and guards in one payload, which is what the panel asks for on every
  # open: one subprocess instead of two, and the tree can never go stale against
  # the file the way a cached copy does.
  #
  # Guards come back as an object keyed `<id>:<w|c|d>`, not as lines: the
  # consumer decodes it natively, and parsing 130 lines in Luau is enough to
  # blow a plugin callback's CPU budget.
  load_menu
  prime_guard_helpers
  declare -A guard_results=()
  guard_pairs=$(
    while IFS=$'\x1f' read -r key kind expression; do
      [[ -z $expression ]] && continue
      if [[ -n ${guard_results["$expression"]+present} ]]; then
        passed=${guard_results["$expression"]}
      elif guard_passes "$expression"; then
        passed=true
        guard_results["$expression"]=$passed
      else
        passed=false
        guard_results["$expression"]=$passed
      fi
      if [[ $passed == true ]]; then
        printf '%s:%s\ttrue\n' "$key" "$kind"
      else
        printf '%s:%s\tfalse\n' "$key" "$kind"
      fi
    done < <(jq -r 'to_entries[] | .key as $k |
      (if .value.when then [$k, "w", .value.when] else empty end),
      (if .value.checked then [$k, "c", .value.checked] else empty end),
      (if .value.disabled then [$k, "d", .value.disabled] else empty end)
      | join("\u001f")' <<<"$MENU_JSON")
  )
  jq -nc \
    --argjson tree "$(tree_payload)" \
    --argjson guards "$(printf '%s' "$guard_pairs" | jq -R -s 'split("\n") | map(select(length > 0) | split("\t")) | map({key: .[0], value: (.[1] == "true")}) | from_entries')" \
    '{tree: $tree, guards: $guards}'
  exit 0
  ;;
--provider)
  # A provider's rows, as JSON, for a consumer that renders them itself. The
  # provider definitions stay here so the CLI and the panel cannot drift.
  load_menu
  provider=$(field "${2:-}" provider)
  list=""
  [[ -n $provider ]] && list="${PROVIDER_LIST[$provider]:-}"
  if [[ -z $list ]]; then
    echo "monarch-menu: ${2:-} has no known provider" >&2
    exit 1
  fi
  current=$(${PROVIDER_CURRENT[$provider]} 2>/dev/null)
  $list | jq -R --arg current "$current" '{label: ., value: ., current: (. == $current)}' | jq -sc .
  exit 0
  ;;
--provider-set)
  load_menu
  provider=$(field "${2:-}" provider)
  action=""
  [[ -n $provider ]] && action="${PROVIDER_ACTION[$provider]:-}"
  if [[ -z $action ]]; then
    echo "monarch-menu: ${2:-} has no known provider" >&2
    exit 1
  fi
  exec $action "${3:-}"
  ;;
--resolve)
  load_menu
  resolve_route "${2:-}"
  exit 0
  ;;
--rows)
  load_menu
  prime_guard_helpers
  while IFS=$'\x1f' read -r key icon label when checked disabled; do
    [[ -z $key ]] && continue
    [[ -n $when ]] && ! guard_passes "$when" && continue
    printf '%s\t%s\n' "$key" "$label"
  done < <(level_rows "$(resolve_route "${2:-}")")
  exit 0
  ;;
--check)
  load_menu
  check_menu
  exit $?
  ;;
esac

# ── Entry point ──────────────────────────────────────────────────────────────

# The menu itself is the monarch/menu Noctalia panel. This only routes: the
# route is passed as the panel's context, and panel-toggle means a second press
# of the same keybind closes it.
PANEL="monarch/menu:panel"

case "${1:-}" in
close) exec noctalia msg panel-close "$PANEL" ;;
--*)
  # Anything else starting with a dash is a typo, not a route: without this it
  # would fall through and toggle the panel, which looks like the flag worked.
  echo "monarch-menu: unknown option '$1'" >&2
  exit 2
  ;;
esac

exec noctalia msg panel-toggle "$PANEL" "${1:-root}"
