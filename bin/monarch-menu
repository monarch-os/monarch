  *RetroArch*) present_terminal monarch-install-gaming-retroarch ;;
  *Minecraft*) install_and_launch "Minecraft" "minecraft-launcher" "minecraft-launcher" ;;
  *GeForce*) present_terminal monarch-install-gaming-geforce-now ;;
  *"Xbox Cloud"*) present_terminal monarch-install-gaming-xbox-cloud ;;
  *Xbox*) present_terminal monarch-install-gaming-xbox-controllers ;;
  *Lutris*) present_terminal monarch-install-gaming-lutris ;;
  *Heroic*) present_terminal monarch-install-gaming-heroic ;;
  *Moonlight*) present_terminal monarch-install-gaming-moonlight ;;
  *) show_install_menu ;;
  esac
}

