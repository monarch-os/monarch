  case $(menu "Restart" "  Audio\n󱚾  Wi-Fi\n󰂯  Bluetooth\n󰟸  Trackpad") in
  *Audio*) present_terminal monarch-restart-pipewire ;;
  *Wi-Fi*) present_terminal monarch-restart-wifi ;;
  *Bluetooth*) present_terminal monarch-restart-bluetooth ;;
