  case $(menu "Install" "󰣇  Package\n󰣇  AUR\n  Web App\n  TUI\n  Service\n  Font\n󰵮  Development\n󰨈  Cyber\n  Editor\n  Terminal\n  Browser\n󱚤  AI\n  Gaming\n󰍲  Windows") in
  *Package*) terminal monarch-pkg-install ;;
  *AUR*) terminal monarch-pkg-aur-install ;;
  *Web*) present_terminal monarch-webapp-install ;;
  *TUI*) present_terminal monarch-tui-install ;;
  *Service*) show_install_service_menu ;;
  *Font*) show_install_font_menu ;;
  *Development*) show_install_development_menu ;;
  *Cyber*) show_install_cyber_menu ;;
  *Editor*) show_install_editor_menu ;;
  *Terminal*) show_install_terminal_menu ;;
  *Browser*) show_install_browser_menu ;;
  *Gaming*) show_install_gaming_menu ;;
  *AI*) show_install_ai_menu ;;
  *Windows*) present_terminal "monarch-windows-vm install" ;;
  *) show_main_menu ;;
  esac
}

