#!/bin/bash

# monarch:summary=Launch the Monarch Menu or jump straight to a submenu.
# monarch:args=[route]
# monarch:examples=monarch menu | monarch menu style | monarch menu trigger.capture

# The menu's content is data: default/monarch/monarch-menu.jsonc, overlaid by
# ~/.config/monarch/extensions/monarch-menu.jsonc. This file only renders it.
# See the header of the .jsonc for the entry schema.

MONARCH_ROOT="${MONARCH_PATH:-$HOME/.local/share/monarch}"

# Fall back to the checkout this script lives in when the installed tree has no
# menu data. That is the case in CI and whenever a developer runs bin/monarch-menu
# straight out of a clone, where relying on MONARCH_PATH being exported is a trap:
# the test suite sets it, a bare invocation does not, and the two disagree.
if [[ ! -f "$MONARCH_ROOT/default/monarch/monarch-menu.jsonc" ]]; then
  MONARCH_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
fi

DEFAULT_MENU="$MONARCH_ROOT/default/monarch/monarch-menu.jsonc"
USER_MENU="$HOME/.config/monarch/extensions/monarch-menu.jsonc"

STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/monarch"
MENU_PID_FILE="$STATE_DIR/menu.pid"
PICKER_PID_FILE="$STATE_DIR/menu-picker.pid"
STATE_DIR_READY=false

CHECK_MARK="✓"
SELECTED=""

# Row sources the data cannot express: `list` enumerates values, `current` names
# the selected one, `action` receives it. An extension may point a submenu at one
# of these but cannot declare a new one.
declare -A PROVIDER_LIST=(
  [fonts]="monarch-font-list"
  [power-profiles]="monarch-powerprofiles-list"
)
declare -A PROVIDER_CURRENT=(
  [fonts]="monarch-font-current"
  [power-profiles]="powerprofilesctl get"
)
declare -A PROVIDER_ACTION=(
  [fonts]="monarch-font-set"
  [power-profiles]="powerprofilesctl set"
)
declare -A PROVIDER_WIDTH=(
  [fonts]="350"
)

# ── Data ─────────────────────────────────────────────────────────────────────

# JSONC is JSON plus whole-line // comments and trailing commas, both stripped
# textually — an inline trailing comment breaks the parse, same limitation
# quattro documents. The user file is overlaid per key and per field, so reusing
# a shipped id replaces only the fields it declares and keeps its position,
# while new ids append. A user file that does not parse contributes nothing
# rather than taking the whole menu down with it.
load_menu() {
  MENU_JSON=$(
    python - "$DEFAULT_MENU" "$USER_MENU" <<'PY'
import json, re, sys

def load(path):
    try:
        raw = open(path, encoding="utf-8").read()
    except OSError:
        return None
    raw = "\n".join("" if l.lstrip().startswith("//") else l for l in raw.splitlines())
    raw = re.sub(r",(\s*[}\]])", r"\1", raw)
    try:
        data = json.loads(raw)
    except ValueError as exc:
        print(f"{path}: {exc}", file=sys.stderr)
        return None
    return data if isinstance(data, dict) else None

defaults = load(sys.argv[1])
if defaults is None:
    sys.exit(1)

for key, entry in (load(sys.argv[2]) or {}).items():
    if key in defaults and isinstance(entry, dict) and isinstance(defaults[key], dict):
        defaults[key].update(entry)
    else:
        defaults[key] = entry

json.dump(defaults, sys.stdout)
PY
  ) || {
    echo "monarch-menu: cannot read $DEFAULT_MENU" >&2
    exit 1
  }
}

ids() { jq -r 'keys_unsorted[]' <<<"$MENU_JSON"; }

# One jq call per level: id and every field the renderer needs, unit-separated —
# not tab, because bash `read` folds runs of whitespace delimiters together and
# an empty field would shift every field after it.
level_rows() {
  local parent="$1"
  jq -r --arg parent "$parent" '
    to_entries
    | map(select(
        if $parent == "root"
        then (.key | contains(".") | not)
        else (.key | startswith($parent + ".")) and
             ((.key | ltrimstr($parent + ".") | contains(".")) | not)
        end))
    | .[]
    | [ .key,
        (.value.icon // ""),
        (.value.label // (.key | split(".") | last)),
        (.value.when // ""),
        (.value.checked // ""),
        (.value.disabled // "") ]
    | join("\u001f")' <<<"$MENU_JSON"
}

field() {
  jq -r --arg id "$1" --arg key "$2" '.[$id][$key] // empty' <<<"$MENU_JSON"
}

menu_title() {
  [[ $1 == root ]] && {
    echo Go
    return
  }
  local title
  title=$(jq -r --arg id "$1" '.[$id].title // .[$id].label // ($id | split(".") | last)' <<<"$MENU_JSON")
  echo "$title"
}

# ── Routes ───────────────────────────────────────────────────────────────────

# Exact id first, then a declared alias, then the last segment of an id — which
# is why `monarch menu style` and `monarch menu trigger.capture` both work and
# almost nothing needs an alias. An unknown route is passed through unchanged so
# a typo fails visibly instead of silently opening the root menu.
resolve_route() {
  local route="${1,,}"
  route="${route//_/-}"

  if [[ -z $route || $route == go || $route == menu || $route == root ]]; then
    echo root
    return
  fi

  jq -r --arg r "$route" '
    (keys_unsorted[] | select(ascii_downcase == $r)),
    (to_entries[] | select(.value.aliases // [] | map(ascii_downcase) | index($r)) | .key),
    (keys_unsorted[] | select((split(".") | last | ascii_downcase) == $r)),
    $r' <<<"$MENU_JSON" | head -1
}

# ── Picker ───────────────────────────────────────────────────────────────────

claim_menu_instance() {
  mkdir -p "$STATE_DIR"
  echo $$ >"$MENU_PID_FILE"
  STATE_DIR_READY=true
  trap 'rm -f "$MENU_PID_FILE" "$PICKER_PID_FILE"' EXIT
}

running_menu_pids() {
  local menu_pid picker_pid picker_comm

  read -r menu_pid <"$MENU_PID_FILE" 2>/dev/null || return 1
  read -r picker_pid <"$PICKER_PID_FILE" 2>/dev/null || return 1
  [[ $menu_pid =~ ^[0-9]+$ && $picker_pid =~ ^[0-9]+$ ]] || return 1
  [[ $(tr -d '\0' <"/proc/$menu_pid/cmdline" 2>/dev/null) == *monarch-menu* ]] || return 1
  # `read`, not `$(<...)`: procfs files report size 0 and the latter comes back empty.
  read -r picker_comm <"/proc/$picker_pid/comm" 2>/dev/null || return 1
  [[ $picker_comm == fuzzel ]] || return 1

  echo "$menu_pid"
  echo "$picker_pid"
}

# fuzzel is single-instance per display (it holds /run/user/UID/fuzzel-$WAYLAND_DISPLAY.lock
# and a second one exits 1), so any live picker has to go before a menu can open.
# When it is our own, the monarch-menu behind it goes too: an empty selection
# reads as "go back", so killing the picker alone pops the parent menu straight
# back up instead of closing.
toggle_existing_menu() {
  pgrep -x fuzzel >/dev/null || return

  local -a pids
  mapfile -t pids < <(running_menu_pids)
  if ((${#pids[@]} == 2)); then
    kill "${pids[@]}" 2>/dev/null
  else
    pkill -x fuzzel 2>/dev/null
  fi
  exit 0
}

# fuzzel runs in the background so its pid can be published for
# toggle_existing_menu; `wait` keeps the call synchronous.
pick() {
  local prompt="$1" width="$2" preselect="$3"
  local args=(--dmenu --lines 12 -p "$prompt… ")
  [[ -n $width ]] && args+=(--width "$width")
  [[ -n $preselect ]] && args+=("--select=$preselect")

  local input output
  input=$(mktemp) || return 1
  output=$(mktemp) || {
    rm -f "$input"
    return 1
  }
  cat >"$input"

  fuzzel "${args[@]}" <"$input" >"$output" 2>/dev/null &
  local picker_pid=$!
  [[ $STATE_DIR_READY == true ]] && echo "$picker_pid" >"$PICKER_PID_FILE"
  wait "$picker_pid"
  [[ $STATE_DIR_READY == true ]] && rm -f "$PICKER_PID_FILE"

  cat "$output"
  rm -f "$input" "$output"
}

# ── Rendering ────────────────────────────────────────────────────────────────

guard_passes() { (eval "$1") >/dev/null 2>&1; }

# Actions are detached: the menu has said its piece and should not stay in the
# process tree of whatever it launched.
run_action() {
  setsid bash -c "$1" >/dev/null 2>&1 &
  exit 0
}

# Sets SELECTED to the chosen id, or leaves it empty when the row was inert.
# Returns 1 when the picker was dismissed, which is how a level says "go back".
show_menu() {
  local id="$1"
  SELECTED=""

  local provider
  provider=$(field "$id" provider)
  [[ -n $provider ]] && {
    show_provider "$id" "$provider"
    return $?
  }

  local -a row_ids=() row_labels=()
  local key icon label when checked disabled line

  while IFS=$'\x1f' read -r key icon label when checked disabled; do
    [[ -z $key ]] && continue
    [[ -n $when ]] && ! guard_passes "$when" && continue

    line="$label"
    [[ -n $icon ]] && line="$icon  $label"

    if [[ -n $disabled ]] && guard_passes "$disabled"; then
      # A disabled row keeps its place in the list but cannot be entered.
      row_ids+=("")
      row_labels+=("$line  $CHECK_MARK")
      continue
    fi

    [[ -n $checked ]] && guard_passes "$checked" && line="$line  $CHECK_MARK"

    row_ids+=("$key")
    row_labels+=("$line")
  done < <(level_rows "$id")

  if ((${#row_ids[@]} == 0)); then
    monarch-notification-send "󰍜" "Empty menu" "$id has nothing to show" -u low
    return 1
  fi

  local selection i
  selection=$(printf '%s\n' "${row_labels[@]}" | pick "$(menu_title "$id")" "" "")
  [[ -z $selection ]] && return 1

  for i in "${!row_labels[@]}"; do
    [[ ${row_labels[$i]} == "$selection" ]] || continue
    SELECTED="${row_ids[$i]}"
    return 0
  done

  return 1
}

show_provider() {
  local id="$1" name="$2"
  local list="${PROVIDER_LIST[$name]:-}"

  if [[ -z $list ]]; then
    monarch-notification-send "󰍜" "Unknown menu provider" "$name" -u critical
    return 1
  fi

  local rows current selection
  rows=$($list) || return 1
  current=$(${PROVIDER_CURRENT[$name]} 2>/dev/null)

  selection=$(printf '%s\n' "$rows" | pick "$(menu_title "$id")" "${PROVIDER_WIDTH[$name]:-}" "$current")
  [[ -z $selection || $selection == "CNCLD" ]] && return 1

  run_action "${PROVIDER_ACTION[$name]} \"$selection\""
}

# Recursion is the back stack: a dismissed child returns here and this level is
# drawn again, and dismissing the level the menu was opened at ends it.
browse() {
  local id="$1" action target

  while true; do
    show_menu "$id" || return 1
    [[ -z $SELECTED ]] && continue

    action=$(field "$SELECTED" action)
    [[ -n $action ]] && run_action "$action"

    target=$(field "$SELECTED" target)
    browse "${target:-$SELECTED}" || true
  done
}

# ── Inspection ───────────────────────────────────────────────────────────────

# Everything above renders; nothing below it opens a window. These modes are
# what the test suite drives, and they are equally useful for debugging a route
# or a guard by hand.

# Reports what the data says that the renderer cannot discover at runtime:
# a target or provider that does not exist, an entry whose parent is missing,
# and a submenu with no children.
check_menu() {
  local status=0 key target provider parent

  while read -r key; do
    target=$(field "$key" target)
    if [[ -n $target ]] && ! ids | grep -qxF "$target"; then
      echo "$key: target '$target' does not exist" >&2
      status=1
    fi

    provider=$(field "$key" provider)
    if [[ -n $provider && -z ${PROVIDER_LIST[$provider]:-} ]]; then
      echo "$key: unknown provider '$provider'" >&2
      status=1
    fi

    if [[ $key == *.* ]]; then
      parent="${key%.*}"
      if ! ids | grep -qxF "$parent"; then
        echo "$key: parent '$parent' does not exist" >&2
        status=1
      fi
    fi

    if [[ -z $target && -z $provider ]] && [[ -z $(field "$key" action) ]] &&
      [[ -z $(level_rows "$key") ]]; then
      echo "$key: submenu with no children" >&2
      status=1
    fi
  done < <(ids)

  ((status == 0)) && echo "Menu data check passed ($(ids | wc -l) entries)"
  return $status
}

case "${1:-}" in
--resolve)
  load_menu
  resolve_route "${2:-}"
  exit 0
  ;;
--rows)
  load_menu
  while IFS=$'\x1f' read -r key icon label when checked disabled; do
    [[ -z $key ]] && continue
    [[ -n $when ]] && ! guard_passes "$when" && continue
    printf '%s\t%s\n' "$key" "$label"
  done < <(level_rows "$(resolve_route "${2:-}")")
  exit 0
  ;;
--check)
  load_menu
  check_menu
  exit $?
  ;;
esac

# ── Entry point ──────────────────────────────────────────────────────────────

toggle_existing_menu
claim_menu_instance
load_menu

route=$(resolve_route "${1:-}")

if [[ $route != root ]] && ! ids | grep -qxF "$route"; then
  monarch-notification-send "󰍜" "Unknown menu route" "$route" -u critical
  exit 1
fi

# A route that names an action runs it rather than opening a menu with no rows.
if [[ $route != root ]]; then
  route_action=$(field "$route" action)
  [[ -n $route_action ]] && run_action "$route_action"

  route_target=$(field "$route" target)
  [[ -n $route_target ]] && route="$route_target"
fi

browse "$route"
exit 0
