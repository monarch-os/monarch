}

show_update_menu() {
  case $(menu "Update" "  Monarch\n󰔫  Channel\n  Config\n󰸌  Extra Themes\n  Process\n󰇅  Hardware\n  Firmware\n  Password\n  Timezone\n  Time") in
  *Monarch*) present_terminal monarch-update ;;
  *Channel*) show_update_channel_menu ;;
  *Config*) show_update_config_menu ;;
  *Themes*) present_terminal monarch-theme-update ;;
  *Process*) show_update_process_menu ;;
  *Hardware*) show_update_hardware_menu ;;
  *Firmware*) present_terminal monarch-update-firmware ;;
  *Timezone*) present_terminal monarch-tz-select ;;
  *Time*) present_terminal monarch-update-time ;;
  *Password*) show_update_password_menu ;;
  *) show_main_menu ;;
  esac
}

show_update_channel_menu() {
  case $(menu "Update channel" "🟢 Stable\n🟡 Edge\n🔴 Dev") in
  *Stable*) present_terminal "monarch-channel-set stable" ;;
  *Edge*) present_terminal "monarch-channel-set edge" ;;
  *Dev*) present_terminal "monarch-channel-set dev" ;;
  *) show_update_menu ;;
  esac
}

show_update_process_menu() {
  case $(menu "Restart" "  Hypridle\n  Hyprsunset\n  Swayosd\n󰌧  Walker\n󰍜  Waybar") in
  *Hypridle*) monarch-restart-hypridle ;;
  *Hyprsunset*) monarch-restart-hyprsunset ;;
  *Swayosd*) monarch-restart-swayosd ;;
  *Walker*) monarch-restart-walker ;;
  *Waybar*) monarch-restart-waybar ;;
  *) show_update_menu ;;
  esac
}

show_update_config_menu() {
  case $(menu "Use default config" "  Hyprland\n  Hypridle\n  Hyprlock\n  Hyprsunset\n󱣴  Plymouth\n  Swayosd\n  Tmux\n󰌧  Walker\n󰍜  Waybar") in
  *Hyprland*) present_terminal monarch-refresh-hyprland ;;
  *Hypridle*) present_terminal monarch-refresh-hypridle ;;
  *Hyprlock*) present_terminal monarch-refresh-hyprlock ;;
  *Hyprsunset*) present_terminal monarch-refresh-hyprsunset ;;
  *Plymouth*) present_terminal monarch-refresh-plymouth ;;
  *Swayosd*) present_terminal monarch-refresh-swayosd ;;
  *Tmux*) present_terminal monarch-refresh-tmux ;;
  *Walker*) present_terminal monarch-refresh-walker ;;
  *Waybar*) present_terminal monarch-refresh-waybar ;;
  *) show_update_menu ;;
  esac
}

show_update_hardware_menu() {
  case $(menu "Restart" "  Audio\n󱚾  Wi-Fi\n󰂯  Bluetooth\n󰟸  Trackpad") in
  *Audio*) present_terminal monarch-restart-pipewire ;;
  *Wi-Fi*) present_terminal monarch-restart-wifi ;;
  *Bluetooth*) present_terminal monarch-restart-bluetooth ;;
  *Trackpad*) present_terminal monarch-restart-trackpad ;;
  *) show_update_menu ;;
  esac
}

show_update_password_menu() {
  case $(menu "Update Password" "  Drive Encryption\n  User") in
  *Drive*) present_terminal monarch-drive-set-password ;;
  *User*) present_terminal passwd ;;
  *) show_update_menu ;;
  esac
}

show_about() {
  monarch-launch-about
}

show_system_menu() {
  local options="󱄄  Screensaver\n  Lock"
  [[ ! -f ~/.local/state/monarch/toggles/suspend-off ]] && options="$options\n󰒲  Suspend"
  monarch-hibernation-available && options="$options\n󰤁  Hibernate"
  options="$options\n󰍃  Logout\n󰜉  Restart\n󰐥  Shutdown"

  case $(menu "System" "$options") in
  *Screensaver*) monarch-launch-screensaver force ;;
  *Lock*) monarch-lock-screen ;;
  *Suspend*) systemctl suspend ;;
  *Hibernate*) systemctl hibernate ;;
  *Logout*) monarch-system-logout ;;
  *Restart*) monarch-system-reboot ;;
  *Shutdown*) monarch-system-shutdown ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  go_to_menu "$(menu "Go" "󰀻  Apps\n󰧑  Learn\n󱓞  Trigger\n  Style\n  Setup\n󰉉  Install\n󰭌  Remove\n  Update\n  About\n  System")"
}

go_to_menu() {
  case "${1,,}" in
  *apps*) walker -p "Launch…" ;;
  *learn*) show_learn_menu ;;
  *toggle*) show_toggle_menu ;;
  *trigger*) show_trigger_menu ;;
  *share*) show_share_menu ;;
  *background*) show_background_menu ;;
  *capture*) show_capture_menu ;;
  *style*) show_style_menu ;;
  *theme*) show_theme_menu ;;
  *screenshot*) show_screenshot_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *setup*) show_setup_menu ;;
  *power*) show_setup_power_menu ;;
  *install*) show_install_menu ;;
  *remove*) show_remove_menu ;;
  *update*) show_update_menu ;;
  *about*) show_about ;;
  *system*) show_system_menu ;;
  esac
}

# Allow user extensions and overrides
USER_EXTENSIONS="$HOME/.config/monarch/extensions/menu.sh"
[[ -f $USER_EXTENSIONS ]] && source "$USER_EXTENSIONS"

toggle_existing_menu

if [[ -n $1 ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
