  *Plymouth*) present_terminal monarch-refresh-plymouth ;;
  *Tmux*) present_terminal monarch-refresh-tmux ;;
  *Noctalia*) present_terminal monarch-refresh-noctalia ;;
  *) show_update_menu ;;
  esac
}

