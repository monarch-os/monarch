#!/bin/bash

# monarch:summary=Launch the Monarch Menu or takes a parameter to jump straight to a submenu.

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ $BACK_TO_EXIT == "true" ]]; then
    exit 0
  elif [[ -n $parent_menu ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

toggle_existing_menu() {
  if pgrep -x fuzzel >/dev/null; then
    pkill -x fuzzel >/dev/null 2>&1
    exit 0
  fi
}

# Pop a dmenu picker via fuzzel. `extra` and `preselect` are kept for source
# compatibility with the previous walker-based menu helper.
menu() {
  local prompt="$1"
  local options="$2"
  local _unused_extra="$3"
  local preselect="$4"

  local args=()
  if [[ -n $preselect ]]; then
    args+=("--select=$preselect")
  fi

  echo -e "$options" | fuzzel --dmenu --lines 12 -p "$prompt… " "${args[@]}" 2>/dev/null
}

terminal() {
  xdg-terminal-exec --app-id=org.monarch.terminal "$@"
}

present_terminal() {
  monarch-launch-floating-terminal-with-presentation "$1"
}

open_in_editor() {
  notify-send -u low "Editing config file" "$1"
  monarch-launch-editor "$1"
}

install() {
  present_terminal "echo 'Installing $1...'; monarch-pkg-add $2"
}

install_and_launch() {
  present_terminal "echo 'Installing $1...'; monarch-pkg-add $2 && setsid gtk-launch $3"
}

install_font() {
  present_terminal "echo 'Installing $1...'; monarch-pkg-add $2 && sleep 2 && monarch-font-set '$3'"
}

install_terminal() {
  present_terminal "monarch-install-terminal $1"
}

aur_install() {
  present_terminal "echo 'Installing $1 from AUR...'; monarch-pkg-aur-add $2"
}

aur_install_and_launch() {
  present_terminal "echo 'Installing $1 from AUR...'; monarch-pkg-aur-add $2 && setsid gtk-launch $3"
}

show_learn_menu() {
  case $(menu "Learn" "  Keybindings\n  Monarch\n  Niri\n󰣇  Arch\n  Neovim\n󱆃  Bash") in
  *Keybindings*) monarch-menu-keybindings ;;
  *Monarch*) monarch-launch-webapp "https://docs.monarchlinux.com/" ;;
  *Niri*) monarch-launch-webapp "https://yalter.github.io/niri/" ;;
  *Arch*) monarch-launch-webapp "https://wiki.archlinux.org/title/Main_page" ;;
  *Bash*) monarch-launch-webapp "https://devhints.io/bash" ;;
  *Neovim*) monarch-launch-webapp "https://www.lazyvim.org/keymaps" ;;
  *) show_main_menu ;;
  esac
}

show_trigger_menu() {
  case $(menu "Trigger" "󰔛  Reminder\n  Capture\n󰧸  Transcode\n  Share\n󰔎  Toggle\n  Hardware") in
  *Reminder*) show_reminder_menu ;;
  *Capture*) show_capture_menu ;;
  *Share*) show_share_menu ;;
  *Transcode*) monarch-transcode || back_to show_trigger_menu ;;
  *Toggle*) show_toggle_menu ;;
  *Hardware*) show_hardware_menu ;;
  *) show_main_menu ;;
  esac
}

show_reminder_menu() {
  case $(menu "Reminder" "󰔛  Set one\n󰔛  Show all\n󰔛  Clear all") in
  *Set*) show_custom_reminder_input ;;
  *"Show all"*) monarch-reminder show ;;
  *"Clear all"*) monarch-reminder clear ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_custom_reminder_input() {
  local minutes
  minutes=$(monarch-menu-input "Remind in minutes")

  if [[ $minutes =~ ^[0-9]+$ ]] && ((minutes > 0)); then
    show_reminder_message_input "$minutes"
  elif [[ -n $minutes ]]; then
    monarch-notification-send "󰔛" "Invalid reminder" "Enter the number of minutes" -u critical
    show_custom_reminder_input
  else
    back_to show_reminder_menu
  fi
}

show_reminder_message_input() {
  local minutes="$1"
  local message
  message=$(monarch-menu-input "Reminder message")

  if [[ -n $message ]]; then
    monarch-reminder "$minutes" "$message"
  else
    monarch-reminder "$minutes"
  fi
}

show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenrecord\n󰴑  Text Extraction\n󰃉  Color") in
  *Screenshot*) monarch-capture-screenshot ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Text*) monarch-capture-text-extraction ;;
  *Color*) pkill hyprpicker || hyprpicker -a ;;
  *) back_to show_trigger_menu ;;
  esac
}

get_webcam_list() {
  v4l2-ctl --list-devices 2>/dev/null | while IFS= read -r line; do
    if [[ $line != $'\t'* && -n $line ]]; then
      local name="$line"
      IFS= read -r device || break
      device=$(echo "$device" | tr -d '\t' | head -1)
      [[ -n $device ]] && echo "$device  $name"
    fi
  done
}

show_webcam_select_menu() {
  local devices=$(get_webcam_list)
  local count=$(echo "$devices" | grep -c . 2>/dev/null || echo 0)

  if [[ -z $devices ]] || ((count == 0)); then
    notify-send "No webcam devices found" -u critical -t 3000
    return 1
  fi

  if ((count == 1)); then
    echo "$devices" | awk '{print $1}'
  else
    menu "Select Webcam" "$devices" | awk '{print $1}'
  fi
}

show_screenrecord_menu() {
  monarch-capture-screenrecording --stop-recording && exit 0

  case $(menu "Screenrecord" "  With no audio\n  With desktop audio\n  With desktop + microphone audio\n  With desktop + microphone audio + webcam") in
  *"With no audio") monarch-capture-screenrecording ;;
  *"With desktop audio") monarch-capture-screenrecording --with-desktop-audio ;;
  *"With desktop + microphone audio") monarch-capture-screenrecording --with-desktop-audio --with-microphone-audio ;;
  *"With desktop + microphone audio + webcam")
    local device=$(show_webcam_select_menu) || {
      back_to show_capture_menu
      return
    }
    monarch-capture-screenrecording --with-desktop-audio --with-microphone-audio --with-webcam --webcam-device="$device"
    ;;
  *) back_to show_capture_menu ;;
  esac
}

show_share_menu() {
  case $(menu "Share" "  Clipboard\n  File \n  Folder") in
  *Clipboard*) monarch-menu-share clipboard ;;
  *File*) terminal bash -c "monarch-menu-share file" ;;
  *Folder*) terminal bash -c "monarch-menu-share folder" ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_toggle_menu() {
  local options="󱄄  Screensaver\n󰔎  Nightlight\n󱫖  Idle Lock\n󰂛  Notifications\n  Direct Boot\n󰟵  Passwordless Sudo"

  case $(menu "Toggle" "$options") in
  *Screensaver*) monarch-toggle-screensaver ;;
  *Nightlight*) monarch-toggle-nightlight ;;
  *Idle*) monarch-toggle-idle ;;
  *Notifications*) monarch-toggle-notification-silencing ;;
  *"Direct Boot"*) present_terminal monarch-config-direct-boot ;;
  *"Passwordless Sudo"*) present_terminal monarch-sudo-passwordless ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_hardware_menu() {
  local options=""

  if monarch-hw-external-monitors; then
    options="$options\n󰛧  Laptop Display"
  fi

  if monarch-hw-hybrid-gpu; then
    options="$options\n  Hybrid GPU"
  fi

  if monarch-hw-touchpad; then
    options="$options\n󰟸  Touchpad"
  fi

  if monarch-hw-dell-xps-haptic-touchpad && monarch-cmd-present dell-xps-touchpad-haptics; then
    options="$options\n󰌌  Touchpad Haptics"
  fi

  if monarch-hw-touchscreen; then
    options="$options\n󰆽  Touchscreen"
  fi

  case $(menu "Toggle" "$options") in
  *"Laptop Display"*) monarch-niri-monitor-internal toggle ;;
  *Haptics*) show_hardware_touchpad_haptics_menu ;;
  *Touchpad*) monarch-toggle-touchpad ;;
  *Touchscreen*) monarch-toggle-touchscreen ;;
  *"Hybrid GPU"*) present_terminal monarch-toggle-hybrid-gpu ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_hardware_touchpad_haptics_menu() {
  local current=$(dell-xps-touchpad-haptics get)
  local selected=$(menu "Touchpad Haptics" "low\nmid\nhigh" "" "$current")

  if [[ -n $selected ]]; then
    dell-xps-touchpad-haptics set "$selected"
  else
    back_to show_hardware_menu
  fi
}

show_style_menu() {
  case $(menu "Style" "  Font\n  Background\n  Niri\n󱄄  Screensaver\n  About") in
  *Font*) show_font_menu ;;
  *Background*) show_background_menu ;;
  *Niri*) open_in_editor ~/.config/niri/user.kdl ;;
  *Screensaver*) show_screensaver_menu ;;
  *About*) show_about_menu ;;
  *) show_main_menu ;;
  esac
}

show_about_menu() {
  case $(menu "About" "  Edit Text\n  Set From Image\n  Restore Default") in
  *Text*) monarch-branding-about text ;;
  *Image*) monarch-branding-about image ;;
  *Default*) monarch-branding-about reset ;;
  *) show_style_menu ;;
  esac
}

show_screensaver_menu() {
  case $(menu "Screensaver" "  Edit Text\n  Set From Image\n  Restore Default") in
  *Text*) monarch-branding-screensaver text ;;
  *Image*) monarch-branding-screensaver image ;;
  *Default*) monarch-branding-screensaver reset ;;
  *) show_style_menu ;;
  esac
}

show_background_menu() {
  qs -c noctalia-shell ipc call wallpaper toggle
}

show_font_menu() {
  theme=$(menu "Font" "$(monarch-font-list)" "--width 350" "$(monarch-font-current)")
  if [[ $theme == "CNCLD" || -z $theme ]]; then
    back_to show_style_menu
  else
    monarch-font-set "$theme"
  fi
}

show_setup_menu() {
  local options="  Audio\n  Wifi\n󰂯  Bluetooth\n󱐋  Power Profile\n  System Sleep"
  [[ -f ~/.config/niri/user.kdl ]] && options="$options\n  Niri"
  options="$options\n  Defaults\n󰱔  DNS\n󰗊  Language\n  Security\n  Config"

  case $(menu "Setup" "$options") in
  *Audio*) monarch-launch-audio ;;
  *Wifi*) monarch-launch-wifi ;;
  *Bluetooth*) monarch-launch-bluetooth ;;
  *Power*) show_setup_power_menu ;;
  *System*) show_setup_system_menu ;;
  *Niri*) open_in_editor ~/.config/niri/user.kdl ;;
  *Defaults*) show_setup_default_menu ;;
  *DNS*) present_terminal monarch-setup-dns ;;
  *Language*) present_terminal monarch-setup-language ;;
  *Security*) show_setup_security_menu ;;
  *Config*) show_setup_config_menu ;;
  *) show_main_menu ;;
  esac
}

show_setup_power_menu() {
  profile=$(menu "Power Profile" "$(monarch-powerprofiles-list)" "" "$(powerprofilesctl get)")

  if [[ $profile == "CNCLD" || -z $profile ]]; then
    back_to show_setup_menu
  else
    powerprofilesctl set "$profile"
  fi
}

show_setup_security_menu() {
  case $(menu "Setup" "󰈷  Fingerprint\n  Fido2") in
    *Fingerprint*) present_terminal monarch-setup-security-fingerprint ;;
    *Fido2*) present_terminal monarch-setup-security-fido2 ;;
    *) show_setup_menu ;;
    esac
  }

  show_setup_default_menu() {
    case $(menu "Default" "  Browser\n  Terminal\n  Editor") in
    *Browser*) show_setup_default_browser_menu ;;
    *Terminal*) show_setup_default_terminal_menu ;;
    *Editor*) show_setup_default_editor_menu ;;
  *) show_setup_menu ;;
  esac
}

browser_desktop_exists() {
  [[ -f ~/.local/share/applications/$1 || -f ~/.nix-profile/share/applications/$1 || -f /usr/share/applications/$1 ]]
}

show_setup_default_browser_menu() {
  local options=""
  browser_desktop_exists chromium.desktop && options="$options  Chromium"
  browser_desktop_exists google-chrome.desktop && options="${options:+$options\n}󰊯  Chrome"
  browser_desktop_exists brave-browser.desktop && options="${options:+$options\n}󰖟  Brave"
  browser_desktop_exists brave-origin-beta.desktop && options="${options:+$options\n}󰖟  Brave Origin"
  browser_desktop_exists microsoft-edge.desktop && options="${options:+$options\n}󰇩  Edge"
  browser_desktop_exists firefox.desktop && options="${options:+$options\n}󰈹  Firefox"
  browser_desktop_exists zen.desktop && options="${options:+$options\n}󰖟  Zen"

  local current=""
  case "$(monarch-default-browser)" in
  chromium) current="  Chromium" ;;
  chrome) current="󰊯  Chrome" ;;
  brave) current="󰖟  Brave" ;;
  brave-origin) current="󰖟  Brave Origin" ;;
  edge) current="󰇩  Edge" ;;
  firefox) current="󰈹  Firefox" ;;
  zen) current="󰖟  Zen" ;;
  esac

  case $(menu "Default Browser" "$options" "" "$current") in
  *Chromium*) monarch-default-browser chromium ;;
  *Chrome*) monarch-default-browser chrome ;;
  *"Brave Origin"*) monarch-default-browser brave-origin ;;
  *Brave*) monarch-default-browser brave ;;
  *Edge*) monarch-default-browser edge ;;
  *Firefox*) monarch-default-browser firefox ;;
  *Zen*) monarch-default-browser zen ;;
  *) show_setup_default_menu ;;
  esac
}

show_setup_default_terminal_menu() {
  local options=""
  monarch-cmd-present alacritty && options="$options  Alacritty"
  monarch-cmd-present foot && options="${options:+$options\n}  Foot"
  monarch-cmd-present ghostty && options="${options:+$options\n}  Ghostty"
  monarch-cmd-present kitty && options="${options:+$options\n}  Kitty"

  local current=""
  case "$(monarch-default-terminal)" in
  alacritty) current="  Alacritty" ;;
  foot) current="  Foot" ;;
  ghostty) current="  Ghostty" ;;
  kitty) current="  Kitty" ;;
  esac

  case $(menu "Default Terminal" "$options" "" "$current") in
  *Alacritty*) monarch-default-terminal alacritty ;;
  *Foot*) monarch-default-terminal foot ;;
  *Ghostty*) monarch-default-terminal ghostty ;;
  *Kitty*) monarch-default-terminal kitty ;;
  *) show_setup_default_menu ;;
  esac
}

show_setup_default_editor_menu() {
  local options=""
  monarch-cmd-present nvim && options="$options  Neovim"
  monarch-cmd-present code && options="${options:+$options\n}  VSCode"
  monarch-cmd-present cursor && options="${options:+$options\n}  Cursor"
  monarch-cmd-present zeditor && options="${options:+$options\n}  Zed"
  monarch-cmd-present sublime_text && options="${options:+$options\n}  Sublime Text"
  monarch-cmd-present helix && options="${options:+$options\n}  Helix"
  monarch-cmd-present vim && options="${options:+$options\n}  Vim"
  monarch-cmd-present emacs && options="${options:+$options\n}  Emacs"

  local current=""
  case "$(monarch-default-editor)" in
  nvim) current="  Neovim" ;;
  code) current="  VSCode" ;;
  cursor) current="  Cursor" ;;
  zed | zeditor) current="  Zed" ;;
  sublime_text) current="  Sublime Text" ;;
  helix) current="  Helix" ;;
  vim) current="  Vim" ;;
  emacs) current="  Emacs" ;;
  esac

  case $(menu "Default Editor" "$options" "" "$current") in
  *Neovim*) monarch-default-editor nvim ;;
  *VSCode*) monarch-default-editor code ;;
  *Cursor*) monarch-default-editor cursor ;;
  *Zed*) monarch-default-editor zed ;;
  *Sublime*) monarch-default-editor sublime_text ;;
  *Helix*) monarch-default-editor helix ;;
  *Vim*) monarch-default-editor vim ;;
  *Emacs*) monarch-default-editor emacs ;;
  *) show_setup_default_menu ;;
  esac
}

show_setup_config_menu() {
  case $(menu "Setup" "  Niri
  Noctalia
󰞅  XCompose") in
  *Niri*) open_in_editor ~/.config/niri/user.kdl && monarch-refresh-niri ;;
  *Noctalia*) open_in_editor ~/.config/noctalia/settings.json && monarch-restart-noctalia ;;
  *XCompose*) open_in_editor ~/.XCompose && monarch-restart-xcompose ;;
  *) show_setup_menu ;;
  esac
}

show_setup_system_menu() {
  local options=""

  if monarch-toggle-enabled suspend-off; then
    options="$options󰒲  Enable Suspend"
  else
    options="$options󰒲  Disable Suspend"
  fi

  if monarch-hibernation-available; then
    options="$options\n󰤁  Disable Hibernate"
  else
    options="$options\n󰤁  Enable Hibernate"
  fi

  case $(menu "System" "$options") in
  *Suspend*) monarch-toggle-suspend ;;
  *"Enable Hibernate"*) present_terminal monarch-hibernation-setup ;;
  *"Disable Hibernate"*) present_terminal monarch-hibernation-remove ;;
  *) show_setup_menu ;;
  esac
}

