show_update_menu() {
  case $(menu "Update" "  Monarch\n󰔫  Channel\n  Config\n  Process\n󰇅  Hardware\n  Firmware\n  Password\n  Timezone\n  Time") in
  *Monarch*) present_terminal monarch-update ;;
  *Channel*) show_update_channel_menu ;;
  *Config*) show_update_config_menu ;;
  *Process*) show_update_process_menu ;;
  *Hardware*) show_update_hardware_menu ;;
  *Firmware*) present_terminal monarch-update-firmware ;;
  *Timezone*) present_terminal monarch-tz-select ;;
  *Time*) present_terminal monarch-update-time ;;
  *Password*) show_update_password_menu ;;
  *) show_main_menu ;;
  esac
}

