#!/bin/bash

# monarch:summary=Install displaylink drivers
# monarch:requires-sudo=true

# Headers for every installed kernel, so evdi-dkms builds against each one and
# DisplayLink survives booting a fallback kernel.
mapfile -t headers < <(monarch-hw-kernel-headers)

yay -S --noconfirm "${headers[@]}" evdi-dkms displaylink

sudo systemctl enable --now displaylink
