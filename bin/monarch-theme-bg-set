#!/bin/bash

# monarch:summary=Set the current background image (persists into Noctalia's wallpapers.json)
# monarch:args=<path-to-image>
# monarch:examples=monarch theme bg set ~/Pictures/wallpaper.png

if [[ -z $1 ]]; then
  echo "Usage: monarch-theme-bg-set <path-to-image>" >&2
  exit 1
fi

BACKGROUND="$(realpath "$1")"
WALLPAPERS_JSON="$HOME/.cache/noctalia/wallpapers.json"

if [[ ! -f "$BACKGROUND" ]]; then
  echo "File does not exist: $BACKGROUND" >&2
  exit 1
fi

# Write Noctalia's declarative wallpaper source-of-truth so the choice survives
# shell restarts, then ask the live shell to pick it up.
mkdir -p "$(dirname "$WALLPAPERS_JSON")"
jq -n --arg path "$BACKGROUND" '{defaultWallpaper: $path, wallpapers: {}}' >"$WALLPAPERS_JSON"
qs -c noctalia-shell ipc call wallpaper refresh >/dev/null 2>&1 || true
