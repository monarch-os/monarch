#!/bin/bash

# monarch:summary=Set the current background image
# monarch:args=<path-to-image>
# monarch:examples=monarch theme bg set ~/Pictures/wallpaper.png

if [[ -z $1 ]]; then
  echo "Usage: monarch-theme-bg-set <path-to-image>" >&2
  exit 1
fi

BACKGROUND="$1"
CURRENT_BACKGROUND_LINK="$HOME/.config/monarch/current/background"

# Create symlink to the new background
ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

# Kill existing swaybg and start new one
pkill -x swaybg
setsid uwsm-app -- swaybg -i "$CURRENT_BACKGROUND_LINK" -m fill >/dev/null 2>&1 &
