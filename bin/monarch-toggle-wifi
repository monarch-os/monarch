#!/bin/bash

# monarch:summary=Toggle the Wi-Fi radio
# monarch:args=[toggle|on|off|status]
# monarch:examples=monarch toggle wifi | monarch toggle wifi status

# NetworkManager owns this state, so unlike the other toggles there is nothing
# to remember on our side: `nmcli radio wifi` is the truth and `status` reports
# it as the same JSON shape the bar indicators read.

set -uo pipefail

radio_on() {
  [[ $(LC_ALL=C nmcli -t radio wifi 2>/dev/null) == "enabled" ]]
}

print_status() {
  if radio_on; then
    printf '{"enabled":true,"tooltip":"Wi-Fi on - click to turn the radio off"}\n'
  else
    printf '{"enabled":false,"tooltip":"Wi-Fi off"}\n'
  fi
}

case "${1:-toggle}" in
  toggle)
    if radio_on; then nmcli radio wifi off; else nmcli radio wifi on; fi
    ;;
  on) nmcli radio wifi on ;;
  off) nmcli radio wifi off ;;
  status | --status) print_status ;;
  *)
    echo "Usage: $0 [toggle|on|off|status]" >&2
    exit 1
    ;;
esac
