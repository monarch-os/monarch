#!/bin/bash

# monarch:summary=Send files to a machine on your tailnet with Taildrop
# monarch:args=<machine> [file...]
# monarch:examples=monarch tailscale send laptop | monarch tailscale send phone ~/Downloads/notes.pdf

set -euo pipefail

if (($# < 1)); then
  echo "Usage: monarch-tailscale-send <machine> [file...]" >&2
  exit 1
fi

machine=$1
name=${machine%%.*}
shift
files=("$@")

if ((${#files[@]} == 0)); then
  picked=$(monarch-file-select --title "Send to $name" --multiple) || status=$?
  if ((${status:-0} > 1)); then
    monarch-notification-send "󰒊" "Could not send to $name" "The file chooser did not open" -u critical
    exit 1
  fi

  [[ -n $picked ]] || exit 0
  readarray -t files <<<"$picked"
fi

if ((${#files[@]} == 1)); then
  what=$(basename "${files[0]}")
else
  what="${#files[@]} files"
fi

if error=$(tailscale file cp --update-interval=0 -- "${files[@]}" "$machine:" 2>&1); then
  monarch-notification-send "󰒊" "Sent to $name" "$what"
else
  monarch-notification-send "󰒊" "Could not send to $name" "${error:-Taildrop transfer failed}" -u critical
  exit 1
fi
