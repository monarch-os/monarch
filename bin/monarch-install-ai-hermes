#!/bin/bash

# monarch:summary=Install and open Hermes Desktop
# monarch:requires-sudo=true

set -euo pipefail

monarch-install-hermes-cli --now
if ! monarch-pkg-present hermes-agent-desktop-bin && ! monarch-pkg-present hermes-agent-desktop; then
  monarch-pkg-add hermes-agent-desktop-bin
fi
flags="$HOME/.config/hermes-desktop-flags.conf"
if [[ ! -e $flags && ! -L $flags ]]; then
  monarch-refresh-config hermes-desktop-flags.conf
fi
setsid uwsm-app -- /usr/bin/hermes-desktop >/dev/null 2>&1 &
