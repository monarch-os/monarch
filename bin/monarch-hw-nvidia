#!/bin/bash

# monarch:summary=Detect whether the computer has an NVIDIA GPU

# Cached sysfs IDs do not wake a runtime-suspended discrete GPU.
pci_devices_path="${MONARCH_PCI_DEVICES_PATH:-/sys/bus/pci/devices}"

shopt -s nullglob

for device in "$pci_devices_path"/*; do
  [[ $(<"$device/vendor") == "0x10de" ]] || continue
  [[ $(<"$device/class") == 0x03* ]] && exit 0
done

exit 1
