#!/bin/bash

# monarch:summary=Prompt for text input with fuzzel
# monarch:group=menu
# monarch:name=input
# monarch:args=prompt [fuzzel args...]
# monarch:examples=monarch menu input Reminder|monarch-menu-input "Reminder in minutes" --width 400

set -euo pipefail

prompt="${1:-Input}"
if (( $# > 0 )); then
  shift
fi

fuzzel --dmenu --lines 0 -p "$prompt… " "$@" 2>/dev/null
