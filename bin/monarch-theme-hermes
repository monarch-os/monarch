#!/bin/bash

# monarch:summary=Render the Monarch Hermes skin with Noctalia
# monarch:args=[--activate]

set -euo pipefail

activate=false
case "${1:-}" in
  "") ;;
  --activate) activate=true ;;
  *) echo "Usage: monarch-theme-hermes [--activate]" >&2; exit 1 ;;
esac

for file in noctalia/templates/hermes.yaml noctalia/monarch-hermes.toml; do
  [[ -e $HOME/.config/$file ]] || monarch-refresh-config "$file"
done
noctalia msg config-reload
noctalia msg templates-apply
[[ -s $HOME/.hermes/skins/monarch.yaml ]]

if [[ $activate == "true" ]]; then
  profile=$(cat "$HOME/.hermes/active_profile" 2>/dev/null || true)
  if [[ -n $profile && $profile != "default" ]] || [[ ${HERMES_HOME:-$HOME/.hermes} != "$HOME/.hermes" ]]; then
    echo "$(monarch-i18n hermes.profileTheme)"
    exit 0
  fi
  current=$(timeout 15 /usr/bin/hermes config get display.skin)
  case "$current" in
    "" | null | default | monarch) timeout 30 /usr/bin/hermes config set display.skin monarch ;;
    *) echo "$(monarch-i18n hermes.keepSkin "$current")" ;;
  esac
fi
