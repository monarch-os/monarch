#!/bin/bash

# monarch:summary=Refresh the SDDM theme from default
# monarch:requires-sudo=true

sudo rm -rf /usr/share/sddm/themes/monarch
sudo cp -r $MONARCH_PATH/default/sddm/monarch /usr/share/sddm/themes/monarch

# theme.conf is regenerated by Noctalia's user-template (templates.sddm) so the
# login screen follows the active color scheme. Noctalia runs as the user and
# writes in-place under /usr/share, so the file must be world-writable.
sudo chmod 666 /usr/share/sddm/themes/monarch/theme.conf
