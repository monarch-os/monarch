#!/bin/bash -p

# monarch:summary=Manage validated temporary sudo grants at the privileged boundary
# monarch:args=<status|enable|disable|expire> <uid> [minutes|token deadline] | revoke-legacy
# monarch:hidden=true
# monarch:requires-sudo=true

# -p blocks BASH_ENV before validation; an ordinary bash invocation is refused.
[[ $- == *p* ]] || exit 126
set -euo pipefail
export PATH=/usr/bin:/usr/sbin LC_ALL=C TZ=UTC0
unset BASH_ENV ENV CDPATH
IFS=$' \t\n'
umask 077

readonly INSTALLED_SELF=/usr/bin/monarch-sudo-passwordless-root
readonly RULE_DIRECTORY=/etc/sudoers.d
readonly LOCK_FILE=/run/lock/monarch-sudo-passwordless.lock

valid_uid() {
  [[ $1 =~ ^[0-9]{1,10}$ ]] && (( 10#$1 > 0 && 10#$1 <= 4294967294 ))
}

resolve_account() {
  local entry password account_uid rest
  valid_uid "$1" || return 2
  uid=$((10#$1))
  entry=$(/usr/bin/getent passwd "$uid") || return 2
  [[ $entry != *$'\n'* ]] || return 2
  IFS=: read -r account password account_uid rest <<<"$entry"
  [[ $account =~ ^[a-z_][a-z0-9_-]{0,31}\$?$ && $account_uid == "$uid" ]] &&
    (( ${#account} <= 32 )) || return 2
  rule="$RULE_DIRECTORY/99-monarch-nopasswd-$uid"
  legacy_rule="$RULE_DIRECTORY/99-monarch-nopasswd-$account"
}

trusted_path() {
  local path=$1 owner mode
  [[ ( -d $path || -f $path ) && ! -L $path ]] || return 1
  [[ $(/usr/bin/realpath -e -- "$path") == "$path" ]] || return 1
  while :; do
    owner=$(/usr/bin/stat -c '%u' -- "$path") || return 1
    mode=$(/usr/bin/stat -c '%a' -- "$path") || return 1
    [[ $owner == 0 && $mode =~ ^[0-7]+$ ]] && ! (( 8#$mode & 022 )) || return 1
    [[ $path == / ]] && return 0
    path=${path%/*}
    [[ -n $path ]] || path=/
  done
}

deadline_epoch() {
  local value=$1 parsed
  [[ $value =~ ^[0-9]{14}Z$ ]] || return 1
  parsed="${value:0:4}-${value:4:2}-${value:6:2} ${value:8:2}:${value:10:2}:${value:12:2} UTC"
  /usr/bin/date -u -d "$parsed" +%s
}

retire_legacy_grant() {
  local lines=()
  [[ -e $legacy_rule || -L $legacy_rule ]] || return 0
  trusted_path "$legacy_rule" && [[ -f $legacy_rule ]] || return 2
  mapfile -t lines <"$legacy_rule" || return 2
  (( ${#lines[@]} == 1 )) && [[ ${lines[0]} == "$account ALL=(ALL) NOPASSWD: ALL" ]] || return 2
  /usr/bin/rm -f -- "$legacy_rule"
}

revoke_legacy_grants() {
  local candidate name lines=()
  for candidate in "$RULE_DIRECTORY"/99-monarch-nopasswd-*; do
    [[ -e $candidate || -L $candidate ]] || continue
    name=${candidate##*/99-monarch-nopasswd-}
    [[ $name =~ ^[a-z_][a-z0-9_-]{0,31}\$?$ ]] && (( ${#name} <= 32 )) || continue
    trusted_path "$candidate" && [[ -f $candidate ]] || return 2
    mapfile -t lines <"$candidate" || return 2
    if (( ${#lines[@]} == 1 )) && [[ ${lines[0]} == "$name ALL=(ALL) NOPASSWD: ALL" ]]; then
      /usr/bin/rm -f -- "$candidate" || return 2
    fi
  done
}

load_and_prune_grant() {
  local lines=() expected now
  token=""
  deadline=""
  [[ -e $rule || -L $rule ]] || return 3
  trusted_path "$rule" && [[ -f $rule ]] || return 2
  mapfile -t lines <"$rule" || return 2
  # Retire only the exact unbounded policy written by the previous helper.
  if (( ${#lines[@]} == 1 )) && [[ ${lines[0]} == "$account ALL=(ALL) NOPASSWD: ALL" ]]; then
    /usr/bin/rm -f -- "$rule" || return 2
    return 3
  fi
  (( ${#lines[@]} == 2 )) || return 2
  [[ ${lines[0]} =~ ^\#\ monarch-nopasswd-token=([0-9a-f]{32})$ ]] || return 2
  token=${BASH_REMATCH[1]}
  expected="$account ALL=(ALL) NOTAFTER="
  [[ ${lines[1]} == "$expected"*' NOPASSWD: ALL' ]] || return 2
  deadline=${lines[1]#"$expected"}
  deadline=${deadline%' NOPASSWD: ALL'}
  expires=$(deadline_epoch "$deadline") || return 2
  now=$(/usr/bin/date +%s) || return 2
  if (( now >= expires )) && [[ ${1:-} != "keep-expired" ]]; then
    /usr/bin/rm -f -- "$rule" || return 2
    return 3
  fi
}

enable_grant() (
  local minutes=$1 stage="" now expires_new deadline_new token_new timer status
  [[ $minutes =~ ^[0-9]{1,8}$ ]] && (( 10#$minutes >= 1 && 10#$minutes <= 1440 )) || return 2
  if load_and_prune_grant; then
    :
  else
    status=$?
    (( status == 3 )) || return "$status"
  fi
  trap '[[ -z $stage ]] || /usr/bin/rm -f -- "$stage"' EXIT
  trap 'exit 1' HUP INT TERM
  now=$(/usr/bin/date +%s) || return 1
  expires_new=$((now + 10#$minutes * 60))
  deadline_new=$(/usr/bin/date -u -d "@$expires_new" +%Y%m%d%H%M%SZ) || return 1
  token_new=$(/usr/bin/tr -d '-' </proc/sys/kernel/random/uuid) || return 1
  [[ $token_new =~ ^[0-9a-f]{32}$ ]] || return 1
  stage=$(/usr/bin/mktemp "$RULE_DIRECTORY/.monarch-nopasswd.XXXXXX") || return 1
  printf '# monarch-nopasswd-token=%s\n%s ALL=(ALL) NOTAFTER=%s NOPASSWD: ALL\n' \
    "$token_new" "$account" "$deadline_new" >"$stage" || return 1
  /usr/bin/chown root:root "$stage" && /usr/bin/chmod 0440 "$stage" || return 1
  /usr/sbin/visudo -cf "$stage" >/dev/null || return 1
  timer="monarch-nopasswd-expire-$uid-$token_new"
  /usr/bin/systemd-run --quiet --collect --on-calendar="@$expires_new" \
    --timer-property=AccuracySec=1s --unit="$timer" \
    -- "$INSTALLED_SELF" expire "$uid" "$token_new" "$deadline_new" || return 1
  /usr/bin/systemctl is-active --quiet "$timer.timer" || return 1
  now=$(/usr/bin/date +%s) || return 1
  (( now < expires_new )) || return 1
  /usr/bin/mv -fT -- "$stage" "$rule" || return 1
  stage=""
)

main() {
  local action=${1:-} requested_uid=${2:-} status lock_fd now mode=""
  (( EUID == 0 )) || return 2
  case $action in
    revoke-legacy) (( $# == 1 )) || return 2 ;;
    enable) (( $# == 3 )) || return 2 ;;
    status | disable) (( $# == 2 )) || return 2 ;;
    expire) (( $# == 4 )) || return 2 ;;
    *) return 2 ;;
  esac
  if [[ $action != "revoke-legacy" ]]; then
    resolve_account "$requested_uid" || return 2
    if [[ $action != "expire" ]]; then
      valid_uid "${SUDO_UID:-}" && (( 10#$SUDO_UID == uid )) || return 2
    else
      [[ $3 =~ ^[0-9a-f]{32}$ ]] && deadline_epoch "$4" >/dev/null || return 2
    fi
  fi
  trusted_path "$RULE_DIRECTORY" && trusted_path /run/lock || return 2
  if [[ -e $LOCK_FILE || -L $LOCK_FILE ]]; then
    trusted_path "$LOCK_FILE" && [[ -f $LOCK_FILE ]] || return 2
  fi
  exec {lock_fd}>"$LOCK_FILE" || return 2
  /usr/bin/chmod 0600 "$LOCK_FILE" || return 2
  /usr/bin/flock -x -w 60 "$lock_fd" || return 2
  if [[ $action == "revoke-legacy" ]]; then
    revoke_legacy_grants
    return $?
  fi
  # UID filenames cannot be removed by the old username-based timer's rm.
  [[ $action == "expire" ]] || retire_legacy_grant || return 2
  if [[ $action == "enable" ]]; then
    enable_grant "$3"
    return $?
  fi
  [[ $action != "expire" ]] || mode=keep-expired
  if load_and_prune_grant "$mode"; then
    case $action in
      status) return 0 ;;
      disable) /usr/bin/rm -f -- "$rule" ;;
      expire)
        [[ $3 == "$token" && $4 == "$deadline" ]] || return 0
        now=$(/usr/bin/date +%s) || return 2
        (( now >= expires )) || return 0
        /usr/bin/rm -f -- "$rule"
        ;;
    esac
  else
    status=$?
    if (( status == 3 )) && [[ $action != "status" ]]; then
      return 0
    fi
    return "$status"
  fi
}

main "$@"
