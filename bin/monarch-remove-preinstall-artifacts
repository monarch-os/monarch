#!/bin/bash

# monarch:summary=Remove Monarch-managed artifacts created for preinstalls.
# monarch:hidden=true

set -euo pipefail

monarch-webapp-remove-all
monarch-tui-remove-all

for command in agy claude codex copilot crush ghui grok omp opencode ori pi playwright-cli; do
  wrapper="$HOME/.local/bin/$command"
  if [[ -f $wrapper && ! -L $wrapper ]] &&
    [[ $(sed -n '2p' "$wrapper") == '# Generated by monarch-mise-install.' ]]; then
    rm -f "$wrapper"
  fi
done
