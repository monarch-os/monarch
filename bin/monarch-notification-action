#!/bin/bash

# monarch:summary=Send a persistent notification that runs a command when clicked
# monarch:args=<glyph> <headline> <description> <label> <command> [args...]
# monarch:hidden=true

set -euo pipefail

if (($# < 5)); then
  echo "Usage: monarch-notification-action <glyph> <headline> <description> <label> <command> [args...]" >&2
  exit 1
fi

glyph=$1
headline=$2
description=$3
label=$4
shift 4

exec monarch-notification-send -u critical -t 0 -g "$glyph" \
  "$headline" "$description" --action "$label" "$@"
