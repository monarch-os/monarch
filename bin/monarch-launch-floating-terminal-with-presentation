#!/bin/bash

# monarch:summary=Launch a floating terminal with the Monarch presentation wrapper
# monarch:args=[--app-id=<id>] <command>

appid="org.monarch.terminal"
if [[ $1 == --app-id=* ]]; then
  appid="${1#--app-id=}"
  shift
fi

cmd="$*"
# 130 is the user bailing with Ctrl-C; anything else gets the Done/Failed prompt.
presentation_script="monarch-show-logo; $cmd; code=\$?; if (( code != 130 )); then monarch-show-done \$code; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id="$appid" --title=Monarch -e bash -c "$presentation_script"
