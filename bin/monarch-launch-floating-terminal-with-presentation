#!/bin/bash

# Launch a floating terminal with the Monarch logo presentation, then execute the command passed in, and finally end with the monarch-show-done presentation.
# Used by actions such as Update System.

cmd="$*"
exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.monarch.terminal --title=Monarch -e bash -c "monarch-show-logo; $cmd; monarch-show-done"
