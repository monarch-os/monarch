#!/bin/bash

# monarch:summary=Launch the default editor; --inline keeps terminal editors in the current terminal
# monarch:args=[--inline] <path>
# monarch:examples=monarch launch editor README.md | monarch launch editor --inline README.md

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

editor="${EDITOR:-nvim}"
[[ $editor != "sublime_text" ]] || editor=subl
monarch-cmd-present "$editor" || editor=nvim

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" -- "$@"
  else
    exec monarch-launch-tui "$editor" -- "$@"
  fi
  ;;
*)
  exec setsid uwsm-app -- "$editor" -- "$@"
  ;;
esac
