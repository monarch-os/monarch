#!/bin/bash

# monarch:summary=Apply the Noctalia theme to newly discovered Obsidian vaults
# monarch:hidden=true

mapfile -t vaults < <(find "$HOME" -maxdepth 4 -name .obsidian -type d 2>/dev/null | sort -u)
((${#vaults[@]})) || exit 0

vault_ready() {
  [[ -f $1/snippets/noctalia.css ]] &&
    jq -e '.enabledCssSnippets | index("noctalia") != null' "$1/appearance.json" >/dev/null 2>&1
}

missing=()
for vault in "${vaults[@]}"; do
  vault_ready "$vault" || missing+=("$vault")
done
((${#missing[@]})) || exit 0

if ! result=$(noctalia msg templates-apply 2>/dev/null) || [[ $result != "ok" ]]; then
  echo "Could not ask Noctalia to apply the Obsidian template" >&2
  exit 1
fi

for _ in {1..50}; do
  pending=0
  for vault in "${missing[@]}"; do
    vault_ready "$vault" || pending=1
  done
  ((pending)) || exit 0
  sleep 0.1
done

echo "Noctalia did not theme every Obsidian vault" >&2
exit 1
