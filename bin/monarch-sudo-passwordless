#!/bin/bash

# monarch:summary=Toggle passwordless sudo for the current user.
# monarch:args=[MINUTES]
# monarch:requires-sudo=true

set -euo pipefail

minutes=${1-15}
if (( $# > 1 )) || [[ ! $minutes =~ ^[0-9]{1,8}$ ]] ||
  (( 10#$minutes < 1 || 10#$minutes > 1440 )); then
  echo "Usage: monarch-sudo-passwordless [MINUTES] (1-1440)" >&2
  exit 1
fi

uid=$(/usr/bin/id -u)
grant() {
  sudo -- /usr/bin/monarch-sudo-passwordless-root "$1" "$uid" "${@:2}"
}

active=false
if grant status; then
  active=true
else
  status=$?
  if (( status != 3 )); then
    echo "Could not verify passwordless sudo state." >&2
    exit 1
  fi
fi

if [[ $active == "true" ]] && (( $# == 0 )); then
  grant disable
  echo "Passwordless sudo has been DISABLED. Sudo will require a password again."
  exit 0
fi

if [[ $active == "false" ]]; then
  echo "⚠️ WARNING: This allows ANY process running as your user to execute ANY"
  echo "command as root WITHOUT a password for $minutes minutes."
  echo "This significantly weakens the security of your system."
  if ! gum confirm "Enable passwordless sudo for $minutes minutes? This is a significant security risk!"; then
    echo "Aborted. No changes made."
    exit 0
  fi
fi

if ! grant enable "$minutes"; then
  echo "Could not confirm passwordless sudo activation. Check the command's state before retrying." >&2
  exit 1
fi
echo "Passwordless sudo enabled for $minutes minutes. Run this command again to disable it early."
echo "A restart removes the passwordless sudo rule as well."
