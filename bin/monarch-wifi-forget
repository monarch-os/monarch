#!/bin/bash

# monarch:summary=Delete a saved Wi-Fi profile
# monarch:group=wifi
# monarch:args=<ssid>
# monarch:examples=monarch wifi forget Cafe

# Deletes the stored connection, credentials included, so the network stops
# being joined automatically. Deleting the active profile disconnects it, which
# is what "forget" means everywhere else.

set -uo pipefail

ssid=${1:-}
if [[ -z $ssid ]]; then
  echo "Usage: monarch-wifi-forget <ssid>" >&2
  exit 2
fi

profiles=()
while IFS=: read -r uuid kind; do
  [[ $kind == "802-11-wireless" ]] || continue
  name=$(LC_ALL=C nmcli -e no -g 802-11-wireless.ssid connection show uuid "$uuid") || exit 1
  [[ $name != "$ssid" ]] || profiles+=("$uuid")
done < <(LC_ALL=C nmcli -t -f UUID,TYPE connection show)
if ((${#profiles[@]} == 0)); then
  echo "Error: no saved Wi-Fi profile for $ssid." >&2
  exit 1
elif ((${#profiles[@]} > 1)); then
  echo "Error: multiple profiles for $ssid; select a specific profile in NetworkManager settings." >&2
  exit 1
fi

if out=$(LC_ALL=C nmcli connection delete uuid "${profiles[0]}" 2>&1); then
  exit 0
fi

printf '%s\n' "${out:-Could not forget $ssid}" >&2
exit 1
