#!/bin/bash

# monarch:summary=Enable, disable, or toggle the touchpad
# monarch:args=[on|off|toggle]

STATE_FILE="$HOME/.local/state/monarch/toggles/niri/touchpad-disabled"

device="$(monarch-hw-touchpad)"

if [[ -z $device ]]; then
  echo "No touchpad device found" >&2
  exit 1
fi

# Niri does not expose runtime device toggles; we drive libinput directly via
# kernel sysfs (legacy fallback) and additionally hint the user. The persistent
# state file controls re-application on reload via monarch-first-run.

apply_kernel_state() {
  local enabled="$1"
  for dev in /sys/class/input/event*/device/inhibited; do
    [[ -e $dev ]] || continue
    local name_file="${dev%/inhibited}/name"
    [[ -e $name_file ]] || continue
    if grep -qi "touchpad\|trackpad" "$name_file" 2>/dev/null; then
      if [[ $enabled == "true" ]]; then
        echo 0 | sudo tee "$dev" >/dev/null 2>&1 || true
      else
        echo 1 | sudo tee "$dev" >/dev/null 2>&1 || true
      fi
    fi
  done
}

enable() {
  apply_kernel_state true
  rm -f "$STATE_FILE"
  notify-send -u low "  Touchpad enabled"
}

disable() {
  apply_kernel_state false
  mkdir -p "$(dirname "$STATE_FILE")"
  echo "disabled" > "$STATE_FILE"
  notify-send -u low "  Touchpad disabled"
}

case "${1:-toggle}" in
  on) enable ;;
  off) disable ;;
  toggle) if [[ -f $STATE_FILE ]]; then enable; else disable; fi ;;
esac
