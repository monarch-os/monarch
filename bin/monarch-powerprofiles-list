#!/bin/bash

# monarch:summary=List the power profiles this machine offers
# monarch:group=powerprofiles
# monarch:args=[--active-state]
# monarch:examples=monarch powerprofiles list | monarch powerprofiles list --active-state

# --active-state appends a tab and 1 or 0, sparing the caller a second call.

if [[ ${1:-} != "" && ${1:-} != "--active-state" ]]; then
  echo "Usage: monarch-powerprofiles-list [--active-state]" >&2
  exit 2
fi

# Least to most power, which is the reverse of what powerprofilesctl prints.
powerprofilesctl list 2>/dev/null |
  awk -v with_state="${1:+1}" '/^[[:space:]]*[* ][[:space:]]*[a-zA-Z0-9-]+:$/ {
    active = ($1 == "*") ? 1 : 0
    gsub(/^[*[:space:]]+|:$/, "")
    print $0 (with_state ? "\t" active : "")
  }' |
  tac
