#!/bin/bash

# Remove preinstalled Omarchy applications (web apps, TUIs, and selected packages).
# This removes all web apps, TUIs, plus specific desktop applications.

if gum confirm "Are you sure you want to remove all preinstalled web apps, TUI wrappers, and desktop applications?"; then
  echo -e "Removing preinstalled Omarchy applications...\n"

  monarch-webapp-remove-all
  monarch-tui-remove-all

  cp ~/.config/hypr/bindings.conf ~/.config/hypr/bindings.conf.bak
  cp "$MONARCH_PATH/default/hypr/plain-bindings.conf" ~/.config/hypr/bindings.conf
  hyprctl reload

  monarch-pkg-drop \
    aether \
    bettercap \
    binwalk \
    caido-desktop \
    claude-code
    deezer \
    fabric-ai-bin \
    ffuf-bin \
    fq \
    fx \
    gitleaks \
    gau \
    hashcat \
    lazydocker \
    lazygit \
    ligolo-ng-git \
    massdns \
    nmap \
    obsidian \
    onlyoffice-bin \
    opencode \
    posting \
    signal-desktop \
    socat \
    sshm-bin \
    termshark \
    traceroute \
    waybackurls \
    websocat \
    wifite \
    xournalpp \
fi
