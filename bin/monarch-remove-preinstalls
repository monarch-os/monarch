#!/bin/bash

# monarch:summary=Remove preinstalled Monarch applications (web apps, TUIs, and selected packages).

if gum confirm "Are you sure you want to remove all preinstalled web apps, TUI wrappers, and desktop applications?"; then
  echo -e "Removing preinstalled Monarch applications...\n"

  monarch-webapp-remove-all
  monarch-tui-remove-all

  cp ~/.config/hypr/bindings.conf ~/.config/hypr/bindings.conf.bak
  cp "$MONARCH_PATH/default/hypr/plain-bindings.conf" ~/.config/hypr/bindings.conf
  hyprctl reload

  # Remove npx stubs
  rm -f ~/.local/bin/codex ~/.local/bin/gemini ~/.local/bin/copilot \
       ~/.local/bin/opencode ~/.local/bin/playwright-cli ~/.local/bin/pi

  monarch-pkg-drop \
    aether \
    bettercap \
    binwalk \
    caido-desktop \
    claude-code \
    deezer \
    fabric-ai-bin \
    ffuf-bin \
    fq \
    fx \
    gitleaks \
    gau \
    hashcat \
    lazydocker \
    lazygit \
    ligolo-ng-git \
    massdns \
    nmap \
    obsidian \
    onlyoffice-bin \
    opencode \
    posting \
    signal-desktop \
    socat \
    sshm-bin \
    termshark \
    traceroute \
    waybackurls \
    websocat \
    wifite \
    xournalpp \
fi
