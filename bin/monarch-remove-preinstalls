#!/bin/bash

# monarch:summary=Remove preinstalled Monarch applications (web apps, TUIs, and selected packages).

if gum confirm "Are you sure you want to remove all preinstalled web apps, TUI wrappers, and desktop applications?"; then
  echo -e "Removing preinstalled Monarch applications...\n"

  monarch-remove-preinstall-artifacts

  mapfile -t packages < <(grep -vE '^[[:space:]]*(#|$)' "$MONARCH_PATH/install/monarch-preinstalls.packages")
  monarch-pkg-drop "${packages[@]}"

  monarch-state set preinstalls-removed
fi
