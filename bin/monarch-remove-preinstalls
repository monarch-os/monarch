#!/bin/bash

# monarch:summary=Remove the user-removable Monarch software bundle.

set -euo pipefail
MONARCH_PATH=${MONARCH_PATH:-/usr/share/monarch}

if gum confirm "Are you sure you want to remove the user-removable Monarch software bundle?"; then
  echo -e "Removing the user-removable Monarch software bundle...\n"

  monarch-remove-preinstall-artifacts

  mapfile -t packages < <(grep -vE '^[[:space:]]*(#|$)' "$MONARCH_PATH/install/monarch-preinstalls.packages")
  monarch-pkg-drop "${packages[@]}"

  monarch-state set preinstalls-removed
fi
