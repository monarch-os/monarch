#!/bin/bash

# monarch:summary=Save incoming Taildrop files and announce them
# monarch:args=[--once] [directory]
# monarch:examples=monarch tailscale receive | monarch tailscale receive --once ~/Desktop

set -euo pipefail

once=false
if [[ ${1:-} == "--once" ]]; then
  once=true
  shift
fi

dir="${1:-${XDG_DOWNLOAD_DIR:-$HOME/Downloads}}"
staging="$dir/.monarch-taildrop"
mkdir -p "$staging"

claim_path() {
  local staged=$1 name="${1##*/}" base ext candidate index=0

  base="${name%.*}"
  ext="${name#"$base"}"
  [[ -z $base ]] && { base=$name; ext=""; }

  while ((index < 1000)); do
    if ((index == 0)); then
      candidate="$dir/$name"
    else
      candidate="$dir/$base-$index$ext"
    fi

    if ln -- "$staged" "$candidate" 2>/dev/null; then
      rm -f -- "$staged"
      printf '%s\n' "$candidate"
      return 0
    fi

    [[ -e $candidate ]] || return 1
    ((index++))
  done

  return 1
}

announce() {
  local received_path=$1 name="${1##*/}" icon="folder-download"

  case ${name,,} in
  *.png | *.jpg | *.jpeg | *.gif | *.webp | *.avif | *.bmp | *.tif | *.tiff)
    icon=$received_path
    ;;
  esac

  monarch-notification-send --app-name="Monarch Taildrop" --urgency=critical \
    --expire-time=0 --icon="$icon" "Received $name" "Saved to ${dir/#$HOME/~}" \
    --action "Open" xdg-open "$received_path"
}

deliver() {
  local staged target

  while IFS= read -r staged; do
    target=$(claim_path "$staged") || continue
    announce "$target" &
  done < <(find "$staging" -mindepth 1 -maxdepth 1)
}

deliver

while true; do
  if ! tailscale file get --wait --conflict=rename "$staging"; then
    $once && exit 1
    sleep 10
    continue
  fi

  deliver
  $once && exit 0
done
