#!/bin/bash

# monarch:summary=Create a desktop launcher for a web app
# monarch:args=[name url icon-url-file-or-name [custom-exec] [mime-types]]

set -e
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../install/helpers/webapps.sh"

if (( $# == 0 )); then
  INTERACTIVE_MODE=true
  APP_NAME=$(gum input --prompt "Name> " --placeholder "My favorite web app")
  APP_URL=$(gum input --prompt "URL> " --placeholder "https://example.com")
  ICON_REF="" CUSTOM_EXEC="" MIME_TYPES=""
elif (( $# >= 3 && $# <= 5 )); then
  INTERACTIVE_MODE=false
  APP_NAME=$1 APP_URL=$2 ICON_REF=$3 CUSTOM_EXEC=${4:-} MIME_TYPES=${5:-}
else
  webapp_error 'Usage: monarch-webapp-install [name url icon [custom-exec] [mime-types]]'
  exit 1
fi

webapp_name_valid "$APP_NAME" || { webapp_error 'Invalid webapp name.'; exit 1; }
APP_URL=$(webapp_url "$APP_URL") || { webapp_error 'Enter a non-empty HTTP(S) URL without whitespace.'; exit 1; }
[[ ! $CUSTOM_EXEC =~ [[:cntrl:]] && ( -z $CUSTOM_EXEC || $CUSTOM_EXEC =~ [^[:space:]] ) ]] ||
  { webapp_error 'Custom Exec must be a single command line.'; exit 1; }
if [[ -n $MIME_TYPES ]]; then
  [[ $MIME_TYPES =~ ^([a-zA-Z0-9][a-zA-Z0-9.+_-]*/[a-zA-Z0-9][a-zA-Z0-9.+_-]*\;)*[a-zA-Z0-9][a-zA-Z0-9.+_-]*/[a-zA-Z0-9][a-zA-Z0-9.+_-]*\;?$ ]] ||
    { webapp_error 'Invalid MIME type list.'; exit 1; }
  MIME_TYPES="${MIME_TYPES%;};"
fi

webapp_paths
DESKTOP_FILE="$WEBAPP_DIR/$APP_NAME.desktop"
OLD_ICON=""
if [[ -e $DESKTOP_FILE || -L $DESKTOP_FILE ]]; then
  webapp_read "$DESKTOP_FILE" && webapp_is_managed ||
    { webapp_error 'Refusing to replace an unmanaged or symbolic launcher. Recreate the webapp with a different name to keep the existing launcher.'; exit 1; }
  OLD_ICON=$(webapp_recorded_icon) || OLD_ICON=""
fi

webapp_icon_reference "$ICON_REF" || { webapp_error 'Enter an HTTP(S) icon URL, a valid local image, or an icon name.'; exit 1; }

ICON_STAGE="" ICON_TEMP="" DESKTOP_TEMP="" OWNED_ICON=""
trap '[[ -z $ICON_TEMP ]] || rm -f -- "$ICON_TEMP"; [[ -z $DESKTOP_TEMP ]] || rm -f -- "$DESKTOP_TEMP"; [[ -z $ICON_STAGE ]] || rm -rf -- "$ICON_STAGE"' EXIT
mkdir -p -- "$WEBAPP_DIR"
if [[ $WEBAPP_ICON_KIND != "theme" ]]; then
  mkdir -p -- "$WEBAPP_THEME_ICON_DIR"
  ICON_STAGE=$(mktemp -d "$WEBAPP_THEME_ICON_DIR/.monarch-webapp.XXXXXXXX")
fi
if [[ $WEBAPP_ICON_KIND == "auto" ]]; then
  if webapp_fetch_site_icon "$ICON_STAGE" "$APP_URL"; then
    WEBAPP_ICON_KIND=ready
  else
    [[ $INTERACTIVE_MODE == "true" ]] || { webapp_error 'Failed to find a valid site icon.'; exit 1; }
    ICON_REF=$(gum input --prompt "Icon URL/file/name> " --placeholder "https://example.com/icon.png, /path/icon.png or icon-name")
    [[ -n $ICON_REF ]] && webapp_icon_reference "$ICON_REF" || { webapp_error 'Invalid icon reference.'; exit 1; }
  fi
fi
case $WEBAPP_ICON_KIND in
  download)
    webapp_download_icon "$ICON_STAGE" "$WEBAPP_ICON_SOURCE" || { webapp_error 'Failed to download a valid icon.'; exit 1; }
    ;;
  local)
    cp -- "$WEBAPP_ICON_SOURCE" "$ICON_STAGE/source"
    webapp_convert_icon "$ICON_STAGE/source" "$ICON_STAGE/icon.png" || { webapp_error 'Failed to decode the local image.'; exit 1; }
    ;;
esac
if [[ $WEBAPP_ICON_KIND == "theme" ]]; then
  ICON_VALUE=$WEBAPP_ICON_SOURCE
else
  ICON_TEMP=$(mktemp "$WEBAPP_THEME_ICON_DIR/monarch-webapp-XXXXXXXX.png")
  mv -T -- "$ICON_STAGE/icon.png" "$ICON_TEMP"
  chmod 644 "$ICON_TEMP"
  OWNED_ICON=$ICON_TEMP
  ICON_VALUE=${ICON_TEMP##*/}
  ICON_VALUE=${ICON_VALUE%.png}
fi

EXEC_COMMAND=${CUSTOM_EXEC:-"monarch-launch-webapp $(webapp_exec_arg "$APP_URL")"}
DESKTOP_TEMP=$(mktemp "$WEBAPP_DIR/.monarch-webapp.XXXXXXXX")
{
  printf '[Desktop Entry]\nVersion=1.0\nType=Application\nTerminal=false\nStartupNotify=true\nX-Monarch-WebApp=true\n'
  printf 'Name=%s\nComment=%s\nExec=%s\nIcon=%s\n' \
    "$(webapp_string "$APP_NAME")" "$(webapp_string "$APP_NAME")" \
    "$(webapp_string "$EXEC_COMMAND")" "$(webapp_string "$ICON_VALUE")"
  [[ -z $OWNED_ICON ]] || printf 'X-Monarch-WebApp-Icon=%s\n' "$(webapp_string "$OWNED_ICON")"
  [[ -z $MIME_TYPES ]] || printf 'MimeType=%s\n' "$MIME_TYPES"
} > "$DESKTOP_TEMP"
chmod 755 "$DESKTOP_TEMP"
mv -T -- "$DESKTOP_TEMP" "$DESKTOP_FILE"
ICON_TEMP="" DESKTOP_TEMP=""
if [[ -n $ICON_STAGE ]]; then
  rm -rf -- "$ICON_STAGE"
  ICON_STAGE=""
fi
CLEANUP_STATUS=0
webapp_cleanup_icons "$OLD_ICON" || CLEANUP_STATUS=$?
[[ -z $OWNED_ICON && -z $OLD_ICON ]] || webapp_refresh_icon_cache
(( CLEANUP_STATUS == 0 )) || exit "$CLEANUP_STATUS"

if [[ $INTERACTIVE_MODE == "true" ]]; then
  printf 'You can now find %s using the app launcher (SUPER + SPACE)\n' "$APP_NAME"
fi
