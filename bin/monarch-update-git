#!/bin/bash

# monarch:summary=Pull the latest Monarch git changes

set -e

echo -e "\e[32mUpdate Monarch\e[0m"

monarch-update-time

git -C $MONARCH_PATH pull --autostash
git -C $MONARCH_PATH --no-pager diff --check || git -C $MONARCH_PATH reset --merge

niri msg action reload-config &>/dev/null || true
