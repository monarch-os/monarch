#!/bin/bash

# monarch:summary=Launch a URL as a web app in the default supported browser
# monarch:args=<url>

source "${MONARCH_PATH:-/usr/share/monarch}/install/helpers/default-browser.sh"

if ! browser=$(monarch_browser_default_desktop); then
  browser="chromium.desktop"
fi

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

if ! browser_exec=$(monarch_browser_desktop_exec "$browser"); then
  echo "The web-app browser '$browser' has no usable desktop launcher" >&2
  exit 1
fi

exec setsid uwsm-app -- "$browser_exec" --app="$1" "${@:2}"
