#!/bin/bash

# monarch:summary=Open an existing screenshot in the configured editor
# monarch:args=<file> [editor]
# monarch:hidden=true

set -euo pipefail

file=${1:-}
editor=${2:-${MONARCH_SCREENSHOT_EDITOR:-satty}}

[[ -f $file ]] || { echo "Screenshot does not exist: $file" >&2; exit 1; }

if [[ $editor == "satty" ]]; then
  exec satty --filename "$file" \
    --output-filename "$file" \
    --actions-on-enter save-to-clipboard \
    --save-after-copy \
    --copy-command wl-copy
else
  exec "$editor" "$file"
fi
