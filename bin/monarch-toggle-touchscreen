#!/bin/bash

# monarch:summary=Enable, disable, or toggle the touch functionality of the screen
# monarch:args=[on|off|toggle]

if [[ -z "$(monarch-hw-touchscreen)" ]]; then
  echo "No touchscreen device found" >&2
  exit 1
fi

# The toggle is driven through niri's own input config (see
# monarch-niri-input-toggle), which disables the device via libinput rather than
# the kernel's unreliable sysfs `inhibited` attribute.
exec monarch-niri-input-toggle touch "${1:-toggle}"
