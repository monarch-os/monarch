#!/bin/bash

# monarch:summary=Set and show lightweight desktop notification reminders
# monarch:args=<minutes> [message] [-u low|normal|critical] | -i | show | clear
# monarch:examples=monarch reminder 5 | monarch reminder 30 "Check the oven" | monarch reminder 60 "Standup" -u normal | monarch reminder -i | monarch reminder show | monarch reminder clear

set -euo pipefail

format_remaining() {
  local seconds=$1
  local minutes=$((seconds / 60))
  local remainder=$((seconds % 60))

  if ((minutes > 0 && remainder > 0)); then
    echo "${minutes}m ${remainder}s"
  elif ((minutes > 0)); then
    echo "${minutes}m"
  else
    echo "${remainder}s"
  fi
}

show_reminders() {
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/monarch-reminders"
  local now timer base rest set_at reminder_minutes fire_at remaining message body=""
  now=$(date +%s)

  # Everything needed is in the unit name (monarch-reminder-<minutes>m-<set_at>,
  # set_at being a wall-clock epoch), so compute remaining time against `date`
  # — never the monotonic clock, which diverges from wall time across suspend.
  while read -r timer; do
    [[ -z $timer ]] && continue
    base=${timer%.timer}
    rest=${base#monarch-reminder-}
    set_at=${rest##*-}
    reminder_minutes=${rest%%m-*}
    [[ $set_at =~ ^[0-9]+$ && $reminder_minutes =~ ^[0-9]+$ ]] || continue

    fire_at=$((set_at + reminder_minutes * 60))
    remaining=$((fire_at - now))
    ((remaining <= 0)) && continue

    message=""
    [[ -f $reminder_dir/$base.message ]] && message=$(<"$reminder_dir/$base.message")
    [[ -z $message ]] && message="${reminder_minutes}-min reminder"

    body+="$message in $(format_remaining "$remaining") ($(date -d "@$fire_at" +%-H:%M))"$'\n'
  done < <(systemctl --user list-timers --all --no-legend --no-pager "monarch-reminder-*.timer" 2>/dev/null | awk '{ print $(NF - 1) }')

  if [[ -z $body ]]; then
    monarch-notification-send -g "󰔛" "Upcoming reminders" "No outstanding reminders" -u low
  else
    monarch-notification-send -g "󰔛" "Upcoming reminders" "${body%$'\n'}" -u low
  fi
}

clear_reminders() {
  local units
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/monarch-reminders"

  units=$(systemctl --user list-timers --all --no-legend --no-pager "monarch-reminder-*.timer" 2>/dev/null | awk '{ print $(NF - 1), $NF }')

  if [[ -n $units ]]; then
    xargs -r systemctl --user stop <<<"$units" || true
  fi

  rm -f "$reminder_dir"/monarch-reminder-*.message 2>/dev/null || true
  monarch-notification-send -g "󰔛" "All reminders have been cleared" -u low
}

# Pull an optional urgency flag from anywhere in the args. The default stays
# "critical" so `monarch reminder <minutes> [message]` is unchanged; callers
# like the todo TUI pass -u to match a task's priority.
urgency="critical"
interactive=false
args=()
while (($#)); do
  case $1 in
  -u | --urgency)
    urgency="${2:-critical}"
    shift 2
    ;;
  -i | --interactive)
    interactive=true
    shift
    ;;
  *)
    args+=("$1")
    shift
    ;;
  esac
done
set -- ${args[@]+"${args[@]}"}

case $urgency in
low | normal | critical) ;;
*)
  echo "Urgency must be low, normal, or critical."
  exit 1
  ;;
esac

case ${1:-} in
show | list)
  show_reminders
  exit 0
  ;;
clear)
  clear_reminders
  exit 0
  ;;
esac

# `-i` walks the two prompts the menu used to own. An empty minutes field means
# the picker was dismissed; an invalid one re-asks rather than failing.
if [[ $interactive == true ]]; then
  while true; do
    prompted_minutes=$(monarch-menu-input "Remind in minutes")
    [[ -z $prompted_minutes ]] && exit 0
    if [[ $prompted_minutes =~ ^[0-9]+$ ]] && ((prompted_minutes > 0)); then
      break
    fi
    monarch-notification-send -g "󰔛" "Invalid reminder" "Enter the number of minutes" -u critical
  done

  prompted_message=$(monarch-menu-input "Reminder message")
  set -- "$prompted_minutes" ${prompted_message:+"$prompted_message"}
fi

minutes=${1:-}
shift || true
message="$*"
custom_message="$message"

if [[ -z $minutes ]] || [[ ! $minutes =~ ^[0-9]+$ ]] || ((minutes == 0)); then
  echo "Usage: monarch-reminder <minutes> [message]"
  echo "       monarch-reminder show"
  echo "       monarch-reminder clear"
  exit 1
fi

if [[ -z $message ]]; then
  message="Your ${minutes} minutes are up"
fi

set_at=$(date +%s)
remind_at=$(date -d "+${minutes} minutes" +%H:%M)
unit="monarch-reminder-${minutes}m-$set_at"
reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/monarch-reminders"
message_file="$reminder_dir/$unit.message"
confirmation="You'll be reminded at $remind_at"
confirmation_title="Reminder set for ${minutes} minutes"

mkdir -p "$reminder_dir"

if [[ -n $custom_message ]]; then
  printf "%s" "$custom_message" >"$message_file"
  confirmation_title="$custom_message in ${minutes} minutes"
fi

systemd-run --user --quiet --collect --on-active="${minutes}m" --unit="$unit" \
  bash -c 'monarch-notification-send -g "󰔛" "Reminder" "$1" -u "$3"; rm -f "$2"' bash "$message" "$message_file" "$urgency"

monarch-notification-send -g "󰔛" "$confirmation_title" "$confirmation" -u low
