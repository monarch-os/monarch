#!/bin/bash

# monarch:summary=List available themes
# monarch:examples=monarch theme list | monarch theme set "Tokyo Night"

{
  find ~/.config/monarch/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$MONARCH_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  echo "$name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
done
