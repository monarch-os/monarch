#!/bin/bash

# monarch:summary=Restart wlsunset (used for blue-light filtering / night light).

was_running=false
if pgrep -x wlsunset >/dev/null 2>&1; then
  was_running=true
fi
pkill -x wlsunset 2>/dev/null

# Re-invoke via monarch-toggle-nightlight semantics so we honour the user config.
if [[ $was_running == "true" ]]; then
  monarch-toggle-nightlight
fi
