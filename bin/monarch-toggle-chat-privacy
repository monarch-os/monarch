#!/bin/bash

# monarch:summary=Toggle masking of chat windows in screen captures
# monarch:args=[toggle|on|off|status]
# monarch:examples=monarch toggle chat-privacy status

set -euo pipefail

root=${MONARCH_PATH:-/usr/share/monarch}
rules=$root/default/niri/chat-privacy.kdl
config=$HOME/.config/niri/chat-privacy.kdl
flag=$HOME/.local/state/monarch/toggles/chat-privacy-off

enabled() {
  [[ ! -f $flag ]]
}

write_config() (
  local value=$1 temporary
  if [[ $value == "on" && ! -f $rules ]]; then
    echo "Missing chat privacy rules: $rules" >&2
    return 1
  fi
  mkdir -p "${config%/*}" || return 1
  temporary=$(mktemp "${config%/*}/.chat-privacy.XXXXXX") || return 1
  trap 'rm -f "$temporary"' EXIT
  if [[ $value == "on" ]]; then
    cp "$rules" "$temporary" || return 1
  fi
  cmp -s "$temporary" "$config" && return 0
  mv -f "$temporary" "$config" || return 1
)

set_state() {
  local desired=$1 current=on changed=false
  [[ -f $flag ]] && current=off
  if [[ $current != "$desired" ]]; then
    "$root/bin/monarch-toggle" chat-privacy-off
    changed=true
  fi
  if ! write_config "$desired"; then
    [[ $changed == "false" ]] || "$root/bin/monarch-toggle" chat-privacy-off
    return 1
  fi
}

case ${1:-toggle} in
  status | --status)
    if enabled; then
      printf '{"enabled":true,"tooltip":"Show chat windows in captures"}\n'
    else
      printf '{"enabled":false,"tooltip":"Mask chat windows in captures"}\n'
    fi
    ;;
  init)
    if enabled; then
      set_state on
    else
      set_state off
    fi
    ;;
  on)
    set_state on
    ;;
  off)
    set_state off
    ;;
  toggle)
    if enabled; then
      set_state off
    else
      set_state on
    fi
    ;;
  *)
    echo "Usage: $0 [toggle|on|off|status]" >&2
    exit 1
    ;;
esac
