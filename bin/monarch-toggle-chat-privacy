#!/bin/bash

# monarch:summary=Toggle masking of chat windows in screen captures
# monarch:args=[toggle|on|off|status]
# monarch:examples=monarch toggle chat-privacy status

set -euo pipefail

root=${MONARCH_PATH:-/usr/share/monarch}
rules=$root/default/niri/chat-privacy.kdl
state=$HOME/.local/state/monarch/chat-privacy.kdl
flag=$HOME/.local/state/monarch/toggles/chat-privacy-off

enabled() {
  [[ ! -f $flag ]]
}

write_state() {
  local value=$1 temporary
  mkdir -p "${state%/*}"
  temporary=$(mktemp "${state%/*}/.chat-privacy.XXXXXX")
  trap 'rm -f "$temporary"' EXIT
  if [[ $value == "on" ]]; then
    [[ -f $rules ]] || {
      echo "Missing chat privacy rules: $rules" >&2
      return 1
    }
    printf 'include "%s"\n' "$rules" >"$temporary"
  else
    printf '// monarch-toggle chat-privacy-off\n' >"$temporary"
  fi
  mv -f "$temporary" "$state"
  trap - EXIT
}

set_state() {
  local desired=$1 current=on changed=false
  [[ -f $flag ]] && current=off
  if [[ $current != "$desired" ]]; then
    "$root/bin/monarch-toggle" chat-privacy-off
    changed=true
  fi
  if ! write_state "$desired"; then
    [[ $changed == "false" ]] || "$root/bin/monarch-toggle" chat-privacy-off
    return 1
  fi
}

case ${1:-toggle} in
  status | --status)
    if enabled; then
      printf '{"enabled":true,"tooltip":"Show chat windows in captures"}\n'
    else
      printf '{"enabled":false,"tooltip":"Mask chat windows in captures"}\n'
    fi
    ;;
  init)
    # Empty files are the legacy off state; generated off files have a marker.
    if [[ -f $state && ! -s $state && ! -f $flag ]]; then
      "$root/bin/monarch-toggle" chat-privacy-off
    fi
    if enabled; then
      [[ -f $state ]] && grep -Fxq "include \"$rules\"" "$state" || write_state on
    else
      [[ -f $state && $(<"$state") == "// monarch-toggle chat-privacy-off" ]] || write_state off
    fi
    ;;
  on)
    set_state on
    ;;
  off)
    set_state off
    ;;
  toggle)
    if enabled; then
      set_state off
    else
      set_state on
    fi
    ;;
  *)
    echo "Usage: $0 [toggle|on|off|status]" >&2
    exit 1
    ;;
esac
