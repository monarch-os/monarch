#!/bin/bash

# Overwrite the user config for the Plymouth drive decryption and boot sequence with the Monarch default and rebuild it.

sudo cp ~/.local/share/monarch/default/plymouth/* /usr/share/plymouth/themes/monarch/
sudo plymouth-set-default-theme monarch

if command -v limine-mkinitcpio &>/dev/null; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
