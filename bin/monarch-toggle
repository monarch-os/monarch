#!/bin/bash

# monarch:summary=Toggle Monarch features between enabled and disabled
# monarch:args=[--enabled-notification <text>] [--disabled-notification <text>] <flag-name>

set -e

ENABLED_NOTIFICATION=""
DISABLED_NOTIFICATION=""

while [[ $# -gt 1 ]]; do
  case $1 in
    --enabled-notification) ENABLED_NOTIFICATION="$2"; shift 2 ;;
    --disabled-notification) DISABLED_NOTIFICATION="$2"; shift 2 ;;
    *) break ;;
  esac
done

FLAG_NAME="$1"
FLAG="$HOME/.local/state/monarch/toggles/$FLAG_NAME"

if [[ -f $FLAG ]]; then
  rm "$FLAG"
  if [[ -n $DISABLED_NOTIFICATION ]]; then
    notify-send -u low "$DISABLED_NOTIFICATION" || true
  fi
else
  mkdir -p "$(dirname "$FLAG")"
  touch "$FLAG"
  if [[ -n $ENABLED_NOTIFICATION ]]; then
    notify-send -u low "$ENABLED_NOTIFICATION" || true
  fi
fi
