#!/bin/bash

# A script to display Exegol workspaces defined in your configuration
# using walker for an interactive search menu.

export PATH="$HOME/.local/bin:$PATH"


# Get Exegol workspaces from Docker containers
get_workspaces() {
  docker ps -a -f "name=exegol" --format json | \
    jq -r '{Names, State} | "\(.Names),\(.State)"' | \
    sed -r \
    -e "s/exegol-//"
}


# Format workspace data for display
parse_workspaces() {
  awk -F, '
    {
        icon = ($2 == "exited") ? "" : "";
        printf "%s  %s\n", icon, $1;
    }
  '
}

# Display interactive menu using walker
menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n "$preselect" ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n "$index" ]]; then
      args+=("-a" "$index")
    fi
  fi

  echo -e "$options" | monarch-launch-walker --dmenu --width 295 --minheight 1 --maxheight 600 -p "$prompt…" "${args[@]}" 2> /dev/null
}

# Handle workspace-specific actions
workspace_actions() {
  local name="$1"

  local action_choice=$(menu "Actions" "Start\nStop\nDelete\nLaunch Bloodhound (old)\nLaunch Firefox")

  if [[ -z "$action_choice" ]]; then
    return 0
  fi

  case $action_choice in
  *Start*)
    echo "Starting $name..."
    xdg-terminal-exec --app-id=com.monarch.Monarch bash -c "exegol exec -b --offline $name kitty"
    ;;
  *Stop*)
    echo "Stopping $name..."
    xdg-terminal-exec --app-id=com.monarch.Monarch bash -c "exegol stop $name"
    ;;
  *Delete*)
    echo "Deleting $name..."
    xdg-terminal-exec --app-id=com.monarch.Monarch bash -c "exegol remove $name"
    ;;
  *Bloodhound*)
    echo "Starting old bloodhound for $name..."
    xdg-terminal-exec --app-id=com.monarch.Monarch bash -c "exegol exec -b --offline $name bloodhound"
    ;;
  *Firefox*)
    echo "Starting Firefox for $name..."
    xdg-terminal-exec --app-id=com.monarch.Monarch bash -c "exegol exec -b --offline $name firefox"
    ;;
  esac
}

# Check if exegol command is available and install if needed
if ! command -v exegol &>/dev/null; then
  monarch-launch-floating-terminal-with-presentation "gum confirm 'Exegol is not installed. Would you like to install it?' && pipx install exegol"
  if ! command -v exegol &>/dev/null; then
    exit 1
  fi
fi

# Calculate menu dimensions and build workspace list
monitor_height=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .height')
menu_height=$((monitor_height * 40 / 100))

workspaces="  Create workspace
$(get_workspaces | sort -u | parse_workspaces)"


# Display main menu and handle user selection
choice=$(menu "Exegol Workspaces" "$workspaces")

if [[ -z "$choice" ]]; then
  exit 0
fi

case $choice in
  *Create*)
    echo "Creating new Exegol workspace..."
    xdg-terminal-exec bash -c "exegol start"
    ;;
  *)
    name=$(echo "$choice" | awk -F ' ' '{print $2}')
    workspace_actions "$name"
    ;;
esac
