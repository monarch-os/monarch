#!/bin/bash

# monarch:summary=Display Exegol wrapper

export PATH="$HOME/.local/bin:$PATH"

# gum pickers for the creation wizard (cmd_create). The wizard runs inside a
# floating terminal, so the whole flow stays in the TUI instead of popping GUI
# dialogs.
menu() {
  local prompt="$1" options="$2"
  echo -e "$options" | grep -v '^[[:space:]]*$' | gum choose --header "$prompt"
}

input() {
  local prompt="$1"
  gum input --placeholder "$prompt"
}

# Pick a single file with yazi (chooser mode). Prints the chosen path, or
# nothing if the user quits without selecting.
pick_file() {
  local out path
  out=$(mktemp)
  yazi --chooser-file="$out" "$HOME"
  path=$(head -n1 "$out" 2>/dev/null)
  rm -f "$out"
  [[ -n "$path" ]] && printf '%s\n' "$path"
}

# Spawn a fresh, centered floating terminal running `monarch-menu-exegol <args>`.
# Uses the Monarch presentation launcher (org.monarch.terminal app-id, floats
# centered per windows.kdl). Same launcher as the SSH manager (Ctrl+Alt+S).
launch_in_terminal() {
  monarch-launch-floating-terminal-with-presentation monarch-menu-exegol "$@"
}

# Show container info (rendered as the fzf preview panel)
cmd_info() {
  local name="$1"

  if [[ "$name" == "__create__" ]]; then
    cat <<'EOF'
Create a new Exegol workspace.

You will be guided through:
  • Image selection
  • Container name
  • VPN configuration (optional)
  • Shell logging (optional)
  • Desktop mode (optional)
EOF
    return 0
  fi

  local cname="exegol-$name"

  local inspect
  inspect=$(docker inspect "$cname" --format json 2>/dev/null)
  if [[ -z "$inspect" ]]; then
    echo "Container not found: $name"
    return 1
  fi

  local jq_get='def get: .[0];'

  local image state status network workspace
  image=$(echo "$inspect" | jq -r "$jq_get get.Config.Image" | sed 's|.*/||')
  state=$(echo "$inspect" | jq -r "$jq_get get.State.Status")
  status=$(docker ps -a -f "name=$cname" --format '{{.Status}}')
  network=$(echo "$inspect" | jq -r "$jq_get get.HostConfig.NetworkMode")
  workspace=$(echo "$inspect" | jq -r "$jq_get [get.Mounts[] | select(.Destination == \"/workspace\")] | .[0].Source // \"N/A\"")

  # Exegol features from labels
  local logging vpn desktop
  logging=$(echo "$inspect" | jq -r "$jq_get get.Config.Labels[\"org.exegol.feature.shell_logging\"] // empty")
  desktop=$(echo "$inspect" | jq -r "$jq_get get.Config.Labels[\"org.exegol.feature.desktop\"] // empty")

  # VPN from mounts
  vpn=$(echo "$inspect" | jq -r "$jq_get [get.Mounts[] | select(.Destination | test(\"vpn|wireguard\"))] | .[0].Source // empty")

  # Ports
  local ports
  ports=$(echo "$inspect" | jq -r "$jq_get [get.NetworkSettings.Ports // {} | to_entries[] | select(.value != null) | \"\(.key) → \(.value[0].HostPort)\"] | join(\", \")")

  # Devices
  local devices
  devices=$(echo "$inspect" | jq -r "$jq_get [get.HostConfig.Devices // [] | .[].PathOnHost] | join(\", \")")

  # Privileged
  local privileged
  privileged=$(echo "$inspect" | jq -r "$jq_get get.HostConfig.Privileged")

  # Exegol metadata
  local creation_date comment
  creation_date=$(echo "$inspect" | jq -r "$jq_get get.Config.Labels[\"org.exegol.metadata.creation_date\"] // empty")
  comment=$(echo "$inspect" | jq -r "$jq_get get.Config.Labels[\"org.exegol.metadata.comment\"] // empty")

  # Format output
  echo "Image       : $image"
  echo "State       : $state ($status)"
  echo "Network     : $network"
  echo "Workspace   : $workspace"
  echo ""
  echo "Logging     : ${logging:-disabled}"
  echo "VPN         : ${vpn:-none}"
  echo "Desktop     : ${desktop:-disabled}"
  echo "Privileged  : $privileged"
  [[ -n "$devices" ]] && echo "Devices     : $devices"
  [[ -n "$ports" ]] && echo "Ports       : $ports"
  [[ -n "$creation_date" ]] && echo ""
  [[ -n "$creation_date" ]] && echo "Created     : $creation_date"
  [[ -n "$comment" ]] && echo "Comment     : $comment"
}

# Session actions (shell/start) open a dedicated floating terminal via
# xdg-terminal-exec + uwsm-app — like the rest of Monarch — so each session is
# its own uwsm scope and the picker (cmd_picker) stays open behind it.
cmd_shell() {
  local name="$1"
  setsid uwsm-app -- xdg-terminal-exec --app-id=org.monarch.terminal --title=Exegol -e bash -c "exegol exec --offline '$name' zsh"
}

# Start a stopped container (drops into a shell)
cmd_start() {
  local name="$1"
  setsid uwsm-app -- xdg-terminal-exec --app-id=org.monarch.terminal --title=Exegol -e bash -c "exegol start --offline '$name'"
}

# Transient ops: run in the foreground. The picker invokes these with fzf
# `execute`, inside its own already-scoped terminal, then reloads the list.
cmd_stop() {
  local name="$1"
  exegol stop "$name"
}

cmd_remove() {
  local name="$1"
  exegol remove "$name"
}

# Open workspace directory in file manager
cmd_workspace() {
  local name="$1"
  local ws_path
  ws_path=$(docker inspect "exegol-$name" \
    --format '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' 2>/dev/null)

  if [[ -n "$ws_path" && -d "$ws_path" ]]; then
    setsid uwsm-app -- nautilus "$ws_path"
  else
    notify-send "Exegol" "Workspace introuvable pour $name"
  fi
}

# Launch Firefox inside a container (-b: detach so the picker stays responsive)
cmd_firefox() {
  local name="$1"
  exegol exec -b --offline "$name" firefox
}

# Launch Bloodhound inside a container
cmd_bloodhound() {
  local name="$1"
  exegol exec -b --offline "$name" bloodhound
}

# Interactive container creation wizard (gum TUI).
cmd_create() {
  # gum needs a terminal. When invoked headless (e.g. from monarch-menu-pentestenv
  # on a keybinding), relaunch in a floating one. The picker hands us our own
  # terminal directly via launch_in_terminal, so that path already has a tty.
  if [[ ! -t 1 ]]; then
    launch_in_terminal create
    return
  fi

  # Step 1: Select image (installed first, then unavailable)
  local all_images=("full" "ad" "osint" "web" "light" "nightly" "free")

  # Approximate download sizes from Docker Hub (nwodtuhs/exegol, snapshot 2026-04)
  declare -A remote_sizes=(
    [full]="20GB"
    [ad]="16GB"
    [osint]="4.5GB"
    [web]="9.2GB"
    [light]="6.8GB"
    [free]="17GB"
  )

  # Local images: on-disk (uncompressed) size from docker
  local installed="" not_installed=""
  declare -A sizes
  while IFS='|' read -r repotag size; do
    [[ -z "$repotag" ]] && continue
    sizes["${repotag##*:}"]="$size"
  done < <(docker images --format '{{.Repository}}:{{.Tag}}|{{.Size}}' 2>/dev/null | grep -i exegol)

  for img in "${all_images[@]}"; do
    if [[ -n "${sizes[$img]:-}" ]]; then
      installed="${installed}🟢 ${img}  (${sizes[$img]})\n"
    elif [[ -n "${remote_sizes[$img]:-}" ]]; then
      not_installed="${not_installed}⚫ ${img}  (~${remote_sizes[$img]}, not installed)\n"
    else
      not_installed="${not_installed}⚫ ${img}  (not installed)\n"
    fi
  done

  local images="${installed}${not_installed}"

  local choice
  choice=$(menu "Image" "$images")
  [[ -z "$choice" ]] && return 0

  local image
  image=$(echo "$choice" | awk '{print $2}')

  # If image is not installed, offer to install it first (inline, in this terminal).
  if [[ "$choice" == *"⚫"* ]]; then
    gum confirm "Installer l'image « $image » puis créer ?" || return 0
    exegol install "$image" && exec monarch-menu-exegol create
    return 0
  fi

  # Step 2: Container name (free text input)
  local name
  name=$(input "Nom du conteneur")
  [[ -z "$name" ]] && return 0
  # Reject names that aren't safe for an exegol container identifier
  if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    notify-send "Exegol" "Nom de conteneur invalide: $name"
    return 1
  fi

  # Step 3: VPN configuration
  local vpn_flags=""
  local vpn_choice
  vpn_choice=$(menu "VPN" "Pas de VPN\nSélectionner un fichier VPN")

  if [[ "$vpn_choice" == *"Sélectionner"* ]]; then
    local vpn_path
    vpn_path=$(pick_file)
    if [[ -n "$vpn_path" ]]; then
      local vpn_quoted
      printf -v vpn_quoted '%q' "$vpn_path"
      vpn_flags="--vpn $vpn_quoted"

      # Optional: VPN auth file
      local auth_choice
      auth_choice=$(menu "Auth VPN" "Pas de fichier d'auth\nSélectionner un fichier d'auth")
      if [[ "$auth_choice" == *"Sélectionner"* ]]; then
        local auth_path
        auth_path=$(pick_file)
        if [[ -n "$auth_path" ]]; then
          local auth_quoted
          printf -v auth_quoted '%q' "$auth_path"
          vpn_flags="$vpn_flags --vpn-auth $auth_quoted"
        fi
      fi
    fi
  fi

  # Step 4: Shell logging
  local log_flag=""
  local log_choice
  log_choice=$(menu "Journalisation" "Désactiver la journalisation\nActiver la journalisation")

  if [[ "$log_choice" == *"Activer"* ]]; then
    log_flag="-l"
  fi

  # Step 5: Desktop mode
  local desktop_flag=""
  local desktop_choice
  desktop_choice=$(menu "Desktop" "Pas de desktop\nHTTP\nVNC")

  case $desktop_choice in
    *HTTP*) desktop_flag="--desktop --desktop-config http" ;;
    *VNC*)  desktop_flag="--desktop --desktop-config vnc" ;;
  esac

  # Build and run — quote name/image; vpn_flags is already %q-escaped. Runs in
  # this terminal so the wizard flows straight into the new container's shell.
  local cmd
  printf -v cmd 'exegol start %q %q %s %s %s' "$name" "$image" "$vpn_flags" "$log_flag" "$desktop_flag"
  echo "+ $cmd"
  # On success, exegol drops into the container shell; on failure, keep the
  # terminal open so the error stays readable instead of flashing by.
  bash -c "$cmd" || {
    local rc=$?
    echo
    echo "exegol a échoué (code $rc)."
    read -rsn1 -p "Appuie sur une touche pour fermer…"
  }
}

# Emit the picker rows as TSV: <name>\t<state>\t<display>. The first two
# columns are hidden (used by fzf placeholders for preview/actions); only the
# third is shown. A synthetic "Create" row sits on top.
cmd_list() {
  printf '%s\t%s\t%s\n' "__create__" "-" "  Create workspace"

  docker ps -a -f 'name=exegol' \
    --format '{{.Names}}|{{.State}}|{{.Image}}' 2>/dev/null |
    while IFS='|' read -r name state image; do
      [[ -z "$name" ]] && continue
      local short="${name#exegol-}"
      local tag
      if [[ "$image" == *:* ]]; then tag="${image##*:}"; else tag="${image##*/}"; fi
      local icon="🔴"
      [[ "$state" == "running" ]] && icon="🟢"
      printf '%s\t%s\t%s %s  (%s)\n' "$short" "$state" "$icon" "$short" "$tag"
    done
}

# Default action (Enter): create wizard, or shell/start depending on state.
# Each branch spawns its own detached process/terminal and returns, so the
# picker (which calls this via execute-silent) stays open.
cmd_enter() {
  local name="$1" state="$2"
  case "$name" in
    __create__) launch_in_terminal create; return ;;
  esac
  if [[ "$state" == "running" ]]; then
    monarch-menu-exegol shell "$name"
  else
    monarch-menu-exegol start "$name"
  fi
}

# The interactive container manager (runs inside the floating terminal that
# cmd_menu opened via the presentation launcher).
cmd_picker() {
  if ! command -v exegol &>/dev/null; then
    gum confirm 'Exegol is not installed. Install it?' && pipx install exegol
    command -v exegol &>/dev/null || exit 1
  fi

  local self="monarch-menu-exegol"
  local header='Enter: shell/start   ^X: stop   ^D: remove   ^W: workspace   ^F: firefox   ^B: bloodhound   ^N: create   ^R: refresh'

  "$self" _list | fzf \
    --ansi \
    --delimiter=$'\t' \
    --with-nth=3 \
    --prompt='Exegol ❯ ' \
    --header="$header" \
    --preview="$self info {1}" \
    --preview-window='right,55%,wrap' \
    --bind="enter:execute-silent($self _enter {1} {2})" \
    --bind="ctrl-x:execute($self stop {1})+reload($self _list)" \
    --bind="ctrl-d:execute($self remove {1})+reload($self _list)" \
    --bind="ctrl-w:execute-silent($self workspace {1})" \
    --bind="ctrl-f:execute-silent($self firefox {1})" \
    --bind="ctrl-b:execute-silent($self bloodhound {1})" \
    --bind="ctrl-n:execute-silent($self _enter __create__ -)" \
    --bind="ctrl-r:reload($self _list)"
}

# Default entry point: always open the picker in its own centered floating
# terminal (via the Monarch presentation launcher), even when called from an
# existing terminal. The launcher re-invokes us as `_picker` so we land
# directly in cmd_picker inside the new terminal.
cmd_menu() {
  exec monarch-launch-floating-terminal-with-presentation monarch-menu-exegol _picker
}

# Route sub-commands
case "${1:-}" in
  info)       cmd_info "$2" ;;
  shell)      cmd_shell "$2" ;;
  start)      cmd_start "$2" ;;
  stop)       cmd_stop "$2" ;;
  remove)     cmd_remove "$2" ;;
  workspace)  cmd_workspace "$2" ;;
  firefox)    cmd_firefox "$2" ;;
  bloodhound) cmd_bloodhound "$2" ;;
  create)     cmd_create ;;
  _picker)    cmd_picker ;;
  _list)      cmd_list ;;
  _enter)     cmd_enter "$2" "$3" ;;
  *)          cmd_menu ;;
esac
