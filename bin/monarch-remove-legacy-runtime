#!/bin/bash

# monarch:summary=Remove the archived Monarch V4 runtime after a successful V5 upgrade

set -euo pipefail

runtime=${MONARCH_RUNTIME_ROOT:-/usr/share/monarch}
legacy="$HOME/.local/share/monarch"
backup="$HOME/.local/share/monarch-v4"
schema="$HOME/.local/state/monarch/schema"

if [[ -e $legacy || -L $legacy || ! -x $runtime/bin/monarch ]]; then
  echo "Refusing cleanup: the packaged Monarch runtime is not the only active runtime." >&2
  exit 1
fi

if [[ ! -f $schema || $(<"$schema") != "2" ]]; then
  echo "Refusing cleanup: the Monarch V5 reconciliation is not complete." >&2
  exit 1
fi

if [[ ! -d $backup/.git || -L $backup ]]; then
  echo "Nothing to remove: $backup is not an archived Monarch V4 runtime."
  exit 0
fi

if gum confirm --default=false "Permanently remove $backup and any local changes it contains?"; then
  rm -rf -- "$backup"
  echo "Removed $backup."
fi
