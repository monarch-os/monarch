#!/bin/bash

# monarch:summary=Print the connected Wi-Fi network's password
# monarch:args=[interface]
# monarch:examples=monarch wifi password

# Same lookup as the QR code, which needs the secret anyway; kept a separate
# invocation so the panel only asks for it in the clear on a deliberate click.

PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd):$PATH"
exec monarch-wifi-qr --password "$@"
