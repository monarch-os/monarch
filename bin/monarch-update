#!/bin/bash

set -e

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://monarch-os.github.io\033[0m"' ERR

monarch-update-confirm
monarch-snapshot create || [ $? -eq 127 ]
monarch-update-git
monarch-update-perform
