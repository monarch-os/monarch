#!/bin/bash -p

# monarch:summary=Update Monarch and system packages
# monarch:args=[-y] [--branch <main|dev>]
# monarch:examples=monarch update | monarch update -y
# monarch:requires-sudo=true

[[ $- == *p* ]] || exit 126
update_entrypoint=$(/usr/bin/readlink -e -- "${BASH_SOURCE[0]}") || exit 126
source "${update_entrypoint%/*}/../default/monarch/update-authorization.sh" || exit 126
monarch_update_sanitize_environment "$0" "$@" || exit 126
set -e
update_user_path=${MONARCH_UPDATE_USER_PATH:-$PATH}
unset MONARCH_UPDATE_USER_PATH
PATH="${update_entrypoint%/*}:/usr/bin:/usr/sbin"
export PATH
update_sudo_wrapper="${update_entrypoint%/*}/../default/monarch/sudo-no-update/sudo"
sudo_keepalive_pid=""
update_stay_awake_stopped=1
update_refresh_panel=false

cleanup_update() {
  local status=$?
  trap - EXIT HUP INT TERM
  if ! monarch_update_end_authorization; then
    echo "Could not invalidate cached sudo authorization after the update." >&2
    status=1
  fi
  if (( ! update_stay_awake_stopped )); then
    monarch-update-stay-awake stop || status=1
  fi
  monarch_update_revoke_authorization || status=1
  if [[ $update_refresh_panel == "true" ]]; then
    noctalia msg plugin monarch/indicators:monarch-update all refresh >/dev/null 2>&1 || true
  fi
  exit "$status"
}

trap cleanup_update EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
monarch_update_revoke_authorization || exit 1
monarch_update_check_sudo || exit 1
monarch_update_select_runtime || exit 1
export MONARCH_UPDATE_SUDO_SESSION=1

# Run the update inside a PTY so pacman/yay keep showing download progress
# while still logging the full session for later analysis.
if [[ -z $MONARCH_UPDATE_LOGGED ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env MONARCH_UPDATE_LOGGED=1 MONARCH_UPDATE_USER_PATH="$update_user_path" \
    script -qefc "$script_command" "/tmp/monarch-update.log"
fi

unattended=false
branch=""

while (( $# > 0 )); do
  case "$1" in
    -y)
      unattended=true
      ;;
    --branch)
      shift
      [[ -n ${1:-} ]] || { echo "Usage: monarch update [-y] [--branch <main|dev>]" >&2; exit 2; }
      branch="$1"
      ;;
    *)
      echo "Usage: monarch update [-y] [--branch <main|dev>]" >&2
      exit 2
      ;;
  esac
  shift
done

case "$branch" in
  "" | main | dev) ;;
  *)
    echo "Unknown branch: $branch" >&2
    exit 2
    ;;
esac

if ! monarch-update-lock held; then
  update_args=()
  [[ $unattended == "false" ]] || update_args+=(-y)
  [[ -z $branch ]] || update_args+=(--branch "$branch")
  exec env MONARCH_UPDATE_USER_PATH="$update_user_path" monarch-update-lock run "$0" "${update_args[@]}"
fi
unset MONARCH_UPDATE_LOCKED

source "$("$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/monarch-i18n" --helper)"
monarch_i18n_load
skip_aur=false
packages_current=false
keyrings_refreshed=false

# Explicit branch switches and Git-managed runtimes also update source, which
# a package-only check cannot describe. Use the same runtime boundary as
# monarch-update-git so channel-set's plain `monarch-update -y` still pulls.
# Packaged runtimes check before confirmation or any maintenance.
if [[ -z $branch && ! -d ${MONARCH_PATH:-/usr/share/monarch}/.git ]]; then
  monarch_message 'update.checking'
  check_status=0
  updates=$(monarch-update-available --all --json) || check_status=$?
  # checkupdates deliberately hides pacman's diagnostic details, so a failed
  # repository sync cannot distinguish transport errors from stale signatures.
  # Keep the passive checker read-only, but offer the existing keyring repair
  # here and retry once. Never turn an unsuccessful retry into "current".
  if (( check_status == 2 )) && jq -e '.status == "error" and .reason == "repositories-unavailable"' >/dev/null 2>&1 <<< "$updates"; then
    if [[ $unattended == "false" ]] && ! gum confirm "$(monarch_t 'update.repairKeyrings')"; then
      exit 130
    fi
    monarch_message 'update.refreshingKeyrings'
    monarch_update_authorize
    update_stay_awake_stopped=0
    monarch-update-stay-awake start
    if monarch-update-keyring; then
      keyrings_refreshed=true
    else
      repair_status=$?
      monarch_message 'update.keyringRepairFailed' >&2
      exit "$repair_status"
    fi
    check_status=0
    updates=$(monarch-update-available --all --json) || check_status=$?
  fi
  case $check_status in
    0)
      if ! count=$(jq -er 'select(.status == "available" and (.count | type) == "number" and .count > 0) | .count' <<< "$updates"); then
        monarch_message 'update.checkFailed' >&2
        exit 2
      fi
      if jq -e 'any(.warnings[]?; .source == "aur")' >/dev/null <<< "$updates"; then
        skip_aur=true
        monarch_message 'update.availableAtLeast' "$count"
        monarch_message 'update.aurSkipped'
      else
        monarch_message 'update.availableCount' "$count"
      fi
      ;;
    1)
      if ! jq -e '.status == "current" and .count == 0 and .complete != false' >/dev/null <<< "$updates"; then
        monarch_message 'update.checkFailed' >&2
        exit 2
      fi
      monarch_message 'update.current'
      packages_current=true
      ;;
    *) monarch_message 'update.checkFailed' >&2; exit 2 ;;
  esac
fi

[[ $unattended == "false" ]] || export MONARCH_UPDATE_UNATTENDED=1
if [[ $packages_current == "false" && $unattended == "false" ]] && ! monarch-update-confirm; then
  exit 130
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://monarch-os.github.io\033[0m"' ERR
update_refresh_panel=true

if [[ $packages_current == "false" ]]; then
  monarch-update-requires-free-space
  monarch_update_authorize
  monarch-update-pkg-prune
  monarch-snapshot create || (($? == 127)) ||
    echo -e "\e[33mContinuing the update without a snapshot.\e[0m" >&2

  [[ -z $branch ]] || monarch-update-switch-branch "$branch"
  update_stay_awake_stopped=0
  [[ $keyrings_refreshed == "true" ]] || monarch-update-stay-awake start
  monarch-update-git
  [[ $keyrings_refreshed == "true" ]] || monarch-update-keyring
  monarch-update-system-pkgs
else
  # Package installation can succeed before reconciliation or a hook fails.
  # Always converge the post-package stages, including retries from older
  # updater versions which did not record a pending transaction.
  monarch_message 'update.finalizing'
  monarch_update_authorize
  update_stay_awake_stopped=0
  [[ $keyrings_refreshed == "true" ]] || monarch-update-stay-awake start
fi
monarch-reconcile
monarch-update-orphan-pkgs
PATH="$update_user_path" "${update_entrypoint%/*}/monarch-hook" --strict post-update
monarch-update-analyze-logs
monarch-update-restart --services-only
monarch_update_end_authorization || exit 1
[[ $skip_aur == "true" || $packages_current == "true" ]] || monarch-update-aur-pkgs
noctalia msg plugin monarch/indicators:monarch-update all refresh >/dev/null 2>&1 || true
update_refresh_panel=false
monarch-update-stay-awake stop
update_stay_awake_stopped=1
monarch-update-restart --reboot-only
