#!/bin/bash

# monarch:summary=Finish the installation of Monarch with items that can only be done after logging in.
# monarch:requires-sudo=true

set -e

FIRST_RUN_MODE=~/.local/state/monarch/first-run.mode

if [[ -f $FIRST_RUN_MODE ]]; then
  rm -f "$FIRST_RUN_MODE"

  bash "$MONARCH_PATH/install/first-run/battery-monitor.sh"
  bash "$MONARCH_PATH/install/first-run/recover-internal-monitor.sh"
  bash "$MONARCH_PATH/install/first-run/cleanup-reboot-sudoers.sh"
  bash "$MONARCH_PATH/install/first-run/firewall.sh"
  bash "$MONARCH_PATH/install/first-run/dns-resolver.sh"
  bash "$MONARCH_PATH/install/first-run/gnome-theme.sh"
  bash "$MONARCH_PATH/install/first-run/gtk-primary-paste.sh"
  bash "$MONARCH_PATH/install/first-run/text-scaling.sh"
  bash "$MONARCH_PATH/install/first-run/nvidia-driver.sh"
  monarch-hook-install post-update "$MONARCH_PATH/install/first-run/install-voxtype.hook"
  sudo rm -f /etc/sudoers.d/first-run

  bash "$MONARCH_PATH/install/first-run/welcome.sh"
fi
