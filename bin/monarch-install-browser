#!/bin/bash

# monarch:summary=Install a supported browser
# monarch:args=<chrome|brave|brave-origin|edge|firefox|zen>
# monarch:examples=monarch install browser firefox | monarch install browser brave

setup_policy_directory() {
  source "${MONARCH_PATH:-/usr/share/monarch}/install/helpers/browser-policy.sh"
  browser_policy_setup_dir "$1"
}

announce_browser_installed() {
  echo ""
  echo "$1 browser installed. Make it the default via Setup > Defaults > Browser."
}

copy_chromium_flags() {
  mkdir -p ~/.config
  cp -f "${MONARCH_PATH:-/usr/share/monarch}/config/chromium-flags.conf" "$1"
}

setup_firefox_preferences() {
  local distribution_dir="$1"

  source "${MONARCH_PATH:-/usr/share/monarch}/install/helpers/browser-policy.sh"
  browser_policy_setup_firefox "$distribution_dir"
}

setup_firefox_wayland() {
  mkdir -p ~/.config/environment.d
  echo "MOZ_ENABLE_WAYLAND=1" > ~/.config/environment.d/monarch-firefox-wayland.conf
}

case $1 in
chrome)
  echo "Installing Chrome..."
  monarch-pkg-aur-add google-chrome || exit 1

  setup_policy_directory /etc/opt/chrome/policies/managed
  copy_chromium_flags ~/.config/chrome-flags.conf
  monarch-theme-apply
  announce_browser_installed "Chrome"
  ;;
edge)
  echo "Installing Edge..."
  monarch-pkg-aur-add microsoft-edge-stable-bin || exit 1

  setup_policy_directory /etc/opt/edge/policies/managed
  copy_chromium_flags ~/.config/microsoft-edge-stable-flags.conf
  monarch-theme-apply
  announce_browser_installed "Edge"
  ;;
brave)
  echo "Installing Brave..."
  monarch-pkg-aur-add brave-bin || exit 1

  setup_policy_directory /etc/brave/policies/managed
  copy_chromium_flags ~/.config/brave-flags.conf
  monarch-theme-apply
  announce_browser_installed "Brave"
  ;;
brave-origin)
  echo "Installing Brave Origin..."
  monarch-pkg-aur-add brave-origin-beta-bin || exit 1

  setup_policy_directory /etc/brave/policies/managed
  mkdir -p ~/.config
  # FIXME: Use normal chromium flags when Brave Origin wrapper has been fixed
  echo "--load-extension=${MONARCH_PATH:-/usr/share/monarch}/default/chromium/extensions/copy-url" > ~/.config/brave-origin-beta-flags.conf
  monarch-theme-apply
  announce_browser_installed "Brave Origin"
  ;;
firefox)
  echo "Installing Firefox..."
  monarch-pkg-add firefox || exit 1

  setup_firefox_preferences /usr/lib/firefox/distribution
  setup_firefox_wayland
  announce_browser_installed "Firefox"
  ;;
zen)
  echo "Installing Zen..."
  monarch-pkg-aur-add zen-browser-bin || exit 1

  setup_firefox_preferences /opt/zen-browser/distribution
  setup_firefox_wayland
  announce_browser_installed "Zen"
  ;;
*)
  echo "Usage: monarch-install-browser <chrome|brave|brave-origin|edge|firefox|zen>"
  exit 1
  ;;
esac
