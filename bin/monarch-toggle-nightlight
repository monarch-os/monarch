#!/bin/bash

# monarch:summary=Toggle nightlight screen temperature (forced on/off) via Noctalia
# monarch:examples=monarch toggle nightlight

# Noctalia's `nightLight toggle` IPC cycles through three states
# (off -> forced -> scheduled -> off), so a single keypress can land on the
# invisible "scheduled" state and leave the screen colour unchanged. We drive a
# clean binary forced on/off by editing nightLight.forced + .enabled together in
# Noctalia's settings.json, which it watches and hot-reloads (Commons/Settings.qml:
# FileView { watchChanges: true; onFileChanged: scheduleExternalReload() }).

cfg="$HOME/.config/noctalia/settings.json"
[[ -f $cfg ]] || { mkdir -p "$(dirname "$cfg")"; echo '{}' >"$cfg"; }

tmp=$(mktemp)
if jq '.nightLight = (.nightLight // {})
       | (.nightLight.forced | not) as $new
       | .nightLight.forced = $new
       | .nightLight.enabled = $new' "$cfg" >"$tmp"; then
  mv "$tmp" "$cfg"
else
  rm -f "$tmp"
  echo "monarch-toggle-nightlight: could not update $cfg" >&2
  exit 1
fi
