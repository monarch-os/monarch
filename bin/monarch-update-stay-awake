#!/bin/bash

# monarch:summary=Manage sleep and idle inhibition during an update
# monarch:args=<start|stop>
# monarch:hidden=true

case ${1:-} in
  start | stop) ;;
  *) echo 'Usage: monarch-update-stay-awake <start|stop>' >&2; exit 2 ;;
esac
script=$(readlink -e -- "${BASH_SOURCE[0]}") || exit 1
exec /usr/bin/python3 -I "${script%/*}/../default/monarch/update-guards.py" "$@"
