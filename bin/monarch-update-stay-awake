#!/bin/bash

# monarch:summary=Manage sleep and idle inhibition during an update
# monarch:args=<start|stop>
# monarch:hidden=true

set -e

state_dir="${XDG_RUNTIME_DIR:-/tmp/monarch-$UID}/monarch-update-stay-awake"
idle_owner_file="$state_dir/idle-owner"
inhibit_pid_file="$state_dir/inhibit-pid"
stay_awake_state="${XDG_RUNTIME_DIR:-/run/user/$UID}/monarch/caffeine"
active_inhibit_pid=""
active_inhibit_start_time=""

process_start_time() {
  local process_pid="$1"
  local process_stat=""
  local stat_fields=()

  [[ -r /proc/$process_pid/stat ]] || return 1
  process_stat=$(</proc/"$process_pid"/stat)
  process_stat="${process_stat##*) }"
  read -r -a stat_fields <<<"$process_stat"
  (( ${#stat_fields[@]} > 19 )) || return 1
  printf '%s\n' "${stat_fields[19]}"
}

process_state() {
  local process_pid="$1"
  local process_stat=""

  [[ -r /proc/$process_pid/stat ]] || return 1
  process_stat=$(</proc/"$process_pid"/stat)
  process_stat="${process_stat##*) }"
  printf '%s\n' "${process_stat%% *}"
}

stop() {
  local inhibit_pid=""
  local recorded_start_time=""
  local current_start_time=""
  local idle_owner=""
  local current_idle_owner=""

  if [[ -s $idle_owner_file ]]; then
    idle_owner=$(<"$idle_owner_file")
    if [[ -f $stay_awake_state ]]; then
      current_idle_owner=$(<"$stay_awake_state")
    fi
    if [[ -n $idle_owner && $current_idle_owner == $idle_owner ]]; then
      monarch-toggle-idle release "$idle_owner" >/dev/null 2>&1 || true
    fi
    rm -f "$idle_owner_file"
  fi

  if [[ -n $active_inhibit_pid ]]; then
    inhibit_pid="$active_inhibit_pid"
    recorded_start_time="$active_inhibit_start_time"
  elif [[ -s $inhibit_pid_file ]]; then
    read -r inhibit_pid recorded_start_time <"$inhibit_pid_file" || true
  fi

  if [[ -n $inhibit_pid ]]; then
    if [[ $inhibit_pid =~ ^[0-9]+$ ]]; then
      current_start_time=$(process_start_time "$inhibit_pid" 2>/dev/null || true)
    fi
    [[ -n $recorded_start_time ]] || recorded_start_time="$current_start_time"
    if [[ -n $recorded_start_time && $current_start_time == $recorded_start_time ]]; then
      kill "$inhibit_pid" >/dev/null 2>&1 || true

      for (( attempt = 0; attempt < 50; attempt++ )); do
        current_start_time=$(process_start_time "$inhibit_pid" 2>/dev/null || true)
        [[ $current_start_time == $recorded_start_time ]] || break
        [[ $(process_state "$inhibit_pid" 2>/dev/null || true) != "Z" ]] || break
        sleep 0.02
      done

      current_start_time=$(process_start_time "$inhibit_pid" 2>/dev/null || true)
      if [[ $current_start_time == $recorded_start_time ]] &&
        [[ $(process_state "$inhibit_pid" 2>/dev/null || true) != "Z" ]]; then
        echo "Failed to stop the Monarch update sleep inhibitor." >&2
        return 1
      fi
    fi
    rm -f "$inhibit_pid_file"
  fi

  active_inhibit_pid=""
  active_inhibit_start_time=""

  rmdir "$state_dir" 2>/dev/null || true
}

start() {
  local inhibit_pid=""
  local inhibit_start_time=""
  local inhibit_runner=()
  local idle_owner="$$:$RANDOM:$RANDOM"

  stop
  mkdir -p "$state_dir"
  trap 'stop; exit 130' INT
  trap 'stop; exit 143' TERM

  if monarch-cmd-present systemd-inhibit; then
    if (( EUID != 0 )); then
      if [[ -t 0 ]]; then
        sudo -v
        inhibit_runner=(sudo)
      else
        inhibit_runner=(pkexec)
      fi
    fi

    "${inhibit_runner[@]}" systemd-inhibit \
      --what=sleep:idle \
      --who=monarch-update \
      --why="Monarch update in progress" \
      --mode=block \
      sleep infinity >/dev/null 2>&1 &
    inhibit_pid=$!
    active_inhibit_pid="$inhibit_pid"
    inhibit_start_time=$(process_start_time "$inhibit_pid" 2>/dev/null || true)
    if [[ -n $inhibit_start_time ]]; then
      active_inhibit_start_time="$inhibit_start_time"
      printf '%s %s\n' "$inhibit_pid" "$inhibit_start_time" >"$inhibit_pid_file"
    else
      kill "$inhibit_pid" >/dev/null 2>&1 || true
      echo "Could not start the Monarch update sleep inhibitor." >&2
      return 1
    fi
  fi

  if [[ ! -f $stay_awake_state ]]; then
    printf '%s\n' "$idle_owner" >"$idle_owner_file"
    if ! monarch-toggle-idle claim "$idle_owner" >/dev/null 2>&1; then
      rm -f "$idle_owner_file"
    fi
  fi

  trap - INT TERM
}

case "${1:-}" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  *)
    echo "Usage: monarch-update-stay-awake <start|stop>" >&2
    exit 2
    ;;
esac
