#!/bin/bash

# monarch:summary=Apply Monarch system setup in the installed target
# monarch:group=apply
# monarch:requires-sudo=true
# monarch:examples=monarch apply system --install-user dhh --first-install
# monarch:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: monarch apply system --install-user USER [--first-install|--upgrade]
       monarch apply system --defer-provisioning --first-install

Runs root-owned Monarch system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
monarch-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/monarch/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${MONARCH_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: monarch-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export MONARCH_INSTALL_USER="$install_user"
export MONARCH_FIRST_INSTALL="$first_install"
export MONARCH_UPGRADE="$upgrade"
export MONARCH_PATH="${MONARCH_PATH:-/usr/share/monarch}"
export MONARCH_INSTALL="${MONARCH_INSTALL:-$MONARCH_PATH/install}"
export MONARCH_INSTALL_LOG_FILE="${MONARCH_INSTALL_LOG_FILE:-/var/log/monarch-install.log}"
export PATH="$MONARCH_PATH/bin:$PATH"

source "$MONARCH_INSTALL/helpers/logging.sh"
start_install_log

source "$MONARCH_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  monarch-apply-hardware --defer-provisioning
else
  monarch-apply-hardware --install-user "$install_user"
fi

source "$MONARCH_INSTALL/login/all.sh"
source "$MONARCH_INSTALL/post-install/all.sh"

stop_install_log
