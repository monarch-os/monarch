#!/bin/bash

# Toggle microphone mute. Dell XPS and ThinkPad systems get special handling for the hardware LED.

if monarch-hw-match "XPS"; then
  monarch-cmd-mic-mute-xps
elif monarch-hw-match "ThinkPad"; then
  monarch-cmd-mic-mute-thinkpad
else
  monarch-swayosd-client --input-volume mute-toggle
fi
