#!/bin/bash

# monarch:summary=Restore the default Monarch Plymouth boot theme and SDDM login screen
# monarch:requires-sudo=true

set -euo pipefail

MONARCH_ROOT="${MONARCH_PATH:-/usr/share/monarch}"

"$MONARCH_ROOT/bin/monarch-refresh-plymouth"
"$MONARCH_ROOT/bin/monarch-refresh-sddm"

mkdir -p "$HOME/.local/state/monarch"
printf '%s\n' default >"$HOME/.local/state/monarch/unlock-theme"
