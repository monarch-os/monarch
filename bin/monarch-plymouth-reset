#!/bin/bash

# monarch:summary=Restore the default Monarch Plymouth boot theme and SDDM login screen
# monarch:requires-sudo=true

theme_dir="/usr/share/plymouth/themes/monarch"

sudo find ~/.local/share/monarch/default/plymouth -maxdepth 1 -type f -exec cp -t "$theme_dir/" {} +
sudo plymouth-set-default-theme monarch

if monarch-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi

monarch-refresh-sddm
