#!/bin/bash

# monarch:summary=Restore the default Monarch Plymouth boot theme and SDDM login screen
# monarch:requires-sudo=true

theme_dir="/usr/share/plymouth/themes/monarch"

sudo find "${MONARCH_PATH:-/usr/share/monarch}/default/plymouth" -maxdepth 1 -type f -exec cp -t "$theme_dir/" {} +
sudo plymouth-set-default-theme monarch

if monarch-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio || exit 1
else
  sudo mkinitcpio -P || exit 1
fi

monarch-refresh-sddm || exit 1

mkdir -p "$HOME/.local/state/monarch"
printf '%s\n' default >"$HOME/.local/state/monarch/unlock-theme"
