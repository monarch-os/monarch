#!/bin/bash

# monarch:summary=Set and remember the power profile, per power source
# monarch:group=powerprofiles
# monarch:args=[autodetect|ac|battery] [power-saver|balanced|performance]
# monarch:examples=monarch powerprofiles set | monarch powerprofiles set battery power-saver

# The profile is remembered against the source it was chosen under, so plugging
# in restores what you last picked on mains and unplugging restores what you
# last picked on battery. Called with no argument it restores rather than
# chooses, which is what makes it the right thing to run at login and on every
# transition.

set -uo pipefail

STATE_DIR=${MONARCH_POWERPROFILES_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/monarch/powerprofiles}

usage() {
  echo "Usage: monarch-powerprofiles-set [autodetect|ac|battery] [power-saver|balanced|performance]" >&2
  exit 2
}

(($# <= 2)) || usage

source=${1:-autodetect}
requested=${2:-}

if [[ $source == autodetect ]]; then
  # The same signal the widget reads, so every entry point agrees on which key
  # it is saving under.
  if [[ $(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower \
      org.freedesktop.UPower OnBattery 2>/dev/null) == "b true" ]]; then
    source=battery
  else
    source=ac
  fi
fi

[[ $source == ac || $source == battery ]] || usage

mapfile -t profiles < <(monarch-powerprofiles-list)
((${#profiles[@]})) || {
  echo "Error: power-profiles-daemon offers no profiles." >&2
  exit 1
}

available() {
  [[ " ${profiles[*]} " == *" $1 "* ]]
}

state_file="$STATE_DIR/$source"
profile=""

if [[ -n $requested ]]; then
  available "$requested" || {
    echo "Error: power profile is not available: $requested" >&2
    exit 1
  }
  profile=$requested
elif [[ -r $state_file ]]; then
  profile=$(<"$state_file")
fi

# Nothing remembered, or a profile this machine stopped offering: mains gets the
# fastest profile it has, battery the middle one.
if [[ -z $profile ]] || ! available "$profile"; then
  if [[ $source == ac ]] && available performance; then
    profile=performance
  else
    profile=balanced
  fi
fi

powerprofilesctl set "$profile" || exit 1

# Only an explicit choice is remembered. Writing back the restored one too would
# turn every transition into a save and quietly erase the other source's pick
# the first time the fallback stood in for it.
if [[ -n $requested ]]; then
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$requested" >"$state_file"
fi
