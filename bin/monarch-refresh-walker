#!/bin/bash

# monarch:summary=Overwrite the user configs for the Walker application launcher (which also powers the monarch Menu) and restart the services.

mkdir -p ~/.config/autostart/
cp $MONARCH_PATH/default/walker/walker.desktop ~/.config/autostart/

# And restarts if it crashes or is killed
mkdir -p ~/.config/systemd/user/app-walker@autostart.service.d/
cp $MONARCH_PATH/default/walker/restart.conf ~/.config/systemd/user/app-walker@autostart.service.d/restart.conf

systemctl --user daemon-reload

# Refresh configs
monarch-refresh-config walker/config.toml
monarch-refresh-config elephant/calc.toml
monarch-refresh-config elephant/desktopapplications.toml
monarch-refresh-config elephant/websearch.toml

# Link all elephant menus
mkdir -p ~/.config/elephant/menus
for menu in $MONARCH_PATH/default/elephant/*.lua; do
  ln -snf "$menu" ~/.config/elephant/menus/"$(basename "$menu")"
done

# Restart service
monarch-restart-walker
