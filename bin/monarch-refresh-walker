#!/bin/bash

# Overwrite the user configs for the Walker application launcher (which also powers the Monarch Menu) and restart the services.

# Ensure walker is set to autostart
mkdir -p ~/.config/autostart/
cp $MONARCH_PATH/default/walker/walker.desktop ~/.config/autostart/
systemctl --user daemon-reload

monarch-refresh-config walker/config.toml
monarch-refresh-config elephant/calc.toml
monarch-refresh-config elephant/desktopapplications.toml
monarch-refresh-config elephant/websearch.toml
monarch-restart-walker
