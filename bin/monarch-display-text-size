#!/bin/bash

# monarch:summary=Scale text everywhere at once — the Noctalia shell, GTK apps and the terminal
# monarch:group=display
# monarch:args=[percent|reset|--list|--current]
# monarch:examples=monarch display text-size | monarch display text-size 115 | monarch display text-size reset

# One knob for apparent text size, driving four settings in lockstep from a
# percentage of the Monarch default:
#   • panels, OSDs, notifications, the lock screen  [accessibility] ui_scale
#   • the bar                                       [bar.<name>] scale
#   • GTK and GNOME apps                            text-scaling-factor
#   • the terminal                                  alacritty [font] size, off 9
#
# The bar needs its own key, and needing it was measured rather than assumed:
# ui_scale reaches the panels, the OSD, the toasts, the lock screen and the
# desktop widgets, and nothing in the bar — a shell restarted with ui_scale at
# 1.4 drew exactly the same clock.
#
# Neither override is written into a file Monarch ships, because
# monarch-refresh-config replaces those wholesale. Noctalia merges every .toml
# in its config dir in sorted order, so a sibling file later in the alphabet
# wins; alacritty loads its imports before the importing file, so its size is
# shipped in the import rather than in alacritty.toml, which no longer sets it.
#
# The step is 5 because Noctalia clamps ui_scale to a 0.05 grid between 0.5 and
# 2.5; anything off that grid is rounded by the shell and the three would drift
# apart.

set -uo pipefail

# Noctalia's PATH is /usr/local/sbin:/usr/local/bin:/usr/bin — Monarch's bin is
# not on it, so a sibling called by name is simply not found when the shell runs
# this. Appended and not prepended: this only adds a fallback, and never takes a
# command away from a caller that put its own ahead of ours.
PATH="$PATH:$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"

MIN=75
MAX=175
STEP=5
# Monarch's shipped alacritty size, the anchor the terminal scales from.
TERMINAL_BASE=9

NOCTALIA_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/config.toml"
NOCTALIA_OVERRIDE="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/monarch-text-size.toml"
ALACRITTY_OVERRIDE="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty/monarch-text-size.toml"
GKEY_SCHEMA="org.gnome.desktop.interface"
GKEY_NAME="text-scaling-factor"

usage() {
  echo "Usage: monarch-display-text-size [percent|reset|--list|--current]" >&2
  echo "  (no argument)  print the current size and what it drives" >&2
  echo "  <percent>      $MIN-$MAX, in steps of $STEP; 100 is the Monarch default" >&2
  echo "  reset          back to 100" >&2
  echo "  --list         every size that can be picked, for the menu" >&2
  echo "  --current      just the current one, for the menu's checkmark" >&2
  exit 2
}

# The bars declared in [bar] order, falling back to the one Monarch ships.
bar_names() {
  local names
  names=$(awk '
    /^[[:space:]]*\[/ { in_bar = ($0 ~ /^[[:space:]]*\[bar\][[:space:]]*$/); next }
    in_bar && /^[[:space:]]*order[[:space:]]*=/ {
      gsub(/.*=|[][",]/, "")
      print
      exit
    }
  ' "$NOCTALIA_CONFIG" 2>/dev/null)
  printf '%s\n' "${names:-default}"
}

current_percent() {
  local scale
  scale=$(awk -F= '/^[[:space:]]*ui_scale[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' \
    "$NOCTALIA_OVERRIDE" 2>/dev/null)
  # Rounded, not truncated: %d on 1.15 * 100 reads back 114, because the
  # product is 114.999… in binary floating point.
  awk -v s="${scale:-1}" 'BEGIN { printf "%d", int(s * 100 + 0.5) }'
}

write_percent() {
  local percent=$1
  local scale terminal
  scale=$(awk -v p="$percent" 'BEGIN { printf "%.2f", p / 100 }')
  terminal=$(awk -v p="$percent" -v b="$TERMINAL_BASE" 'BEGIN { printf "%.1f", b * p / 100 }')

  mkdir -p "$(dirname "$NOCTALIA_OVERRIDE")" "$(dirname "$ALACRITTY_OVERRIDE")"

  {
    cat <<EOF
# GENERATED by monarch-display-text-size. Do not edit — it is rewritten whole.
# Noctalia merges every .toml in this directory in sorted order, so this one
# wins over config.toml and survives monarch-refresh-noctalia.
[accessibility]
ui_scale = $scale
EOF
    # Every bar the user declared, not just the one Monarch ships: a second bar
    # left at 1.0 beside a scaled one is worse than not scaling at all.
    local bar
    for bar in $(bar_names); do
      printf '\n[bar.%s]\nscale = %s\n' "$bar" "$scale"
    done
  } >"$NOCTALIA_OVERRIDE"

  cat >"$ALACRITTY_OVERRIDE" <<EOF
# GENERATED by monarch-display-text-size. Do not edit — it is rewritten whole.
# Imported by alacritty.toml, which deliberately sets no font size of its own:
# alacritty loads imports first and lets the importing file win.
[font]
size = $terminal
EOF

  # gsettings is absent on a machine with no GTK stack; the other two still hold.
  if monarch-cmd-present gsettings; then
    gsettings set "$GKEY_SCHEMA" "$GKEY_NAME" "$scale" 2>/dev/null || true
  fi
}

case "${1:-}" in
  "")
    percent=$(current_percent)
    printf 'percent\t%s\n' "$percent"
    printf 'ui_scale\t%s\n' "$(awk -v p="$percent" 'BEGIN { printf "%.2f", p / 100 }')"
    printf 'gtk\t%s\n' "$(gsettings get "$GKEY_SCHEMA" "$GKEY_NAME" 2>/dev/null || echo "")"
    printf 'terminal\t%s\n' "$(awk -v p="$percent" -v b="$TERMINAL_BASE" 'BEGIN { printf "%.1f", b * p / 100 }')"
    exit 0
    ;;
  --list)
    for ((percent = MIN; percent <= MAX; percent += STEP)); do
      printf '%d%%\n' "$percent"
    done
    exit 0
    ;;
  --current)
    printf '%d%%\n' "$(current_percent)"
    exit 0
    ;;
  reset) percent=100 ;;
  # The menu's rows carry the % they are labelled with, and it comes straight
  # back as the argument.
  *) percent=${1%\%} ;;
esac

if [[ $percent == *[!0-9]* || -z $percent ]]; then
  usage
fi

if ((percent < MIN || percent > MAX || percent % STEP != 0)); then
  echo "Error: size must be $MIN-$MAX in steps of $STEP: $percent" >&2
  exit 1
fi

write_percent "$percent"
echo "Text size set to ${percent}%."
