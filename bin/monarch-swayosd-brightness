#!/bin/bash

# monarch:summary=Display brightness level using SwayOSD on the current monitor.
# monarch:args=<0-100>
# monarch:examples=monarch swayosd brightness 0 | monarch swayosd brightness 50 | monarch swayosd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

monarch-swayosd-client \
  --custom-icon display-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "${percent}%"
