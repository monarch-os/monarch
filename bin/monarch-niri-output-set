#!/bin/bash

# monarch:summary=Persist one output property where whatever owns the outputs will keep it
# monarch:group=niri
# monarch:args=<name> scale <value> | <name> power <on|off>
# monarch:hidden=true

# There can only be one owner of an output's scale, and on a Monarch desktop
# there may be two candidates.
#
# nwg-displays writes ~/.config/niri/monitor.kdl and puts `include "monitor.kdl"`
# at the very top of config.kdl. Monarch's own runtime.kdl is included further
# down, so it wins on every key both set — which silently undid whatever scale
# the user had arranged over there. Writing into monitor.kdl instead leaves one
# owner and no argument.
#
# That works because nwg-displays reads the live compositor rather than its own
# file: `niri msg -j outputs`. A scale applied here is what it sees when it next
# opens, and what it writes back when the user saves a new arrangement. Without
# that the swap would be a one-way trip.
#
# With no monitor.kdl there is nothing to defer to, and runtime.kdl is the owner
# as before — a file whose header says "Generated by nwg-displays" is not ours
# to invent.

set -uo pipefail

PATH="$PATH:$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"

NIRI_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
MONITORS="$NIRI_DIR/monitor.kdl"

name=${1:-}
property=${2:-}
value=${3:-}

if [[ -z $name || -z $property || -z $value ]]; then
  echo "Usage: monarch-niri-output-set <name> scale <value> | <name> power <on|off>" >&2
  exit 2
fi

case "$property" in
  scale | power) ;;
  *)
    echo "Error: unknown property: $property" >&2
    exit 2
    ;;
esac

# No file to defer to, or no block for this output in it: runtime.kdl owns it.
if [[ ! -f $MONITORS ]] || ! grep -qF "output \"$name\" {" "$MONITORS"; then
  if [[ $property == scale ]]; then
    exec monarch-niri-runtime output-scale "$name" "$value"
  fi
  exec monarch-niri-runtime output "$name" "$value"
fi

tmp=$(mktemp "$MONITORS.XXXXXX") || exit 1

# `off` is added to the block and never replaces it. nwg-displays writes a bare
# `output "X" { off }` for an inactive screen, dropping its mode, scale and
# position — so turning one off from Monarch would erase where it sat, and
# turning it back on would land it wherever niri felt like. niri takes `off`
# alongside the rest and the rest simply sleeps.
awk -v name="$name" -v property="$property" -v value="$value" '
  BEGIN { inside = 0; wrote = 0 }

  $0 ~ "^output \"" name "\" \\{" { inside = 1; wrote = 0; print; next }

  inside && /^[[:space:]]*\}/ {
    if (property == "scale" && !wrote) {
      print "    scale " value
    }
    if (property == "power" && value == "off" && !wrote) {
      print "    off"
    }
    inside = 0
    print
    next
  }

  inside && property == "scale" && /^[[:space:]]*scale[[:space:]]/ {
    print "    scale " value
    wrote = 1
    next
  }

  inside && property == "power" && /^[[:space:]]*off[[:space:]]*$/ {
    if (value == "off") {
      print "    off"
      wrote = 1
    }
    next
  }

  { print }
' "$MONITORS" >"$tmp" || { rm -f "$tmp"; exit 1; }

# Atomic, and carrying the original mode: nwg-displays rewrites this file whole
# on every save, and half of one left behind by a failed write would take the
# user's whole arrangement with it.
chmod --reference="$MONITORS" "$tmp" 2>/dev/null || true
mv -f "$tmp" "$MONITORS"

# niri watches its includes, but nudge it so the change feels immediate and
# lands even if the watcher missed the write.
if pgrep -x niri >/dev/null 2>&1; then
  niri msg action reload-config >/dev/null 2>&1 || true
fi

[[ $property == power ]] && echo "$value"
exit 0
