#!/bin/bash

# monarch:summary=Check available Monarch or system package updates
# monarch:args=[--all] [--json]
# monarch:examples=monarch update available | monarch update available --all --json

set -euo pipefail

all=false
json=false
for argument in "$@"; do
  case "$argument" in
    --all) all=true ;;
    --json) json=true ;;
    -h|--help) echo "Usage: monarch-update-available [--all] [--json]"; exit 0 ;;
    *) echo "Unknown option: $argument" >&2; exit 2 ;;
  esac
done
scope="monarch"
[[ $all == "false" ]] || scope="all"

if [[ $json == "false" ]]; then
  source "$("$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/monarch-i18n" --helper)"
  monarch_i18n_load
fi

fail_check() {
  if [[ $json == "true" ]]; then
    jq -cn --arg reason "$1" --arg scope "$scope" \
      '{status:"error",scope:$scope,count:null,reason:$reason}'
  else
    monarch_message 'update.checkFailed' >&2
  fi
  exit 2
}

monarch-cmd-missing checkupdates fakeroot && fail_check "missing-dependencies"
db=$(mktemp -d) || fail_check "temporary-database"
trap 'rm -rf -- "$db"' EXIT

code=0
updates=$(LC_ALL=C CHECKUPDATES_DB="$db" timeout --kill-after=5s 120s checkupdates --nocolor) || code=$?
case $code in
  0) ;;
  2) [[ -z $updates ]] || fail_check "invalid-repository-result" ;;
  *) fail_check "repositories-unavailable" ;;
esac

aur_updates=""
aur_error=""
if [[ $all == "true" ]]; then
  # Classify foreign packages against the freshly synchronized temporary DB.
  # A new installation may not have any system sync databases yet.
  code=0
  foreign=$(pacman --dbpath "$db" -Qqm 2>"$db/foreign.err") || code=$?
  if (( code != 0 )); then
    (( code == 1 )) && [[ -z $foreign && ! -s $db/foreign.err ]] || fail_check "installed-packages-unavailable"
  fi
  if [[ -n $foreign ]]; then
    if monarch-cmd-missing yay; then
      aur_error="missing-aur-helper"
    else
      code=0
      # Match the updater's exclusions. yay returns 1 with no output when no
      # upgrades are found. Preserve repository results when this portion fails.
      aur_updates=$(LC_ALL=C timeout --kill-after=5s 120s yay --dbpath "$db" -Qua \
        --color never --ignore gcc14,gcc14-libs 2>"$db/aur.err") || code=$?
      if (( code != 0 )); then
        (( code == 1 )) && [[ -z $aur_updates && ! -s $db/aur.err ]] || aur_error="aur-unavailable"
      fi
    fi
  fi
fi

package_rows() {
  local package installed arrow available extra category
  # yay 13 appends FormatAgeTag's duration to AUR upgrades (with colors off).
  # It is display metadata, not part of the version. Negative minutes can occur
  # when the package timestamp is ahead of the local clock.
  local age_pattern='^\[([0-9]+d([0-9]+h)?|[0-9]+h([0-9]+m)?|-?[0-9]+m)\]$'
  while read -r package installed arrow available extra; do
    [[ -n $package ]] || continue
    [[ $all == "true" || $package == "monarch" ]] || continue
    [[ -n $installed && $arrow == "->" && -n $available ]] || return 1
    [[ -z $extra || ( $2 == "aur" && $extra =~ $age_pattern ) ]] || return 1
    category=$2
    if [[ $category == "repo" && $package == "monarch" ]]; then
      category="monarch"
    fi
    printf '%s\t%s\t%s\t%s\n' "$package" "$category" "$installed" "$available"
  done <<< "$1"
}

package_rows "$updates" repo > "$db/updates.tsv" || fail_check "invalid-repository-result"
if [[ -z $aur_error ]]; then
  # Stage separately: malformed AUR output must not publish a valid-looking
  # prefix, nor discard the repository upgrades that were already verified.
  if package_rows "$aur_updates" aur > "$db/aur.tsv"; then
    cat "$db/aur.tsv" >> "$db/updates.tsv"
  else
    aur_error="invalid-aur-result"
  fi
fi
result=$(jq -Rn --arg scope "$scope" --arg aur_error "$aur_error" '
  [inputs | split("\t") | {name:.[0],category:.[1],installed:.[2],available:.[3]}] |
  {status:(if length > 0 then "available" elif $aur_error != "" then "error" else "current" end),scope:$scope,
   count:(if length == 0 and $aur_error != "" then null else length end),packages:.,
   complete:($aur_error == ""),
   warnings:(if $aur_error == "" then [] else [{source:"aur",reason:$aur_error}] end),
   repositories:([.[] | select(.category != "aur")] | length),
   aur:(if $aur_error != "" then null else [.[] | select(.category == "aur")] | length end),
   counts:{monarch:([.[] | select(.category == "monarch")] | length),
           repo:([.[] | select(.category == "repo")] | length),
           aur:(if $aur_error != "" then null else [.[] | select(.category == "aur")] | length end)}} +
  (if length == 0 and $aur_error != "" then {reason:$aur_error} else {} end)
' < "$db/updates.tsv")
count=$(jq -r '.count // 0' <<< "$result")

if [[ $json == "true" ]]; then
  printf '%s\n' "$result"
elif [[ -n $aur_error ]]; then
  monarch_message 'update.aurCheckFailed' >&2
  if (( count > 0 )); then monarch_message 'update.availableAtLeast' "$count"; else monarch_message 'update.checkFailed' >&2; fi
elif (( count == 0 )); then
  if [[ $all == "true" ]]; then monarch_message 'update.current'; else monarch_message 'update.monarchCurrent'; fi
elif [[ $all == "true" ]]; then
  monarch_message 'update.availableCount' "$count"
else
  installed=$(jq -r '.packages[0].installed' <<< "$result")
  available=$(jq -r '.packages[0].available' <<< "$result")
  monarch_message 'update.monarchAvailable' "$installed" "$available"
fi

(( count > 0 )) && exit 0
[[ -z $aur_error ]] || exit 2
exit 1
