#!/bin/bash

# monarch:summary=Check whether a newer Monarch package is available

set -euo pipefail

if monarch-cmd-missing checkupdates fakeroot; then
  echo "Cannot check updates: pacman-contrib and fakeroot are required." >&2
  exit 2
fi

db=$(mktemp -d) || { echo "Cannot create the update-check database." >&2; exit 2; }
trap 'rm -rf -- "$db"' EXIT

status=0
updates=$(LC_ALL=C CHECKUPDATES_DB="$db" timeout --kill-after=5s 120s checkupdates --nocolor) || status=$?
case $status in
  0) ;;
  2)
    echo "No Monarch package update available."
    exit 1
    ;;
  *)
    echo "Could not check available package updates." >&2
    exit 2
    ;;
esac

while read -r package installed arrow available; do
  [[ $package == "monarch" ]] || continue
  if [[ $arrow != "->" || -z $installed || -z $available ]]; then
    echo "Invalid Monarch update information." >&2
    exit 2
  fi
  printf 'Monarch update available (%s -> %s)\n' "$installed" "$available"
  exit 0
done <<<"$updates"

echo "No Monarch package update available."
exit 1
