#!/bin/bash

# monarch:summary=Remove all web apps installed via monarch-webapp-install
# monarch:args=[application-subdirectory]

set -e
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../install/helpers/webapps.sh"
(( $# <= 1 )) || { webapp_error 'Expected at most one application subdirectory.'; exit 1; }
webapp_paths
webapp_index "${1:-$WEBAPP_DIR}"

webapp_remove_files "${WEBAPP_FILES[@]}"

if monarch-cmd-present update-desktop-database && [[ -d $WEBAPP_DIR ]]; then
  update-desktop-database "$WEBAPP_DIR" &>/dev/null || true
fi
