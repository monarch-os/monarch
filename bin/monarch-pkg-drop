#!/bin/bash

# monarch:summary=Remove all the named packages from the system if they're installed (otherwise ignore).
# monarch:args=[--keep-dependencies|--cascade] <packages...>
# monarch:requires-sudo=true

# --cascade also removes any installed package that depends on the targets, so a
# removal can't be blocked by an unexpected dependent (e.g. an AUR package built
# against one of the targets).
remove=(-Rns)
extra=()
if [[ ${1:-} == "--keep-dependencies" ]]; then
  remove=(-R)
  shift
fi
if [[ ${1:-} == "--cascade" ]]; then
  extra+=(--cascade)
  shift
fi

installed=()
for pkg in "$@"; do
  if pacman -Qq | grep -Fxq "$pkg"; then
    installed+=("$pkg")
  fi
done

if (( ${#installed[@]} > 0 )); then
  sudo pacman "${remove[@]}" --noconfirm "${extra[@]}" "${installed[@]}"
fi
