#!/bin/bash

set -e

if [ "$EUID" -eq 0 ]; then
  echo "Error: This script should not be run as root"
  exit 1
fi

echo -e "This will reinstall all the default Monarch packages and reset all default configs.\nWarning: All changes to configs will be lost.\n"

if gum confirm "Are you sure you want to reinstall and lose all config changes?"; then
  echo "Resetting Monarch repository"
  git clone "https://github.com/monarch-os/monarch.git" ~/.local/share/monarch-new >/dev/null
  rm -rf $MONARCH_PATH
  mv ~/.local/share/monarch-new $MONARCH_PATH

  echo "Reinstalling missing Monarch packages"
  mapfile -t packages < <(grep -v '^#' "$MONARCH_PATH/install/monarch-base.packages" | grep -v '^$')
  sudo pacman -Syu --noconfirm --needed "${packages[@]}"

  echo "Resetting all Monarch configs"
  cp -R ~/.local/share/monarch/config/* ~/.config/
  cp ~/.local/share/monarch/default/bashrc ~/.bashrc
  cp ~/.local/share/monarch/default/zshrc ~/.zshrc
  echo '[[ -f ~/.bashrc ]] && . ~/.bashrc' | tee ~/.bash_profile >/dev/null

  $(bash $MONARCH_PATH/install/config/theme.sh)
  $(bash $MONARCH_PATH/install/config/git.sh)

  monarch-refresh-limine
  monarch-refresh-plymouth
  monarch-nvim-setup
fi