#!/bin/bash

# monarch:summary=Measure live internet speed for one direction
# monarch:group=network
# monarch:args=[down|up] [seconds]
# monarch:examples=monarch network speedtest down | monarch network speedtest up 20

# Prints one Mbps sample per second on stdout and stops on its own. Port of
# omarchy-network-speedtest, which streams until its caller kills it: Noctalia's
# runStream hands back no handle to stop with, so the duration is the command's
# to own. A test that ends by itself is the better shape anyway.
#
# The rate is read off the interface counters rather than from curl, so it
# measures the link and not one connection's share of it.

set -uo pipefail

direction=${1:-}
seconds=${2:-10}
probe=${MONARCH_NETWORK_PROBE:-1.1.1.1}
parallel=8
url_count=3

case "$direction" in
  down | up) ;;
  *)
    echo "Usage: monarch-network-speedtest [down|up] [seconds]" >&2
    exit 2
    ;;
esac

if [[ ! $seconds =~ ^[0-9]+$ ]] || ((seconds < 1)); then
  echo "Error: seconds must be a positive integer." >&2
  exit 2
fi

format_mbps() {
  awk -v value="$1" 'BEGIN {
    if (value <= 0) print "0.0"
    else if (value < 10) printf "%.1f\n", value
    else printf "%.0f\n", value
  }'
}

iface=$(ip route get "$probe" 2>/dev/null |
  awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')

if [[ -z $iface || ! -r /sys/class/net/$iface/statistics/rx_bytes ]]; then
  echo "No active network interface" >&2
  exit 1
fi

monarch-cmd-present curl || { echo "curl is required" >&2; exit 1; }
monarch-cmd-present jq || { echo "jq is required" >&2; exit 1; }

fast_token="YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm"
fast_urls=$(curl -fsS "https://api.fast.com/netflix/speedtest/v2?https=true&token=$fast_token&urlCount=$url_count" 2>/dev/null |
  jq -r '.targets[]?.url // empty')

if [[ -z $fast_urls ]]; then
  echo "Failed to fetch speed test endpoints" >&2
  exit 1
fi

traffic_pids=()

cleanup() {
  local pid
  for pid in "${traffic_pids[@]}"; do
    [[ -n $pid ]] || continue
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill "$pid" 2>/dev/null || true
  done
  for pid in "${traffic_pids[@]}"; do
    [[ -n $pid ]] || continue
    wait "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT

# Round-robin across the returned URLs to spread load over Netflix OCA nodes.
traffic_worker() {
  local urls=("$@")
  local count=${#urls[@]}
  local idx=$RANDOM url

  while true; do
    url=${urls[$((idx % count))]}
    if [[ $direction == "down" ]]; then
      curl -fsS -o /dev/null "$url" 2>/dev/null || return
    else
      dd if=/dev/zero bs=1M count=64 2>/dev/null |
        curl -fsS -o /dev/null -X POST --data-binary @- "$url" 2>/dev/null || return
    fi
    idx=$((idx + 1))
  done
}

for ((i = 0; i < parallel; i++)); do
  # Unquoted on purpose: the URL list is newline-separated and each one becomes
  # its own argument.
  # shellcheck disable=SC2086
  traffic_worker $fast_urls &
  traffic_pids+=("$!")
done

counter=rx_bytes
[[ $direction == "up" ]] && counter=tx_bytes
before=$(<"/sys/class/net/$iface/statistics/$counter")

any_alive() {
  local pid
  for pid in "${traffic_pids[@]}"; do
    [[ -n $pid ]] || continue
    kill -0 "$pid" 2>/dev/null && return 0
  done
  return 1
}

for ((elapsed = 0; elapsed < seconds; elapsed++)); do
  any_alive || break
  sleep 1
  after=$(<"/sys/class/net/$iface/statistics/$counter")
  format_mbps "$(awk -v b="$before" -v a="$after" 'BEGIN { print (a < b) ? 0 : (a - b) * 8 / 1000000 }')"
  before=$after
done
