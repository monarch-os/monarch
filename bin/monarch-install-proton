#!/bin/bash

# monarch:summary=Install Proton Suite (VPN, Pass, Mail), enable VPN background service.
# monarch:requires-sudo=true

echo "Installing all dependencies..."
monarch-pkg-add openvpn wireguard-tools

echo "Ensure systemd resolved is started"
sudo systemctl enable --now systemd-resolved

echo "Installing Proton suites..."
monarch-pkg-aur-add proton-vpn-gtk-app proton-pass-bin proton-mail-bin
