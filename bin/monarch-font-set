#!/bin/bash

# monarch:summary=Set the system monospace font
# monarch:args=<font-name>
# monarch:examples=monarch font list | monarch font set "CaskaydiaMono Nerd Font"

if (( $# != 1 )); then
  echo "Usage: monarch-font-set <font-name>" >&2
  exit 1
fi

font_name="$1"
MONARCH_ROOT=${MONARCH_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}
source "$MONARCH_ROOT/install/helpers/fonts.sh" || exit 1
monarch_font_validate_family "$font_name" || exit 1

if ! fc-list | grep -Fqi -- "$font_name"; then
  printf "Font '%s' not found.\n" "$font_name" >&2
  exit 1
fi

font_replacement=$(monarch_font_sed_replacement "$font_name")

if [[ -f ~/.config/alacritty/alacritty.toml ]]; then
  toml_family=${font_name//\"/\\\"}
  toml_replacement=$(monarch_font_sed_replacement "$toml_family")
  sed -Ei "s|family = \"([^\"\\\\]\\|\\\\.)*\"|family = \"$toml_replacement\"|g" ~/.config/alacritty/alacritty.toml || exit 1
fi

if [[ -f ~/.config/kitty/kitty.conf ]]; then
  sed -i "s|^font_family .*|font_family $font_replacement|g" ~/.config/kitty/kitty.conf || exit 1
  pkill -USR1 kitty
fi

if [[ -f ~/.config/ghostty/config ]]; then
  # Ghostty strips the outer quotes without unescaping the value inside them.
  sed -i "s|^font-family = .*|font-family = \"$font_replacement\"|g" ~/.config/ghostty/config || exit 1
  pkill -SIGUSR2 ghostty
fi

if [[ -f ~/.config/foot/foot.ini ]]; then
  foot_family=${font_name//-/\\-}
  foot_replacement=$(monarch_font_sed_replacement "$foot_family")
  sed -i "s|^font=.*|font=$foot_replacement:size=9|g" ~/.config/foot/foot.ini || exit 1
fi

xmlstarlet ed -L \
  -u '//match[@target="pattern"][test/string="monospace"]/edit[@name="family"]/string' \
  -v "$font_name" \
  ~/.config/fontconfig/fonts.conf || exit 1

if pgrep -x ghostty; then
  notify-send -u low "    You must restart Ghostty to see font change"
fi

if pgrep -x foot; then
  notify-send -u low "    You must restart Foot to see font change"
fi

monarch-hook font-set "$font_name"
