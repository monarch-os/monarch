#!/bin/bash

# monarch:summary=Install monarch-todo (a fast TUI/CLI todo manager)

echo "Installing monarch-todo..."
monarch-pkg-add monarch-todo

# The package ships only the binary, so wire the desktop integration here.
# monarch-remove-todo strips every piece added below.

# App-launcher entry. Launches via monarch-launch-tui so the window gets the
# org.monarch.monarch-todo app-id matched by the niri rule added further down.
echo -e "\nAdding 'Todo' to the app launcher..."
DESKTOP_FILE="$HOME/.local/share/applications/Todo.desktop"
cat >"$DESKTOP_FILE" <<'EOF'
[Desktop Entry]
Version=1.0
Name=Todo
Comment=Fast TUI todo manager
Exec=monarch-launch-tui monarch-todo
Terminal=false
Type=Application
Icon=view-task
StartupNotify=true
EOF
chmod +x "$DESKTOP_FILE"

# Niri keybinding (Mod+T) + a fitted floating window-rule, added to the user
# override file inside a marker block so removal is exact. The rule sizes the
# TUI like a compact picker rather than the tall shared terminal float.
USER_KDL="$HOME/.config/niri/user.kdl"
if [[ -f "$USER_KDL" ]] && ! grep -q 'monarch:todo:begin' "$USER_KDL"; then
  echo -e "\nAdding Niri keybinding (Mod+T) and window rule..."
  cat >>"$USER_KDL" <<'EOF'

// monarch:todo:begin
binds {
    Mod+T hotkey-overlay-title="Todo" { spawn "monarch-launch-tui" "monarch-todo"; }
}
window-rule {
    match app-id="org.monarch.monarch-todo"
    open-floating true
    default-column-width { fixed 760; }
    default-window-height { fixed 560; }
}
// monarch:todo:end
EOF
  if pgrep -x niri >/dev/null 2>&1; then
    niri msg action reload-config >/dev/null 2>&1 || true
  fi
fi

# Noctalia bar widget: live open-task count (click opens the TUI). The count
# comes from `monarch-todo bar` (JSON), so no store logic is duplicated here.
# Idempotent: skip if the button already exists. Noctalia hot-reloads.
NOCTALIA_CFG="$HOME/.config/noctalia/settings.json"
if command -v jq >/dev/null && [[ -f "$NOCTALIA_CFG" ]]; then
  if ! jq -e '[.. | objects | select(.textCommand? == "monarch-todo bar")] | length > 0' \
       "$NOCTALIA_CFG" >/dev/null 2>&1; then
    echo -e "\nAdding the Todo widget to the Noctalia bar..."
    tmp=$(mktemp)
    if jq '.bar.widgets.right = (
             (.bar.widgets.right // []) as $w
             | {
                 "id": "CustomButton",
                 "icon": "format-list-checks",
                 "parseJson": true,
                 "hideMode": "expandWithOutput",
                 "textCommand": "monarch-todo bar",
                 "textIntervalMs": 10000,
                 "leftClickExec": "monarch-launch-tui monarch-todo"
               } as $btn
             | ($w | map(.id == "Tray") | index(true)) as $i
             | if $i == null then [$btn] + $w else $w[0:$i+1] + [$btn] + $w[$i+1:] end
           )' \
         "$NOCTALIA_CFG" >"$tmp"; then
      mv "$tmp" "$NOCTALIA_CFG"
    else
      rm -f "$tmp"
      echo "  Warning: could not update $NOCTALIA_CFG; add the widget manually." >&2
    fi
  fi
fi

echo -e "\nmonarch-todo installed!"
echo "  - Launch from app menu: Todo"
echo "  - Keyboard shortcut: WIN+T"
echo "  - Command line (TUI): monarch-todo"
echo "  - Command line (CLI): monarch-todo add|list|done|...; '?' in the TUI for keys"
echo "  - Bar widget: open-task count (shown in the Noctalia bar)"
