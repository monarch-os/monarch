#!/bin/bash

# monarch:summary=Tint the SDDM login logo to the active Noctalia accent (post_hook for [templates.sddm])
# monarch:hidden=true

# Post_hook for the [templates.sddm] Noctalia user-template. The login screen's
# colors follow the scheme via theme.conf (read as config.* in Main.qml), but the
# logo is a fixed PNG — a monochrome crown that otherwise stays brand-violet on
# every scheme. SDDM/Qt can't recolor an image at runtime without extra Qt deps,
# and editing the login QML is risky (a bad import breaks the greeter), so we
# recolor the PNG here instead: magick-tint the shipped master crown to the active
# accent (mPrimary) into the world-writable theme dir. SDDM picks it up next login.

COLORS="$HOME/.config/noctalia/colors.json"
MASTER="${MONARCH_PATH:-$HOME/.local/share/monarch}/default/sddm/monarch/logo.png"
DEST="/usr/share/sddm/themes/monarch/logo.png"

command -v magick >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0
# DEST must exist and be writable by us (monarch-refresh-sddm makes it 666); if not,
# no-op rather than fail — never break the template render or leave a half-state.
[[ -f $COLORS && -f $MASTER && -w $DEST ]] || exit 0

accent=$(jq -r '.mPrimary // empty' "$COLORS")
accent=${accent#\#}
[[ $accent =~ ^[0-9a-fA-F]{6}$ ]] || exit 0

# +level-colors with a single color turns the crown into a solid silhouette of
# that color, preserving alpha. Tinting from the pristine master each time is
# idempotent (no compounding across scheme changes).
magick "$MASTER" -channel RGB +level-colors "#$accent","#$accent" "$DEST" 2>/dev/null || true
