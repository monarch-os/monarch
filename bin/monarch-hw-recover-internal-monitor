#!/bin/bash

# monarch:summary=Re-enable the laptop display if the external monitor is unplugged while it was off
# monarch:hidden=true

# Safety net for monarch-niri-monitor-internal, restored from the Hyprland model
# (this binary + monarch-recover-internal-monitor.service + the
# install/user/first-run/enable-user-units.sh enabler).
#
# The old Hyprland helper was a login-time oneshot that cleared a *persisted*
# toggle file. niri is different: monarch-niri-monitor-internal disables the eDP
# panel with a live `niri msg output <eDP> off` that niri never saves, so a
# reboot already recovers. The real danger is unplugging the external monitor
# mid-session — a hotplug, not a niri reload — which leaves the eDP off with no
# display and which niri does not recover from on its own. So this is a
# long-running watcher rather than a oneshot.
#
# niri-ipc has no OutputsChanged event, so we watch WorkspacesChanged: the
# closest proxy, since workspaces relocate whenever outputs come or go. On each
# one, if the internal eDP panel is off AND no external monitor is connected, we
# turn it back on.

set -uo pipefail

# A niri socket file outlives the session that created it, and connecting to a
# dead one only fails at connect time, so validate the pid its name carries.
socket_live() {
  [[ -S ${1:-} ]] || return 1
  local pid=${1##*/}
  pid=${pid%.sock}
  pid=${pid##*.}
  [[ -r /proc/$pid/comm && $(< "/proc/$pid/comm") == niri ]]
}

# uwsm finalizes NIRI_SOCKET into the systemd user environment, so the service
# normally inherits it; the rest repairs a value a niri restart left stale.
ensure_socket() {
  socket_live "${NIRI_SOCKET:-}" && return 0
  local pid
  pid=$(pgrep -x niri | head -n1)
  [[ -n $pid ]] || return 1
  # Not read from /proc/<pid>/environ: that block is the one the process was
  # exec'd with, and the socket does not exist yet at that point.
  local sock
  sock=$(printf '%s\n' "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/niri.*."$pid".sock | head -n1)
  [[ -S $sock ]] || return 1
  export NIRI_SOCKET="$sock"
}

# Internal panel connector (eDP), read live so a rename can't break us.
internal_output() {
  niri msg --json outputs 2>/dev/null \
    | jq -r 'to_entries[] | select(.key | test("eDP")) | .key' | head -n1
}

recover() {
  local internal=$1
  # current_mode is null while the output is disabled (niri IPC).
  niri msg --json outputs 2>/dev/null \
    | jq -e --arg m "$internal" '.[$m].current_mode == null' >/dev/null || return
  # eDP is off — only rescue it when it is the last display standing.
  monarch-hw-external-monitors && return
  niri msg output "$internal" on >/dev/null 2>&1
  notify-send -u normal "󰍹    Laptop display restored" \
    "External monitor disconnected while the laptop screen was off."
}

# Sourcing stops here: test/monarch-niri-socket-test.sh drives the discovery
# above without entering the watch loop.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

# Reconnect loop: the stream ends when niri restarts; the sleep also guards a
# hot spin while niri (and thus its socket) is not up yet.
while true; do
  if ensure_socket; then
    niri msg --json event-stream 2>/dev/null | while IFS= read -r line; do
      [[ $line == *'"WorkspacesChanged"'* ]] || continue
      internal=$(internal_output)
      [[ -n $internal ]] && recover "$internal"
      # Same unplug event: tear down a display mirror left pointing at a now-gone
      # external output (otherwise wl-mirror strands a hall-of-mirrors on the eDP).
      monarch-niri-monitor-internal-mirror recover
    done
  fi
  sleep 2
done
