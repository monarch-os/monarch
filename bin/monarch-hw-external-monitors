#!/bin/bash

# monarch:summary=Returns true when an external monitor is physically connected.

drm_path="${MONARCH_DRM_PATH:-/sys/class/drm}"

for status in "$drm_path"/card*-*/status; do
  [[ -e $status ]] || continue
  connector=${status%/status}
  connector=${connector##*/}
  connector=${connector#card*-}
  monarch-hw-display-internal "$connector" && continue
  [[ $(<"$status") == "connected" ]] && exit 0
done
exit 1
