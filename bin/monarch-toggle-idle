#!/bin/bash

# monarch:summary=Toggle idle locking (Noctalia caffeine)

# v4 flipped `idle.enabled` in settings.json. v5 has no such switch — inhibiting
# idle is caffeine, and the shell owns it: the toggle raises its own "Caffeine
# On/Off" OSD, so the hand-rolled notify-send this script used to print is gone.
#
# Lid-close lock is handled separately by niri switch-events and is unaffected.

exec noctalia msg caffeine-toggle
