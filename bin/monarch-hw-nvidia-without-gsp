#!/bin/bash

# monarch:summary=Detect whether the computer has an NVIDIA GPU without GSP firmware (Maxwell/Pascal/Volta).

# The supported 580xx range starts at Maxwell and ends before Turing.
pci_devices_path="${MONARCH_PCI_DEVICES_PATH:-/sys/bus/pci/devices}"

shopt -s nullglob

for device in "$pci_devices_path"/*; do
  [[ $(<"$device/vendor") == "0x10de" ]] || continue
  [[ $(<"$device/class") == 0x03* ]] || continue
  device_id=$(<"$device/device")
  (( device_id >= 0x1340 && device_id < 0x1e00 )) && exit 0
done

exit 1
