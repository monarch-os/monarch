#!/bin/bash

# monarch:summary=Set the branch for Monarch's git repository.
# monarch:args=<master|dev>

if (($# == 0)); then
  echo "Usage: monarch-branch-set [master|dev]"
  exit 1
else
  branch="$1"
fi

case "$branch" in
  "master") git -C $MONARCH_PATH switch master ;;
  "dev") git -C $MONARCH_PATH switch dev ;;
  *) echo "Unknown branch: $branch"; exit 1; ;;
esac
