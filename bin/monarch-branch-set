#!/bin/bash

# monarch:summary=Set the branch for Monarch's git repository.
# monarch:args=<main|dev>

if (($# == 0)); then
  echo "Usage: monarch-branch-set [main|dev]"
  exit 1
else
  branch="$1"
fi

case "$branch" in
  "main")
    [[ ! -d $MONARCH_PATH/.git ]] || git -C "$MONARCH_PATH" switch main
    ;;
  "dev")
    if [[ ! -d $MONARCH_PATH/.git ]]; then
      echo "The dev channel requires a Monarch source checkout." >&2
      exit 1
    fi
    git -C "$MONARCH_PATH" switch dev
    ;;
  *) echo "Unknown branch: $branch"; exit 1; ;;
esac
