#!/bin/bash

# monarch:summary=Reload the Herdr config in the running server and attached clients

# herdr reloads config.toml live, without dropping panes. Worth reporting on:
# an invalid config does not fail loudly, it falls back to herdr's built-in
# defaults, so a silent reload looks identical to a working one.

[[ $(herdr status server --json 2>/dev/null | jq -r '.running') == "true" ]] || exit 0

reload=$(herdr server reload-config)

jq -r '.result.diagnostics[]?, (.error.message | select(. != null))' <<<"$reload" >&2

if [[ $(jq -r '.result.status // "failed"' <<<"$reload") == "failed" ]]; then
  exit 1
fi
