#!/bin/bash

# monarch:summary=Remove web app desktop launchers
# monarch:args=[--check | [--] name...]

set -e
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../install/helpers/webapps.sh"
webapp_paths
webapp_index

if [[ ${1:-} == "--check" ]]; then
  (( $# == 1 && ${#WEBAPP_FILES[@]} > 0 ))
  exit
fi
[[ ${1:-} != "--" ]] || shift
if (( $# == 0 )); then
  (( ${#WEBAPP_FILES[@]} )) || { webapp_error 'No web apps to remove.'; exit 1; }
  if APP_NAMES_STRING=$(printf '%s\n' "${WEBAPP_NAMES[@]}" | FZF_DEFAULT_OPTS= FZF_DEFAULT_OPTS_FILE= fzf --multi --no-sort --layout=reverse \
    --header 'Space: select · Enter: remove selected · Esc: cancel' \
    --bind 'space:toggle' \
    --bind 'enter:transform:if [ "$FZF_SELECT_COUNT" -gt 0 ]; then echo accept; else echo "change-header(Select at least one app · Space: select · Esc: cancel)"; fi'); then
    [[ -n $APP_NAMES_STRING ]] || exit 0
  else
    status=$?
    (( status != 130 )) || exit 0
    exit "$status"
  fi
  mapfile -t APP_NAMES <<< "$APP_NAMES_STRING"
else
  APP_NAMES=("$@")
fi

SELECTED_FILES=()
declare -A SELECTED=()
for APP_NAME in "${APP_NAMES[@]}"; do
  MATCHES=()
  for i in "${!WEBAPP_NAMES[@]}"; do
    [[ ${WEBAPP_NAMES[i]} != "$APP_NAME" ]] || MATCHES+=("${WEBAPP_FILES[i]}")
  done
  (( ${#MATCHES[@]} == 1 )) || { webapp_error "Webapp not found or ambiguous: $APP_NAME"; exit 1; }
  [[ ! ${SELECTED[${MATCHES[0]}]+present} ]] || continue
  SELECTED[${MATCHES[0]}]=1
  SELECTED_FILES+=("${MATCHES[0]}")
done

webapp_remove_files "${SELECTED_FILES[@]}"
