#!/bin/bash

# monarch:summary=Check free disk space required for an update
# monarch:hidden=true

set -e

if [[ ${MONARCH_UPDATE_FORCE:-0} == "1" ]]; then
  exit 0
elif read -r available_bytes < <(df --output=avail --block-size=1 / 2>/dev/null | tail -n 1) &&
  [[ $available_bytes =~ ^[0-9]+$ ]] &&
  (( available_bytes < 10 * 1024 * 1024 * 1024 )); then
  echo "You need at least 10 GiB free to safely update Monarch."
  exit 1
fi
