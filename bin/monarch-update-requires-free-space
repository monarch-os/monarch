#!/bin/bash

# monarch:summary=Check free disk space required for an update
# monarch:hidden=true

set -e

if [[ ${MONARCH_UPDATE_FORCE:-0} == "1" ]]; then
  exit 0
fi

if ! read -r available_bytes < <(df --output=avail --block-size=1 / 2>/dev/null | tail -n 1) ||
  [[ ! $available_bytes =~ ^[0-9]+$ ]]; then
  echo "Could not verify free disk space. Retry, or use MONARCH_UPDATE_FORCE=1 to bypass this check." >&2
  exit 1
elif (( available_bytes < 10 * 1024 * 1024 * 1024 )); then
  echo "You need at least 10 GiB free to safely update Monarch."
  exit 1
fi
