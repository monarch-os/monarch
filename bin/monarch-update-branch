#!/bin/bash

# monarch:summary=Switch Monarch branches and update from the selected branch
# monarch:args=<branch>

set -e

if (($# == 0)); then
  echo "Usage: monarch-update-branch [main|dev]"
  exit 1
fi

branch="$1"

# Snapshot before switching branch
monarch-snapshot create || (( $? == 127 ))

if ! git -C "$MONARCH_PATH" diff --quiet || ! git -C "$MONARCH_PATH" diff --cached --quiet; then
  stashed=true
  git -C "$MONARCH_PATH" stash push -u -m "Autostash before switching to $branch"
else
  stashed=false
fi

# Switch branches
git -C "$MONARCH_PATH" switch "$branch"

# Reapply stash if we made one
if [[ $stashed == "true" ]]; then
  if ! git -C "$MONARCH_PATH" stash pop; then
    echo "⚠️ Conflicts when applying stash — stash kept"
  fi
fi

# Update the system from the new branch
monarch-update-perform
