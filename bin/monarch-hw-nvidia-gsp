#!/bin/bash

# monarch:summary=Detect whether the computer has an NVIDIA GPU with GSP firmware (Turing or newer).

# Turing is the first generation at device ID 0x1e00 or above.
pci_devices_path="${MONARCH_PCI_DEVICES_PATH:-/sys/bus/pci/devices}"

shopt -s nullglob

for device in "$pci_devices_path"/*; do
  [[ $(<"$device/vendor") == "0x10de" ]] || continue
  [[ $(<"$device/class") == 0x03* ]] || continue
  (( $(<"$device/device") >= 0x1e00 )) && exit 0
done

exit 1
