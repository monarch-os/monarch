#!/bin/bash

# monarch:summary=Set the Monarch channel, which dictates what git branch is tracked. Packages come from the single Monarch repository.
# monarch:args=<stable|dev>
# monarch:requires-sudo=true


if (($# == 0)); then
  echo "Usage: monarch-channel-set [stable|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") monarch-branch-set "main" && monarch-refresh-pacman ;;
"dev") monarch-branch-set "dev" && monarch-refresh-pacman ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

monarch-update -y
