#!/bin/bash

# monarch:summary=Set the Monarch and Monarch channel, which dictates what git branch and package repository is used.
# monarch:args=<stable|edge|dev>
# monarch:requires-sudo=true


if (($# == 0)); then
  echo "Usage: monarch-channel-set [stable|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") monarch-branch-set "master" && monarch-refresh-pacman "stable" ;;
"edge") monarch-branch-set "master" && monarch-refresh-pacman "edge" && sudo pacman -Suu --noconfirm ;;
"dev") monarch-branch-set "dev" && monarch-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

monarch-update -y
