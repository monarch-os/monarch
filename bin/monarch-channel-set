#!/bin/bash

if (($# == 0)); then
  echo "Usage: monarch-channel-set [stable|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") monarch-branch-set "master" && monarch-refresh-pacman "stable" ;;
"edge") monarch-branch-set "master" && monarch-refresh-pacman "edge" ;;
"dev") monarch-branch-set "dev" && monarch-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac
