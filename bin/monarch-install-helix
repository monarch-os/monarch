#!/bin/bash

# monarch:summary=Install Helix and configure it to follow Noctalia's theme

echo "Installing Helix..."
monarch-pkg-add helix

mkdir -p ~/.config/helix/themes

# Helix theming is delegated to Noctalia's built-in template, which renders
# ~/.config/helix/themes/noctalia.toml on every color generation. Point Helix at
# it; only seed config.toml if the user does not already have one.
if [[ ! -f ~/.config/helix/config.toml ]]; then
  cat >~/.config/helix/config.toml <<'EOF'
theme = "noctalia"
EOF
fi

# Arch-based distros ship Helix as 'helix' rather than the upstream 'hx'.
if ! grep -q '^alias hx="helix"' ~/.bashrc 2>/dev/null; then
  echo 'alias hx="helix"' >>~/.bashrc
fi
