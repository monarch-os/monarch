#!/bin/bash

# monarch:summary=Disable the OpenSSH server, remove standard firewall rules, and optionally remove authorized keys
# monarch:requires-sudo=true

set -e

AUTHORIZED_KEYS="$HOME/.ssh/authorized_keys"

echo -e "\e[32mRemoving SSH server access.\n\e[0m"

echo "Stopping and disabling the OpenSSH server..."
sudo systemctl disable --now sshd.service 2>/dev/null || true

if monarch-cmd-present ufw; then
  echo "Removing standard SSH firewall rules..."
  sudo ufw --force delete limit 22/tcp >/dev/null 2>&1 || true
  sudo ufw --force delete allow 22/tcp >/dev/null 2>&1 || true
  sudo ufw --force delete allow 22 >/dev/null 2>&1 || true
  sudo ufw --force delete allow ssh >/dev/null 2>&1 || true
  sudo ufw --force delete limit ssh >/dev/null 2>&1 || true
  sudo ufw --force delete allow to any app SSH >/dev/null 2>&1 || true
  sudo ufw --force delete limit to any app SSH >/dev/null 2>&1 || true
  sudo ufw reload >/dev/null
  echo "Standard SSH firewall rules removed. Review custom firewall rules separately."
fi

if [[ -s $AUTHORIZED_KEYS ]]; then
  echo
  if gum confirm "Also remove all authorized SSH keys ($AUTHORIZED_KEYS)?"; then
    rm -f "$AUTHORIZED_KEYS"
    echo "Authorized keys removed."
  else
    echo "Keeping authorized keys."
  fi
fi

echo -e "\e[32m\nThe SSH server has been disabled.\e[0m"
echo "The key-only SSH policy remains installed; run monarch setup security sshd before re-enabling the server."
echo "The openssh package remains installed because it also provides the SSH client."
