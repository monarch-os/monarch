#!/bin/bash

# monarch:summary=Reset Noctalia configuration to Monarch defaults, refresh shipped plugins, and reload the shell.
# monarch:examples=monarch refresh noctalia

monarch-refresh-config noctalia/settings.json

# Ensure every Monarch-shipped Noctalia plugin is linked into the user's
# plugin directory AND enabled in plugins.json (Noctalia ships plugins
# disabled by default; we mark our own as explicitly enabled).
plugin_root="$HOME/.config/noctalia/plugins"
plugins_file="$HOME/.config/noctalia/plugins.json"
mkdir -p "$plugin_root"
[[ -f $plugins_file ]] || echo '{"version":2,"states":{},"sources":[]}' >"$plugins_file"

for plugin in "$MONARCH_PATH/config/noctalia/plugins"/*/; do
  [[ -d $plugin ]] || continue
  name=$(basename "$plugin")
  target="$plugin_root/$name"
  if [[ -L $target || ! -e $target ]]; then
    ln -sfn "$plugin" "$target"
  fi
  if command -v jq >/dev/null; then
    tmp=$(mktemp)
    if jq --arg id "$name" '.states[$id] = ((.states[$id] // {}) | .enabled = true)' "$plugins_file" >"$tmp"; then
      mv "$tmp" "$plugins_file"
    else
      rm -f "$tmp"
    fi
  fi
done

monarch-restart-noctalia
