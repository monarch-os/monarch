#!/bin/bash

# monarch:summary=Reset Noctalia configuration to Monarch defaults, re-apply the Monarch wallpaper, and restart the shell.
# monarch:examples=monarch refresh noctalia

set -euo pipefail

monarch-refresh-config noctalia/config.toml
monarch-refresh-config noctalia/monarch-workspaces.toml
monarch-refresh-config noctalia/monarch-widgets.toml
monarch-refresh-config noctalia/palettes/Monarch.json

monarch-restart-noctalia

# Once Noctalia is up, re-apply the theme so the wallpaper IPC lands (it
# silently no-ops at install time). `msg status` is the readiness probe: it
# prints state as JSON and fails while no instance is listening on the socket.
# Detached so this script returns immediately.
setsid --fork bash -c '
  for _ in $(seq 1 30); do
    if noctalia msg status >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
  monarch-theme-apply >/dev/null 2>&1 || true
' </dev/null >/dev/null 2>&1 &
