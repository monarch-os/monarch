#!/bin/bash

# monarch:summary=Install a mise-backed wrapper for a tool
# monarch:args=<package> [command-name [bin-name]]

set -euo pipefail

if [[ -z ${1:-} ]]; then
  echo "Usage: monarch-mise-install <package> [command-name [bin-name]]"
  exit 1
fi

package=$1
command=${2:-$1}
bin=${3:-$command}
target="$HOME/.local/bin/$command"

if [[ ! $command =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*$ ]]; then
  echo "Invalid wrapper command name: $command" >&2
  exit 1
fi

mkdir -p "$HOME/.local/bin"

if [[ -e $target || -L $target ]]; then
  if [[ ! -f $target || -L $target ]] ||
    [[ $(sed -n '2p' "$target") != '# Generated by monarch-mise-install.' ]]; then
    echo "Keeping existing $target; it is not owned by Monarch." >&2
    exit 0
  fi
fi

temporary=$(mktemp "$HOME/.local/bin/.$command.XXXXXX")
trap 'rm -f "$temporary"' EXIT
printf -v quoted_package '%q' "$package"
printf -v quoted_bin '%q' "$bin"

cat >"$temporary" <<EOF
#!/bin/bash
# Generated by monarch-mise-install.
export MISE_MINIMUM_RELEASE_AGE=0
mise use -g --quiet $quoted_package || exit 1
exec mise x $quoted_package -- $quoted_bin "\$@"
EOF

chmod +x "$temporary"
mv -f "$temporary" "$target"
trap - EXIT
