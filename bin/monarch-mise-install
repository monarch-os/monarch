#!/bin/bash

# monarch:summary=Install a mise-backed wrapper for a tool
# monarch:args=<package> [command-name [bin-name]]

if [[ -z ${1:-} ]]; then
  echo "Usage: monarch-mise-install <package> [command-name [bin-name]]"
  exit 1
fi

package=$1
command=${2:-$1}
bin=${3:-$command}

mkdir -p "$HOME/.local/bin"

cat > "$HOME/.local/bin/$command" <<EOF
#!/bin/bash
export MISE_MINIMUM_RELEASE_AGE=0
mise use -g --quiet "$package" || exit 1
exec mise x "$package" -- "$bin" "\$@"
EOF

chmod +x "$HOME/.local/bin/$command"
