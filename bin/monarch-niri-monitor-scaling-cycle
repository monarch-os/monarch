#!/bin/bash

# monarch:summary=Cycle the focused monitor scaling through 1x, 1.25x, 1.6x, 2x, 3x, and 4x
# monarch:args=[--reverse]

set -uo pipefail

# Cycle order; reverse with --reverse.
SCALES=(1 1.25 1.6 2 3 4)

info=$(niri msg --json focused-output 2>/dev/null)
focused=$(jq -r '.name // empty' <<<"$info")
current=$(jq -r '.logical.scale // empty' <<<"$info")

if [[ -z $focused ]]; then
  notify-send -u low "󰍹    No focused output"
  exit 1
fi

# Find the cycle index closest to the current scale: niri (like Hyprland) may
# report a fractional scale that does not equal a list entry exactly.
idx=$(awk -v s="${current:-1}" -v list="${SCALES[*]}" 'BEGIN {
  n = split(list, a, " "); best = 0; bestd = 1e9
  for (i = 1; i <= n; i++) { d = s - a[i]; if (d < 0) d = -d; if (d < bestd) { bestd = d; best = i - 1 } }
  print best
}')

if [[ ${1:-} == "--reverse" ]]; then
  new_idx=$(( (idx - 1 + ${#SCALES[@]}) % ${#SCALES[@]} ))
else
  new_idx=$(( (idx + 1) % ${#SCALES[@]} ))
fi
new=${SCALES[$new_idx]}

# Applying and persisting both live in monarch-display-scale, which this is now
# only the keyboard's way into: two copies of "set it live, then write it where
# a reload will find it" is one too many.
monarch-display-scale "$focused" "$new" >/dev/null || exit 1

notify-send -u low "󰍹    Display scaling set to ${new}x"
