#!/bin/bash

# monarch:summary=Install Zed Editor and theme it via the Noctalia user-template

set -euo pipefail

echo "Installing Zed Editor..."
monarch-pkg-add zed

# Zed follows the active Monarch/Noctalia scheme through the [templates.zed]
# Noctalia user-template (config/noctalia/templates/zed.json renders to
# ~/.config/zed/themes/noctalia.json, shipped in the default config). Noctalia
# re-renders it on every color generation and Zed hot-reloads its themes/ dir,
# so theme switching is live. (This replaces the old `monzed` package.)

# Select the theme so Zed actually uses it (the template only makes it
# available). Fresh installs have no settings.json yet, so seed one that follows
# the system dark/light toggle; never rewrite an existing (JSONC) settings file.
zed_settings="$HOME/.config/zed/settings.json"
theme_block='"theme": { "mode": "system", "light": "Noctalia Light", "dark": "Noctalia Dark" }'
mkdir -p "$HOME/.config/zed"
if [[ ! -f $zed_settings ]]; then
  printf '{\n  %s\n}\n' "$theme_block" > "$zed_settings"
elif ! grep -q '"Noctalia ' "$zed_settings"; then
  echo "Note: set ${theme_block} in $zed_settings to follow the Monarch theme."
fi

# Render the theme now so it exists before first launch: re-selecting the active
# scheme makes Noctalia regenerate colors and render all user templates.
#
# TODO(noctalia-v5): the scheme name is still read from the v4 settings.json,
# which v5 ignores (it reads noctalia_config.toml). The palette source keyword
# is also a guess — `color-scheme-set` expects
# <builtin|wallpaper|community|custom> <name-or-scheme>, and which one Monarch's
# own scheme registers as has to be confirmed in the VM.
if command -v noctalia >/dev/null 2>&1; then
  scheme=$(jq -r '.colorSchemes.predefinedScheme // "Monarch"' \
    "$HOME/.config/noctalia/settings.json" 2>/dev/null || echo "Monarch")
  noctalia msg color-scheme-set custom "$scheme" >/dev/null 2>&1 || true
fi

setsid gtk-launch dev.zed.Zed
