#!/bin/bash

# monarch:summary=Returns true if a battery is present on the system.

# BAT* was a guess at the firmware's name; type is the actual answer.
for bat in "${MONARCH_POWER_SUPPLY_PATH:-/sys/class/power_supply}"/*; do
  [[ -r $bat/present ]] &&
  [[ $(cat $bat/present) == "1" ]] &&
  [[ $(cat $bat/type) == "Battery" ]] &&
  exit 0
done

exit 1
