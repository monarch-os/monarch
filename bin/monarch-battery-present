#!/bin/bash

# monarch:summary=Returns true if a battery is present on the system.

# Every glob here used to be BAT*, which is a guess at what the firmware named
# the pack. The type file is the actual answer and was already being read.
for bat in "${MONARCH_POWER_SUPPLY_PATH:-/sys/class/power_supply}"/*; do
  [[ -r $bat/present ]] &&
  [[ $(cat $bat/present) == "1" ]] &&
  [[ $(cat $bat/type) == "Battery" ]] &&
  exit 0
done

exit 1
