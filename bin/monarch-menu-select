#!/bin/bash

# monarch:summary=Pick one option with Walker
# monarch:group=menu
# monarch:name=select
# monarch:args=prompt option... [-- fuzzel args...]
# monarch:examples=monarch menu select Format jpg png|monarch-menu-select Resolution 4k 1080p 720p -- --width 400

set -euo pipefail

if (( $# < 2 )); then
  echo "Usage: monarch-menu-select <prompt> <option>... [-- fuzzel args...]" >&2
  exit 1
fi

prompt="$1"
shift

options=()
walker_args=()

while (( $# > 0 )); do
  if [[ $1 == "--" ]]; then
    shift
    walker_args=("$@")
    break
  fi

  options+=("$1")
  shift
done

if (( ${#options[@]} == 0 )); then
  echo "Usage: monarch-menu-select <prompt> <option>... [-- fuzzel args...]" >&2
  exit 1
fi

printf '%s\n' "${options[@]}" | fuzzel --dmenu --lines 8 -p "$prompt… " "${walker_args[@]}" 2>/dev/null
