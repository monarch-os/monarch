#!/bin/bash

# monarch:summary=Pick one option from the Monarch menu
# monarch:group=menu
# monarch:name=select
# monarch:args=prompt [option...]
# monarch:examples=monarch menu select Format jpg png|monarch-menu-select Resolution 4k 1080p 720p

set -euo pipefail

if (( $# < 1 )); then
  echo "Usage: monarch-menu-select <prompt> [option...]" >&2
  exit 1
fi

prompt="$1"
shift

options=()

while (( $# > 0 )); do
  if [[ $1 == "--" ]]; then
    break
  fi

  options+=("$1")
  shift
done

if (( ${#options[@]} == 0 )) && [[ ! -t 0 ]]; then
  mapfile -t options
fi

if (( ${#options[@]} == 0 )); then
  echo "Usage: monarch-menu-select <prompt> [option...]" >&2
  exit 1
fi

selection_file=$(mktemp)
done_file=$(mktemp)
options_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file" "$options_file"' EXIT

printf '%s\0' "${options[@]}" | jq -Rsc '
  split("\u0000")[:-1]
  | to_entries
  | map(
      .key as $index
      | (.value | split("\t")) as $parts
      | {
          kind: "choice",
          id: ("choice-" + (($index + 1) | tostring)),
          glyph: (if ($parts | length) >= 2 then $parts[0] else "" end),
          label: (if ($parts | length) >= 2 then $parts[1] else $parts[0] end),
          detail: (if ($parts | length) >= 3 then $parts[2] else "" end)
        }
      | .value = (if ($parts | length) >= 4 then $parts[3]
          elif .detail != "" then .label + "\t" + .detail
          else .label
          end)
      | .searchText = (.label + " " + .detail + " " + .value)
    )
' >"$options_file"

payload=$(jq -nc \
  --arg mode select \
  --arg prompt "$prompt" \
  --arg optionsFile "$options_file" \
  --arg selectionFile "$selection_file" \
  --arg doneFile "$done_file" \
  '{mode: $mode, prompt: $prompt, optionsFile: $optionsFile, selectionFile: $selectionFile, doneFile: $doneFile}')

noctalia msg panel-open monarch/menu:select "$payload" >/dev/null

while [[ ! -e $done_file ]]; do
  sleep 0.05
done

if [[ -s $selection_file ]]; then
  cat "$selection_file"
else
  exit 1
fi
