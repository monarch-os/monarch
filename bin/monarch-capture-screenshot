#!/bin/bash

# monarch:summary=Take a screenshot
# monarch:group=capture
# monarch:args=[smart|region|windows|fullscreen] [slurp|copy|save|edit] [--editor=<name>]
# monarch:examples=monarch screenshot | monarch capture screenshot region | monarch screenshot smart edit
# monarch:aliases=monarch screenshot

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${MONARCH_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"

if [[ ! -d $OUTPUT_DIR ]]; then
  mkdir -p "$OUTPUT_DIR"
  notify-send "Created screenshot directory: $OUTPUT_DIR" -u normal -t 2000
fi

pkill slurp && exit 0

SCREENSHOT_EDITOR="${MONARCH_SCREENSHOT_EDITOR:-tensaku}"

# Parse --editor flag from any position
ARGS=()
for arg in "$@"; do
  if [[ $arg == --editor=* ]]; then
    SCREENSHOT_EDITOR="${arg#--editor=}"
  else
    ARGS+=("$arg")
  fi
done
set -- "${ARGS[@]}"

MODE="${1:-smart}"
PROCESSING="${2:-slurp}"

FILENAME="screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
FILEPATH="$OUTPUT_DIR/$FILENAME"

TENSAKU=0
[[ $SCREENSHOT_EDITOR == tensaku ]] && TENSAKU=1

# Niri reports outputs and windows in logical pixels via its IPC.
# format_output_geo: "<x>,<y> <w>x<h>" (already scale-adjusted by niri).
JQ_OUTPUT_GEO='
  def format_geo:
    (.logical.x // 0) as $x | (.logical.y // 0) as $y |
    (.logical.width // 0) as $w | (.logical.height // 0) as $h |
    "\($x),\($y) \($w)x\($h)";
'

get_rectangles() {
  local focused_output
  focused_output=$(niri msg --json focused-output 2>/dev/null | jq -r '.name // empty')
  # Outputs whose logical position overlaps the focused workspace.
  niri msg --json outputs 2>/dev/null | jq -r --arg out "$focused_output" "${JQ_OUTPUT_GEO} to_entries[] | .value | select(.name == \$out) | format_geo"
  # Windows on the focused workspace.
  local focused_workspace
  focused_workspace=$(niri msg --json workspaces 2>/dev/null | jq -r '.[] | select(.is_focused == true) | .id')
  niri msg --json windows 2>/dev/null | jq -r --arg ws "$focused_workspace" '.[] | select(.workspace_id == ($ws | tonumber)) | select(.layout.pos_in_scrolling_layout != null) | "\(.layout.pos_in_scrolling_layout[0]),\(.layout.pos_in_scrolling_layout[1]) \(.layout.window_size[0])x\(.layout.window_size[1])"'
}

# Tensaku's capture overlay freezes the screen and folds region, window and
# full-screen selection into one window, so the editor path no longer needs
# slurp, grim or a separate freeze helper for interactive selections.
if ((TENSAKU)) && [[ $PROCESSING == "edit" && $MODE != "windows" && $MODE != "fullscreen" ]]; then
  tensaku --capture --output-filename "$FILEPATH" \
    --actions-on-enter save-to-clipboard --copy-command wl-copy --early-exit
  exit $?
fi

SELECTION=""

# Select based on mode
case "$MODE" in
region)
  SELECTION=$(slurp 2>/dev/null)
  ;;
windows)
  SELECTION=$(get_rectangles | slurp -r 2>/dev/null)
  ;;
fullscreen)
  SELECTION=$(niri msg --json focused-output 2>/dev/null | jq -r "${JQ_OUTPUT_GEO} . | format_geo")
  ;;
smart | *)
  RECTS=$(get_rectangles)
  SELECTION=$(echo "$RECTS" | slurp 2>/dev/null)

  # If the selection area is L * W < 20, we'll assume you were trying to select whichever
  # window or output it was inside of to prevent accidental 2px snapshots
  if [[ $SELECTION =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]]; then
    if ((${BASH_REMATCH[3]} * ${BASH_REMATCH[4]} < 20)); then
      click_x="${BASH_REMATCH[1]}"
      click_y="${BASH_REMATCH[2]}"

      while IFS= read -r rect; do
        if [[ $rect =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+) ]]; then
          rect_x="${BASH_REMATCH[1]}"
          rect_y="${BASH_REMATCH[2]}"
          rect_width="${BASH_REMATCH[3]}"
          rect_height="${BASH_REMATCH[4]}"

          if ((click_x >= rect_x && click_x < rect_x + rect_width && click_y >= rect_y && click_y < rect_y + rect_height)); then
            SELECTION="${rect_x},${rect_y} ${rect_width}x${rect_height}"
            break
          fi
        fi
      done <<<"$RECTS"
    fi
  fi
  ;;
esac

[[ -z $SELECTION ]] && exit 0

case "$PROCESSING" in
  slurp)
    grim -g "$SELECTION" "$FILEPATH" || exit 1
    echo "$FILEPATH"
    wl-copy --type image/png <"$FILEPATH"

    EDIT_ACTION=("$SCREENSHOT_EDITOR")
    ((TENSAKU)) && EDIT_ACTION=(tensaku-edit)
    monarch-notification-send -t 10000 --image "$FILEPATH" \
      "Screenshot saved to clipboard and file" "Click to edit" \
      --action "Edit" "${EDIT_ACTION[@]}" "$FILEPATH"
    ;;
  copy)
    grim -g "$SELECTION" - | wl-copy --type image/png
    ;;
  save)
    grim -g "$SELECTION" "$FILEPATH" || exit 1
    echo "$FILEPATH"
    ;;
  edit)
    if ((TENSAKU)); then
      # Edit a throwaway copy: Enter only copies, and Pictures gets the file only
      # when the save action is used explicitly.
      capture=$(mktemp --suffix=.png) || exit 1
      trap 'rm -f "$capture"' EXIT
      grim -g "$SELECTION" "$capture" || exit 1

      if ! tensaku --filename "$capture" --output-filename "$FILEPATH" \
        --actions-on-enter save-to-clipboard --copy-command wl-copy --early-exit; then
        wl-copy --type image/png <"$capture"
        monarch-notification-send -g 󰃉 "$(monarch-i18n 'capture.editorUnavailable')" \
          "$(monarch-i18n 'capture.editorUnavailableHint')"
        exit 1
      fi
    else
      grim -g "$SELECTION" "$FILEPATH" || exit 1
      "$SCREENSHOT_EDITOR" "$FILEPATH"
    fi
    ;;
  esac
