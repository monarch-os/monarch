#!/bin/bash

# monarch:summary=Launch the fastfetch TUI that gives information about the current system.

ABOUT_LOGO_LEFT_PADDING=8
ABOUT_FASTFETCH_DIR=/etc/fastfetch

about_layout() {
  local columns=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}
  local lines=${LINES:-$(tput lines 2>/dev/null || echo 24)}

  if (( columns >= 104 && lines >= 30 )); then
    echo full
  else
    echo compact
  fi
}

about_terminal_supports_sheen() {
  local colors

  [[ -t 0 && -t 1 && ${TERM:-dumb} != "dumb" ]] || return 1
  command -v tte >/dev/null 2>&1 || return 1
  colors=$(tput colors 2>/dev/null) || return 1
  [[ $colors =~ ^[0-9]+$ ]] && (( colors >= 256 ))
}

about_fastfetch_config_is_custom() {
  local directory listed=false

  while IFS= read -r directory; do
    listed=true
    directory=${directory% (\*)}
    [[ ${directory%/} == "$ABOUT_FASTFETCH_DIR" ]] && return 1
    [[ -f ${directory%/}/config.jsonc ]] && return 0
  done < <(fastfetch --list-config-paths 2>/dev/null)

  [[ $listed == true ]] && return 1
  [[ -f $HOME/.config/fastfetch/config.jsonc ]]
}

about_logo_is_stock() {
  local monarch_path=$1
  local branding="$HOME/.config/monarch/branding/about.txt"

  [[ -f $branding && -f $monarch_path/icon.txt ]] &&
    cmp -s -- "$branding" "$monarch_path/icon.txt"
}

about_restore_stock_logo() {
  local branding=$1
  local logo_lines=$2
  local line

  printf '\0338\033[%dA\r' "$logo_lines"
  while IFS= read -r line || [[ -n $line ]]; do
    printf '%*s%s\033[1B\r' "$ABOUT_LOGO_LEFT_PADDING" '' "$line"
  done <"$branding"
}

about_padded_logo() {
  local branding=$1
  local line

  while IFS= read -r line || [[ -n $line ]]; do
    printf '%*s%s\n' "$ABOUT_LOGO_LEFT_PADDING" '' "$line"
  done <"$branding"
}

about_animate_stock_logo() {
  local branding=$1
  local rendered_lines=$2
  local logo_lines offset

  logo_lines=$(awk 'END { print NR }' "$branding")
  offset=$((rendered_lines - logo_lines - 2))
  (( offset >= 0 )) || return 1

  (( offset > 0 )) && printf '\033[%dA' "$offset"
  printf '\0337'
  sleep 0.12
  about_padded_logo "$branding" | tte \
    --existing-color-handling dynamic \
    --frame-rate 144 \
    --reuse-canvas \
    --no-eol \
    highlight \
    --highlight-brightness 1.75 \
    --highlight-direction diagonal_top_left_to_bottom_right \
    --highlight-width 4 \
    2>/dev/null

  about_restore_stock_logo "$branding" "$logo_lines"
  (( offset > 0 )) && printf '\033[%dB' "$offset"
  printf '\r\033[0m\033[?25h'
}

about_render_full() {
  local monarch_path=$1
  local branding="$HOME/.config/monarch/branding/about.txt"
  local rendered rendered_lines status

  if ! about_terminal_supports_sheen ||
    ! about_logo_is_stock "$monarch_path" ||
    about_fastfetch_config_is_custom; then
    fastfetch
    return
  fi

  rendered=$(mktemp "${TMPDIR:-/tmp}/monarch-about.XXXXXX") || {
    fastfetch
    return
  }

  fastfetch >"$rendered"
  status=$?
  cat "$rendered"

  if (( status == 0 )); then
    rendered_lines=$(awk 'END { print NR }' "$rendered")
    about_animate_stock_logo "$branding" "$rendered_lines" || true
  fi

  rm -f -- "$rendered"
  return "$status"
}

about_main() {
  local monarch_path

  if [[ ${1:-} == "--layout" ]]; then
    about_layout
    return
  fi

  if [[ ${1:-} == "--render" ]]; then
    monarch_path=${MONARCH_PATH:-/usr/share/monarch}
    if [[ $(about_layout) == "full" ]]; then
      about_render_full "$monarch_path"
    else
      fastfetch --config "$monarch_path/config/fastfetch/compact.jsonc"
    fi
    read -n 1 -s
    return
  fi

  exec monarch-launch-or-focus \
    "org.monarch.about" \
    "monarch-launch-tui --app-id=org.monarch.about monarch-launch-about --render"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  about_main "$@"
fi
