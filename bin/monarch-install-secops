#!/bin/bash

# monarch:summary=Install SecOps tools like RDP client and SSH manager
# monarch:requires-sudo=true

# freerdp: RDP client, and the backend Remmina uses for its RDP plugin. This
# was named `xfreerdp` here, which is a binary the package ships (alongside
# wlfreerdp3 and sdl-freerdp3), not a package name — nothing provides it, so
# the install failed outright.
# remmina + libvncserver: one GUI for RDP/VNC/SPICE/SSH, driving the freerdp
# above; libvncserver is what enables its VNC plugin.
#
# Traffic analysis is deliberately absent: termshark ships in the base package
# set with its own launcher, and migration 1762160733 dropped wireshark-qt in
# its favour.
echo "Installing SecOps tools..."

monarch-pkg-add freerdp remmina libvncserver sshm-bin
