#!/bin/zsh

# monarch:summary=Install SecOps tools like RDP client and SSH manager
# monarch:requires-sudo=true

TOOLS_DIR=/opt/secops
[ ! -d $TOOLS_DIR ] && sudo chown $USER:$USER /opt && mkdir -p /opt/secops


echo "Install sys tools..."

yes|sudo pacman -S --noconfirm --needed xfreerdp
yay --noconfirm --needed -S sshm-bin
