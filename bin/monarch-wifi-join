#!/bin/bash
# monarch:summary=Join a Wi-Fi network using its saved profile or a password on stdin
# monarch:group=wifi
# monarch:args=<ssid> [--password-stdin]
# monarch:examples=monarch wifi join Cafe
set -euo pipefail
if (($# < 1 || $# > 2)) || [[ ${2:-} != "" && ${2:-} != "--password-stdin" ]]; then
  echo "Usage: monarch-wifi-join <ssid> [--password-stdin]; passwords are never accepted as arguments." >&2
  exit 2
fi
MONARCH_ROOT=${MONARCH_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}
mode=saved
[[ ${2:-} != "--password-stdin" ]] || mode=password-stdin
exec /usr/bin/python3 "$MONARCH_ROOT/default/monarch/network-wifi.py" connect "$1" "$mode"
