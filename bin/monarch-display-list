#!/bin/bash

# monarch:summary=List the displays niri sees, with their state, scale and mode
# monarch:group=display
# monarch:examples=monarch display list

# name<TAB>state<TAB>scale<TAB>mode<TAB>description — description goes last,
# being the only field that may contain a tab.
#
# A disabled output still appears, with no scale and no mode: niri keeps
# reporting it so it can be turned back on by name.

set -uo pipefail

# Noctalia's PATH is /usr/local/sbin:/usr/local/bin:/usr/bin — Monarch's bin is
# not on it, so a sibling called by name is simply not found when the shell runs
# this. Appended and not prepended: this only adds a fallback, and never takes a
# command away from a caller that put its own ahead of ours.
PATH="$PATH:$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"

NIRI_SOCKET=$(monarch-hw-niri-socket) || {
  echo "Error: niri is not running." >&2
  exit 1
}
export NIRI_SOCKET

niri msg --json outputs 2>/dev/null | jq -r '
  to_entries[]
  | .value as $o
  # current_mode is the index into modes, and null while the output is off —
  # indexing on it has to be guarded, not defaulted: jq throws on modes[null]
  # rather than yielding one.
  | (if $o.current_mode == null then null else $o.modes[$o.current_mode] end) as $m
  | [
      .key,
      (if $o.current_mode == null then "off" else "on" end),
      ($o.logical.scale // "" | tostring),
      (if $m == null then "" else "\($m.width)x\($m.height)@\(($m.refresh_rate / 1000) | floor)" end),
      ([$o.make, $o.model] | map(select(. != null and . != "")) | join(" "))
    ]
  | @tsv
'
