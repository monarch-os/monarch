#!/bin/bash

# monarch:summary=Set a new encryption password for a drive selected.
# monarch:requires-sudo=true

encrypted_drives=$(blkid -t TYPE=crypto_LUKS -o device)

if [[ -n $encrypted_drives ]]; then
  if (( $(wc -l <<<"$encrypted_drives") == 1 )); then
    drive_to_change="$encrypted_drives"
  else
    drive_to_change="$(monarch-drive-select "$encrypted_drives")"
  fi

  if [[ -n $drive_to_change ]]; then
    # Keep inherited export state from exposing either passphrase to child processes.
    set +a
    unset new_password confirmation
    new_password=$(gum input --password --char-limit=512 --header "New encryption password") || exit $?
    [[ -n $new_password ]] || {
      echo "Password cannot be empty."
      exit 1
    }

    confirmation=$(gum input --password --char-limit=512 --header "Confirm new encryption password") || exit $?
    [[ $new_password == "$confirmation" ]] || {
      echo "Passwords do not match."
      exit 1
    }

    echo "Changing full-disk encryption password for $drive_to_change"
    printf '%s' "$new_password" |
      sudo bash -c 'exec cryptsetup luksChangeKey --pbkdf argon2id --iter-time 2000 "$1" <(cat) </dev/tty' bash "$drive_to_change"
  else
    echo "No drive selected."
  fi
else
  echo "No encrypted drives available."
  exit 1
fi
