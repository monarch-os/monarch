#!/bin/bash

# monarch:summary=Set the Plymouth boot theme from a Monarch theme
# monarch:args=<theme-name>
# monarch:requires-sudo=true

# Resolve a theme by name and apply its unlock.png + colors.toml as the
# Plymouth boot screen via monarch-plymouth-set.

if [[ $# -ne 1 ]]; then
  echo "Usage: monarch-plymouth-set-by-theme <theme-name>" >&2
  exit 1
fi

theme=$1

if [[ -d ~/.config/monarch/themes/$theme ]]; then
  theme_dir=~/.config/monarch/themes/$theme
else
  theme_dir="$MONARCH_PATH/themes/$theme"
fi

bg=$(awk -F'"' '/^background/{print $2}' "$theme_dir/colors.toml")
text=$(awk -F'"' '/^foreground/{print $2}' "$theme_dir/colors.toml")

exec monarch-plymouth-set "$bg" "$text" "$theme_dir/unlock.png"
