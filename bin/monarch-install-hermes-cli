#!/bin/bash

# monarch:summary=Install the Hermes CLI
# monarch:args=<--check|--now>
# monarch:requires-sudo=true

set -euo pipefail

runtime_present() {
  monarch-pkg-present hermes-agent-bin || monarch-pkg-present hermes-agent
}

case "${1:-}" in
  --check) runtime_present; exit $? ;;
  --now) ;;
  *) echo "Usage: monarch-install-hermes-cli <--check|--now>" >&2; exit 1 ;;
esac

if monarch-pkg-present hermes-agent-bin; then
  sudo pacman -D --asexplicit hermes-agent-bin
elif monarch-pkg-present hermes-agent; then
  sudo pacman -D --asexplicit hermes-agent
else
  monarch-pkg-add hermes-agent-bin
fi
