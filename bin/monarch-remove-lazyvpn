#!/bin/bash

# monarch:summary=Remove LazyVPN

echo "Removing monarch-lazyvpn..."

# Disconnect any active VPN connection
if command -v lazyvpn-disconnect &>/dev/null; then
  echo "Disconnecting VPN..."
  lazyvpn-disconnect 2>/dev/null || true
fi

# Remove the package
monarch-pkg-drop monarch-lazyvpn

# Remove TUI app entry
monarch-tui-remove "LazyVPN"

# Remove Niri keybinding (marker block in ~/.config/niri/user.kdl).
USER_KDL="$HOME/.config/niri/user.kdl"
if [[ -f "$USER_KDL" ]] && grep -q 'monarch:lazyvpn:begin' "$USER_KDL"; then
  echo "Removing Niri keybinding..."
  sed -i '/\/\/ monarch:lazyvpn:begin/,/\/\/ monarch:lazyvpn:end/d' "$USER_KDL"
  if pgrep -x niri >/dev/null 2>&1; then
    niri msg action reload-config >/dev/null 2>&1 || true
  fi
fi

echo -e "\nLazyVPN removed!"
