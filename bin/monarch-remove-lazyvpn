#!/bin/bash
# monarch:summary=Remove LazyVPN

set -euo pipefail
monarch-pkg-drop monarch-lazyvpn

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
data_dir=${XDG_DATA_HOME:-$HOME/.local/share}
rm -f "$data_dir/applications/LazyVPN.desktop"
rm -f "$HOME/.config/niri/monarch-lazyvpn.kdl" "$config_dir/noctalia/lazyvpn.toml"
user_kdl="$HOME/.config/niri/user.kdl"
if [[ -f $user_kdl ]]; then
  sed -i '/\/\/ monarch:lazyvpn:begin/,/\/\/ monarch:lazyvpn:end/d; /^[[:space:]]*include[[:space:]]*"\.\/monarch-lazyvpn\.kdl"[[:space:]]*$/d' "$user_kdl"
fi
if [[ -n ${NIRI_SOCKET:-} ]] && pgrep -u "$(id -u)" -x niri >/dev/null 2>&1; then
  niri validate && niri msg action load-config-file
fi
echo "LazyVPN removed. Profiles and credentials have been preserved."
