#!/bin/bash

# monarch:summary=Remove LazyVPN

echo "Removing monarch-lazyvpn..."

# Remove the package
monarch-pkg-drop monarch-lazyvpn

# Remove the app-launcher entry
monarch-tui-remove "LazyVPN"

# The bar status widget needs no removal: it is declared by the
# monarch-indicators Noctalia plugin and hides itself as soon as this package's
# binary is gone. See monarch-install-lazyvpn for why it is permanent.

# Remove the dedicated niri include file and its one-line include in user.kdl.
NIRI_DIR="$HOME/.config/niri"
rm -f "$NIRI_DIR/monarch-lazyvpn.kdl"
USER_KDL="$NIRI_DIR/user.kdl"
if [[ -f "$USER_KDL" ]] && grep -q 'monarch:lazyvpn:begin' "$USER_KDL"; then
  echo "Removing the LazyVPN keybinding..."
  sed -i '/\/\/ monarch:lazyvpn:begin/,/\/\/ monarch:lazyvpn:end/d' "$USER_KDL"
fi
if pgrep -x niri >/dev/null 2>&1; then
  niri msg action load-config-file >/dev/null 2>&1 || true
fi

echo -e "\nLazyVPN removed!"
