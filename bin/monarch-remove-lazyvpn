#!/bin/bash

# monarch:summary=Remove LazyVPN

echo "Removing monarch-lazyvpn..."

# Remove the package
monarch-pkg-drop monarch-lazyvpn

# Remove the app-launcher entry
monarch-tui-remove "LazyVPN"

# Remove the Noctalia bar status widget (any CustomButton tied to LazyVPN).
# Noctalia hot-reloads settings.json, so the bar drops it without a restart.
NOCTALIA_CFG="$HOME/.config/noctalia/settings.json"
if command -v jq >/dev/null && [[ -f "$NOCTALIA_CFG" ]]; then
  if jq -e '[.. | objects | select(.textCommand? == "monarch-lazyvpn-status")] | length > 0' \
       "$NOCTALIA_CFG" >/dev/null 2>&1; then
    echo "Removing the LazyVPN status widget from the Noctalia bar..."
    tmp=$(mktemp)
    if jq '(.bar.widgets.left, .bar.widgets.center, .bar.widgets.right) |=
             ((. // []) | map(select(.textCommand? != "monarch-lazyvpn-status")))' \
         "$NOCTALIA_CFG" >"$tmp"; then
      mv "$tmp" "$NOCTALIA_CFG"
    else
      rm -f "$tmp"
      echo "  Warning: could not update $NOCTALIA_CFG; remove the widget manually." >&2
    fi
  fi
fi

# Remove the dedicated niri include file and its one-line include in user.kdl.
NIRI_DIR="$HOME/.config/niri"
rm -f "$NIRI_DIR/monarch-lazyvpn.kdl"
USER_KDL="$NIRI_DIR/user.kdl"
if [[ -f "$USER_KDL" ]] && grep -q 'monarch:lazyvpn:begin' "$USER_KDL"; then
  echo "Removing the LazyVPN keybinding..."
  sed -i '/\/\/ monarch:lazyvpn:begin/,/\/\/ monarch:lazyvpn:end/d' "$USER_KDL"
fi
if pgrep -x niri >/dev/null 2>&1; then
  niri msg action load-config-file >/dev/null 2>&1 || true
fi

echo -e "\nLazyVPN removed!"
