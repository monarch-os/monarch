#!/bin/bash

# monarch:summary=Extract text from a screenshot region with OCR
# monarch:group=capture
# monarch:examples=monarch capture ocr

SELECTION=$(slurp 2>/dev/null)

[[ -z $SELECTION ]] && exit 0

TEXT=$(grim -g "$SELECTION" - | tesseract stdin stdout --oem 1 --psm 6 -l "${OMARCHY_OCR_LANGS:-eng}" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || exit 1

[[ -z $TEXT ]] && exit 1

printf "%s" "$TEXT" | wl-copy
notify-send "󰴑    $(monarch-i18n 'capture.textCopied')"
