#!/bin/bash

# monarch:summary=Finalize Monarch user setup (runtime tweaks /etc/skel can't do)
# monarch:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: monarch provision user [--force] [--first-install]

Runs the per-user setup steps that /etc/skel can't seed:
dev-aware skill symlinks, xdg-user-dirs + gtk bookmarks (need \$HOME),
default browser/mailto, and install/user/all.sh.

For shipped configs see /etc/skel (new users) and monarch-reinstall-configs
(existing users explicitly resyncing).

--first-install is used by the ISO in the target chroot.

Idempotency marker: ~/.local/state/monarch/done/finalize-user
USAGE
}

if (( EUID == 0 )); then
  echo "Error: run monarch-provision-user as the user being configured, not as root." >&2
  exit 1
fi

force=0
first_install=0
while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --first-install)
      first_install=1
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir="$HOME/.local/state/monarch"
mkdir -p "$state_dir"

export MONARCH_PATH="${MONARCH_PATH:-/usr/share/monarch}"
export MONARCH_INSTALL="${MONARCH_INSTALL:-$MONARCH_PATH/install}"
export MONARCH_SETUP_CONTEXT="${MONARCH_SETUP_CONTEXT:-runtime}"
export PATH="$MONARCH_PATH/bin:$PATH"

if monarch-done check finalize-user && (( force == 0 )); then
  echo "User finalization already complete (rerun with --force to refresh)."
  exit 0
fi

if (( first_install )) && [[ $MONARCH_SETUP_CONTEXT == "runtime" ]]; then
  # The ISO chroot doesn't set a context; monarch-provision-owner runs first-install
  # finalization too but with MONARCH_SETUP_CONTEXT=provision-owner already set.
  export MONARCH_SETUP_CONTEXT=iso-chroot
fi

if [[ -n ${MONARCH_INSTALL_LOG_FILE:-} && -f $MONARCH_INSTALL/helpers/logging.sh ]]; then
  source "$MONARCH_INSTALL/helpers/logging.sh"
else
  run_logged() {
    local script="$1"
    bash -eE -c 'source "$1"' bash "$script"
  }
fi

# Dev-aware skill symlinks. Cannot live in /etc/skel because MONARCH_PATH may
# point at a dev checkout (monarch dev link) where the target differs.
# Loops every skill directory, so shipping a new one needs no edit here.
mkdir -p ~/.agents/skills ~/.claude/skills ~/.codex/skills ~/.pi/agent/skills ~/.gemini/config/skills
for skill in "$MONARCH_PATH"/default/agents/skills/*/; do
  skill=${skill%/}
  name=${skill##*/}
  ln -sfn "$skill" ~/.agents/skills/"$name"
  ln -sfn "$skill" ~/.claude/skills/"$name"
  ln -sfn "$skill" ~/.codex/skills/"$name"
  ln -sfn "$skill" ~/.pi/agent/skills/"$name"
  ln -sfn "$skill" ~/.gemini/config/skills/"$name"
done

mkdir -p ~/Downloads ~/Pictures ~/Videos ~/.config/gtk-3.0
xdg-user-dirs-update --set TEMPLATES "$HOME"
xdg-user-dirs-update --set PUBLICSHARE "$HOME"
xdg-user-dirs-update --set DESKTOP "$HOME"
rmdir ~/Templates ~/Public ~/Desktop 2>/dev/null || true
touch ~/.config/gtk-3.0/bookmarks
for dir in Downloads Projects Pictures Videos; do
  bookmark="file://$HOME/$dir $dir"
  grep -qxF "$bookmark" ~/.config/gtk-3.0/bookmarks || echo "$bookmark" >>~/.config/gtk-3.0/bookmarks
done

source "$MONARCH_INSTALL/user/all.sh"

monarch-done mark finalize-user
echo "User finalization complete."
