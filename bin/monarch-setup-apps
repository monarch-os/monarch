#!/bin/bash

# monarch:summary=Browse and install optional Monarch apps and tools (TUI)
# monarch:examples=monarch setup apps

set -uo pipefail

have_gum() { command -v gum >/dev/null 2>&1; }

header() {
  if have_gum; then
    gum style --foreground 213 --border-foreground 213 --border rounded \
      --padding "0 2" --margin "0 0 1 0" --align center "$1"
  else
    echo; echo "  ── $1 ──"; echo
  fi
}

pick() {
  if have_gum; then
    printf '%s\n' "$@" | gum choose --height "$(($# + 2))"
  else
    local choice
    PS3=$'\nSelect: '
    select choice in "$@"; do
      [[ -n $choice ]] && { echo "$choice"; return; }
    done
  fi
}

press_to_continue() {
  echo
  read -n1 -p "  Press any key to continue…" -r _ || true
}

# Curated installers per category, as "Label|command" rows. Edit here to add
# or retire entries; the menus build themselves from this list.
items_for() {
  case "$1" in
    *Editors*) cat <<'EOF'
VS Code|monarch-install-vscode
Zed|monarch-install-zed
Helix|monarch-install-helix
Development environment|monarch-install-dev-env
Terminal emulator|monarch-install-terminal
Docker databases|monarch-install-docker-dbs
EOF
      ;;
    *Security*) cat <<'EOF'
Fingerprint login|monarch-setup-security-fingerprint
Security key (FIDO2)|monarch-setup-security-fido2
Burp Suite|monarch-install-burp
SecOps tools|monarch-install-secops
RFSwift (radio)|monarch-install-rfswift
LazyVPN|monarch-install-lazyvpn
Proton Suite|monarch-install-proton
Tailscale|monarch-install-tailscale
NordVPN|monarch-install-nordvpn
EOF
      ;;
    *Productivity*) cat <<'EOF'
Voxtype dictation|monarch-voxtype-install
Todo manager|monarch-install-todo
Web browser|monarch-install-browser
EOF
      ;;
    *Gaming*) cat <<'EOF'
Steam|monarch-install-gaming-steam
Lutris|monarch-install-gaming-lutris
Heroic Games Launcher|monarch-install-gaming-heroic
RetroArch|monarch-install-gaming-retroarch
Moonlight|monarch-install-gaming-moonlight
GeForce Now|monarch-install-gaming-geforce-now
Xbox Cloud Gaming|monarch-install-gaming-xbox-cloud
EOF
      ;;
  esac
}

while true; do
  clear
  header "Apps & tools"

  cat=$(pick \
    "Editors & dev tools" \
    "Security & privacy" \
    "Productivity" \
    "Gaming" \
    "← Back")

  [[ -z $cat || $cat == "← Back" ]] && break

  while true; do
    clear
    header "$cat"

    mapfile -t rows < <(items_for "$cat")
    labels=(); declare -A CMD=()
    for row in "${rows[@]}"; do
      [[ -z $row ]] && continue
      lbl=${row%%|*}; CMD[$lbl]=${row#*|}
      labels+=("$lbl")
    done
    labels+=("← Back")

    sel=$(pick "${labels[@]}")
    if [[ -z $sel || $sel == "← Back" ]]; then
      unset CMD; break
    fi

    "${CMD[$sel]}" || true
    press_to_continue
    unset CMD
  done
done
