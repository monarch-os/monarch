#!/bin/bash

# monarch:summary=Set Wi-Fi power save mode on wireless interfaces
# monarch:args=<on|off>

# Only until the next reconnect: NetworkManager reasserts wifi.powersave on
# activation. Edit conf.d/wifi-powersave.conf for the policy; this is the moment.

for iface in /sys/class/net/*/wireless; do
  iface="$(basename "$(dirname "$iface")")"
  iw dev "$iface" set power_save "$1" 2>/dev/null
done
