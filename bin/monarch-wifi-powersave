#!/bin/bash

# monarch:summary=Set Wi-Fi power save mode on wireless interfaces
# monarch:args=<on|off>

# Until the next reconnect only; conf.d/wifi-powersave.conf holds the policy.

for iface in /sys/class/net/*/wireless; do
  iface="$(basename "$(dirname "$iface")")"
  iw dev "$iface" set power_save "$1" 2>/dev/null
done
