#!/bin/bash

# monarch:summary=Render a Plymouth and SDDM preview with custom colors and logo
# monarch:args=<background-hex> <text-hex> <path-to-logo.png> <output-path>
# monarch:examples=monarch plymouth preview '#1d2021' '#ebdbb2' ~/.local/share/monarch/default/plymouth/logo.png /tmp/unlock.png

set -uo pipefail

if [[ $# -ne 4 ]]; then
  echo "Usage: monarch-plymouth-preview <background-hex> <text-hex> <path-to-logo.png> <output-path>" >&2
  exit 1
fi

bg_hex=${1#\#}
text_hex=${2#\#}
logo_path=$3
output_path=$4
MONARCH_ROOT="${MONARCH_PATH:-$HOME/.local/share/monarch}"

[[ $bg_hex =~ ^[0-9a-fA-F]{6}$ ]] || { echo "Invalid background color: $1" >&2; exit 1; }
[[ $text_hex =~ ^[0-9a-fA-F]{6}$ ]] || { echo "Invalid text color: $2" >&2; exit 1; }
[[ -f $logo_path ]] || { echo "Logo file not found: $logo_path" >&2; exit 1; }
command -v magick >/dev/null 2>&1 || { echo "imagemagick (magick) is required" >&2; exit 1; }

staging_dir=$(mktemp -d) || exit 1
trap 'rm -rf "$staging_dir"' EXIT

find "$MONARCH_ROOT/default/plymouth" -maxdepth 1 -type f -exec cp -t "$staging_dir/" {} + || exit 1
cp "$logo_path" "$staging_dir/logo.png" || exit 1

for asset in bullet.png entry.png lock.png; do
  magick "$staging_dir/$asset" -channel RGB +level-colors "#$text_hex","#$text_hex" "$staging_dir/$asset" || exit 1
done

canvas_w=1920
canvas_h=1080
logo_w=$(magick identify -format '%w' "$staging_dir/logo.png")
logo_h=$(magick identify -format '%h' "$staging_dir/logo.png")
entry_w=$(magick identify -format '%w' "$staging_dir/entry.png")
entry_h=$(magick identify -format '%h' "$staging_dir/entry.png")
lock_h=$(awk "BEGIN{print int($entry_h * 0.8)}")
lock_w=$(awk "BEGIN{print int(84 * $lock_h / 96)}")

logo_x=$(((canvas_w - logo_w) / 2))
logo_y=$(((canvas_h - logo_h) / 2))
entry_x=$(((canvas_w - entry_w) / 2))
entry_y=$((logo_y + logo_h + 40))
lock_x=$((entry_x - lock_w - 15))
lock_y=$((entry_y + entry_h / 2 - lock_h / 2))
bullet_y=$((entry_y + entry_h / 2 - 4))

bullet_args=()
for i in 0 1 2 3; do
  bx=$((entry_x + 20 + i * 12))
  bullet_args+=( '(' "$staging_dir/bullet.png" -resize 7x7 ')' -geometry "+${bx}+${bullet_y}" -composite )
done

magick -size "${canvas_w}x${canvas_h}" "xc:#$bg_hex" \
  "$staging_dir/logo.png" -geometry "+${logo_x}+${logo_y}" -composite \
  "$staging_dir/entry.png" -geometry "+${entry_x}+${entry_y}" -composite \
  \( "$staging_dir/lock.png" -resize "${lock_w}x${lock_h}" \) -geometry "+${lock_x}+${lock_y}" -composite \
  "${bullet_args[@]}" \
  "$output_path" || exit 1

if [[ ${MONARCH_PLYMOUTH_PREVIEW_OPEN:-1} == 1 ]] && command -v imv >/dev/null 2>&1; then
  imv -f "$output_path"
fi
