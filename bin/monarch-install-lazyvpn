#!/bin/bash
# monarch:summary=Install LazyVPN (a native WireGuard multi-provider VPN manager)

set -euo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
monarch-pkg-add monarch-lazyvpn
source "$root/install/helpers/lazyvpn.sh"
monarch_configure_lazyvpn "$root"
