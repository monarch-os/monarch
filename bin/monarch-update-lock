#!/bin/bash

# monarch:summary=Run a command while holding the Monarch update lock
# monarch:args=<held|run> [command] [args...]
# monarch:hidden=true

case ${1:-} in
  held | run) ;;
  *) echo 'Usage: monarch-update-lock <held|run> [command] [args...]' >&2; exit 2 ;;
esac
script=$(readlink -e -- "${BASH_SOURCE[0]}") || exit 1
exec /usr/bin/python3 -I "${script%/*}/../default/monarch/update-guards.py" "$@"
