#!/bin/bash

# monarch:summary=Print the OEM Windows product key stored in firmware
# monarch:requires-sudo=true

set -euo pipefail

DEFAULT_MSDM=/sys/firmware/acpi/tables/MSDM
MSDM=${MONARCH_MSDM_PATH:-$DEFAULT_MSDM}

if [[ ! -e $MSDM ]]; then
  echo "No Windows license key found in firmware." >&2
  exit 1
fi

if [[ $MSDM != "$DEFAULT_MSDM" && ! -r $MSDM ]]; then
  echo "Refusing to elevate a custom Windows license path." >&2
  exit 1
fi

read_msdm() {
  if [[ $MSDM != "$DEFAULT_MSDM" || -r $MSDM ]]; then
    "$@" "$MSDM"
  else
    sudo "$@" "$MSDM"
  fi
}

extract_key() {
  grep -aoEm1 '[A-Z0-9]{5}(-[A-Z0-9]{5}){4}'
}

key=""
if monarch-cmd-present strings; then
  key=$(read_msdm strings | extract_key) || true
fi

if [[ -z $key ]]; then
  key=$(read_msdm cat | extract_key) || true
fi

if [[ -z $key ]]; then
  echo "Firmware license table found, but no Windows product key could be extracted." >&2
  exit 1
fi

printf '%s\n' "$key"
