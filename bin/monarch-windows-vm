#!/bin/bash
COMPOSE_FILE="$HOME/.config/windows/docker-compose.yml"

check_prerequisites() {
  local DISK_SIZE_GB=${1:-64}
  local REQUIRED_SPACE=$((DISK_SIZE_GB + 10))  # Add 10GB for Windows ISO and overhead

  # Check for KVM support
  if [ ! -e /dev/kvm ]; then
    gum style \
      --border normal \
      --padding "1 2" \
      --margin "1" \
      "❌ KVM virtualization not available!" \
      "" \
      "Please enable virtualization in BIOS or run:" \
      "  sudo modprobe kvm-intel  # for Intel CPUs" \
      "  sudo modprobe kvm-amd    # for AMD CPUs"
    exit 1
  fi

  # Check disk space
  AVAILABLE_SPACE=$(df "$HOME" | awk 'NR==2 {print int($4/1024/1024)}')
  if [ "$AVAILABLE_SPACE" -lt "$REQUIRED_SPACE" ]; then
    echo "❌ Insufficient disk space!"
    echo "   Available: ${AVAILABLE_SPACE}GB"
    echo "   Required: ${REQUIRED_SPACE}GB (${DISK_SIZE_GB}GB disk + 10GB for Windows image)"
    exit 1
  fi
}

install_windows() {
  # Set up trap to handle Ctrl+C
  trap "echo ''; echo 'Installation cancelled by user'; exit 1" INT

  check_prerequisites

  monarch-pkg-add freerdp openbsd-netcat gum

  mkdir -p "$HOME/.windows"
  mkdir -p "$HOME/.config/windows"
  mkdir -p "$HOME/.local/share/applications/icons"

  # Install Windows VM icon and desktop file
  if [ -f "$MONARCH_PATH/applications/icons/windows.png" ]; then
    cp "$MONARCH_PATH/applications/icons/windows.png" "$HOME/.local/share/applications/icons/windows.png"
  fi

  cat << EOF | tee "$HOME/.local/share/applications/windows-vm.desktop" > /dev/null
[Desktop Entry]
Name=Windows
Comment=Start Windows VM via Docker and connect with RDP
Exec=uwsm app -- monarch-windows-vm launch
Icon=$HOME/.local/share/applications/icons/windows.png
Terminal=false
Type=Application
Categories=System;Virtualization;
EOF

  # Get system resources
  TOTAL_RAM=$(free -h | awk 'NR==2 {print $2}')
  TOTAL_RAM_GB=$(awk 'NR==1 {printf "%d", $2/1024/1024}' /proc/meminfo)
  TOTAL_CORES=$(nproc)

  echo ""
  echo "System Resources Detected:"
  echo "  Total RAM: $TOTAL_RAM"
  echo "  Total CPU Cores: $TOTAL_CORES"
  echo ""

  RAM_OPTIONS=""
  for size in 2 4 8 16 32 64; do
    if [ $size -le $TOTAL_RAM_GB ]; then
      RAM_OPTIONS="$RAM_OPTIONS ${size}G"
    fi
  done

  SELECTED_RAM=$(echo $RAM_OPTIONS | tr ' ' '\n' | gum choose --selected="4G" --header="How much RAM would you like to allocate to Windows VM?")

  # Check if user cancelled
  if [ -z "$SELECTED_RAM" ]; then
    echo "Installation cancelled by user"
    exit 1
  fi

  SELECTED_CORES=$(gum input --placeholder="Number of CPU cores (1-$TOTAL_CORES)" --value="2" --header="How many CPU cores would you like to allocate to Windows VM?" --char-limit=2)

  # Check if user cancelled (Ctrl+C in gum input returns empty string)
  if [ -z "$SELECTED_CORES" ]; then
    echo "Installation cancelled by user"
    exit 1
  fi

  if ! [[ "$SELECTED_CORES" =~ ^[0-9]+$ ]] || [ "$SELECTED_CORES" -lt 1 ] || [ "$SELECTED_CORES" -gt "$TOTAL_CORES" ]; then
    echo "Invalid input. Using default: 2 cores"
    SELECTED_CORES=2
  fi

  AVAILABLE_SPACE=$(df "$HOME" | awk 'NR==2 {print int($4/1024/1024)}')
  MAX_DISK_GB=$((AVAILABLE_SPACE - 10))  # Leave 10GB for Windows image

  # Check if we have enough space for minimum
  if [ $MAX_DISK_GB -lt 32 ]; then
    echo "❌ Insufficient disk space for Windows VM!"
    echo "   Available: ${AVAILABLE_SPACE}GB"
    echo "   Minimum required: 42GB (32GB disk + 10GB for Windows image)"
    exit 1
  fi

  DISK_OPTIONS=""
  for size in 32 64 128 256 512; do
    if [ $size -le $MAX_DISK_GB ]; then
      DISK_OPTIONS="$DISK_OPTIONS ${size}G"
    fi
  done

  # Default to 64G if available, otherwise 32G
  DEFAULT_DISK="64G"
  if ! echo "$DISK_OPTIONS" | grep -q "64G"; then
    DEFAULT_DISK="32G"
  fi

  SELECTED_DISK=$(echo $DISK_OPTIONS | tr ' ' '\n' | gum choose --selected="$DEFAULT_DISK" --header="How much disk space would you like to give Windows VM? (64GB+ recommended)")

  # Check if user cancelled
  if [ -z "$SELECTED_DISK" ]; then
    echo "Installation cancelled by user"
    exit 1
  fi

  # Extract just the number for prerequisite check
  DISK_SIZE_NUM=$(echo "$SELECTED_DISK" | sed 's/G//')

  # Re-check prerequisites with selected disk size
  check_prerequisites "$DISK_SIZE_NUM"

  # Prompt for username and password
  USERNAME=$(gum input --placeholder="Username (Press enter to use default: docker)" --header="Enter Windows username:")
  if [ -z "$USERNAME" ]; then
    USERNAME="docker"
  fi

  PASSWORD=$(gum input --placeholder="Password (Press enter to use default: admin)" --password --header="Enter Windows password:")
  if [ -z "$PASSWORD" ]; then
    PASSWORD="admin"
    PASSWORD_DISPLAY="(default)"
  else
    PASSWORD_DISPLAY="(user-defined)"
  fi

  languages=$'Arabic
Bulgarian
Chinese
Croatian
Czech
Danish
Dutch
English
Estonian
Finnish
French
German
Greek
Hebrew
Hungarian
Italian
Japanese
Korean
Latvian
Lithuanian
Norwegian
Polish
Portuguese
Romanian
Russian
Serbian
Slovak
Slovenian
Spanish
Swedish
Thai
Turkish
Ukrainian
  '

  LANGUAGE=$(printf '%s\n' "$languages" | gum choose --selected="French" --header="Select OS language:")
  if [ -z "$LANGUAGE" ]; then
    echo "Installation cancelled by user"
    exit 1
  fi

  # Display configuration summary
  gum style \
    --border normal \
    --padding "1 2" \
    --margin "1" \
    --align left \
    --bold \
    "Windows VM Configuration" \
    "" \
    "RAM:       $SELECTED_RAM" \
    "CPU:       $SELECTED_CORES cores" \
    "Disk:      $SELECTED_DISK" \
    "Username:  $USERNAME" \
    "Password:  $PASSWORD_DISPLAY" \
    "Language:  $LANGUAGE"

  # Ask for confirmation
  echo ""
  if ! gum confirm "Proceed with this configuration?"; then
    echo "Installation cancelled by user"
    exit 1
  fi

  mkdir -p $HOME/Windows

  # Create docker-compose.yml in user config directory
  cat << EOF | tee "$COMPOSE_FILE" > /dev/null
services:
  windows:
    image: dockurr/windows
    container_name: monarch-windows
    environment:
      VERSION: "11"
      RAM_SIZE: "$SELECTED_RAM"
      CPU_CORES: "$SELECTED_CORES"
      DISK_FMT: "qcow2"
      DISK_SIZE: "$SELECTED_DISK"
      USERNAME: "$USERNAME"
      PASSWORD: "$PASSWORD"
      LANGUAGE: "$LANGUAGE"
    devices:
      - /dev/kvm
      - /dev/net/tun
    cap_add:
      - NET_ADMIN
    ports:
      - 8006:8006
      - 3389:3389/tcp
      - 3389:3389/udp
    volumes:
      - $HOME/.windows:/storage
      - $HOME/Windows:/shared
    restart: always
    stop_grace_period: 2m
EOF

  echo ""
  echo "Starting Windows VM installation..."
  echo "This will download a Windows 11 image (may take 10-15 minutes)."
  echo ""
  echo "Monitor installation progress at: http://127.0.0.1:8006"
  echo ""

  # Start docker-compose with user's config
  echo "Starting Windows VM with docker-compose..."
  if ! docker-compose -f "$COMPOSE_FILE" up -d 2>&1; then
    echo "❌ Failed to start Windows VM!"
    echo "   Common issues:"
    echo "   - Docker daemon not running: sudo systemctl start docker"
    echo "   - Port already in use: check if another VM is running"
    echo "   - Permission issues: make sure you're in the docker group"
    exit 1
  fi

  echo ""
  echo "Windows VM is starting up!"
  echo ""
  echo "Opening browser to monitor installation..."

  # Open browser to monitor installation
  sleep 3
  xdg-open "http://127.0.0.1:8006"

  echo ""
  echo "Installation is running in the background."
  echo "You can monitor progress at: http://127.0.0.1:8006"
  echo ""
  echo "Once finished, launch 'Windows' via Super + Space"
  echo ""
  echo "To stop the VM: monarch-windows-vm stop"
  echo "To change resources: ~/.config/windows/docker-compose.yml"
  echo ""
}

remove_windows() {
  echo "Removing Windows VM..."

  docker-compose -f "$COMPOSE_FILE" down 2>/dev/null || true

  docker rmi dockurr/windows 2>/dev/null || echo "Image already removed or not found"

  rm "$HOME/.local/share/applications/windows-vm.desktop"
  rm -rf "$HOME/.config/windows"
  rm -rf "$HOME/.windows"

  echo ""
  echo "Windows VM removal completed!"
}

launch_windows() {
  KEEP_ALIVE=false
  if [ "$1" = "--keep-alive" ] || [ "$1" = "-k" ]; then
    KEEP_ALIVE=true
  fi

  # Check if config exists
  if [ ! -f "$COMPOSE_FILE" ]; then
    echo "Windows VM not configured. Please run: monarch-windows-vm install"
    exit 1
  fi

  # Check if container is already running
  CONTAINER_STATUS=$(docker inspect --format='{{.State.Status}}' monarch-windows 2>/dev/null)

  if [ "$CONTAINER_STATUS" != "running" ]; then
    echo "Starting Windows VM..."

    # Send desktop notification
    notify-send "    Starting Windows VM" "      This can take 15-30 seconds" -t 15000

    if ! docker-compose -f "$COMPOSE_FILE" up -d 2>&1; then
      echo "❌ Failed to start Windows VM!"
      echo "   Try checking: monarch-windows-vm status"
      echo "   View logs: docker logs monarch-windows"
      notify-send -u critical "Windows VM" "Failed to start Windows VM"
      exit 1
    fi

    # Wait for RDP to be ready
    echo "Waiting for Windows VM to be ready..."
    WAIT_COUNT=0
    while ! nc -z 127.0.0.1 3389 2>/dev/null; do
      sleep 2
      WAIT_COUNT=$((WAIT_COUNT + 1))
      if [ $WAIT_COUNT -gt 60 ]; then  # 2 minutes timeout
        echo "❌ Timeout waiting for RDP!"
        echo "   The VM might still be installing Windows."
        echo "   Check progress at: http://127.0.0.1:8006"
        exit 1
      fi
    done

    # Give it a moment more to fully initialize
    sleep 15
  fi

  # Extract credentials from compose file
  WIN_USER=$(grep "USERNAME:" "$COMPOSE_FILE" | sed 's/.*USERNAME: "\(.*\)"/\1/')
  WIN_PASS=$(grep "PASSWORD:" "$COMPOSE_FILE" | sed 's/.*PASSWORD: "\(.*\)"/\1/')

  # Use defaults if not found
  [ -z "$WIN_USER" ] && WIN_USER="docker"
  [ -z "$WIN_PASS" ] && WIN_PASS="admin"

  # Build the connection info
  if [ "$KEEP_ALIVE" = true ]; then
    LIFECYCLE="VM will keep running after RDP closes
To stop: monarch-windows-vm stop"
  else
    LIFECYCLE="VM will auto-stop when RDP closes"
  fi

  gum style \
    --border normal \
    --padding "1 2" \
    --margin "1" \
    --align center \
    "Connecting to Windows VM" \
    "" \
    "$LIFECYCLE"

  # Detect display scale from Hyprland
  HYPR_SCALE=$(hyprctl monitors -j | jq -r '.[] | select (.focused == true) | .scale')
  SCALE_PERCENT=$(echo "$HYPR_SCALE" | awk '{print int($1 * 100)}')

  RDP_SCALE=""
  if [ "$SCALE_PERCENT" -ge 170 ]; then
    RDP_SCALE="/scale:180"
  elif [ "$SCALE_PERCENT" -ge 130 ]; then
    RDP_SCALE="/scale:140"
  fi
  # If scale is less than 130%, don't set any scale (use default 100)

  # Connect with RDP in fullscreen (auto-detects resolution)
  xfreerdp3 /u:"$WIN_USER" /p:"$WIN_PASS" /v:127.0.0.1:3389 -grab-keyboard /sound /microphone /cert:ignore /title:"Windows VM - Monarch" /dynamic-resolution /gfx:AVC444 /floatbar:sticky:off,default:visible,show:fullscreen $RDP_SCALE

  # After RDP closes, stop the container unless --keep-alive was specified
  if [ "$KEEP_ALIVE" = false ]; then
    echo ""
    echo "RDP session closed. Stopping Windows VM..."
    docker-compose -f "$COMPOSE_FILE" down
    echo "Windows VM stopped."
  else
    echo ""
    echo "RDP session closed. Windows VM is still running."
    echo "To stop it: monarch-windows-vm stop"
  fi
}

stop_windows() {
  if [ ! -f "$COMPOSE_FILE" ]; then
    echo "Windows VM not configured."
    exit 1
  fi

  echo "Stopping Windows VM..."
  docker-compose -f "$COMPOSE_FILE" down
  echo "Windows VM stopped."
}

status_windows() {
  if [ ! -f "$COMPOSE_FILE" ]; then
    echo "Windows VM not configured."
    echo "To set up: monarch-windows-vm install"
    exit 1
  fi

  CONTAINER_STATUS=$(docker inspect --format='{{.State.Status}}' monarch-windows 2>/dev/null)

  if [ -z "$CONTAINER_STATUS" ]; then
    echo "Windows VM container not found."
    echo "To start: monarch-windows-vm launch"
  elif [ "$CONTAINER_STATUS" = "running" ]; then
    gum style \
      --border normal \
      --padding "1 2" \
      --margin "1" \
      --align left \
      "Windows VM Status: RUNNING" \
      "" \
      "Web interface: http://127.0.0.1:8006" \
      "RDP available: port 3389" \
      "" \
      "To connect: monarch-windows-vm launch" \
      "To stop:    monarch-windows-vm stop"
  else
    echo "Windows VM is stopped (status: $CONTAINER_STATUS)"
    echo "To start: monarch-windows-vm launch"
  fi
}

check_vm_stopped() {
  CONTAINER_STATUS=$(docker inspect --format='{{.State.Status}}' monarch-windows 2>/dev/null)

  if [ "$CONTAINER_STATUS" = "running" ]; then
    echo "❌ The Windows VM must be stopped before managing snapshots!"
    echo "   Stop it with: monarch-windows-vm stop"
    return 1
  fi

  return 0
}

list_snapshots() {
  local DISK_FILE="$HOME/.windows/data.qcow2"

  if ! command -v qemu-img >/dev/null 2>&1; then
    echo "❌ qemu-img not found!"
    echo "   Install it with: monarch-pkg-add qemu"
    exit 1
  fi

  # Use JSON output to reliably handle names with spaces
  local SNAP_JSON=$(qemu-img info --output=json "$DISK_FILE" 2>/dev/null)
  if [ -z "$SNAP_JSON" ] || [ "$(echo "$SNAP_JSON" | jq 'has("snapshots") and (.snapshots|length>0)')" != "true" ]; then
    gum style \
      --border normal \
      --padding "1 2" \
      --margin "1" \
      --foreground="240" \
      "No snapshots found"
    return
  fi

  local SNAPSHOT_COUNT=$(echo "$SNAP_JSON" | jq '.snapshots|length')

  {
    echo "ID  Name                 Date"
    echo "────────────────────────────────────────────────"
    echo "$SNAP_JSON" | jq -r '.snapshots[] | @base64' | while read -r row; do
      _jq(){ echo "$row" | base64 -d | jq -r "$1"; }
      ID=$(_jq '.id')
      NAME=$(_jq '.name')
      DATE_SECS=$(_jq '."date-sec" // empty')
      if [ -n "$DATE_SECS" ]; then
        DATE=$(date -d "@$DATE_SECS" "+%Y-%m-%d %H:%M:%S")
      else
        DATE=""
      fi
      printf "%-3s %-20s %s\n" "$ID" "$NAME" "$DATE"
    done
  } | gum style \
    --border normal \
    --padding "1 2" \
    --margin "1" \
    --foreground="250"
}

create_snapshot() {
  local SNAPSHOT_NAME="$1"

  if [ -z "$SNAPSHOT_NAME" ]; then
    SNAPSHOT_NAME=$(gum input --placeholder="snapshot-name" --header="Enter snapshot name:")
    if [ -z "$SNAPSHOT_NAME" ]; then
      echo "Snapshot creation cancelled"
      exit 1
    fi
  fi

  # Note: snapshot creation can work while VM is running, but it's safer when stopped
  CONTAINER_STATUS=$(docker inspect --format='{{.State.Status}}' monarch-windows 2>/dev/null)
  if [ "$CONTAINER_STATUS" = "running" ]; then
    echo ""
    gum style \
      --border normal \
      --padding "1 2" \
      --margin "1" \
      --foreground="yellow" \
      "⚠ Warning: VM is currently running" \
      "" \
      "Creating snapshot while VM is running may cause inconsistencies."
    echo ""
    if ! gum confirm "Continue anyway?"; then
      echo "Snapshot creation cancelled. Stop VM first: monarch-windows-vm stop"
      exit 1
    fi
  fi

  local DISK_FILE="$HOME/.windows/data.qcow2"
  [ $? -ne 0 ] && exit 1

  if ! command -v qemu-img >/dev/null 2>&1; then
    echo "❌ qemu-img not found!"
    echo "   Install it with: monarch-pkg-add qemu"
    exit 1
  fi

  echo "Creating snapshot: $SNAPSHOT_NAME"

  if qemu-img snapshot -c "$SNAPSHOT_NAME" "$DISK_FILE" 2>/dev/null; then
    gum style \
      --border normal \
      --padding "1 2" \
      --margin "1" \
      --foreground="green" \
      "✓ Snapshot '$SNAPSHOT_NAME' created successfully"
  else
    echo "❌ Failed to create snapshot: $SNAPSHOT_NAME"
    exit 1
  fi
}

restore_snapshot() {
  local SNAPSHOT_NAME="$1"

  if ! check_vm_stopped; then
    exit 1
  fi

  local DISK_FILE="$HOME/.windows/data.qcow2"
  [ $? -ne 0 ] && exit 1

  if ! command -v qemu-img >/dev/null 2>&1; then
    echo "❌ qemu-img not found!"
    echo "   Install it with: monarch-pkg-add qemu"
    exit 1
  fi

  # List available snapshots (support names with spaces)
  local SNAPSHOTS=$(qemu-img info --output=json "$DISK_FILE" 2>/dev/null | jq -r '.snapshots[].name')

  if [ -z "$SNAPSHOTS" ]; then
    echo "❌ No snapshots available to restore"
    exit 1
  fi

  if [ -z "$SNAPSHOT_NAME" ]; then
    SNAPSHOT_NAME=$(echo "$SNAPSHOTS" | gum choose --header="Select snapshot to restore:")
    if [ -z "$SNAPSHOT_NAME" ]; then
      echo "Snapshot restoration cancelled"
      exit 1
    fi
  fi

  # Verify snapshot exists
  if ! echo "$SNAPSHOTS" | grep -Fxq "$SNAPSHOT_NAME"; then
    echo "❌ Snapshot '$SNAPSHOT_NAME' not found"
    exit 1
  fi

  echo ""
  gum style \
    --border normal \
    --padding "1 2" \
    --margin "1" \
    --foreground="yellow" \
    "⚠ WARNING: Restoring snapshot '$SNAPSHOT_NAME'" \
    "" \
    "This will discard all changes made after this snapshot!"
  echo ""

  if ! gum confirm "Are you sure you want to continue?"; then
    echo "Snapshot restoration cancelled"
    exit 1
  fi

  echo "Restoring snapshot: $SNAPSHOT_NAME"

  if qemu-img snapshot -a "$SNAPSHOT_NAME" "$DISK_FILE" 2>/dev/null; then
    gum style \
      --border normal \
      --padding "1 2" \
      --margin "1" \
      --foreground="green" \
      "✓ Snapshot '$SNAPSHOT_NAME' restored successfully"
  else
    echo "❌ Failed to restore snapshot: $SNAPSHOT_NAME"
    exit 1
  fi
}

delete_snapshot() {
  local SNAPSHOT_NAME="$1"

  if ! check_vm_stopped; then
    exit 1
  fi

  local DISK_FILE="$HOME/.windows/data.qcow2"
  [ $? -ne 0 ] && exit 1

  if ! command -v qemu-img >/dev/null 2>&1; then
    echo "❌ qemu-img not found!"
    echo "   Install it with: monarch-pkg-add qemu"
    exit 1
  fi

  # List available snapshots (support names with spaces)
  local SNAPSHOTS=$(qemu-img info --output=json "$DISK_FILE" 2>/dev/null | jq -r '.snapshots[].name')

  if [ -z "$SNAPSHOTS" ]; then
    echo "❌ No snapshots available to delete"
    exit 1
  fi

  if [ -z "$SNAPSHOT_NAME" ]; then
    SNAPSHOT_NAME=$(echo "$SNAPSHOTS" | gum choose --header="Select snapshot to delete:")
    if [ -z "$SNAPSHOT_NAME" ]; then
      echo "Snapshot deletion cancelled"
      exit 1
    fi
  fi

  # Verify snapshot exists
  if ! echo "$SNAPSHOTS" | grep -Fxq "$SNAPSHOT_NAME"; then
    echo "❌ Snapshot '$SNAPSHOT_NAME' not found"
    exit 1
  fi

  echo ""
  gum style \
    --border normal \
    --padding "1 2" \
    --margin "1" \
    --foreground="red" \
    "⚠ WARNING: Deleting snapshot '$SNAPSHOT_NAME'" \
    "" \
    "This action cannot be undone!"
  echo ""

  if ! gum confirm "Are you sure you want to delete this snapshot?"; then
    echo "Snapshot deletion cancelled"
    exit 1
  fi

  echo "Deleting snapshot: $SNAPSHOT_NAME"

  if qemu-img snapshot -d "$SNAPSHOT_NAME" "$DISK_FILE" 2>/dev/null; then
    gum style \
      --border normal \
      --padding "1 2" \
      --margin "1" \
      --foreground="green" \
      "✓ Snapshot '$SNAPSHOT_NAME' deleted successfully"
  else
    echo "❌ Failed to delete snapshot: $SNAPSHOT_NAME"
    exit 1
  fi
}

manage_snapshots() {
  local SUBCOMMAND="$1"
  local SNAPSHOT_NAME="$2"

  case "$SUBCOMMAND" in
    list|ls)
      list_snapshots
      ;;
    create|add)
      create_snapshot "$SNAPSHOT_NAME"
      ;;
    restore|rollback)
      restore_snapshot "$SNAPSHOT_NAME"
      ;;
    delete|remove|rm)
      delete_snapshot "$SNAPSHOT_NAME"
      ;;
    help|--help|-h|"")
      echo "Usage: monarch-windows-vm snapshot [command] [name]"
      echo ""
      echo "Commands:"
      echo "  list, ls            List all snapshots"
      echo "  create, add [name]  Create a new snapshot"
      echo "                       (works while VM is running, but safer when stopped)"
      echo "  restore [name]     Restore a snapshot (VM must be stopped)"
      echo "  delete [name]      Delete a snapshot (VM must be stopped)"
      echo "  help               Show this help message"
      echo ""
      echo "Examples:"
      echo "  monarch-windows-vm snapshot list              # List all snapshots"
      echo "  monarch-windows-vm snapshot create            # Create snapshot (interactive)"
      echo "  monarch-windows-vm snapshot create before-update  # Create named snapshot"
      echo "  monarch-windows-vm snapshot restore           # Restore snapshot (interactive)"
      echo "  monarch-windows-vm snapshot restore before-update  # Restore specific snapshot"
      echo "  monarch-windows-vm snapshot delete            # Delete snapshot (interactive)"
      echo ""
      echo "Note: VM must be stopped before restore/delete operations"
      ;;
    *)
      echo "Unknown snapshot command: $SUBCOMMAND" >&2
      echo "" >&2
      manage_snapshots help >&2
      exit 1
      ;;
  esac
}

show_usage() {
  echo "Usage: monarch-windows-vm [command] [options]"
  echo ""
  echo "Commands:"
  echo "  install              Install and configure Windows VM"
  echo "  remove               Remove Windows VM and optionally its data"
  echo "  launch [options]     Start Windows VM (if needed) and connect via RDP"
  echo "                       Options:"
  echo "                         --keep-alive, -k   Keep VM running after RDP closes"
  echo "  stop                 Stop the running Windows VM"
  echo "  status               Show current VM status"
  echo "  snapshot [cmd]       Manage VM snapshots"
  echo "                       Commands: list, create, restore, delete"
  echo "                       See: monarch-windows-vm snapshot help"
  echo "  help                 Show this help message"
  echo ""
  echo "Examples:"
  echo "  monarch-windows-vm install           # Set up Windows VM for first time"
  echo "  monarch-windows-vm launch            # Connect to VM (auto-stop on exit)"
  echo "  monarch-windows-vm launch -k         # Connect to VM (keep running)"
  echo "  monarch-windows-vm stop              # Shut down the VM"
  echo "  monarch-windows-vm snapshot list     # List all snapshots"
  echo "  monarch-windows-vm snapshot create   # Create a snapshot"
}

# Main command dispatcher
case "$1" in
  install)
    install_windows
    ;;
  remove)
    remove_windows
    ;;
  launch|start)
    launch_windows "$2"
    ;;
  stop|down)
    stop_windows
    ;;
  status)
    status_windows
    ;;
  snapshot)
    manage_snapshots "$2" "$3"
    ;;
  help|--help|-h|"")
    show_usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo "" >&2
    show_usage >&2
    exit 1
    ;;
esac
