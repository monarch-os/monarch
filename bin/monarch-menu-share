#!/bin/bash

# monarch:summary=Share clipboard, files, or folders with LocalSend
# monarch:group=share
# monarch:name=
# monarch:args=<clipboard|file|folder> [path...]
# monarch:examples=monarch share clipboard | monarch share file ~/Downloads/example.txt

if (($# == 0)); then
  echo "Usage: monarch-menu-share [clipboard|file|folder]"
  exit 1
fi

MODE="$1"
shift

if [[ $MODE == "clipboard" ]]; then
  # Never cleaned up: LocalSend reads the file when the transfer starts, not
  # when it is queued here, so deleting it on the way out sends an empty file.
  TEMP_FILE=$(mktemp --suffix=.txt)
  wl-paste >"$TEMP_FILE"
  FILE_ARRAY=("$TEMP_FILE")
elif (($# > 0)); then
  FILE_ARRAY=("$@")
else
  if [[ $MODE == "folder" ]]; then
    select_args=(--title "Choose a folder to share" --directory)
  else
    select_args=(--title "Choose files to share" --multiple)
  fi

  # Command substitution so the chooser's exit status survives: reading it
  # through a process substitution reports success for a chooser that never
  # opened, which is indistinguishable here from someone deciding not to share.
  picked=$(monarch-file-select "${select_args[@]}") || status=$?

  if ((${status:-0} > 1)); then
    monarch-notification-send -g "" "Could not share" "The file chooser did not open" -u critical
    exit 1
  fi

  [[ -n $picked ]] || exit 0
  readarray -t FILE_ARRAY <<<"$picked"
fi

# Run LocalSend in its own systemd service (detached from terminal)
systemd-run --user --quiet --collect localsend --headless send "${FILE_ARRAY[@]}"

exit 0
