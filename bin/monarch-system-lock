#!/bin/bash

# monarch:summary=Lock the computer without turning off the display
# monarch:group=system
# monarch:name=lock
# monarch:examples=monarch system lock

lock_status=0
noctalia msg session lock >/dev/null 2>&1 || lock_status=$?
if (( lock_status != 0 )); then
  echo "Noctalia could not accept the screen lock request" >&2
fi

if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

pkill -f '[o]rg.monarch.screensaver'

if [[ ${MONARCH_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    monarch-brightness-keyboard off
  ) &
fi

exit "$lock_status"
