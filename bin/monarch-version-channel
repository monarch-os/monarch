#!/bin/bash

# monarch:summary=Print the active Monarch channel (the git branch tracked by the Monarch repository)

if [[ -d $MONARCH_PATH/.git ]]; then
  branch=$(git -C "$MONARCH_PATH" branch --show-current 2>/dev/null)
else
  branch=main
fi

case "$branch" in
main) echo "stable" ;;
dev) echo "dev" ;;
"") echo "unknown" ;;
*) echo "$branch" ;;
esac
