#!/bin/bash

# monarch:summary=Read/write Monarch's generated niri runtime overrides (input on-off, per-output scale)
# monarch:args=input <touchpad|touch> <on|off|toggle> | output-scale <name> <scale>
# monarch:hidden=true

# Single owner of ~/.config/niri/runtime.kdl — the one generated include holding
# every runtime override Monarch applies to niri (input device on-off, per-output
# scale, …). Keeping it in one file avoids littering ~/.config/niri with cryptic
# per-feature includes. niri allows one `input {}` plus any number of distinct
# `output "name" {}` blocks in the same file, merges it onto the rest of the
# config, and live-reloads when it changes; user.kdl is included afterwards so a
# manual setting there still wins.

set -uo pipefail

FILE="$HOME/.config/niri/runtime.kdl"

# --- Read the full current state (this file is ours, so the format is known) ---
touchpad_off=false
touch_off=false
declare -A out_scale=()
if [[ -f $FILE ]]; then
  grep -qF 'touchpad {' "$FILE" && touchpad_off=true
  # "touch {" cannot match the "touchpad {" line (no space after "touch").
  grep -qF 'touch {' "$FILE" && touch_off=true
  while IFS=$'\t' read -r name val; do
    [[ -n $name ]] && out_scale["$name"]="$val"
  done < <(awk '
    match($0, /^output "([^"]+)" \{/, m) { cur = m[1]; next }
    cur != "" && match($0, /^[[:space:]]*scale[[:space:]]+([0-9.]+)/, s) { print cur "\t" s[1]; cur = "" }
  ' "$FILE")
fi

regenerate_and_reload() {
  mkdir -p "$(dirname "$FILE")"
  local tmp name
  tmp=$(mktemp "${FILE}.XXXXXX")
  {
    echo "// GENERATED by Monarch — niri runtime overrides. Do not edit:"
    echo "// rewritten by monarch-toggle-touchpad / monarch-toggle-touchscreen"
    echo "// (device on-off) and monarch-niri-monitor-scaling-cycle (output scale)."
    echo "// niri merges this onto its config and live-reloads on change; your own"
    echo "// settings in user.kdl are included afterwards and win on conflict."
    if $touchpad_off || $touch_off; then
      echo
      echo "input {"
      $touchpad_off && printf '    touchpad {\n        off\n    }\n'
      $touch_off && printf '    touch {\n        off\n    }\n'
      echo "}"
    fi
    for name in $(printf '%s\n' "${!out_scale[@]}" | sort); do
      printf '\noutput "%s" {\n    scale %s\n}\n' "$name" "${out_scale[$name]}"
    done
  } >"$tmp"
  mv -f "$tmp" "$FILE"

  # niri watches included files and live-reloads, but nudge it so changes feel
  # instant and apply even if the watcher missed the write.
  if pgrep -x niri >/dev/null 2>&1; then
    niri msg action reload-config >/dev/null 2>&1 || true
  fi
}

usage() {
  echo "usage: $(basename "$0") input <touchpad|touch> <on|off|toggle>" >&2
  echo "       $(basename "$0") output-scale <name> <scale>" >&2
  exit 1
}

case "${1:-}" in
  input)
    device="${2:-}"
    action="${3:-toggle}"
    case "$device" in
      touchpad) cur=$touchpad_off ;;
      touch) cur=$touch_off ;;
      *) usage ;;
    esac
    case "$action" in
      on) new=false ;;
      off) new=true ;;
      toggle) if $cur; then new=false; else new=true; fi ;;
      *) usage ;;
    esac
    if [[ $device == touchpad ]]; then touchpad_off=$new; else touch_off=$new; fi
    regenerate_and_reload
    # Echo the resulting state so the caller can craft its notification.
    $new && echo "disabled" || echo "enabled"
    ;;
  output-scale)
    name="${2:-}"
    scale="${3:-}"
    [[ -z $name || -z $scale ]] && usage
    out_scale["$name"]="$scale"
    regenerate_and_reload
    ;;
  *) usage ;;
esac
