#!/bin/bash

# monarch:summary=Update an installed Git theme
# monarch:args=[theme-id]
# monarch:examples=monarch theme update tokyo-night

set -euo pipefail

id=${1:-}
if [[ -z $id ]]; then
  selection=$(monarch-theme-bundle list | gum choose --header "Update theme" --no-limit=1)
  [[ -n $selection ]] || exit 0
  id=${selection%%$'\t'*}
fi

active=$(noctalia msg color-scheme-get 2>/dev/null || true)
active=${active#custom }
result=$(monarch-theme-bundle update "$id")
IFS=$'\t' read -r id name <<<"$result"
if [[ $active == "$name" ]]; then
  monarch-theme-set "$name"
fi
echo "Updated $name ($id)"
