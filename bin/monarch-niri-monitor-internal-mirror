#!/bin/bash

# monarch:summary=Enable, disable, toggle, or recover mirroring the laptop display onto an external monitor
# monarch:args=<on|off|toggle|recover>

# niri has no native output mirroring (the `output` block only does mode/scale/
# transform/position), so we can't reproduce the Hyprland `monitor=…,mirror,eDP`
# line. The niri-documented approach is wl-mirror: it screencopies a source
# output into a client window which we send fullscreen onto the target output.
# Here the source is the internal eDP panel and the target is the external
# monitor — the "presentation mode" the old SUPER+CTRL+ALT+Delete gave us.
#
#   https://niri-wm.github.io/niri/Screencasting.html#screen-mirroring

APP_ID="at.yrlf.wl_mirror"

# Connector names, read live from niri so a rename can't break us. niri exposes
# them as the wl_output names wl-mirror expects for both the source arg and
# --fullscreen-output (see monarch-niri-monitor-internal for the eDP query).
INTERNAL=$(niri msg --json outputs 2>/dev/null | jq -r 'to_entries[] | select(.key | test("eDP")) | .key' | head -n1)
EXTERNAL=$(niri msg --json outputs 2>/dev/null | jq -r 'to_entries[] | select(.key | test("eDP") | not) | .key' | head -n1)

# wl-mirror keeps running for the lifetime of the mirror; its presence IS the
# state. Match the process we own rather than poll niri windows so toggle reacts
# instantly (the window maps a beat after spawn).
is_on() {
  pgrep -x wl-mirror >/dev/null 2>&1
}

enable() {
  if ! command -v wl-mirror >/dev/null 2>&1; then
    notify-send -u normal "󰍹    Mirroring unavailable" "wl-mirror is not installed."
    exit 1
  fi
  if [[ -z $EXTERNAL ]]; then
    notify-send -u low "󰍹    No external monitor found for mirror"
    exit 1
  fi
  if [[ -z $INTERNAL ]]; then
    notify-send -u low "󰍹    No laptop display found to mirror"
    exit 1
  fi

  # Mirroring screencopies the eDP buffer, so the panel must be on — re-enable it
  # in case monarch-niri-monitor-internal had turned it off.
  niri msg output "$INTERNAL" on >/dev/null 2>&1

  is_on && return  # already mirroring

  setsid uwsm-app -- wl-mirror --fullscreen-output "$EXTERNAL" "$INTERNAL" >/dev/null 2>&1 &
  notify-send -u low "󰍹    Mirroring enabled ($EXTERNAL)"
}

disable() {
  is_on || return
  pkill -x wl-mirror >/dev/null 2>&1
  notify-send -u low "󰍹    Extended mode restored"
}

# Unplugging the external monitor mid-session strands the mirror on the laptop
# (a feedback loop), so tear it down when no external display is left.
recover() {
  if is_on && ! monarch-hw-external-monitors; then
    pkill -x wl-mirror >/dev/null 2>&1
  fi
}

case "${1:-toggle}" in
  on) enable ;;
  off) disable ;;
  toggle) if is_on; then disable; else enable; fi ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
