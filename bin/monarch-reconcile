#!/bin/bash

# monarch:summary=Converge an existing Monarch installation onto the current packaged state.
# monarch:requires-sudo=true

set -euo pipefail

CURRENT_SCHEMA=2
MIN_SUPPORTED_SCHEMA=1
LEGACY_FLOOR_MARKER=1787067946.sh
state_dir="$HOME/.local/state/monarch"
schema_file="$state_dir/schema"
legacy_root="$HOME/.local/share/monarch"
plugin_hook="$HOME/.config/monarch/hooks/post-boot.d/noctalia-v5-plugins"
runtime_hook="$HOME/.config/monarch/hooks/post-boot.d/packaged-runtime"

complete_reconciliation() {
  [[ ! -e $plugin_hook && ! -e $runtime_hook ]] || return 0
  if [[ -f $schema_file ]]; then
    existing_schema=$(<"$schema_file")
    [[ $existing_schema =~ ^[0-9]+$ ]] || return 1
    ((existing_schema <= CURRENT_SCHEMA)) || return 1
  fi
  mkdir -p "$state_dir"
  printf '%s\n' "$CURRENT_SCHEMA" >"$schema_file.tmp"
  mv "$schema_file.tmp" "$schema_file"
  rm -rf "$state_dir/reconcile"
}

if [[ ${1:-} == "--complete" ]]; then
  complete_reconciliation
  exit
fi

source_root=${MONARCH_PATH:-$HOME/.local/share/monarch}
runtime_root=${MONARCH_RUNTIME_ROOT:-/usr/share/monarch}

if monarch-pkg-missing monarch || [[ ! -x $runtime_root/bin/monarch ]]; then
  echo "Install the packaged Monarch runtime"
  source "$source_root/install/reconcile/packaged-runtime-bootstrap.sh"
  legacy_supported=false
  if [[ $source_root == $legacy_root && -d $source_root && ! -L $source_root && \
    -f $state_dir/migrations/$LEGACY_FLOOR_MARKER ]]; then
    legacy_supported=true
  fi
  monarch_install_packaged_runtime "$legacy_supported"
fi

if monarch-pkg-missing monarch || [[ ! -x $runtime_root/bin/monarch ]]; then
  echo "The Monarch package did not provide $runtime_root/bin/monarch" >&2
  exit 1
fi

export MONARCH_PATH=$runtime_root
export PATH="$runtime_root/bin:$PATH"

if [[ -f $schema_file ]]; then
  schema=$(<"$schema_file")
  [[ $schema =~ ^[0-9]+$ ]] || {
    echo "Invalid Monarch installation schema: $schema" >&2
    exit 1
  }
elif [[ -d $legacy_root && ! -L $legacy_root ]] ||
  monarch-pkg-present noctalia-shell || [[ -f $HOME/.config/noctalia/settings.json ]]; then
  if [[ ! -f $state_dir/migrations/$LEGACY_FLOOR_MARKER ]]; then
    echo "This legacy installation predates the supported v4 upgrade baseline." >&2
    echo "Update it fully on the v4 branch before moving to Noctalia v5." >&2
    exit 1
  fi
  schema=1
else
  schema=$CURRENT_SCHEMA
fi

if ((schema < MIN_SUPPORTED_SCHEMA)); then
  echo "Monarch schema $schema is no longer supported; use a supported intermediate release or reinstall." >&2
  exit 1
fi

if ((schema > CURRENT_SCHEMA)); then
  echo "Monarch schema $schema is newer than this runtime; refusing to downgrade it." >&2
  exit 1
fi

bash "$runtime_root/install/reconcile/required-packages.sh"
bash "$runtime_root/install/reconcile/system.sh"

while ((schema < CURRENT_SCHEMA)); do
  next_schema=$((schema + 1))
  transition="$runtime_root/install/reconcile/schema/$schema-to-$next_schema"
  [[ -d $transition ]] || {
    echo "Missing Monarch schema transition: $schema to $next_schema" >&2
    exit 1
  }
  [[ ! -f $transition/system.sh ]] || bash "$transition/system.sh"
  [[ ! -f $transition/user.sh ]] || bash "$transition/user.sh"
  [[ ! -f $transition/system-after-user.sh ]] || bash "$transition/system-after-user.sh"
  schema=$next_schema
done

bash "$runtime_root/install/reconcile/user.sh"
complete_reconciliation
