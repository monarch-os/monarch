#!/bin/bash

# monarch:summary=Set up fingerprint authentication for sudo, polkit, and lock screen
# monarch:requires-sudo=true

set -e


check_fingerprint_hardware() {
  # Get fingerprint devices for the user
  devices=$(fprintd-list "$USER" 2>/dev/null)

  # Exit if no devices found
  if [[ -z $devices ]]; then
    echo -e "\e[31m\nNo fingerprint sensor detected.\e[0m"
    return 1
  fi
  return 0
}

setup_pam_config() {
  # Configure sudo
  if ! grep -q pam_fprintd.so /etc/pam.d/sudo; then
    echo "Configuring sudo for fingerprint authentication..."
    sudo sed -i '1i auth    sufficient pam_fprintd.so' /etc/pam.d/sudo
  fi

  # Configure polkit
  if [[ -f /etc/pam.d/polkit-1 ]] && ! grep -q 'pam_fprintd.so' /etc/pam.d/polkit-1; then
    echo "Configuring polkit for fingerprint authentication..."
    sudo sed -i '1i auth      sufficient pam_fprintd.so' /etc/pam.d/polkit-1
  elif [[ ! -f /etc/pam.d/polkit-1 ]]; then
    echo "Creating polkit configuration with fingerprint authentication..."
    sudo tee /etc/pam.d/polkit-1 >/dev/null <<'EOF'
auth      sufficient pam_fprintd.so
auth      required pam_unix.so
account   required pam_unix.so
password  required pam_unix.so
session   required pam_unix.so
EOF
  fi
}

setup_noctalia_lockscreen() {
  # Noctalia's lock screen never reads /etc/pam.d/sudo or polkit-1. It
  # authenticates through its own PAM service, taken from NOCTALIA_PAM_SERVICE
  # (otherwise auto-detected as login/system-auth/common-auth). Give it a
  # dedicated service rather than editing system-auth, which would also expose
  # sudo to CVE-2024-37408 background fingerprint hijacking.
  if ! grep -q pam_fprintd.so /etc/pam.d/noctalia 2>/dev/null; then
    echo "Configuring Noctalia lock screen for fingerprint authentication..."
    sudo tee /etc/pam.d/noctalia >/dev/null <<'EOF'
#%PAM-1.0
# Managed by Monarch (monarch-setup-security-fingerprint).
# Fingerprint first, password (system-auth) as fallback.
auth      sufficient pam_fprintd.so
auth      include    system-auth
account   include    system-auth
password  include    system-auth
session   include    system-auth
EOF
  fi

  # Point Noctalia at that service. environment.d is read by the systemd user
  # manager at login, so the uwsm-launched shell inherits it. Deliberately kept
  # out of the versioned Niri config: setting NOCTALIA_PAM_SERVICE globally for
  # users without /etc/pam.d/noctalia would route them to pam_deny and lock
  # them out of their own screen.
  mkdir -p "$HOME/.config/environment.d"
  cat >"$HOME/.config/environment.d/noctalia-fingerprint.conf" <<'EOF'
# Managed by Monarch (monarch-setup-security-fingerprint).
# Removed by monarch-remove-security-fingerprint.
NOCTALIA_PAM_SERVICE=noctalia
EOF

  # Arm the reader the moment the lock screen appears. Without autoStartAuth
  # Noctalia only invokes PAM once you start typing, so the sensor stays idle
  # and a finger tap does nothing.
  local cfg="$HOME/.config/noctalia/settings.json"
  if command -v jq >/dev/null; then
    [[ -f $cfg ]] || { mkdir -p "$(dirname "$cfg")"; echo '{}' >"$cfg"; }
    local tmp
    tmp=$(mktemp)
    if jq '.general = (.general // {})
           | .general.autoStartAuth = true
           | .general.allowPasswordWithFprintd = true' "$cfg" >"$tmp"; then
      mv "$tmp" "$cfg"
    else
      rm -f "$tmp"
      echo -e "\e[33mWarning: could not update $cfg; set general.autoStartAuth manually.\e[0m"
    fi
  fi

  # Restart so Noctalia reloads the toggles; otherwise it rewrites settings.json
  # from memory on logout and reverts them.
  if command -v monarch-restart-noctalia >/dev/null && pgrep -f 'qs.*noctalia-shell' >/dev/null 2>&1; then
    echo "Restarting Noctalia so the lock screen picks up the new settings..."
    monarch-restart-noctalia
  fi
}

add_fingerprint_marker() {
  # Noctalia's lock screen delegates to PAM (pam_fprintd.so via the dedicated
  # noctalia service). Persist a marker so the rest of Monarch can adapt UI
  # hints accordingly.
  mkdir -p "$HOME/.local/state/monarch"
  touch "$HOME/.local/state/monarch/fingerprint-enabled"
}

echo -e "\e[32mSetting up fingerprint scanner for authentication.\n\e[0m"

# Install required packages
echo "Installing required packages..."

# libfprint-git provides+conflicts libfprint; pacman -S --noconfirm
# defaults the conflict prompt to N and aborts. Pre-remove libfprint
# with -Rdd so the install goes silent. -Rdd (not monarch-pkg-drop's
# -Rns) is required because fprintd requires libfprint; the dep is
# re-satisfied immediately by libfprint-git's provides=libfprint.
if monarch-pkg-present libfprint; then
  sudo pacman -Rdd --noconfirm libfprint
fi

monarch-pkg-add libfprint-git fprintd usbutils

if ! check_fingerprint_hardware; then
  exit 1
fi

# Configure PAM
setup_pam_config

# Wire up the Noctalia lock screen (PAM service + env var + settings)
setup_noctalia_lockscreen

# Record that fingerprint auth is enabled for downstream Monarch tooling
add_fingerprint_marker

# Enroll first fingerprint
echo -e "\e[32m\nLet's setup your right index finger as the first fingerprint.\e[0m"
echo -e "Keep moving the finger around on sensor until the process completes.\n"

if sudo fprintd-enroll "$USER"; then
  echo -e "\e[32m\nFingerprint enrolled successfully!\e[0m"

  # Verify
  echo -e "\nNow let's verify that it's working correctly.\n"
  if fprintd-verify; then
    echo -e "\e[32m\nPerfect! Fingerprint authentication is now configured.\e[0m"
    echo "You can use your fingerprint for sudo, polkit, and the lock screen (Super + L)."
    echo -e "\e[33mLog out and back in so the lock screen picks up the fingerprint reader.\e[0m"
  else
    echo -e "\e[31m\nVerification failed. You may want to try enrolling again.\e[0m"
  fi
else
  echo -e "\e[31m\nEnrollment failed. Please try again.\e[0m"
  exit 1
fi
