#!/bin/bash

# monarch:summary=Install a packaged app, surfacing the install in a floating terminal
# monarch:args=<display-name> <packages>
# monarch:examples=monarch install app 'LM Studio' lmstudio-bin

name="${1-}"
packages="${2-}"

if [[ -z $name || -z $packages ]]; then
  echo "Usage: monarch-install-app <display-name> <packages>" >&2
  exit 1
fi

MONARCH_ROOT=${MONARCH_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}
source "$MONARCH_ROOT/install/helpers/install-app.sh" || exit 1
install_command=$(monarch_install_app_command "$name" "$packages") || exit 1

exec monarch-launch-floating-terminal-with-presentation "$install_command"
