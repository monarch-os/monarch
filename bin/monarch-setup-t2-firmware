#!/bin/bash

# monarch:summary=Install T2 Wi-Fi and Bluetooth firmware extracted from macOS
# monarch:args=[install|stage <disk> <archive>|build <archive> <package>]
# monarch:examples=monarch setup t2-firmware
# monarch:requires-sudo=true

set -euo pipefail

MONARCH_PATH=${MONARCH_PATH:-/usr/share/monarch}
NORMALIZER=${MONARCH_T2_FIRMWARE_NORMALIZER:-$MONARCH_PATH/assets/t2/firmware.py}
PACKAGE_NAME=apple-bcm-firmware-local

usage() {
  cat <<'EOF'
Usage: monarch setup t2-firmware
       monarch-setup-t2-firmware stage <disk> <archive>
       monarch-setup-t2-firmware build <archive> <package>

The source archive is created from macOS with the t2linux firmware tool. Monarch
never executes scripts stored on the EFI partition and never uploads firmware.

Run these commands in macOS before installing Monarch:

  curl -fL https://raw.githubusercontent.com/t2linux/wiki/5e79e6ed1481571df10d86c13ee35d5cbf5ef1ec/docs/tools/firmware.sh \
    -o /tmp/monarch-t2-firmware.sh
  printf '%s  %s\n' c1c1d8aa25bb5f089e46ccd0d9738fc13bfbd784f499aa924466c690f059961e \
    /tmp/monarch-t2-firmware.sh | shasum -a 256 -c -
  bash /tmp/monarch-t2-firmware.sh copy_to_efi

The Monarch installer discovers the resulting archive before changing the disk.
EOF
}

require_root() {
  if (( EUID != 0 )); then
    echo "Run this command with sudo." >&2
    exit 1
  fi
}

stage_archive() {
  local disk=$1 destination=$2 device type fstype parttype parent mountpoint mounted candidate
  if [[ -n ${MONARCH_T2_FIRMWARE_ESP_ROOT:-} ]]; then
    candidate="$MONARCH_T2_FIRMWARE_ESP_ROOT/firmware-raw.tar.gz"
    if [[ -f $candidate ]]; then
      python "$NORMALIZER" verify "$candidate" >/dev/null
      install -Dm600 "$candidate" "$destination"
      echo "Staged T2 firmware from $candidate"
      return
    fi
    echo "No prepared T2 firmware archive was found in $MONARCH_T2_FIRMWARE_ESP_ROOT." >&2
    return 2
  fi

  while IFS=$'\x1f' read -r device type fstype parttype parent; do
    [[ $type == "part" ]] || continue
    [[ -z $disk || $parent == "$disk" ]] || continue
    [[ ${parttype,,} == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" || $fstype == "vfat" ]] || continue

    mounted=0
    mountpoint=$(findmnt -rn -S "$device" -o TARGET | head -n 1 || true)
    if [[ -z $mountpoint ]]; then
      mountpoint=$(mktemp -d)
      if ! mount -o ro "$device" "$mountpoint"; then
        rmdir "$mountpoint"
        continue
      fi
      mounted=1
    fi

    for candidate in "$mountpoint/firmware-raw.tar.gz" \
      "$mountpoint/monarch/firmware-raw.tar.gz"; do
      if [[ -f $candidate ]] && python "$NORMALIZER" verify "$candidate" >/dev/null; then
        install -Dm600 "$candidate" "$destination"
        echo "Staged T2 firmware from $device"
        (( mounted )) && umount "$mountpoint"
        (( mounted )) && rmdir "$mountpoint"
        return 0
      fi
    done

    (( mounted )) && umount "$mountpoint"
    (( mounted )) && rmdir "$mountpoint"
  done < <(
    lsblk -Jp -o PATH,TYPE,FSTYPE,PARTTYPE,PKNAME |
      jq -r '.blockdevices[] | recurse(.children[]?) | select(.type == "part") |
        [.path, .type, (.fstype // ""), (.parttype // ""), (.pkname // "")] | join("\u001f")'
  )

  echo "No prepared T2 firmware archive was found${disk:+ on the EFI partitions of $disk}." >&2
  return 2
}

build_package() {
  local source=$1 destination
  destination=$(realpath -m "$2")
  mkdir -p "$(dirname "$destination")"
  python "$NORMALIZER" package "$source" "$destination" >/dev/null
  echo "Built $destination"
}

install_firmware() {
  local disk=${1:-} source package work
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  source="$work/firmware-raw.tar.gz"
  package="$work/$PACKAGE_NAME-1-1-any.pkg.tar.gz"
  stage_archive "$disk" "$source"
  build_package "$source" "$package"
  pacman -U --noconfirm "$package"
  modprobe -r brcmfmac_wcc 2>/dev/null || true
  modprobe -r brcmfmac 2>/dev/null || true
  modprobe brcmfmac
  modprobe -r hci_bcm4377 2>/dev/null || true
  modprobe hci_bcm4377 2>/dev/null || true
  rm -rf "$work"
  trap - EXIT
}

[[ -x $NORMALIZER || -f $NORMALIZER ]] || {
  echo "T2 firmware normalizer not found: $NORMALIZER" >&2
  exit 1
}

case ${1:-install} in
  install)
    require_root
    shift || true
    install_firmware "${1:-}"
    ;;
  stage)
    [[ $# == 3 ]] || { usage >&2; exit 2; }
    [[ -n ${MONARCH_T2_FIRMWARE_ESP_ROOT:-} || ${MONARCH_T2_FIRMWARE_ALLOW_UNPRIVILEGED:-0} == 1 ]] || require_root
    stage_archive "$2" "$3"
    ;;
  build)
    [[ $# == 3 ]] || { usage >&2; exit 2; }
    build_package "$2" "$3"
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
