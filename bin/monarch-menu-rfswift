#!/bin/bash

# monarch:summary=Display RFSwift wrapper

export PATH="$HOME/.local/bin:$PATH"

RFSWIFT_REPO="penthertz/rfswift_noble"
# rfswift has no config hook for the workspace root (its DefaultWorkspaceRoot()
# is hardcoded to ~/rfswift-workspace), so we always pass --workspace explicitly.
RFSWIFT_WORKSPACE_ROOT="$HOME/Work/rfswift"

# gum pickers for the creation wizard (cmd_create). The wizard runs inside a
# floating terminal, so the whole flow stays in the TUI instead of popping GUI
# dialogs.
menu() {
  local prompt="$1" options="$2"
  echo -e "$options" | grep -v '^[[:space:]]*$' | gum choose --header "$prompt"
}

input() {
  local prompt="$1"
  gum input --placeholder "$prompt"
}

# Pick a single file with yazi (chooser mode). Prints the chosen path, or
# nothing if the user quits without selecting.
pick_file() {
  local out path
  out=$(mktemp)
  yazi --chooser-file="$out" "$HOME"
  path=$(head -n1 "$out" 2>/dev/null)
  rm -f "$out"
  [[ -n "$path" ]] && printf '%s\n' "$path"
}

# Spawn a fresh, centered floating terminal running `monarch-menu-rfswift <args>`.
# Same presentation launcher used by the picker and the SSH manager.
launch_in_terminal() {
  monarch-launch-floating-terminal-with-presentation monarch-menu-rfswift "$@"
}

# Show container info (rendered as the fzf preview panel)
cmd_info() {
  local name="$1"

  if [[ "$name" == "__create__" ]]; then
    cat <<'EOF'
Create a new RF Swift workspace.

You will be guided through:
  • Image selection
  • Container name
  • VPN configuration (OpenVPN or WireGuard, optional)
  • Session recording (optional)
  • Desktop mode (optional)
EOF
    return 0
  fi

  local inspect
  inspect=$(docker inspect "$name" --format json 2>/dev/null)
  if [[ -z "$inspect" ]]; then
    echo "Container not found: $name"
    return 1
  fi

  local jq_get='def get: .[0];'

  local image state status network workspace
  image=$(echo "$inspect" | jq -r "$jq_get get.Config.Image" | sed 's|.*:||')
  state=$(echo "$inspect" | jq -r "$jq_get get.State.Status")
  status=$(docker ps -a -f "name=^${name}$" --format '{{.Status}}')
  network=$(echo "$inspect" | jq -r "$jq_get get.HostConfig.NetworkMode")
  workspace=$(echo "$inspect" | jq -r "$jq_get [get.Mounts[] | select(.Destination == \"/root/workspace\")] | .[0].Source // \"N/A\"")

  # VPN from mounts (rfswift mounts the VPN config inside the container)
  local vpn
  vpn=$(echo "$inspect" | jq -r "$jq_get [get.Mounts[] | select(.Destination | test(\"vpn|wireguard|wg|ovpn\"))] | .[0].Source // empty")

  # Ports
  local ports
  ports=$(echo "$inspect" | jq -r "$jq_get [get.NetworkSettings.Ports // {} | to_entries[] | select(.value != null) | \"\(.key) → \(.value[0].HostPort)\"] | join(\", \")")

  # Devices
  local devices
  devices=$(echo "$inspect" | jq -r "$jq_get [get.HostConfig.Devices // [] | .[].PathOnHost] | join(\", \")")

  # Privileged
  local privileged
  privileged=$(echo "$inspect" | jq -r "$jq_get get.HostConfig.Privileged")

  # Format output
  echo "Image       : $image"
  echo "State       : $state ($status)"
  echo "Network     : $network"
  echo "Workspace   : $workspace"
  echo ""
  echo "VPN         : ${vpn:-none}"
  echo "Privileged  : $privileged"
  [[ -n "$devices" ]] && echo "Devices     : $devices"
  [[ -n "$ports" ]] && echo "Ports       : $ports"
}

# Session actions (shell/start) open a dedicated floating terminal via
# xdg-terminal-exec + uwsm-app — like the rest of Monarch — so each session is
# its own uwsm scope and the picker (cmd_picker) stays open behind it.
cmd_shell() {
  local name="$1"
  setsid uwsm-app -- xdg-terminal-exec --app-id=org.monarch.terminal --title="RF Swift" -e bash -c "rfswift exec -c '$name' -e /bin/bash"
}

# Start a stopped container (rfswift has no resume command, fall back to docker start)
cmd_start() {
  local name="$1"
  setsid uwsm-app -- xdg-terminal-exec --app-id=org.monarch.terminal --title="RF Swift" -e bash -c "docker start '$name' && rfswift exec -c '$name' -e /bin/bash"
}

# Transient ops: run in the foreground. The picker invokes these with fzf
# `execute`, inside its own already-scoped terminal, then reloads the list.
cmd_stop() {
  local name="$1"
  rfswift stop -c "$name"
}

cmd_remove() {
  local name="$1"
  rfswift remove -c "$name"
}

# Open workspace directory in file manager
cmd_workspace() {
  local name="$1"
  local ws_path
  ws_path=$(docker inspect "$name" \
    --format '{{range .Mounts}}{{if eq .Destination "/root/workspace"}}{{.Source}}{{end}}{{end}}' 2>/dev/null)

  if [[ -n "$ws_path" && -d "$ws_path" ]]; then
    setsid uwsm-app -- nautilus "$ws_path"
  else
    notify-send "RF Swift" "Workspace introuvable pour $name"
  fi
}

# Interactive container creation wizard (gum TUI).
cmd_create() {
  # gum needs a terminal. When invoked headless, relaunch in a floating one.
  if [[ ! -t 1 ]]; then
    launch_in_terminal create
    return
  fi

  # Step 1: Select image
  # Curated subset of useful images. Sizes are a 2026-04 snapshot from
  # `rfswift images remote` (penthertz/rfswift_noble) — refresh manually.
  local all_images=("sdr_full" "sdr_light" "wifi" "bluetooth" "hardware" "reversing" "rfid" "automotive" "network")
  declare -A remote_sizes=(
    [sdr_full]="15.6GB"
    [sdr_light]="5.7GB"
    [wifi]="14.6GB"
    [bluetooth]="3.8GB"
    [hardware]="9.0GB"
    [reversing]="10.4GB"
    [rfid]="2.4GB"
    [automotive]="2.1GB"
    [network]="13.1GB"
  )

  # Local images: on-disk size from docker
  local installed="" not_installed=""
  declare -A sizes
  while IFS='|' read -r repotag size; do
    [[ -z "$repotag" ]] && continue
    sizes["${repotag##*:}"]="$size"
  done < <(docker images --format '{{.Repository}}:{{.Tag}}|{{.Size}}' 2>/dev/null | grep "^${RFSWIFT_REPO}:")

  for img in "${all_images[@]}"; do
    if [[ -n "${sizes[$img]:-}" ]]; then
      installed="${installed}🟢 ${img}  (${sizes[$img]})\n"
    elif [[ -n "${remote_sizes[$img]:-}" ]]; then
      not_installed="${not_installed}⚫ ${img}  (~${remote_sizes[$img]}, not installed)\n"
    else
      not_installed="${not_installed}⚫ ${img}  (not installed)\n"
    fi
  done

  local images="${installed}${not_installed}"

  local choice
  choice=$(menu "Image" "$images")
  [[ -z "$choice" ]] && return 0

  local image
  image=$(echo "$choice" | awk '{print $2}')

  # If image is not installed, offer to pull it first (inline, in this terminal).
  if [[ "$choice" == *"⚫"* ]]; then
    gum confirm "Télécharger l'image « $image » puis créer ?" || return 0
    rfswift images pull -i "$image" && exec monarch-menu-rfswift create
    return 0
  fi

  # Step 2: Container name
  local name
  name=$(input "Nom du conteneur")
  [[ -z "$name" ]] && return 0
  if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    notify-send "RF Swift" "Nom de conteneur invalide: $name"
    return 1
  fi

  # Step 3: VPN configuration (rfswift uses scheme-prefixed paths)
  local vpn_flags=""
  local vpn_choice
  vpn_choice=$(menu "VPN" "Pas de VPN\nOpenVPN\nWireGuard")

  local vpn_scheme=""
  case "$vpn_choice" in
    *OpenVPN*)   vpn_scheme="openvpn" ;;
    *WireGuard*) vpn_scheme="wireguard" ;;
  esac

  if [[ -n "$vpn_scheme" ]]; then
    local vpn_path
    vpn_path=$(pick_file)
    if [[ -n "$vpn_path" ]]; then
      local vpn_quoted
      printf -v vpn_quoted '%q' "${vpn_scheme}:${vpn_path}"
      vpn_flags="--vpn $vpn_quoted"
    fi
  fi

  # Step 4: Session recording
  local record_flag=""
  local record_choice
  record_choice=$(menu "Enregistrement" "Désactiver l'enregistrement\nActiver l'enregistrement")
  if [[ "$record_choice" == *"Activer"* ]]; then
    record_flag="--record"
  fi

  # Step 5: Desktop mode
  local desktop_flag=""
  local desktop_choice
  desktop_choice=$(menu "Desktop" "Pas de desktop\nHTTP (noVNC)\nVNC")

  case $desktop_choice in
    *HTTP*) desktop_flag="--desktop --desktop-config http:0.0.0.0:6080" ;;
    *VNC*)  desktop_flag="--desktop --desktop-config vnc::5900" ;;
  esac

  # Force the workspace under $RFSWIFT_WORKSPACE_ROOT/<name>/ (rfswift will mkdir it)
  local ws_quoted
  printf -v ws_quoted '%q' "$RFSWIFT_WORKSPACE_ROOT/$name"
  local workspace_flag="--workspace $ws_quoted"

  # Build and run — quote name/image; vpn_flags is already %q-escaped. Runs in
  # this terminal so the wizard flows straight into the new container's shell.
  local cmd
  printf -v cmd 'rfswift run -n %q -i %q %s %s %s %s' "$name" "$image" "$vpn_flags" "$record_flag" "$desktop_flag" "$workspace_flag"
  echo "+ $cmd"
  bash -c "$cmd" || {
    local rc=$?
    echo
    echo "rfswift a échoué (code $rc)."
    read -rsn1 -p "Appuie sur une touche pour fermer…"
  }
}

# Emit the picker rows as TSV: <name>\t<state>\t<display>. The first two
# columns are hidden (used by fzf placeholders for preview/actions); only the
# third is shown. A synthetic "Create" row sits on top.
cmd_list() {
  printf '%s\t%s\t%s\n' "__create__" "-" "  Create RF Swift workspace"

  docker ps -a --format '{{.Names}}|{{.State}}|{{.Image}}' 2>/dev/null |
    grep "|${RFSWIFT_REPO}:" |
    while IFS='|' read -r name state image; do
      [[ -z "$name" ]] && continue
      local tag="${image##*:}"
      local icon="🔴"
      [[ "$state" == "running" ]] && icon="🟢"
      printf '%s\t%s\t%s %s  (%s)\n' "$name" "$state" "$icon" "$name" "$tag"
    done
}

# Default action (Enter): create wizard, or shell/start depending on state.
# Each branch spawns its own detached process/terminal and returns, so the
# picker (which calls this via execute-silent) stays open.
cmd_enter() {
  local name="$1" state="$2"
  case "$name" in
    __create__) launch_in_terminal create; return ;;
  esac
  if [[ "$state" == "running" ]]; then
    monarch-menu-rfswift shell "$name"
  else
    monarch-menu-rfswift start "$name"
  fi
}

# The interactive container manager (runs inside the floating terminal that
# cmd_menu opened via the presentation launcher).
cmd_picker() {
  if ! command -v rfswift &>/dev/null; then
    gum confirm 'RF Swift is not installed. Install it?' && monarch-install-rfswift
    command -v rfswift &>/dev/null || exit 1
  fi

  local self="monarch-menu-rfswift"
  local header='Enter: shell/start   ^X: stop   ^D: remove   ^W: workspace   ^N: create   ^R: refresh'

  "$self" _list | fzf \
    --ansi \
    --delimiter=$'\t' \
    --with-nth=3 \
    --prompt='RF Swift ❯ ' \
    --header="$header" \
    --preview="$self info {1}" \
    --preview-window='right,55%,wrap' \
    --bind="enter:execute-silent($self _enter {1} {2})" \
    --bind="ctrl-x:execute($self stop {1})+reload($self _list)" \
    --bind="ctrl-d:execute($self remove {1})+reload($self _list)" \
    --bind="ctrl-w:execute-silent($self workspace {1})" \
    --bind="ctrl-n:execute-silent($self _enter __create__ -)" \
    --bind="ctrl-r:reload($self _list)"
}

# Default entry point: always open the picker in its own centered floating
# terminal (via the Monarch presentation launcher), even when called from an
# existing terminal. The launcher re-invokes us as `_picker` so we land
# directly in cmd_picker inside the new terminal.
cmd_menu() {
  exec monarch-launch-floating-terminal-with-presentation monarch-menu-rfswift _picker
}

# Route sub-commands
case "${1:-}" in
  info)       cmd_info "$2" ;;
  shell)      cmd_shell "$2" ;;
  start)      cmd_start "$2" ;;
  stop)       cmd_stop "$2" ;;
  remove)     cmd_remove "$2" ;;
  workspace)  cmd_workspace "$2" ;;
  create)     cmd_create ;;
  _picker)    cmd_picker ;;
  _list)      cmd_list ;;
  _enter)     cmd_enter "$2" "$3" ;;
  *)          cmd_menu ;;
esac
