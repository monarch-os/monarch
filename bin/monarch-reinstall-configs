#!/bin/bash

# monarch:summary=Reset all Monarch user configs to the defaults
# monarch:requires-sudo=true

set -e

# Overwrite all user configs with the Monarch defaults.

if (( EUID == 0 )); then
  echo "Error: This script should not be run as root"
  exit 1
fi

echo "Resetting all Monarch configs"
cp -R "${MONARCH_PATH:-/usr/share/monarch}"/config/* ~/.config/
cp "${MONARCH_PATH:-/usr/share/monarch}/default/bashrc" ~/.bashrc
echo '[[ -f ~/.bashrc ]] && . ~/.bashrc' | tee ~/.bash_profile >/dev/null

monarch-theme-apply

monarch-refresh-limine
monarch-refresh-plymouth
monarch-nvim-refresh
