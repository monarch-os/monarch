#!/bin/bash
if [[ -z $1 ]]; then
  echo "Usage: monarch-theme-set <theme-name>"
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.config/monarch/current/theme"
NEXT_THEME_PATH="$HOME/.config/monarch/current/next-theme"
USER_THEMES_PATH="$HOME/.config/monarch/themes"
MONARCH_THEMES_PATH="$MONARCH_PATH/themes"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ ! -d $MONARCH_THEMES_PATH/$THEME_NAME ]] && [[ ! -d $USER_THEMES_PATH/$THEME_NAME ]]; then
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Copy official theme first, then overlay user customizations on top
cp -r "$MONARCH_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null
cp -r "$USER_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null

# Generate colors.toml from alacritty.toml if theme is missing colors.toml
if [[ ! -f $NEXT_THEME_PATH/colors.toml && -f $NEXT_THEME_PATH/alacritty.toml ]]; then
  monarch-theme-colors-from-alacritty "$NEXT_THEME_PATH"
fi

# Generate dynamic configs
monarch-theme-set-templates

# Swap next theme in as current
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" >"$HOME/.config/monarch/current/theme.name"

# Change background with theme
monarch-theme-bg-next

# Restart components to apply new theme
if pgrep -x waybar >/dev/null; then
  monarch-restart-waybar
fi
monarch-restart-swayosd
monarch-restart-terminal
monarch-restart-hyprctl
monarch-restart-btop
monarch-restart-opencode
monarch-restart-mako
monarch-restart-helix

# Change app-specific themes
monarch-theme-set-gnome
monarch-theme-set-browser
monarch-theme-set-vscode
monarch-theme-set-obsidian
monarch-theme-set-keyboard

# Call hook on theme set
monarch-hook theme-set "$THEME_NAME"
