#!/bin/bash

# monarch:summary=Enable, disable, or toggle a niri input device class via libinput
# monarch:args=<touchpad|touch> [on|off|toggle]

# Backs monarch-toggle-touchpad / monarch-toggle-touchscreen. Instead of poking
# the kernel's sysfs `inhibited` attribute (a best-effort hack that does not
# reliably stop a touchscreen), we toggle niri's own `input { <class> { off } }`
# in a dedicated include. niri passes `off` to libinput (SEND_EVENTS_DISABLED)
# and live-reloads when the watched include changes, so the device truly stops.
# The include file is the single source of truth and persists across reboots.

FILE="$HOME/.config/niri/monarch-input.kdl"

usage() {
  echo "usage: $(basename "$0") <touchpad|touch> [on|off|toggle]" >&2
  exit 1
}

device="${1:-}"
action="${2:-toggle}"

case "$device" in
  touchpad | touch) ;;
  *) usage ;;
esac

# A class is disabled when its `<class> {` block is present. The fixed string
# "touch {" cannot match the "touchpad {" line (no space after "touch"), so the
# two classes are read independently.
is_off() { [[ -f $FILE ]] && grep -qF "$1 {" "$FILE"; }

case "$action" in
  on) new_off=false ;;
  off) new_off=true ;;
  toggle) if is_off "$device"; then new_off=false; else new_off=true; fi ;;
  *) usage ;;
esac

# Resolve the desired state of both classes, preserving the one we are not
# changing, then regenerate the whole include deterministically.
if [[ $device == touchpad ]]; then
  touchpad_off=$new_off
  if is_off touch; then touch_off=true; else touch_off=false; fi
else
  touch_off=$new_off
  if is_off touchpad; then touchpad_off=true; else touchpad_off=false; fi
fi

mkdir -p "$(dirname "$FILE")"
tmp="$(mktemp "${FILE}.XXXXXX")"
{
  echo "// GENERATED by monarch-toggle-touchpad / monarch-toggle-touchscreen."
  echo "// Do not edit — changes are overwritten. Toggle via the Toggle menu or"
  echo "// the XF86 touchpad keys. niri applies 'off' through libinput on reload."
  if $touchpad_off || $touch_off; then
    echo
    echo "input {"
    $touchpad_off && printf '    touchpad {\n        off\n    }\n'
    $touch_off && printf '    touch {\n        off\n    }\n'
    echo "}"
  fi
} >"$tmp"
mv -f "$tmp" "$FILE"

# niri watches included files and live-reloads on change; nudge it anyway so the
# toggle feels instant and works even if the watcher missed the write.
if pgrep -x niri >/dev/null 2>&1; then
  niri msg action reload-config >/dev/null 2>&1 || true
fi

if $new_off; then state="disabled"; else state="enabled"; fi
case "$device" in
  touchpad) notify-send -u low "  Touchpad $state" ;;
  touch) notify-send -u low "󰟸  Touchscreen $state" ;;
esac
