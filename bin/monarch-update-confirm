#!/bin/bash

# monarch:summary=Prompt for confirmation before starting an update

source "$("$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/monarch-i18n" --helper)"
monarch_i18n_load

gum style --border normal --padding "1 2" \
  "$(monarch_t 'update.ready')" \
  "" \
  "$(monarch_t 'update.noInterruption')" \
  "$(monarch_t 'update.powerWarning')" \
  "" \
  "$(monarch_t 'update.releaseNotes' 'https://github.com/monarch-os/monarch/releases')"

echo
if ! gum confirm "$(monarch_t 'update.confirm')"; then
  monarch_message 'update.cancelled'
  exit 1
fi
