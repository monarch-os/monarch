#!/bin/bash

# monarch:summary=Cycle to the next background for the current theme (persists into Noctalia's wallpapers.json)
# monarch:examples=monarch theme bg next

THEME_NAME=$(cat "$HOME/.config/monarch/current/theme.name" 2>/dev/null)
THEME_BACKGROUNDS_PATH="$HOME/.config/monarch/current/theme/backgrounds/"
USER_BACKGROUNDS_PATH="$HOME/.config/monarch/backgrounds/$THEME_NAME/"
WALLPAPERS_JSON="$HOME/.cache/noctalia/wallpapers.json"

mapfile -d '' -t BACKGROUNDS < <(find -L "$USER_BACKGROUNDS_PATH" "$THEME_BACKGROUNDS_PATH" -maxdepth 1 -type f -print0 2>/dev/null | sort -z)
TOTAL=${#BACKGROUNDS[@]}

if (( TOTAL == 0 )); then
  notify-send "No background was found for theme" -t 2000
  exit 0
fi

# Read the currently-set default wallpaper from Noctalia's source-of-truth so
# the cycle survives Noctalia restarts. Falls back to the first available file.
CURRENT_BACKGROUND=""
if [[ -f $WALLPAPERS_JSON ]]; then
  CURRENT_BACKGROUND=$(jq -r '.defaultWallpaper // empty' "$WALLPAPERS_JSON" 2>/dev/null)
fi

INDEX=-1
for i in "${!BACKGROUNDS[@]}"; do
  if [[ ${BACKGROUNDS[$i]} == "$CURRENT_BACKGROUND" ]]; then
    INDEX=$i
    break
  fi
done

if (( INDEX == -1 )); then
  NEW_BACKGROUND="${BACKGROUNDS[0]}"
else
  NEXT_INDEX=$(((INDEX + 1) % TOTAL))
  NEW_BACKGROUND="${BACKGROUNDS[$NEXT_INDEX]}"
fi

mkdir -p "$(dirname "$WALLPAPERS_JSON")"
jq -n --arg path "$NEW_BACKGROUND" '{defaultWallpaper: $path, wallpapers: {}}' >"$WALLPAPERS_JSON"
qs -c noctalia-shell ipc call wallpaper refresh >/dev/null 2>&1 || true
