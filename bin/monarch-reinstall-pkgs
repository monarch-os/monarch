#!/bin/bash

# monarch:summary=Reinstall all Monarch base packages from the stable channel
# monarch:requires-sudo=true

set -e

# Reinstall all default Monarch packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
monarch-refresh-pacman

# Downgrade any packages to the stable setup
monarch-update-pacman -Suu --noconfirm

monarch-update-pacman -S --noconfirm monarch monarch-settings

# Ensure all packages are installed
source "$MONARCH_PATH/install/helpers/package-manifest.sh"
packages=()
monarch_load_package_manifest packages "$MONARCH_PATH/install/monarch-base.packages"
monarch-update-pacman -Syu --noconfirm --needed "${packages[@]}"
