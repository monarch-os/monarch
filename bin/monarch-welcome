#!/bin/bash

# monarch:summary=Monarch welcome / onboarding wizard (TUI)
# monarch:examples=monarch welcome

set -uo pipefail

have_gum() { command -v gum >/dev/null 2>&1; }

online_quiet() { ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; }

is_online() {
  if have_gum; then
    gum spin --spinner dot --title "Checking your internet connection…" \
      -- ping -c1 -W2 1.1.1.1 >/dev/null 2>&1
  else
    echo "  Checking your internet connection…"
    online_quiet
  fi
}

render_header() {
  if have_gum; then
    gum style \
      --foreground 213 --border-foreground 213 --border rounded \
      --padding "1 4" --margin "0 0 1 0" --align center \
      "Welcome to Monarch" "" "A few steps to get you started"
  else
    cat <<HEADER

  ╭───────────────────────╮
  │   Welcome to Monarch  │
  ╰───────────────────────╯
  A few steps to get you started.

HEADER
  fi
}

status() {
  if have_gum; then gum style --margin "0 0 1 0" "  $1"; else echo "  $1"; fi
}

pick() {
  if have_gum; then
    printf '%s\n' "$@" | gum choose --height "$(($# + 2))"
  else
    local choice
    PS3=$'\nSelect: '
    select choice in "$@"; do
      [[ -n $choice ]] && { echo "$choice"; return; }
    done
  fi
}

confirm() {
  if have_gum; then gum confirm "$1"; else read -rp "  $1 [y/N] " a; [[ $a == [yY]* ]]; fi
}

press_to_continue() {
  echo
  read -n1 -p "  Press any key to return to the menu…" -r _ || true
}

# ── Guided first pass ───────────────────────────────────────────────────────
clear
render_header

if is_online; then
  status "✓  You're connected to the internet."
else
  status "○  No internet connection detected."
  # Offer Wi-Fi setup, then re-check, until online or the user declines.
  while confirm "Set up Wi-Fi now?"; do
    monarch-wifi-connect || true
    clear; render_header
    if is_online; then
      status "✓  You're now connected to the internet."
      break
    fi
    status "○  Still offline."
  done
fi

# A system update only makes sense once we're online. monarch-update shows its
# own confirmation box (power warning + release notes), so it doubles as the
# yes/skip prompt — no second confirmation here.
if is_online; then
  status "Recommended: bring Monarch up to date."
  monarch-update || true
fi

# ── Menu hub (keybindings stay reachable even while offline) ─────────────────
while true; do
  clear
  render_header

  labels=("Wi-Fi setup")
  if online_quiet; then
    labels+=("Apps & tools" "System update")
  fi
  labels+=("Keybindings & shortcuts" "Finish")

  sel=$(pick "${labels[@]}")

  case "$sel" in
    *Keybindings*) monarch-menu-keybindings; press_to_continue ;;
    *Wi-Fi*)       monarch-wifi-connect;     press_to_continue ;;
    *Apps*)        monarch-setup-apps ;;
    *update*)      monarch-update;           press_to_continue ;;
    *Finish*|"")   break ;;
  esac
done

clear
echo "All set. Re-open anytime with: monarch welcome"
