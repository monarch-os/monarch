#!/bin/bash

# monarch:summary=Install the ChatGPT desktop app
# monarch:requires-sudo=true

set -e

echo "Installing ChatGPT..."
bash "$MONARCH_PATH/install/reconcile/chatgpt.sh"
monarch-pkg-add chatgpt-desktop-bin

echo "Opening ChatGPT..."
setsid uwsm-app -- /usr/bin/chatgpt >/dev/null 2>&1 &

echo ""
echo "ChatGPT has been installed."
