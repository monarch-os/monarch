#!/bin/bash

# monarch:summary=Remove Hermes Desktop while preserving sessions and runtime
# monarch:requires-sudo=true

set -euo pipefail

if monarch-pkg-present hermes-agent-desktop-bin; then
  monarch-pkg-drop --keep-dependencies hermes-agent-desktop-bin
elif monarch-pkg-present hermes-agent-desktop; then
  monarch-pkg-drop --keep-dependencies hermes-agent-desktop
fi
if [[ $(monarch-default-agent) == "hermes" ]]; then
  rm -f "$HOME/.config/monarch/defaults/agent"
fi
echo "$(monarch-i18n hermes.removed)"
