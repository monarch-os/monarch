#!/bin/bash

# monarch:summary=Report available repository and AUR package updates as JSON

set -euo pipefail

fail_check() {
  jq -cn --arg reason "$1" '{status:"error",count:null,reason:$reason}'
  exit 2
}

monarch-cmd-missing checkupdates fakeroot && fail_check "missing-dependencies"
db=$(mktemp -d) || fail_check "temporary-database"
trap 'rm -rf -- "$db"' EXIT

code=0
updates=$(LC_ALL=C CHECKUPDATES_DB="$db" timeout --kill-after=5s 120s checkupdates --nocolor) || code=$?
case $code in
  0) ;;
  2) [[ -z $updates ]] || fail_check "invalid-repository-result" ;;
  *) fail_check "repositories-unavailable" ;;
esac

# Use the freshly synchronized, isolated database for AUR classification too:
# a new installation may not have any system sync databases yet.
foreign=""
code=0
foreign=$(pacman --dbpath "$db" -Qqm 2>"$db/foreign.err") || code=$?
if (( code != 0 )); then
  (( code == 1 )) && [[ -z $foreign && ! -s $db/foreign.err ]] || fail_check "installed-packages-unavailable"
fi

aur_updates=""
if [[ -n $foreign ]]; then
  monarch-cmd-missing yay && fail_check "missing-aur-helper"
  code=0
  # Match the updater's exclusions. Query only; never install or refresh the
  # system database. yay returns 1 with no output when no upgrades are found.
  aur_updates=$(LC_ALL=C timeout --kill-after=5s 120s yay --dbpath "$db" -Qua \
    --color never --ignore gcc14,gcc14-libs 2>"$db/aur.err") || code=$?
  if (( code != 0 )); then
    (( code == 1 )) && [[ -z $aur_updates && ! -s $db/aur.err ]] || fail_check "aur-unavailable"
  fi
fi

count_updates() {
  local package installed arrow available extra count=0
  while read -r package installed arrow available extra; do
    [[ -n $package ]] || continue
    [[ -n $installed && $arrow == "->" && -n $available && -z $extra ]] || return 1
    ((count += 1))
  done <<< "$1"
  printf '%s\n' "$count"
}

repository_count=$(count_updates "$updates") || fail_check "invalid-repository-result"
aur_count=$(count_updates "$aur_updates") || fail_check "invalid-aur-result"
count=$((repository_count + aur_count))
status="current"
(( count == 0 )) || status="available"
jq -cn --arg status "$status" --argjson count "$count" \
  --argjson repositories "$repository_count" --argjson aur "$aur_count" \
  '{status:$status,count:$count,repositories:$repositories,aur:$aur}'
