#!/bin/bash

# monarch:summary=Configure the system DNS provider
# monarch:args=[Cloudflare|Google|DHCP|Custom]
# monarch:requires-sudo=true

# The chooser, and nothing else. Writing DNS belongs to the monarch-dns package:
# a NOPASSWD grant may only name a path root owns, and this tree is a checkout
# the user can rewrite.

set -uo pipefail

# The launching shell's PATH carries no bin/ of ours. Appended, never prepended.
PATH="$PATH:$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"

PACKAGED_DNS=/usr/bin/monarch-dns

# The one caller with a terminal, which is why the panel sends its buttons here.
if [[ ! -x $PACKAGED_DNS ]]; then
  echo "Setting the DNS provider needs the monarch-dns package."
  monarch-pkg-add monarch-dns || exit 1
fi

provider=${1:-}
if [[ -z $provider ]]; then
  provider=$(gum choose --height 6 --header "Select DNS provider" Cloudflare Google DHCP Custom)
fi
[[ -n $provider ]] || exit 1

exec "$PACKAGED_DNS" "$provider"
