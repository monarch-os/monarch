#!/bin/bash

# monarch:summary=Remove fingerprint authentication from sudo, polkit, and lock screen
# monarch:requires-sudo=true

set -e

if (( EUID == 0 )) && [[ -v SUDO_UID ]]; then
  [[ $SUDO_UID =~ ^[0-9]+$ ]] || { echo "Cannot identify the invoking fingerprint user" >&2; exit 1; }
  fingerprint_user=$(/usr/bin/id -nu "+$SUDO_UID")
else
  fingerprint_user=$(/usr/bin/id -un)
fi
[[ -n $fingerprint_user && $fingerprint_user != "." && $fingerprint_user != ".." &&
  $fingerprint_user != */* ]] || { echo "Unsafe fingerprint user name" >&2; exit 1; }
fingerprint_home=$(/usr/bin/getent passwd "$fingerprint_user" | cut -d: -f6)
[[ $fingerprint_home == /* && $fingerprint_home != / ]] || {
  echo "Cannot identify the fingerprint user's home" >&2
  exit 1
}


remove_pam_config() {
  # The lid gate goes with pam_fprintd: on its own it would run a helper before
  # every sudo to decide nothing. Matched on the helper name rather than on
  # pam_exec, so an unrelated pam_exec line in the same stack survives.
  # Remove from sudo
  if grep -Eq 'pam_fprintd\.so|monarch-hw-laptop-closed' /etc/pam.d/sudo; then
    echo "Removing fingerprint authentication from sudo..."
    sudo sed -i -e '/pam_fprintd\.so/d' -e '/monarch-hw-laptop-closed/d' /etc/pam.d/sudo
  fi

  # Remove from polkit
  if [[ -f /etc/pam.d/polkit-1 ]] && grep -Eq 'pam_fprintd\.so|monarch-hw-laptop-closed' /etc/pam.d/polkit-1; then
    echo "Removing fingerprint authentication from polkit..."
    sudo sed -i -e '/pam_fprintd\.so/d' -e '/monarch-hw-laptop-closed/d' /etc/pam.d/polkit-1
  fi

  sudo rm -f /usr/local/bin/monarch-hw-laptop-closed
}

remove_noctalia_lockscreen() {
  # Inert on v5, but installs set up before that still carry both.
  if [[ -f /etc/pam.d/noctalia ]]; then
    echo "Removing the v4 lock-screen PAM service..."
    sudo rm -f /etc/pam.d/noctalia
  fi

  rm -f "$fingerprint_home/.config/environment.d/noctalia-fingerprint.conf"

  # Restore the lock-screen auth defaults so it no longer waits on a sensor that
  # is gone. Dropping the file is the whole revert: lockscreen.fingerprint is
  # only ever set there, so the merged config falls back to the v5 default.
  rm -f "$fingerprint_home/.config/noctalia/monarch-fingerprint.toml"
  noctalia msg config-reload >/dev/null 2>&1 || true
}

remove_fingerprint_marker() {
  rm -f "$fingerprint_home/.local/state/monarch/fingerprint-enabled"
}

echo -e "\e[32mRemoving fingerprint scanner from authentication.\n\e[0m"

sudo rm -rf -- "/var/lib/fprint/$fingerprint_user"

remove_pam_config
remove_noctalia_lockscreen
remove_fingerprint_marker

echo "Removing fingerprint packages..."
monarch-pkg-drop fprintd libfprint

echo -e "\e[32mFingerprint authentication and $fingerprint_user's saved fingerprints have been removed.\e[0m"
