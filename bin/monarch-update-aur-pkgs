#!/bin/bash

# monarch:summary=Update AUR packages if any are installed

sudo_options=()
if [[ ${MONARCH_SUDO_NO_UPDATE:-0} == "1" ]]; then
  sudo_wrapper="$MONARCH_PATH/default/monarch/sudo-no-update/sudo"
  [[ -x $sudo_wrapper ]] || { echo "Missing no-update sudo wrapper." >&2; exit 1; }
  sudo_options=(--sudo "$sudo_wrapper" --sudoloop=false)
fi

if pacman -Qem >/dev/null; then
  if monarch-pkg-aur-accessible; then
    echo -e "\e[32m\nUpdate AUR packages\e[0m"
    yay "${sudo_options[@]}" -Sua --noconfirm --cleanafter --ignore gcc14,gcc14-libs || exit $?
    echo
  else
    echo -e "\e[31m\nAUR is unavailable (so skipping updates)\e[0m"
    echo
  fi
fi
