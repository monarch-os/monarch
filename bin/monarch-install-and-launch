#!/bin/bash

# monarch:summary=Install a packaged app and launch it once it finishes
# monarch:args=<display-name> <packages> <desktop-id>
# monarch:examples=monarch install and-launch Cursor cursor-bin cursor

name="${1-}"
packages="${2-}"
desktop_id="${3-}"

if [[ -z $name || -z $packages || -z $desktop_id ]]; then
  echo "Usage: monarch-install-and-launch <display-name> <packages> <desktop-id>" >&2
  exit 1
fi

MONARCH_ROOT=${MONARCH_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}
source "$MONARCH_ROOT/install/helpers/install-app.sh" || exit 1
install_command=$(monarch_install_app_command "$name" "$packages") || exit 1
printf -v launch_command '%q ' setsid uwsm-app -- gtk-launch "$desktop_id"

# The subshell keeps & from backgrounding the package installation too.
exec monarch-launch-floating-terminal-with-presentation \
  "$install_command && ($launch_command >/dev/null 2>&1 &)"
