#!/bin/bash

# monarch:summary=Manage persistent state files for Monarch toggles and settings.
# monarch:args=<set|clear|clear-before-boot> [state-name-or-pattern]
# monarch:hidden=true

set -e

STATE_DIR="$HOME/.local/state/monarch"

COMMAND="${1:-}"
STATE_NAME="${2:-}"

if [[ -z $COMMAND ]]; then
  echo "Usage: monarch-state <set|clear> <state-name-or-pattern> | monarch-state clear-before-boot"
  exit 1
fi

if [[ -z $STATE_NAME && $COMMAND != "clear-before-boot" ]]; then
  echo "Usage: monarch-state $COMMAND <state-name>"
  exit 1
fi

case "$COMMAND" in
set)
  if [[ $STATE_NAME == */* || $STATE_NAME == "." || $STATE_NAME == ".." ]]; then
    echo "Invalid state name: $STATE_NAME" >&2
    exit 2
  fi
  mkdir -p "$STATE_DIR"
  touch -- "$STATE_DIR/$STATE_NAME"
  ;;
clear)
  [[ -d $STATE_DIR ]] || exit 0
  find "$STATE_DIR" -maxdepth 1 -type f -name "$STATE_NAME" -delete
  ;;
clear-before-boot)
  [[ -d $STATE_DIR ]] || exit 0
  boot_time=$(awk '$1 == "btime" { print $2; exit }' /proc/stat)
  if [[ ! $boot_time =~ ^[0-9]+$ ]] || (( boot_time == 0 )); then
    echo "Cannot determine boot time; restart markers were retained." >&2
    exit 1
  fi
  for state_file in "$STATE_DIR"/re*-required; do
    [[ -f $state_file && ! -L $state_file ]] || continue
    state_time=$(stat -c %Y -- "$state_file")
    if (( state_time < boot_time )); then
      rm -f -- "$state_file"
    fi
  done
  ;;
*)
  echo "Unknown state command: $COMMAND" >&2
  exit 2
  ;;
esac
