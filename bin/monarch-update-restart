#!/bin/bash

echo

if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
  gum confirm "Linux kernel has been updated. Reboot?" && monarch-system-reboot
elif [[ -f $HOME/.local/state/monarch/reboot-required ]]; then
  gum confirm "Updates require reboot. Ready?" && monarch-system-reboot
fi

running_hyprland=$(readlink /proc/$(pgrep -x Hyprland)/exe 2>/dev/null)
if [[ $running_hyprland == *"(deleted)"* ]]; then
<<<<<<< HEAD
  gum confirm "Hyprland has been updated. Reboot?" && monarch-system-reboot
=======
  gum confirm "Hyprland has been updated. Reboot?" && omarchy-system-reboot
>>>>>>> c67c4b3 (Update(Upstream sync with Omarchy 3.4.1))
fi

for file in "$HOME"/.local/state/monarch/restart-*-required; do
  if [[ -f $file ]]; then
    filename=$(basename "$file")
    service=$(echo "$filename" | sed 's/restart-\(.*\)-required/\1/')
    echo "Restarting $service"
    monarch-state clear "$filename"
    monarch-restart-"$service"
  fi
done
