#!/bin/bash

# monarch:summary=Toggle dedicated vs integrated GPU mode via supergfxd (for hybrid gpu laptops, like Asus G14).
# monarch:requires-sudo=true

unset MONARCH_ROOT_FILE_TEST_ROOT MONARCH_ROOT_FILE_TEST_RUNTIME
source /usr/share/monarch/install/helpers/root-file.sh

if monarch-cmd-missing supergfxctl; then
  monarch-pkg-add supergfxctl

  # Create config before starting service to prevent hang on first boot
  sudo tee /etc/supergfxd.conf >/dev/null <<'CONF'
{
  "mode": "Hybrid",
  "vfio_enable": true,
  "vfio_save": false,
  "always_reboot": false,
  "no_logind": false,
  "logout_timeout_s": 180,
  "hotplug_type": "None"
}
CONF

  sudo systemctl enable --now supergfxd
fi

gpu_mode=$(supergfxctl -g)

case "$gpu_mode" in
"Integrated")
  if gum confirm "Enable dedicated GPU and reboot?"; then
    if ! monarch_root_file_can_remove force-igpu || ! monarch_root_file_can_remove delay-start; then
      echo "Could not remove customized supergfxd support files" >&2
      exit 1
    fi

    if ! monarch_configure_supergfxd Hybrid; then
      echo "Could not configure supergfxd for hybrid mode" >&2
      exit 1
    fi

    monarch_remove_root_file force-igpu || exit 1
    monarch_remove_root_file delay-start || exit 1

    monarch-system-reboot
  fi
  ;;
"Hybrid")
  if gum confirm "Use only integrated GPU and reboot?"; then
    if ! monarch_install_root_file delay-start; then
      echo "Could not install the supergfxd startup-delay override" >&2
      exit 1
    fi

    if ! monarch_install_root_file force-igpu; then
      echo "Could not install the force-igpu system-sleep hook" >&2
      exit 1
    fi

    if ! monarch_configure_supergfxd Integrated; then
      echo "Could not configure supergfxd for integrated mode" >&2
      exit 1
    fi

    monarch-system-reboot
  fi
  ;;
*)
  echo "Hybrid GPU not found or in unknown mode."
  exit 1
  ;;
esac
