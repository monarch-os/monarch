#!/bin/bash

# monarch:summary=Overwrite /etc/pacman.conf with the Monarch default (its dedicated repositories), then update all packages.
# monarch:requires-sudo=true

sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak

sudo cp -f "$MONARCH_PATH/default/pacman/pacman.conf" /etc/pacman.conf

# Reset all package DBs and then update
sudo env MONARCH_UPDATE_PACMAN=1 pacman -Syyuu --noconfirm
