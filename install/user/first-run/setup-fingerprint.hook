#!/bin/bash

set -e

if monarch-hw-fingerprint && [[ ! -f /etc/pam.d/monarch-lock-fingerprint ]] &&
  monarch-done ensure fingerprint-setup-invitation; then
  monarch-notification-send -u critical -t 0 -g 󰈷 "Setup Fingerprint Reader" \
    "Enable sudo and unlocking with your fingerprint." \
    --action "Configure" monarch-launch-floating-terminal-with-presentation monarch-setup-security-fingerprint
fi
