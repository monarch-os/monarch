{
  // Monarch menu definition. Ported from the nested bash of bin/monarch-menu,
  // modelled on omarchy quattro's default/omarchy/omarchy-menu.jsonc.
  //
  // JSONC here is JSON plus whole-line // comments and trailing commas, both
  // stripped before parsing — an inline trailing comment breaks the parse. A
  // file that fails to parse contributes nothing, so a broken user extension
  // silently drops every user entry while the shipped menu keeps working.
  //
  // IDs are object keys, and the dotted ID *is* the tree: trigger.share.file is
  // a child of trigger.share, and an ID with no dot sits on the root menu.
  // Kind is inferred: an entry with `action` is an action, one with `target` is
  // a link to another submenu, anything else is a submenu.
  //
  // Fields:
  //   icon        glyph in the icon column (Nerd Font); omitted where the bash
  //               menu had none, rather than inventing one
  // Shipped presentation text lives in default/i18n/{en,fr}.json under menu,
  // keyed by <entry-id>.<field>. User extensions may set these fields directly:
  //   label       visible row title; defaults to the last ID segment
  //   title       header shown when the submenu is open; defaults to label
  //   action      shell command, run detached when the row is selected
  //   target      existing submenu ID to open; makes the row a link
  //   provider    runtime row source (fonts, power-profiles) — defined by the
  //               renderer, not here; an extension can point at one but cannot
  //               declare a new one
  //   aliases     extra `monarch menu <name>` routes. Routes already match an
  //               ID's last segment, so only add one where that is not enough
  //   description short explanation shown under matching search results
  //   keywords    extra search terms which do not alter routes or labels
  //   when        shell condition; the row is hidden when it fails
  //   checked     shell condition; appends a check mark when it succeeds
  //   disabled    shell condition; the row stays listed but cannot be selected
  //   disabledLabel explanation shown under a disabled row; defaults to Installed
  //   hiddenAtRoot keep a legacy category routable without listing it at root
  //   rootGroup   visible root category which groups its global search results

  // Root
  "apps": {"icon":"󰀻","aliases":["app","applications"],"action":"noctalia msg panel-toggle launcher"},
  "trigger": {"icon":"󱓞"},
  "setup": {"icon":"","aliases":["settings"]},
  "style": {"icon":""},
  "install": {"icon":"󰉉"},
  "update": {"icon":"","aliases":["refresh"]},
  "system": {"icon":"","aliases":["power-menu"]},
  "learn": {"icon":"󰧑"},
  "remove": {"icon":"󰭌","aliases":["uninstall"],"hiddenAtRoot":true,"rootGroup":"install"},
  "about": {"icon":"","action":"monarch-launch-about","hiddenAtRoot":true,"rootGroup":"learn"},

  // Learn
  "learn.first-steps": {"icon":"󰧑","action":"monarch-setup-first-steps"},
  "learn.keybindings": {"icon":"","action":"monarch-menu-keybindings"},
  "learn.monarch": {"icon":"󰆥","action":"monarch-launch-webapp 'https://docs.monarchlinux.com/'"},
  "learn.niri": {"icon":"","action":"monarch-launch-webapp 'https://yalter.github.io/niri/'"},
  "learn.noctalia": {"icon":"󰕮","action":"monarch-launch-webapp 'https://docs.noctalia.dev/noctalia/'"},
  "learn.arch": {"icon":"󰣇","action":"monarch-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","action":"monarch-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","action":"monarch-launch-webapp 'https://devhints.io/bash'"},
  "learn.herdr-keybindings": {"icon":"","action":"monarch-menu-herdr-keybindings"},
  "learn.about": {"icon":"","action":"monarch-launch-about"},

  // Trigger
  "trigger.emoji": {"icon":"","aliases":["emojis"],"action":"noctalia msg panel-toggle launcher /emo"},
  "trigger.reminder": {"icon":"󰔛"},
  "trigger.capture": {"icon":""},
  "trigger.transcode": {"icon":"󰧸","action":"monarch-transcode"},
  "trigger.share": {"icon":""},
  "trigger.toggle": {"icon":"󰔎","aliases":["toggles"]},
  "trigger.hardware": {"icon":"","aliases":["hw"]},
  "trigger.tests": {"icon":"󰓅","aliases":["speedtest","benchmark"]},

  // Trigger > Reminder
  "trigger.reminder.set": {"icon":"󰔛","action":"monarch-reminder -i"},
  "trigger.reminder.show": {"icon":"󰔛","action":"monarch-reminder show"},
  "trigger.reminder.clear": {"icon":"󰔛","action":"monarch-reminder clear"},

  // Trigger > Capture
  "trigger.capture.screenshot": {"icon":"","keywords":["screen","image","snip"],"action":"monarch-capture-screenshot"},
  "trigger.capture.screenrecord": {"icon":"","keywords":["record","video","screen"]},
  "trigger.capture.text": {"icon":"󰴑","action":"monarch-capture-text-extraction"},
  "trigger.capture.qr": {"icon":"󰐲","action":"monarch-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","action":"pkill hyprpicker || hyprpicker -a"},

  // Trigger > Capture > Screenrecord. The bash menu stopped an ongoing recording
  // on the way in, so entering the submenu twice was the only way to stop one.
  // A guarded row does the same job and says so.
  "trigger.capture.screenrecord.stop": {"icon":"","when":"pgrep -f '^gpu-screen-recorder'","action":"monarch-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","action":"monarch-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","action":"monarch-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","action":"monarch-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","when":"monarch-hw-webcam","action":"monarch-capture-screenrecording-with-webcam --webcam-shape=circle"},
  "trigger.capture.screenrecord.webcam-rectangle": {"icon":"","when":"monarch-hw-webcam","action":"monarch-capture-screenrecording-with-webcam --webcam-shape=rectangle"},

  // Trigger > Share
  "trigger.share.clipboard": {"icon":"","action":"monarch-menu-share clipboard"},
  "trigger.share.file": {"icon":"","action":"monarch-menu-share file"},
  "trigger.share.folder": {"icon":"","action":"monarch-menu-share folder"},
  // LocalSend receives by being open, so this row only has to put it on screen
  // — and focus the instance already there rather than ask for a second one.
  "trigger.share.receive": {"icon":"󰥦","action":"monarch-launch-or-focus localsend"},
  // Hidden rather than greyed when nothing is connected. The guard is the same
  // detection the QR command uses, so the row and the panel never disagree.
  "trigger.share.wifi": {"icon":"󰐲","aliases":["wifi-qr"],"when":"monarch-wifi-device >/dev/null 2>&1","action":"noctalia msg panel-open monarch/wifi-qr:panel"},

  // Trigger > Toggle
  "trigger.toggle.screensaver": {"icon":"󱄄","checked":"! monarch-toggle-enabled screensaver-off","action":"monarch-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","checked":"monarch-toggle-nightlight status | jq -e '.enabled'","action":"monarch-toggle-nightlight"},
  "trigger.toggle.idle-lock": {"icon":"󱫖","checked":"monarch-toggle-idle status | jq -e '.enabled'","action":"monarch-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","checked":"monarch-toggle-notification-silencing status | jq -e '.enabled'","action":"monarch-toggle-notification-silencing"},
  "trigger.toggle.crash-capture": {"icon":"󱚡","checked":"! monarch-toggle-enabled crash-capture-off","action":"monarch-toggle-crash-capture"},
  "trigger.toggle.top-bar": {"icon":"󰍜","checked":"monarch-toggle-bar status | jq -e '.enabled'","action":"monarch-toggle-bar"},
  "trigger.toggle.battery-percentage": {"icon":"󰁹","when":"monarch-battery-present","checked":"monarch-toggle-battery-percentage status | jq -e '.enabled'","action":"monarch-toggle-battery-percentage"},
  "trigger.toggle.direct-boot": {"icon":"","checked":"monarch-direct-boot-present","action":"monarch-launch-floating-terminal-with-presentation monarch-config-direct-boot"},
  "trigger.toggle.passwordless-sudo": {"icon":"󰟵","checked":"sudo -n test -f /etc/sudoers.d/99-monarch-nopasswd-$USER && systemctl is-active --quiet monarch-nopasswd-expire-$USER.timer","action":"monarch-launch-floating-terminal-with-presentation monarch-sudo-passwordless"},

  // Trigger > Hardware
  "trigger.hardware.displays": {"icon":"󰍺","keywords":["monitor","screen","resolution"],"action":"noctalia msg panel-toggle monarch/display:panel"},
  "trigger.hardware.display-scaling": {"icon":"󰍹","action":"monarch-niri-monitor-scaling-cycle"},
  "trigger.hardware.laptop-display": {"icon":"󰛧","when":"monarch-hw-external-monitors","action":"monarch-niri-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","when":"monarch-hw-external-monitors","action":"monarch-niri-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","when":"monarch-hw-hybrid-gpu","action":"monarch-launch-floating-terminal-with-presentation monarch-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","when":"monarch-hw-touchpad","checked":"monarch-toggle-touchpad status | jq -e '.enabled'","action":"monarch-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","when":"monarch-hw-dell-xps-haptic-touchpad && monarch-cmd-present dell-xps-touchpad-haptics"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","when":"monarch-hw-touchscreen","checked":"monarch-toggle-touchscreen status | jq -e '.enabled'","action":"monarch-toggle-touchscreen"},

  // Actions > Speed Test
  "trigger.tests.network": {"icon":"󰓅","action":"noctalia msg panel-open monarch/network:speedtest"},
  "trigger.tests.disk": {"icon":"󰋊","action":"noctalia msg panel-open monarch/network:disk-speedtest"},

  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","checked":"[[ $(dell-xps-touchpad-haptics get) == low ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","checked":"[[ $(dell-xps-touchpad-haptics get) == mid ]]","action":"dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon":"󰌌","checked":"[[ $(dell-xps-touchpad-haptics get) == high ]]","action":"dell-xps-touchpad-haptics set high"},

  // Style
  "style.dark-mode": {"icon":"󰟥","checked":"[[ $(noctalia msg theme-mode-get) == dark ]]","action":"noctalia msg theme-mode-toggle"},
  "style.theme": {"icon":"󰏘","action":"noctalia msg panel-toggle monarch/theme:theme"},
  "style.font": {"icon":"","provider":"fonts"},
  "style.text-size": {"icon":"󰛖","provider":"text-size"},
  "style.backgrounds": {"icon":"","aliases":["background","wallpaper"],"keywords":["desktop","image","import","picture","custom"],"action":"noctalia msg panel-toggle monarch/theme:background"},
  "style.bar": {"icon":"󰍜"},
  "style.niri": {"icon":"","action":"notify-send -u low 'Editing config file' \"$HOME/.config/niri/user.kdl\"; monarch-launch-editor \"$HOME/.config/niri/user.kdl\""},
  "style.unlock": {"icon":"󰟵","action":"noctalia msg panel-toggle monarch/theme:unlock"},
  "style.screensaver": {"icon":"󱄄"},
  "style.about": {"icon":""},

  "style.screensaver.text": {"icon":"","action":"monarch-branding-screensaver text"},
  "style.screensaver.image": {"icon":"","action":"monarch-branding-screensaver image"},
  "style.screensaver.default": {"icon":"","action":"monarch-branding-screensaver reset"},

  "style.about.text": {"icon":"","action":"monarch-branding-about text"},
  "style.about.image": {"icon":"","action":"monarch-branding-about image"},
  "style.about.default": {"icon":"","action":"monarch-branding-about reset"},

  "style.bar.position": {"icon":""},
  "style.bar.position.top": {"icon":"󰁝","checked":"[[ $(monarch-bar-position) == top ]]","action":"monarch-bar-position top"},
  "style.bar.position.bottom": {"icon":"󰁅","checked":"[[ $(monarch-bar-position) == bottom ]]","action":"monarch-bar-position bottom"},
  "style.bar.position.left": {"icon":"󰁍","checked":"[[ $(monarch-bar-position) == left ]]","action":"monarch-bar-position left"},
  "style.bar.position.right": {"icon":"󰁔","checked":"[[ $(monarch-bar-position) == right ]]","action":"monarch-bar-position right"},

  // Setup
  "setup.audio": {"icon":"","action":"monarch-launch-audio"},
  "setup.network": {"icon":"󰌘","aliases":["net"]},
  "setup.bluetooth": {"icon":"󰂯","keywords":["device","headphones","wireless"],"action":"monarch-launch-bluetooth"},
  "setup.power": {"icon":"󱐋","provider":"power-profiles"},
  "setup.sleep": {"icon":"󰒲"},
  "setup.defaults": {"icon":"","aliases":["default"]},
  "setup.plugins": {"icon":"󰆧","action":"noctalia msg settings-open plugins"},
  "setup.language": {"icon":"󰗊","action":"monarch-launch-floating-terminal-with-presentation monarch-setup-language"},
  "setup.monarch-language": {"icon":"󰗊"},
  "setup.monarch-language.auto": {"checked":"[[ $(monarch-language --preference) == auto ]]","action":"monarch-language auto"},
  "setup.monarch-language.en": {"checked":"[[ $(monarch-language --preference) == en ]]","action":"monarch-language en"},
  "setup.monarch-language.fr": {"checked":"[[ $(monarch-language --preference) == fr ]]","action":"monarch-language fr"},
  "setup.security": {"icon":""},
  "setup.config": {"icon":""},

  // Setup > Network
  "setup.network.overview": {"icon":"󰌘","aliases":["band"],"action":"noctalia msg panel-open monarch/network:panel"},
  "setup.network.wifi": {"icon":"󱚾","aliases":["wifi"],"keywords":["network","internet","wireless"],"action":"monarch-launch-wifi"},
  "setup.network.dns": {"icon":"󰱔","aliases":["dns"]},

  // Setup > System Sleep. Each row states the transition, so both are declared
  // and the current state hides the one that would be a no-op.
  "setup.sleep.enable-suspend": {"icon":"󰒲","when":"monarch-toggle-enabled suspend-off","action":"monarch-toggle-suspend"},
  "setup.sleep.disable-suspend": {"icon":"󰒲","when":"! monarch-toggle-enabled suspend-off","action":"monarch-toggle-suspend"},
  "setup.sleep.enable-hibernate": {"icon":"󰤁","when":"! monarch-hibernation-available","action":"monarch-launch-floating-terminal-with-presentation monarch-hibernation-setup"},
  "setup.sleep.disable-hibernate": {"icon":"󰤁","when":"monarch-hibernation-available","action":"monarch-launch-floating-terminal-with-presentation monarch-hibernation-remove"},

  // Setup > Security
  "setup.security.fingerprint": {"icon":"󰈷","when":"monarch-hw-fingerprint","checked":"[[ -f $HOME/.local/state/monarch/fingerprint-enabled ]]","action":"monarch-launch-floating-terminal-with-presentation monarch-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","checked":"[[ -s /etc/fido2/fido2 ]] && grep -q pam_u2f.so /etc/pam.d/sudo","action":"monarch-launch-floating-terminal-with-presentation monarch-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","checked":"systemctl is-enabled --quiet sshd","action":"monarch-launch-floating-terminal-with-presentation monarch-setup-security-sshd"},
  "setup.security.sudoless-docker": {"icon":"󰡨","when":"monarch-sudo-docker --configured","action":"monarch-launch-floating-terminal-with-presentation monarch-setup-security-sudoless-docker"},
  "setup.security.chat-privacy": {"icon":"󰈉","checked":"! monarch-toggle-enabled chat-privacy-off","action":"monarch-toggle-chat-privacy"},
  "setup.factory-reset": {"icon":"󰑐","action":"monarch-launch-floating-terminal-with-presentation sudo monarch-system-factory-reset"},
  "setup.network.dns.dhcp": {"icon":"󰩟","checked":"[[ \"$(/usr/bin/monarch-dns)\" == \"DHCP\" ]]","action":"/usr/bin/monarch-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","checked":"[[ \"$(/usr/bin/monarch-dns)\" == \"Cloudflare\" ]]","action":"/usr/bin/monarch-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","checked":"[[ \"$(/usr/bin/monarch-dns)\" == \"Google\" ]]","action":"/usr/bin/monarch-dns Google"},
  "setup.network.dns.custom": {"icon":"","checked":"[[ \"$(/usr/bin/monarch-dns)\" == \"Custom\" ]]","action":"monarch-launch-floating-terminal-with-presentation \"monarch-setup-dns Custom\""},

  // Setup > Defaults
  "setup.defaults.agent": {"icon":"󰚩"},
  "setup.defaults.browser": {"icon":""},
  "setup.defaults.terminal": {"icon":""},
  "setup.defaults.editor": {"icon":""},

  // Every agent Monarch can set is listed, installed or not: picking one that
  // is missing installs it — which is why these rows carry no presence guard,
  // unlike the three lists below.
  "setup.defaults.agent.agy": {"icon":"󰫢","checked":"[[ $(monarch-default-agent) == agy ]]","action":"monarch-default-agent agy"},
  "setup.defaults.agent.claude": {"icon":"󰛄","checked":"[[ $(monarch-default-agent) == claude ]]","action":"monarch-default-agent claude"},
  "setup.defaults.agent.codex": {"icon":"󰚩","checked":"[[ $(monarch-default-agent) == codex ]]","action":"monarch-default-agent codex"},
  "setup.defaults.agent.copilot": {"icon":"","checked":"[[ $(monarch-default-agent) == copilot ]]","action":"monarch-default-agent copilot"},
  "setup.defaults.agent.crush": {"icon":"󰋑","checked":"[[ $(monarch-default-agent) == crush ]]","action":"monarch-default-agent crush"},
  "setup.defaults.agent.cursor": {"icon":"󰚩","checked":"[[ $(monarch-default-agent) == cursor-agent ]]","action":"monarch-default-agent cursor-agent"},
  "setup.defaults.agent.grok": {"icon":"󰚩","checked":"[[ $(monarch-default-agent) == grok ]]","action":"monarch-default-agent grok"},
  "setup.defaults.agent.muse": {"icon":"󰚩","checked":"[[ $(monarch-default-agent) == muse ]]","action":"monarch-default-agent muse"},
  "setup.defaults.agent.omp": {"icon":"󰚩","checked":"[[ $(monarch-default-agent) == omp ]]","action":"monarch-default-agent omp"},
  "setup.defaults.agent.opencode": {"icon":"󰚩","checked":"[[ $(monarch-default-agent) == opencode ]]","action":"monarch-default-agent opencode"},
  "setup.defaults.agent.hermes": {"icon":"󰚩","checked":"[[ $(monarch-default-agent) == hermes ]]","action":"monarch-default-agent hermes"},
  "setup.defaults.agent.ori": {"icon":"󰚩","checked":"[[ $(monarch-default-agent) == ori ]]","action":"monarch-default-agent ori"},
  "setup.defaults.agent.pi": {"icon":"󰚩","checked":"[[ $(monarch-default-agent) == pi ]]","action":"monarch-default-agent pi"},

  // A browser is offered when its desktop entry exists in any of the three
  // search paths the bash menu checked, and marked when it is the current one.
  "setup.defaults.browser.chromium": {"icon":"","when":"monarch-desktop-present chromium.desktop","checked":"[[ $(monarch-default-browser) == chromium ]]","action":"monarch-default-browser chromium"},
  "setup.defaults.browser.chrome": {"icon":"󰊯","when":"monarch-desktop-present google-chrome.desktop","checked":"[[ $(monarch-default-browser) == chrome ]]","action":"monarch-default-browser chrome"},
  "setup.defaults.browser.brave": {"icon":"󰖟","when":"monarch-desktop-present brave-browser.desktop","checked":"[[ $(monarch-default-browser) == brave ]]","action":"monarch-default-browser brave"},
  "setup.defaults.browser.brave-origin": {"icon":"󰖟","when":"monarch-desktop-present brave-origin-beta.desktop","checked":"[[ $(monarch-default-browser) == brave-origin ]]","action":"monarch-default-browser brave-origin"},
  "setup.defaults.browser.edge": {"icon":"󰇩","when":"monarch-desktop-present microsoft-edge.desktop","checked":"[[ $(monarch-default-browser) == edge ]]","action":"monarch-default-browser edge"},
  "setup.defaults.browser.firefox": {"icon":"󰈹","when":"monarch-desktop-present firefox.desktop","checked":"[[ $(monarch-default-browser) == firefox ]]","action":"monarch-default-browser firefox"},
  "setup.defaults.browser.zen": {"icon":"󰖟","when":"monarch-desktop-present zen.desktop","checked":"[[ $(monarch-default-browser) == zen ]]","action":"monarch-default-browser zen"},

  "setup.defaults.terminal.alacritty": {"icon":"","when":"monarch-cmd-present alacritty","checked":"[[ $(monarch-default-terminal) == alacritty ]]","action":"monarch-default-terminal alacritty"},
  "setup.defaults.terminal.foot": {"icon":"","when":"monarch-cmd-present foot","checked":"[[ $(monarch-default-terminal) == foot ]]","action":"monarch-default-terminal foot"},
  "setup.defaults.terminal.ghostty": {"icon":"","when":"monarch-cmd-present ghostty","checked":"[[ $(monarch-default-terminal) == ghostty ]]","action":"monarch-default-terminal ghostty"},
  "setup.defaults.terminal.kitty": {"icon":"","when":"monarch-cmd-present kitty","checked":"[[ $(monarch-default-terminal) == kitty ]]","action":"monarch-default-terminal kitty"},

  "setup.defaults.editor.neovim": {"icon":"","when":"monarch-cmd-present nvim","checked":"[[ $(monarch-default-editor) == nvim ]]","action":"monarch-default-editor nvim"},
  "setup.defaults.editor.vscode": {"icon":"","when":"monarch-cmd-present code","checked":"[[ $(monarch-default-editor) == code ]]","action":"monarch-default-editor code"},
  "setup.defaults.editor.cursor": {"icon":"","when":"monarch-cmd-present cursor","checked":"[[ $(monarch-default-editor) == cursor ]]","action":"monarch-default-editor cursor"},
  "setup.defaults.editor.zed": {"icon":"","when":"monarch-cmd-present zeditor","checked":"[[ $(monarch-default-editor) == zed || $(monarch-default-editor) == zeditor ]]","action":"monarch-default-editor zed"},
  "setup.defaults.editor.sublime": {"icon":"","when":"monarch-cmd-present subl","checked":"[[ $(monarch-default-editor) == subl ]]","action":"monarch-default-editor subl"},
  "setup.defaults.editor.helix": {"icon":"","when":"monarch-cmd-present helix","checked":"[[ $(monarch-default-editor) == helix ]]","action":"monarch-default-editor helix"},
  "setup.defaults.editor.vim": {"icon":"","when":"monarch-cmd-present vim","checked":"[[ $(monarch-default-editor) == vim ]]","action":"monarch-default-editor vim"},
  "setup.defaults.editor.emacs": {"icon":"","when":"monarch-cmd-present emacs","checked":"[[ $(monarch-default-editor) == emacs ]]","action":"monarch-default-editor emacs"},

  // Setup > Config
  "setup.config.input": {"icon":"","keywords":["keyboard","mouse","touchpad","layout"],"action":"notify-send -u low 'Editing input settings' \"$HOME/.config/niri/user.kdl\"; monarch-launch-editor \"$HOME/.config/niri/user.kdl\" && monarch-refresh-niri"},
  "setup.config.niri": {"icon":"","action":"notify-send -u low 'Editing config file' \"$HOME/.config/niri/user.kdl\"; monarch-launch-editor \"$HOME/.config/niri/user.kdl\" && monarch-refresh-niri"},
  "setup.config.noctalia": {"icon":"󰕮","action":"notify-send -u low 'Editing config file' \"$HOME/.config/noctalia/config.toml\"; monarch-launch-editor \"$HOME/.config/noctalia/config.toml\" && noctalia msg config-reload"},
  "setup.config.xcompose": {"icon":"󰞅","action":"notify-send -u low 'Editing config file' \"$HOME/.XCompose\"; monarch-launch-editor \"$HOME/.XCompose\" && monarch-restart-xcompose"},

  // Install
  "install.package": {"icon":"󰣇","action":"xdg-terminal-exec --app-id=org.monarch.terminal monarch-pkg-install"},
  "install.aur": {"icon":"󰣇","action":"xdg-terminal-exec --app-id=org.monarch.terminal monarch-pkg-aur-install"},
  "install.webapp": {"icon":"","action":"monarch-launch-floating-terminal-with-presentation monarch-webapp-install"},
  "install.tui": {"icon":"","action":"monarch-launch-floating-terminal-with-presentation monarch-tui-install"},
  "install.theme": {"icon":"󰏘","action":"monarch-launch-floating-terminal-with-presentation monarch-theme-install"},
  "install.browser": {"icon":""},
  "install.editor": {"icon":""},
  "install.terminal": {"icon":""},
  "install.development": {"icon":"󰵮"},
  "install.ai": {"icon":"󱚤"},
  "install.cyber": {"icon":"󰨈"},
  "install.gaming": {"icon":""},
  "install.service": {"icon":""},
  "install.font": {"icon":""},
  "install.windows": {"icon":"󰍲","disabled":"[[ -f $HOME/.local/share/applications/windows-vm.desktop ]]","action":"monarch-launch-floating-terminal-with-presentation \"monarch-windows-vm install\""},
