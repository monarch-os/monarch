  "update.monarch": {"icon":"","label":"Monarch","description":"Update Monarch and installed packages","keywords":["upgrade","system","packages"],"action":"monarch-launch-floating-terminal-with-presentation monarch-update"},
  "update.channel": {"icon":"󰔫","label":"Channel","title":"Update channel"},
  "update.config": {"icon":"","label":"Config","title":"Use default config"},
  "update.process": {"icon":"","label":"Process","title":"Restart"},
  "update.hardware": {"icon":"󰇅","label":"Hardware","title":"Restart"},
  "update.firmware": {"icon":"","label":"Firmware","action":"monarch-launch-floating-terminal-with-presentation monarch-update-firmware"},
  "update.password": {"icon":"","label":"Password","title":"Update Password"},
  "update.timezone": {"icon":"","label":"Timezone","action":"monarch-launch-floating-terminal-with-presentation monarch-tz-select"},
  "update.time": {"icon":"","label":"Time","action":"monarch-launch-floating-terminal-with-presentation monarch-update-time"},

  "update.channel.stable": {"icon":"󰕥","label":"Stable","checked":"[[ \"$(monarch-version-channel)\" == \"stable\" ]]","action":"monarch-launch-floating-terminal-with-presentation \"monarch-channel-set stable\""},
  "update.channel.dev": {"icon":"󰂓","label":"Dev","checked":"[[ \"$(monarch-version-channel)\" == \"dev\" ]]","action":"monarch-launch-floating-terminal-with-presentation \"monarch-channel-set dev\""},

  "update.config.niri": {"icon":"","label":"Niri","action":"monarch-launch-floating-terminal-with-presentation monarch-refresh-niri"},
  "update.config.plymouth": {"icon":"󱣴","label":"Plymouth","action":"monarch-launch-floating-terminal-with-presentation monarch-refresh-plymouth"},
  "update.config.noctalia": {"icon":"󰕮","label":"Noctalia","action":"monarch-launch-floating-terminal-with-presentation monarch-refresh-noctalia"},

  "update.process.noctalia": {"icon":"󰕮","label":"Noctalia","action":"monarch-restart-noctalia"},

  "update.hardware.audio": {"icon":"","label":"Audio","action":"monarch-launch-floating-terminal-with-presentation monarch-restart-pipewire"},
  "update.hardware.wifi": {"icon":"󱚾","label":"Wi-Fi","action":"monarch-launch-floating-terminal-with-presentation monarch-restart-wifi"},
  "update.hardware.bluetooth": {"icon":"󰂯","label":"Bluetooth","action":"monarch-launch-floating-terminal-with-presentation monarch-restart-bluetooth"},
  "update.hardware.trackpad": {"icon":"󰟸","label":"Trackpad","action":"monarch-launch-floating-terminal-with-presentation monarch-restart-trackpad"},

  "update.password.drive": {"icon":"","label":"Drive Encryption","action":"monarch-launch-floating-terminal-with-presentation monarch-drive-password"},
  "update.password.user": {"icon":"","label":"User","action":"monarch-launch-floating-terminal-with-presentation passwd"},

  // System
  "system.lock": {"icon":"","label":"Lock","keywords":["secure","session"],"action":"monarch-system-lock"},
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"monarch-launch-screensaver force"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! monarch-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"monarch-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"monarch-system-logout"},
  "system.restart": {"icon":"󰜉","label":"Restart","keywords":["reboot","power"],"action":"monarch-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","keywords":["poweroff","turn off","power"],"action":"monarch-system-shutdown"},
}
