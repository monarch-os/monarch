  "remove.development.php.laravel": {"icon":"","action":"monarch-launch-floating-terminal-with-presentation \"monarch-remove-dev-env laravel\"","when":"[[ -x $HOME/.config/composer/vendor/bin/laravel ]]"},
  "remove.development.php.symfony": {"icon":"","action":"monarch-launch-floating-terminal-with-presentation \"monarch-remove-dev-env symfony\"","when":"monarch-pkg-present symfony-cli"},

  "remove.development.elixir.elixir": {"icon":"","action":"monarch-launch-floating-terminal-with-presentation \"monarch-remove-dev-env elixir\"","when":"[[ -d $HOME/.local/share/mise/installs/elixir ]]"},
  "remove.development.elixir.phoenix": {"icon":"","when":"compgen -G \"$HOME/.mix/archives/phx_new*\"","action":"monarch-launch-floating-terminal-with-presentation \"monarch-remove-dev-env phoenix\""},

  // Update
  "update.monarch": {"icon":"","keywords":["upgrade","system","packages"],"action":"monarch-launch-floating-terminal-with-presentation --app-id=org.monarch.update monarch-update"},
  "update.theme": {"icon":"󰏘","when":"compgen -G \"$HOME/.config/monarch/themes/*/provenance.json\"","action":"monarch-launch-floating-terminal-with-presentation monarch-theme-update"},
  "update.channel": {"icon":"󰔫"},
  "update.config": {"icon":""},
  "update.process": {"icon":""},
  "update.hardware": {"icon":"󰇅"},
  "update.firmware": {"icon":"","action":"monarch-launch-floating-terminal-with-presentation monarch-update-firmware"},
  "update.password": {"icon":""},
  "update.timezone": {"icon":"","action":"monarch-launch-floating-terminal-with-presentation monarch-tz-select"},
  "update.time": {"icon":"","action":"monarch-launch-floating-terminal-with-presentation monarch-update-time"},

  "update.channel.stable": {"icon":"󰕥","checked":"[[ \"$(monarch-version-channel)\" == \"stable\" ]]","action":"monarch-launch-floating-terminal-with-presentation \"monarch-channel-set stable\""},
  "update.channel.dev": {"icon":"󰂓","checked":"[[ \"$(monarch-version-channel)\" == \"dev\" ]]","action":"monarch-launch-floating-terminal-with-presentation \"monarch-channel-set dev\""},

  "update.config.niri": {"icon":"","action":"monarch-launch-floating-terminal-with-presentation monarch-refresh-niri"},
  "update.config.plymouth": {"icon":"󱣴","action":"monarch-launch-floating-terminal-with-presentation monarch-refresh-plymouth"},
  "update.config.noctalia": {"icon":"󰕮","action":"monarch-launch-floating-terminal-with-presentation monarch-refresh-noctalia"},

  "update.process.noctalia": {"icon":"󰕮","action":"monarch-restart-noctalia"},

  "update.hardware.audio": {"icon":"","action":"monarch-launch-floating-terminal-with-presentation monarch-restart-pipewire"},
  "update.hardware.wifi": {"icon":"󱚾","action":"monarch-launch-floating-terminal-with-presentation monarch-restart-wifi"},
  "update.hardware.bluetooth": {"icon":"󰂯","action":"monarch-launch-floating-terminal-with-presentation monarch-restart-bluetooth"},
  "update.hardware.trackpad": {"icon":"󰟸","action":"monarch-launch-floating-terminal-with-presentation monarch-restart-trackpad"},

  "update.password.drive": {"icon":"","action":"monarch-launch-floating-terminal-with-presentation monarch-drive-password"},
  "update.password.user": {"icon":"","action":"monarch-launch-floating-terminal-with-presentation passwd"},

  // System
  "system.lock": {"icon":"","keywords":["secure","session"],"action":"monarch-system-lock"},
  "system.screensaver": {"icon":"󱄄","action":"monarch-launch-screensaver force"},
  "system.suspend": {"icon":"󰒲","when":"! monarch-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","when":"monarch-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","action":"monarch-system-logout"},
  "system.restart": {"icon":"󰜉","keywords":["reboot","power"],"action":"monarch-system-reboot"},
  "system.shutdown": {"icon":"󰐥","keywords":["poweroff","turn off","power"],"action":"monarch-system-shutdown"},
  "system.crashes": {"icon":"󰨇","keywords":["crash","diagnostic","logs","report"],"action":"monarch-crash-history"},
}
