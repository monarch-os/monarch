unalias digall cheat upload pv pysrv probe-urls show-open-ports 2>/dev/null || true

digall() { dig +answer +multiline "$1" any @8.8.8.8; }
cheat() { curl -s "cheat.sh/$1"; }
upload() { curl -F "file=@$1" https://0x0.st; }

show-open-ports() (
  set -o pipefail
  local sockets
  local -a color_args=()
  sockets=$(sudo ss -H -lntup) || return $?
  if [[ -t 1 && -z ${NO_COLOR+x} && ${TERM:-} != "dumb" ]]; then
    color_args=(--color)
  fi
  printf '%s\n' "$sockets" |
    python3 "${MONARCH_PATH:-/usr/share/monarch}/default/shells/lib/open-ports.py" "${color_args[@]}"
)

pysrv() {
  mkdir -pv /tmp/empty && python -m http.server -d /tmp/empty
}

probe-urls() {
  if (( $# != 1 )); then
    echo "Usage: probe-urls <url-list>" >&2
    return 2
  fi
  local url
  while IFS= read -r url || [[ -n $url ]]; do
    curl -sk "$url" -o /dev/null -w '%{http_code}:%{size_download}:%{url_effective}\n'
  done < "$1"
}

pv() {
  if (( $# != 1 )); then
    echo "Usage: pv <python-version>" >&2
    return 2
  fi
  mise use "python@$1" &&
    mise config set env._.python.venv.path .venv &&
    mise config set --type list env._.python.venv.uv_create_args -- --seed &&
    mise config set --type bool env._.python.venv.create true &&
    mise exec -- which python &&
    mise exec -- python --version
}
