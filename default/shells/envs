# Editor used by CLI
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# Color man pages with bat
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

export NESSUS_KEY="NESSUS_KEY"

# Duplicated from .config/uwsm/env so SSH works too
if [[ -z ${MONARCH_PATH:-} ]]; then
  if [[ -x ${MONARCH_RUNTIME_ROOT:-/usr/share/monarch}/bin/monarch ]]; then
    MONARCH_PATH=${MONARCH_RUNTIME_ROOT:-/usr/share/monarch}
  else
    MONARCH_PATH=$HOME/.local/share/monarch
  fi
fi
export MONARCH_PATH
case ":$PATH:" in
  *":$MONARCH_PATH/bin:"*) ;;
  *) PATH=$MONARCH_PATH/bin${PATH:+:$PATH} ;;
esac
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH=${PATH:+$PATH:}$HOME/.local/share/mise/shims ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH=${PATH:+$PATH:}$HOME/.local/bin ;;
esac
export PATH
