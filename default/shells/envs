# Editor used by CLI
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# Color man pages with bat
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

export NESSUS_KEY="NESSUS_KEY"

# Duplicated from .config/uwsm/env so SSH works too
export MONARCH_PATH=${MONARCH_PATH:-/usr/share/monarch}
case ":$PATH:" in
  *":$MONARCH_PATH/bin:"*) ;;
  *) PATH=$MONARCH_PATH/bin${PATH:+:$PATH} ;;
esac
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH=${PATH:+$PATH:}$HOME/.local/share/mise/shims ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH=${PATH:+$PATH:}$HOME/.local/bin ;;
esac
export PATH
