## Nessus
alias dnessus-start='if [ $(docker inspect -f "{{.State.Running}}" nessus-pro 2>/dev/null) ]; then docker start nessus-pro; else docker run --name "nessus-pro" -d -p 127.0.0.1:8834:8834  -e ACTIVATION_CODE=$NESSUS_KEY -e USERNAME=admin -e PASSWORD=admin tenable/nessus:latest-ubuntu && dnessus-web; fi'
alias dnessus-web='if [ $(docker inspect -f "{{.State.Running}}" nessus-pro 2>/dev/null) ]; then xdg-open https://localhost:8834; else echo "nessus is not running, try \"dnessus-start\" to launch it"; fi'
alias dnessus-stop='if [ $(docker inspect -f "{{.State.Running}}" nessus-pro 2>/dev/null) ]; then docker stop nessus-pro; else echo "nessus is already stopped"; fi'
alias dnessus-logs='if [ $(docker inspect -f "{{.State.Running}}" nessus-pro 2>/dev/null) ]; then docker logs -f nessus-pro; else echo "nessus is is not running, try \"dnessus-start\" to launch it"; fi'

