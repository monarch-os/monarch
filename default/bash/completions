_monarch_complete() {
  COMPREPLY=()
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local IFS=$'\n'
  COMPREPLY=($(compgen -W "$(_monarch_candidates "$((COMP_CWORD + 1))" "${COMP_WORDS[@]}")" -- "$cur"))
}
complete -o default -F _monarch_complete monarch

# Hide individual monarch-* binaries from initial-word command completion;
# the unified `monarch` dispatcher is the user-facing entry point.
complete -I -A command -X 'monarch-*'
