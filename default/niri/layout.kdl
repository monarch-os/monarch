// Monarch — layout (gaps, focus-ring/border geometry, shadow, hints).
//
// Theme colours for focus-ring and border live in
// ~/.config/monarch/current/theme/niri-colors.kdl (rendered by
// monarch-theme-set-templates) and merge into this layout block at load
// time. Niri merges nested sections from includes, so width/urgent-color
// stay here while active/inactive colours come from the theme.

layout {
    gaps 10
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        on
        width 2
        urgent-color "#9b0000"
    }

    border {
        off
        width 2
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 20
        spread 2
        offset x=0 y=4
        color "#1a1a1aee"
    }

    insert-hint {
        on
    }
}
