// Monarch entry-point Niri configuration.
//
// This file is installed at ~/.config/niri/config.kdl by monarch-refresh-niri.
// It is intentionally minimal: the heavy lifting lives in the Monarch
// defaults under @MONARCH_PATH@/default/niri/ and in the current
// theme directory. Niri merges sections from included files, so each piece
// stays focused on a single concern.
//
// To customise Monarch's defaults, edit ~/.config/niri/user.kdl instead
// (it is included LAST so your overrides win). See that file for examples.

include "@MONARCH_PATH@/default/niri/environment.kdl"
include "@MONARCH_PATH@/default/niri/input.kdl"

// Monarch's runtime overrides — a single generated include holding every
// override Monarch applies live: input device on-off (touchpad/touchscreen) and
// per-output scale (display-scaling cycle). Owned by monarch-niri-runtime,
// bootstrapped empty by monarch-refresh-niri so the include always resolves, and
// watched by niri for live-reload. Kept before user.kdl so manual settings win.
include "./runtime.kdl"

include "@MONARCH_PATH@/default/niri/power.kdl"
include "@MONARCH_PATH@/default/niri/layout.kdl"

// Persistent 1..10 workspaces + their Mod+1..0 / Mod+Shift+1..0 binds.
// Generated by monarch-refresh-niri from ~/.config/niri/workspaces.conf so the
// workspace names (shown in the bar) and the bind targets stay in lockstep.
// MUST come before misc.kdl: Niri starts on the FIRST-declared workspace, and
// misc.kdl declares the scratchpad — include it first and you boot into the
// "scratchpad" workspace instead of workspace 1.
include "~/.config/niri/workspaces.kdl"

include "@MONARCH_PATH@/default/niri/misc.kdl"
include "@MONARCH_PATH@/default/niri/windows.kdl"
include "@MONARCH_PATH@/default/niri/autostart.kdl"
include "@MONARCH_PATH@/default/niri/binds.kdl"

// Theme colours (focus-ring / border). Monarch ships a default noctalia.kdl so
// this include always resolves on first boot; Noctalia regenerates it per scheme.
include "./noctalia.kdl"

// Console keyboard layout mirror. Generated by detect-keyboard-layout.sh.
include "~/.config/niri/keyboard.kdl"

// User overrides — always loaded last so they take precedence.
include "~/.config/niri/user.kdl"
