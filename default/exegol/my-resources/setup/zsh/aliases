alias extract_smbv1_hosts='sqlite3 /root/.nxc/workspaces/default/smb.db -list "SELECT ip,hostname from hosts where smbv1 = 1 and hostname != \"server_name\";" | sort -t . -k 1,1n -k 2,2n -k 3,3n -k 4,4n | sed "s/|/ (/; s/$/)/" | tee smbv1_hosts.txt'
alias extract_no_smb_signing_hosts='sqlite3 /root/.nxc/workspaces/default/smb.db -list "SELECT ip, hostname from hosts where signing = 0 and hostname != \"server_name\";" | sort -t . -k 1,1n -k 2,2n -k 3,3n -k 4,4n | sed "s/|/ (/; s/$/)/" | tee no_signing_hosts.txt'
alias extract_obsolete_windows='sqlite3 /root/.nxc/workspaces/default/smb.db -list "SELECT printf('\''%s (%s) : %s'\'', IP, Hostname, OS) FROM hosts WHERE OS LIKE '\''%Windows XP%'\'' OR OS LIKE '\''%Windows Vista%'\'' OR OS LIKE '\''%Windows 5.1%'\'' OR OS LIKE '\''%Windows 7%'\'' OR OS LIKE '\''%Windows 8%'\'' OR OS LIKE '\''%Windows 8.1%'\'' OR OS LIKE '\''%Windows Server 2003%'\'' OR OS LIKE '\''%Windows Server 2008%'\'' OR OS LIKE '\''%Windows Server 2008 R2%'\'' OR OS LIKE '\''%Windows Server 2012%'\'' OR OS LIKE '\''%Windows Server 2012 R2%'\'' OR OS LIKE '\''%Windows Embedded%'\'';" | sort -t . -k 1,1n -k 2,2n -k 3,3n -k 4,4n | tee windows_obsolete_from_nxcdb.txt'
