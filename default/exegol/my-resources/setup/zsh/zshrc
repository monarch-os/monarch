# Config file dedicated to the user's personal zshrc profile shared between all exegol containers.
# This file is sourced in /root/.zshrc file.
# Alternatively, the /opt/my-resources/setup/load_user_setup.sh file can be used to operate the change once (instead of sourcing a file for each zsh instance)

# ═══════════════════════════════════════════════════════════════════
# Custom Zsh Configuration (sourced by Exegol's .zshrc at the end)
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# Disable Exegol's prompt to allow Starship to take over
# ───────────────────────────────────────────────────────────────────
precmd_functions=("${(@)precmd_functions:#update_prompt}")

# ───────────────────────────────────────────────────────────────────
# TERMINAL & EDITOR
# ───────────────────────────────────────────────────────────────────
export TERM=xterm-256color
export EDITOR="nvim"

# ───────────────────────────────────────────────────────────────────
# PATH CONFIGURATION
# ───────────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"

# ───────────────────────────────────────────────────────────────────
# PROMPT & THEME
# ───────────────────────────────────────────────────────────────────
if command -v /opt/my-resources/bin/starship &> /dev/null; then
    export STARSHIP_CONFIG=~/.config/starship.toml
    eval "$(/opt/my-resources/bin/starship init zsh)"
fi

# ───────────────────────────────────────────────────────────────────
# MODERN CLI TOOLS
# ───────────────────────────────────────────────────────────────────

# Zoxide (better cd)
if command -v /opt/my-resources/bin/zoxide &> /dev/null; then
    eval "$(/opt/my-resources/bin/zoxide init zsh --cmd cd)"
fi

# Bat - use Dracula theme
export BAT_THEME="Dracula"

# FZF - Dracula theme
export FZF_DEFAULT_OPTS="--color=fg:#f8f8f2,bg:#282a36,hl:#bd93f9 --color=fg+:#f8f8f2,bg+:#44475a,hl+:#bd93f9 --color=info:#ffb86c,prompt:#50fa7b,pointer:#ff79c6 --color=marker:#ff79c6,spinner:#ffb86c,header:#6272a4"
export FZF_DEFAULT_COMMAND='/opt/my-resources/bin/fd --type f --hidden --follow --exclude .git 2>/dev/null || find . -type f'

# Eza colors
export EZA_COLORS="da=1;34:gm=1;34"

# Delta (git diff)
export DELTA_FEATURES="+side-by-side"

# ───────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLE SHARING (for Zellij panes/tabs)
# ───────────────────────────────────────────────────────────────────

# Legacy ~/.shared_env contains shell code and is deliberately never imported.
export SHARED_ENV_FILE="${HOME}/.shared_env.json"

setshared() {
  if (( $# != 1 )) || [[ $1 != *=* ]]; then
    echo "Usage: setshared VARIABLE=value"
    echo "Example: setshared IP=10.4.10.100"
    return 1
  fi
  printf '%s' "$1" | _monarch_shared_env set || return
  export "$1"
}

loadshared() {
  local records record
  records=$(_monarch_shared_env load) || return
  for record in "${(@0)records}"; do
    if [[ -n $record ]]; then
      export "$record" || return
    fi
  done
  return 0
}

listshared() {
  _monarch_shared_env list
}

clearshared() {
  _monarch_shared_env clear
}

_monarch_shared_env() {
  python3 -I /opt/my-resources/tools/shared-env.py "$SHARED_ENV_FILE" "$1"
}

loadshared

autoload -Uz add-zsh-hook
reload_shared_env() {
  loadshared
}
add-zsh-hook precmd reload_shared_env

unalias setip settarget setdomain setuser setpass 2>/dev/null
function setip() { (( $# == 1 )) && setshared "IP=$1"; }
function settarget() { (( $# == 1 )) && setshared "TARGET=$1"; }
function setdomain() { (( $# == 1 )) && setshared "DOMAIN=$1"; }
function setuser() { (( $# == 1 )) && setshared "USER=$1"; }
function setpass() { (( $# == 1 )) && setshared "PASS=$1"; }


export INTELX_KEY=YOUR_INTELX_KEY
export PDCP_API_KEY=YOUR_PROJECT_DISCOVERY_KEY
export LEAKCHECK_APIKEY=YOUR_LEAKCHECK_KEY
