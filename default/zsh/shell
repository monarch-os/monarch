source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# History control
HISTFILE=~/.zsh_history           # History file location
HISTSIZE=10000                    # Number of commands to remember in session
SAVEHIST=10000                    # Number of commands to save to file
setopt SHARE_HISTORY              # Share history between all sessions
setopt INC_APPEND_HISTORY         # Write to history file immediately, not on shell exit
setopt HIST_IGNORE_ALL_DUPS       # Delete old recorded entry if new entry is a duplicate
setopt HIST_FIND_NO_DUPS          # Do not display duplicates when searching
setopt HIST_REDUCE_BLANKS         # Remove superfluous blanks from history

autoload -U select-word-style
select-word-style bash

# Make Monarch's completion functions discoverable by compinit (now and on
# any subsequent compinit calls from other tools, e.g. scw/kubectl/talosctl).
fpath=(~/.local/share/monarch/default/zsh/functions $fpath)

autoload -Uz compinit
compinit
zstyle ':completion:*' menu select

# Hide individual monarch-* binaries from command completion;
# the unified `monarch` dispatcher is the user-facing entry point.
zstyle ':completion:*:-command-:*' ignored-patterns 'monarch-*'
